+    fn native_image_proof_preserves_position_reference_and_detail() -> anyhow::Result<()> {
+        let make = |id: &str, detail: &str| {
+            item(json!({"type":"message", "role":"user",
+            "content":[{"type":"input_image", "file_id":id, "detail":detail}]}))
+        };
+        let original = make("private-reference-one", "high")?;
+        let same = make("private-reference-one", "high")?;
+        let different_id = make("private-reference-two", "high")?;
+        let different_detail = make("private-reference-one", "low")?;
+        let unavailable = item(json!({"type":"message", "role":"user",
+            "content":[{"type":"input_text", "text":"[image unavailable]"}]}))?;
+        for (other, matches) in [
+            (same, true),
+            (different_id, false),
+            (different_detail, false),
+            (unavailable, false),
+        ] {
+            assert_eq!(
+                same_media_slots(std::iter::once(&original.item), &[other.item]),
+                matches
+            );
+        }
+        Ok(())
+    }
