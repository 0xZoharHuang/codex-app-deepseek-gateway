+#[tokio::test(start_paused = true)]
+async fn payload_too_large_retries_only_with_explicit_server_advice() {
+    let error = CodexErr::UnexpectedStatus(UnexpectedResponseError {
+        status: StatusCode::PAYLOAD_TOO_LARGE,
+        body: "request exceeds transport bytes".into(),
+        user_message: None,
+        url: None,
+        cf_ray: None,
+        request_id: None,
+        identity_authorization_error: None,
+        identity_error_code: None,
+    });
+    assert_eq!(error.retry_delay(1), None);
+    assert_eq!(error.http_status_code_value(), Some(413));
+    let delay = Duration::from_secs(3);
+    let with_advice =
+        error.with_retry_after(RetryAfter::from_delay(delay).expect("valid deadline"));
+    assert_eq!(with_advice.retry_delay(1), Some(delay));
+}
