+//! Typed, ordered prompt views of an immutable historical compaction target.
+//! The native installer sees the original prefix, never a projected envelope.
+use crate::compact_remote_history::is_attached_notice;
+use crate::session::capacity_recovery::pair_safe_prefix;
+use codex_context_fragments::set_annotated_content;
+use codex_context_fragments::to_annotated_content;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::models::is_image_close_tag_text;
+use codex_protocol::models::is_image_open_tag_text;
+use codex_protocol::models::is_local_image_open_tag_text;
+use std::ops::Range;
+
+#[derive(Clone, Debug)]
+pub(super) struct Projection {
+    original: Range<usize>,
+    part_item: Option<usize>,
+    parts: Range<usize>,
+    text: Option<Range<usize>>,
+}
+
+impl Projection {
+    pub(super) fn whole(original: Range<usize>) -> Self {
+        Self {
+            original,
+            part_item: None,
+            parts: 0..0,
+            text: None,
+        }
+    }
+
+    pub(super) fn original(&self) -> Range<usize> {
+        self.original.clone()
+    }
+
+    pub(super) fn is_whole(&self) -> bool {
+        self.part_item.is_none()
+    }
+
+    pub(super) fn instruction(&self) -> String {
+        if self.part_item.is_none() {
+            return String::new();
+        }
+        format!(
+            "\nHistorical compaction view of original items {:?}, content parts {:?}, text bytes {:?}. These are ordered parts of already recorded content. Integrate them with the prior fresh summary without treating old calls as new actions.",
+            self.original, self.parts, self.text,
+        )
+    }
+
+    pub(super) fn items(
+        &self,
+        source: &[ResponseItemEnvelope],
+    ) -> Option<Vec<ResponseItemEnvelope>> {
+        let mut selected = source.get(self.original.clone())?.to_vec();
+        let Some(index) = self.part_item else {
+            return Some(selected);
+        };
+        let item = &mut selected.get_mut(index - self.original.start)?.item;
+        match item {
+            ResponseItem::Message { .. } => {
+                let mut annotated = to_annotated_content(item)?;
+                let mut parts = annotated.drain(self.parts.clone()).collect::<Vec<_>>();
+                if let Some(range) = &self.text {
+                    let ContentItem::InputText { text } = parts.first_mut()?.content_mut() else {
+                        return None;
+                    };
+                    *text = text.get(range.clone())?.to_owned();
+                }
+                set_annotated_content(item, parts)?;
+            }
+            ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } => match &mut output.body {
+                FunctionCallOutputBody::ContentItems(parts) => {
+                    let mut chosen = parts.drain(self.parts.clone()).collect::<Vec<_>>();
+                    if let Some(range) = &self.text {
+                        let FunctionCallOutputContentItem::InputText { text } =
+                            chosen.first_mut()?
+                        else {
+                            return None;
+                        };
+                        *text = text.get(range.clone())?.to_owned();
+                    }
+                    *parts = chosen;
+                }
+                FunctionCallOutputBody::Text(text) => {
+                    *text = text.get(self.text.clone()?)?.to_owned();
+                }
+            },
+            _ => return None,
+        }
+        Some(selected)
+    }
+
+    pub(super) fn split(
+        &self,
+        source: &[ResponseItemEnvelope],
+        current_turn: &str,
+        confirmed_len: usize,
+    ) -> Option<(Self, Self)> {
+        let mut projection = self.clone();
+        if projection.part_item.is_none() {
+            let middle = self.original.start + self.original.len() / 2;
+            let cut = pair_safe_prefix(source, middle);
+            if safe_item_cut(source, &self.original, cut) {
+                return Some((
+                    Self::whole(self.original.start..cut),
+                    Self::whole(cut..self.original.end),
+                ));
+            }
+            if let Some(cut) = (self.original.start + 1..self.original.end).find(|cut| {
+                safe_item_cut(source, &self.original, *cut)
+                    && pair_safe_prefix(source, *cut) == *cut
+            }) {
+                return Some((
+                    Self::whole(self.original.start..cut),
+                    Self::whole(cut..self.original.end),
+                ));
+            }
+            let original = source.get(self.original.clone())?;
+            let body = if original
+                .last()
+                .is_some_and(|item| is_attached_notice(&item.item))
+            {
+                &original[..original.len() - 1]
+            } else {
+                original
+            };
+            let attributed = body.first()?.item.turn_id()?;
+            if (attributed == current_turn && self.original.end > confirmed_len)
+                || body
+                    .iter()
+                    .any(|envelope| envelope.item.turn_id() != Some(attributed))
+            {
+                return None;
+            }
+            let part_item = match body {
+                [message] if splittable_message(&message.item) => self.original.start,
+                [call, output] if matching_plain_pair(&call.item, &output.item) => {
+                    self.original.start + 1
+                }
+                _ => return None,
+            };
+            projection.part_item = Some(part_item);
+            projection.parts = 0..parts(&source[part_item].item)?.len();
+        }
+
+        let item = &source[projection.part_item?].item;
+        let all_parts = parts(item)?;
+        let middle = projection.parts.start + projection.parts.len() / 2;
+        if let Some(cut) = (projection.parts.start + 1..projection.parts.end)
+            .filter(|cut| !atomic_image_boundary(&all_parts, *cut))
+            .min_by_key(|cut| cut.abs_diff(middle))
+        {
+            let mut right = projection.clone();
+            right.parts.start = cut;
+            projection.parts.end = cut;
+            return Some((projection, right));
+        }
+        if projection.parts.len() != 1 {
+            return None;
+        }
+        let Part::Text(text) = all_parts[projection.parts.start] else {
+            return None;
+        };
+        if image_open(text) || is_image_close_tag_text(text) {
+            return None;
+        }
+        let range = projection.text.clone().unwrap_or(0..text.len());
+        let middle = range.start + range.len() / 2;
+        let cut = (range.start + 1..=middle)
+            .rev()
+            .take(4)
+            .chain((middle + 1..range.end).take(4))
+            .find(|index| *index < range.end && text.is_char_boundary(*index))?;
+        let mut right = projection.clone();
+        right.text = Some(cut..range.end);
+        projection.text = Some(range.start..cut);
+        Some((projection, right))
+    }
+}
+
+fn safe_item_cut(source: &[ResponseItemEnvelope], original: &Range<usize>, cut: usize) -> bool {
+    original.start < cut && cut < original.end && !is_attached_notice(&source[cut].item)
+}
+
+fn splittable_message(item: &ResponseItem) -> bool {
+    matches!(item, ResponseItem::Message { encrypted_content: None, status, .. }
+        if status.as_deref().is_none_or(|status| status == "completed"))
+}
+
+fn matching_plain_pair(call: &ResponseItem, output: &ResponseItem) -> bool {
+    match (call, output) {
+        (
+            ResponseItem::FunctionCall {
+                call_id,
+                encrypted_content: None,
+                encrypted_function_args: None,
+                status,
+                ..
+            },
+            ResponseItem::FunctionCallOutput {
+                call_id: Some(output_id),
+                ..
+            },
+        )
+        | (
+            ResponseItem::CustomToolCall {
+                call_id,
+                encrypted_content: None,
+                status,
+                ..
+            },
+            ResponseItem::CustomToolCallOutput {
+                call_id: output_id, ..
+            },
+        ) => call_id == output_id && status.as_deref().is_none_or(|status| status == "completed"),
+        _ => false,
+    }
+}
+
+#[derive(Clone, Copy)]
+enum Part<'a> {
+    Text(&'a str),
+    Image,
+    Opaque,
+}
+
+fn parts(item: &ResponseItem) -> Option<Vec<Part<'_>>> {
+    Some(match item {
+        ResponseItem::Message { content, .. } => content
+            .iter()
+            .map(|part| match part {
+                ContentItem::InputText { text } => Part::Text(text),
+                ContentItem::InputImage { .. } => Part::Image,
+                _ => Part::Opaque,
+            })
+            .collect(),
+        ResponseItem::FunctionCallOutput { output, .. }
+        | ResponseItem::CustomToolCallOutput { output, .. } => match &output.body {
+            FunctionCallOutputBody::Text(text) => vec![Part::Text(text)],
+            FunctionCallOutputBody::ContentItems(parts) => parts
+                .iter()
+                .map(|part| match part {
+                    FunctionCallOutputContentItem::InputText { text } => Part::Text(text),
+                    FunctionCallOutputContentItem::InputImage { .. } => Part::Image,
+                    _ => Part::Opaque,
+                })
+                .collect(),
+        },
+        _ => return None,
+    })
+}
+
+fn image_open(text: &str) -> bool {
+    is_local_image_open_tag_text(text) || is_image_open_tag_text(text)
+}
+
+fn atomic_image_boundary(parts: &[Part<'_>], cut: usize) -> bool {
+    matches!((parts[cut - 1], parts[cut]), (Part::Text(text), Part::Image) if image_open(text))
+        || matches!((parts[cut - 1], parts[cut]), (Part::Image, Part::Text(text)) if is_image_close_tag_text(text))
+}
