+#[derive(Debug)]
+pub struct RequestCapacityCleanup {
+    pub checkpoint_removed: bool,
+    /// Bounded deletion markers retain the per-thread OS lock domain and prevent
+    /// late admitted writers from republishing. No history or credential is kept.
+    pub lock_retained: bool,
+}
+
+/// Call only after the native thread was successfully deleted. A retained lock
+/// marker fences writers still admitted after bounded shutdown observation.
+/// Close/archive/resume retain their consumption checkpoint.
+pub async fn delete_thread_request_capacity_checkpoint(
+    home: &std::path::Path,
+    thread_id: codex_protocol::ThreadId,
+) -> anyhow::Result<RequestCapacityCleanup> {
+    let home = home.to_owned();
+    tokio::task::spawn_blocking(move || -> anyhow::Result<RequestCapacityCleanup> {
+        let result = session::request_capacity::delete_thread_data(&home, &thread_id.to_string())?;
+        Ok(RequestCapacityCleanup {
+            checkpoint_removed: result.checkpoint_removed,
+            lock_retained: result.lock_retained,
+        })
+    })
+    .await?
+}
