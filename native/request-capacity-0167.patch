+    path: PathBuf,
+}
+
+#[cfg(test)]
+impl TestProfile {
+    pub(crate) fn new() -> Result<Self> {
+        let root = tempfile::tempdir()?;
+        let parent = std::fs::canonicalize(root.path())?;
+        // A Windows elevated token can give ordinary temporary directories
+        // the Administrators group as owner. Create the profile with the
+        // same explicit current-user ownership as native capacity children.
+        let directory = platform::Directory::open_home(&parent)?;
+        directory
+            .child("profile", true, true)?
+            .context("create private test profile")?;
+        let path = parent.join("profile");
+        Ok(Self { _root: root, path })
+    }
+
+    pub(crate) fn path(&self) -> &Path {
+        &self.path
+    }
+}
