+/// Admission checked at the native install linearization point, not when the
+/// summary request is launched. The existing Prefix installation remains the
+/// sole mutator of the live annotated history.
+pub(crate) struct CapacityCommit<'a> {
+    pub(crate) install_hash: [u8; 32],
+    pub(crate) history_anchor: &'a str,
+    pub(crate) cancellation_token: &'a CancellationToken,
+    pub(crate) preempt: Option<&'a CancellationToken>,
+    pub(crate) new_context_window: bool,
+    pub(crate) installed: &'a mut Option<CapacityInstallReceipt>,
+}
+
+#[derive(Clone, Copy, Eq, Hash, PartialEq)]
+enum PairKind {
+    Function,
+    ToolSearch,
+    Custom,
+}
+
+fn pair_endpoint(item: &ResponseItem) -> Option<(PairKind, &str, bool)> {
+    match item {
+        ResponseItem::FunctionCall { call_id, .. }
+        | ResponseItem::LocalShellCall {
+            call_id: Some(call_id),
+            ..
+        } => Some((PairKind::Function, call_id, true)),
+        ResponseItem::FunctionCallOutput {
+            call_id: Some(call_id),
+            ..
+        } => Some((PairKind::Function, call_id, false)),
+        ResponseItem::ToolSearchCall {
+            call_id: Some(call_id),
+            ..
+        } => Some((PairKind::ToolSearch, call_id, true)),
+        ResponseItem::ToolSearchOutput {
+            call_id: Some(call_id),
+            execution,
+            ..
+        } if execution != "server" => Some((PairKind::ToolSearch, call_id, false)),
+        ResponseItem::CustomToolCall { call_id, .. } => Some((PairKind::Custom, call_id, true)),
+        ResponseItem::CustomToolCallOutput { call_id, .. } => {
+            Some((PairKind::Custom, call_id, false))
+        }
+        _ => None,
+    }
+}
+
+pub(crate) fn pair_safe_prefix(items: &[ResponseItemEnvelope], proposed: usize) -> usize {
+    let mut pairs = HashMap::<_, (Option<usize>, Option<usize>)>::new();
+    for (index, envelope) in items.iter().enumerate() {
+        if let Some((kind, id, call)) = pair_endpoint(&envelope.item) {
+            let endpoints = pairs.entry((kind, id)).or_default();
+            let slot = if call {
+                &mut endpoints.0
+            } else {
+                &mut endpoints.1
+            };
+            if slot.replace(index).is_some() {
+                return 0;
+            }
+        }
+    }
+    let mut cut = proposed.min(items.len());
+    loop {
+        let previous = cut;
+        for &(call, output) in pairs.values() {
+            match (call, output) {
+                (Some(call), Some(output)) if call < output => {
+                    if call < cut && output >= cut {
+                        cut = call;
+                    }
+                }
+                (Some(call), Some(output)) => cut = cut.min(call.min(output)),
+                (Some(call), None) => cut = cut.min(call),
+                (None, Some(output)) => cut = cut.min(output),
+                (None, None) => {}
+            }
+        }
+        if previous == cut {
+            return cut;
+        }
+    }
+}
+
+pub(crate) fn manual_prefix_has_input(items: &[ResponseItemEnvelope]) -> bool {
+    items.iter().any(|envelope| {
+        crate::compact::is_real_user_or_agent_message(&envelope.item)
+            || matches!(
+                envelope.item,
+                ResponseItem::FunctionCallOutput { .. }
+                    | ResponseItem::CustomToolCallOutput { .. }
+                    | ResponseItem::ToolSearchOutput { .. }
+            )
+    })
+}
+
+#[derive(Default)]
+struct CountBytes(usize);
+impl Write for CountBytes {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        self.0 = self.0.saturating_add(bytes.len());
+        Ok(bytes.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+pub(crate) fn serialized_json_bytes(value: &impl serde::Serialize) -> serde_json::Result<usize> {
+    let mut size = CountBytes::default();
+    serde_json::to_writer(&mut size, value)?;
+    Ok(size.0)
+}
+
+pub(crate) fn serialized_item_bytes<'a>(
+    items: impl IntoIterator<Item = &'a ResponseItem>,
+) -> serde_json::Result<usize> {
+    let mut size = CountBytes::default();
+    for item in items {
+        serde_json::to_writer(&mut size, item)?;
+    }
+    Ok(size.0)
+}
+
+fn old_prefix_len(items: &[ResponseItemEnvelope], confirmed: usize) -> Option<usize> {
+    // A real prior completion can confirm earlier sampling steps in this turn.
+    // The exact checkpoint boundary still excludes every unsent input item.
+    let limit = confirmed.min(items.len()).min(MAX_RECOVERY_PREFIX_ITEMS);
+    // An unlabelled real input or tool cannot be proved old merely because
+    // it precedes the first explicit current-turn item in restored history.
+    let limit = items[..limit]
+        .iter()
+        .position(|envelope| {
+            envelope.item.turn_id().is_none()
+                && (crate::compact::is_real_user_or_agent_message(&envelope.item)
+                    || pair_endpoint(&envelope.item).is_some())
+        })
+        .unwrap_or(limit);
+    let mut size = CountBytes::default();
+    let mut cut = 0;
+    for envelope in &items[..limit] {
+        serde_json::to_writer(&mut size, &envelope.item).ok()?;
+        if size.0 > MAX_RECOVERY_PREFIX_BYTES {
+            break;
+        }
+        cut += 1;
+    }
+    let cut = pair_safe_prefix(items, cut);
+    // Refuse zero progress and context-only prefixes. The live suffix is never
+    // recoded, squeezed, or treated as input proven by the old completion.
+    items[..cut]
+        .iter()
+        .any(|envelope| crate::compact::is_real_user_or_agent_message(&envelope.item))
+        .then_some(cut)
+}
+
+#[derive(PartialEq)]
+enum Media<'a> {
+    Image(&'a ImageReference, Option<ImageDetail>),
+    Audio(&'a AudioReference),
+    ToolAudioUrl(&'a str),
+    GeneratedImage(&'a ResponseItem),
+}
+
+type MediaSlot<'a> = (usize, usize, Media<'a>);
+fn media_slots<'a>(items: impl Iterator<Item = &'a ResponseItem>) -> Vec<MediaSlot<'a>> {
+    let mut slots = Vec::new();
+    for (item_index, item) in items.enumerate() {
+        match item {
+            ResponseItem::Message { content, .. } => {
+                for (content_index, part) in content.iter().enumerate() {
+                    let media = match part {
+                        ContentItem::InputImage { image, detail } => Media::Image(image, *detail),
+                        ContentItem::InputAudio { audio } => Media::Audio(audio),
+                        _ => continue,
+                    };
+                    slots.push((item_index, content_index, media));
+                }
+            }
+            ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } => {
+                if let Some(content) = output.content_items() {
+                    for (content_index, part) in content.iter().enumerate() {
+                        let media = match part {
+                            FunctionCallOutputContentItem::InputImage { image, detail } => {
+                                Media::Image(image, *detail)
+                            }
+                            FunctionCallOutputContentItem::InputAudio { audio_url } => {
+                                Media::ToolAudioUrl(audio_url)
+                            }
+                            _ => continue,
+                        };
+                        slots.push((item_index, content_index, media));
+                    }
+                }
+            }
+            ResponseItem::ImageGenerationCall { .. } => {
+                slots.push((item_index, 0, Media::GeneratedImage(item)));
+            }
+            _ => {}
+        }
+    }
+    slots
+}
+
+pub(crate) fn same_media_slots<'a>(
+    history: impl Iterator<Item = &'a ResponseItem>,
+    wire: &[ResponseItem],
+) -> bool {
+    media_slots(history) == media_slots(wire.iter())
+}
