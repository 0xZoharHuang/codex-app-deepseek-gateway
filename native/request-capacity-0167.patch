+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::Value;
+    use serde_json::json;
+
+    fn item(value: Value) -> anyhow::Result<ResponseItemEnvelope> {
+        Ok(ResponseItemEnvelope::new(serde_json::from_value(value)?))
+    }
+
+    fn message(text: &str, turn: &str) -> anyhow::Result<ResponseItemEnvelope> {
+        let mut entry = item(json!({"type":"message", "role":"user",
+            "content":[{"type":"input_text","text":text}]}))?;
+        entry.set_turn_id_if_missing(turn);
+        anyhow::ensure!(entry.item.turn_id() == Some(turn));
+        Ok(entry)
+    }
+
+    #[test]
+    fn recovery_cut_does_not_consume_current_input_or_split_a_tool_pair() -> anyhow::Result<()> {
+        let old_turn = "018f3405-e835-71af-914a-7efb76abfa71";
+        let turn = "018f3405-e835-71af-914a-7efb76abfa72";
+        let old = message("already consumed", old_turn)?;
+        let call = item(json!({"type":"function_call", "name":"local",
+            "arguments":"{}", "call_id":"call_1"}))?;
+        let output = item(json!({"type":"function_call_output", "call_id":"call_1",
+            "output":"tool result"}))?;
+        let new = message("must remain pending", turn)?;
+        let history = vec![old.clone(), call, new.clone(), output];
+        assert_eq!(old_prefix_len(&history, 3), Some(1));
+        assert_eq!(old_prefix_len(&[old], 1), Some(1));
+        let unattributed = item(json!({"type":"message", "role":"user",
+            "content":[{"type":"input_text","text":"unknown historical boundary"}]}))?;
+        assert_eq!(old_prefix_len(&[unattributed, new.clone()], 2), None);
+        assert_eq!(old_prefix_len(&[new.clone()], 0), None);
+        assert_eq!(old_prefix_len(&[new], 1), Some(1));
+        Ok(())
+    }
+
+    #[test]
+    fn translated_reset_receipt_preserves_epoch_fence_and_excludes_live_suffix()
+    -> anyhow::Result<()> {
+        let home = request_capacity::TestProfile::new()?;
+        let thread = "018f3405-e835-71af-914a-7efb76abfa71";
+        let turn = "018f3405-e835-71af-914a-7efb76abfa72";
+        let binding = request_capacity::Binding::for_profile(
+            home.path(),
+            thread,
+            "model",
+            "provider",
+            "window-0",
+        )?;
+        let original = message("confirmed", thread)?;
+        let old = request_capacity::Checkpoint {
+            binding,
+            prefix_len: 1,
+            prefix_hash: request_capacity::prefix_hash(std::slice::from_ref(&original))?,
+            response_id: "ordinary-7".into(),
+            completed_epoch: 7,
+            recovery_turn_id: None,
+            origin: request_capacity::Origin::OrdinaryCompleted,
+        };
+        request_capacity::save(home.path(), &old)?;
+        let fenced = request_capacity::fence(home.path(), &old, turn)?;
+        let rebuilt = item(json!({"type":"message", "role":"developer",
+            "content":[{"type":"input_text","text":"native context"}]}))?;
+        let pending = message("pending input", turn)?;
+        let mut history = ContextManager::new();
+        history.replace_annotated(vec![rebuilt.clone(), pending.clone()]);
+        let receipt = CapacityInstallReceipt {
+            history,
+            anchor: "window-1".into(),
+            prefix_len: 1,
+        };
+        let translated = translate_checkpoint(home.path(), &fenced, &receipt)?;
+        let cold = request_capacity::load(home.path(), &translated.binding)?;
+        assert_eq!(cold.as_ref(), Some(&translated));
+        assert_eq!(translated.response_id, old.response_id);
+        assert_eq!(translated.completed_epoch, 7);
+        assert_eq!(translated.recovery_turn_id.as_deref(), Some(turn));
+        assert!(translated.matches_prefix(&[rebuilt, message("edited pending input", turn)?])?);
+        assert!(!translated.matches_prefix(&[pending])?);
+        assert!(translate_checkpoint(home.path(), &fenced, &receipt).is_err());
+        Ok(())
+    }
+
+    #[test]
+    fn reset_old_gap_proof_checks_typed_bytes_and_exact_metadata_and_excludes_current()
+    -> anyhow::Result<()> {
+        let old_turn = "018f3405-e835-71af-914a-7efb76abfa71";
+        let turn = "018f3405-e835-71af-914a-7efb76abfa72";
+        let old = message("confirmed input", old_turn)?;
+        let pending = message("pending user input", turn)?;
+        let mut gap_entry = item(json!({"type":"message", "role":"user",
+            "content":[{"type":"input_image", "file_id":"old-gap-image", "detail":"high"}]}))?;
+        gap_entry.set_turn_id_if_missing(old_turn);
+        gap_entry.metadata = Some(codex_history::CodexHarnessMetadata {
+            client_authored: true,
+            ..Default::default()
+        });
+        let gap = OldGap::capture(&[old.clone(), gap_entry.clone(), pending.clone()], 1, turn)
+            .ok_or_else(|| anyhow::anyhow!("missing exact old-gap proof"))?;
+        assert!(gap.matches(&[old.clone(), gap_entry.clone(), pending.clone()], 1, turn));
+        assert!(!gap.matches(&[old.clone(), pending.clone()], 1, turn));
+        let mut changed = gap_entry;
+        changed.metadata = None;
+        assert!(!gap.matches(&[old.clone(), changed, pending.clone()], 1, turn));
+        assert!(OldGap::capture(&[old.clone(), pending.clone()], 1, turn).is_none());
+        let unknown = item(json!({"type":"message", "role":"user",
+            "content":[{"type":"input_text", "text":"unattributed"}]}))?;
+        assert!(OldGap::capture(&[old, unknown, pending], 1, turn).is_none());
+        Ok(())
+    }
