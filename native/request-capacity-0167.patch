+
+    #[test]
+    fn cold_owned_checkpoint_revalidates_typed_image_metadata_and_delete_fences_late_writer()
+    -> Result<()> {
+        let home = TestProfile::new()?;
+        let thread = "018f3405-e835-71af-914a-7efb76abfa71";
+        let binding = Binding::for_profile(home.path(), thread, "model", "provider", "window")?;
+        let item = serde_json::from_value(json!({"type":"message", "role":"user",
+            "content":[{"type":"input_image", "file_id":"owned-image", "detail":"high"}]}))?;
+        let original = ResponseItemEnvelope {
+            item,
+            metadata: Some(CodexHarnessMetadata {
+                client_authored: true,
+                ..Default::default()
+            }),
+        };
+        let checkpoint = Checkpoint {
+            binding: binding.clone(),
+            prefix_len: 1,
+            prefix_hash: prefix_hash(std::slice::from_ref(&original))?,
+            response_id: "ordinary-completion".into(),
+            completed_epoch: 1,
+            recovery_turn_id: None,
+            origin: Origin::OrdinaryCompleted,
+        };
+        save(home.path(), &checkpoint)?;
+        let cold = load(home.path(), &binding)?.context("missing cold checkpoint")?;
+        assert!(cold.matches_prefix(std::slice::from_ref(&original))?);
+        let mut changed = original;
+        changed.metadata = None;
+        assert!(!cold.matches_prefix(&[changed])?);
+        let removed = delete_thread_data(home.path(), thread)?;
+        assert!(removed.checkpoint_removed && removed.lock_retained);
+        assert!(load(home.path(), &binding)?.is_none());
+        assert!(save(home.path(), &checkpoint).is_err());
+        Ok(())
+    }
+}
