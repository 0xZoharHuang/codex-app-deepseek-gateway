+#[derive(Default)]
+pub(crate) struct CapacityPersistenceFault {
+    cause: OnceLock<String>,
+    pub(super) close: CancellationToken,
+}
+
+impl Session {
+    pub(crate) fn fence_capacity_persistence(&self, cause: impl Into<String>) {
+        let _ = self.capacity_persistence_fault.cause.set(cause.into());
+    }
+
+    pub(crate) fn capacity_persistence_faulted(&self) -> bool {
+        self.capacity_persistence_fault.cause.get().is_some()
+    }
+
+    pub(crate) fn capacity_persistence_error(&self) -> Option<CodexErr> {
+        self.capacity_persistence_fault.cause.get().map(|cause| {
+            CodexErr::Fatal(format!(
+                "Request-capacity compaction could not verify saved history. Reopen this thread to recover from its rollout. {cause}"
+            ))
+        })
+    }
+
+    pub(crate) fn close_faulted_capacity_session(&self) {
+        if self.capacity_persistence_faulted() {
+            self.capacity_persistence_fault.close.cancel();
+        }
+    }
+
+    pub(crate) async fn close_faulted_capacity_session_if_idle(&self) {
+        if self.capacity_persistence_faulted() && self.active_turn.lock().await.is_none() {
+            self.close_faulted_capacity_session();
+        }
+    }
+
+    pub(crate) async fn acquire_capacity_persistence_boundary(
+        &self,
+    ) -> Result<tokio::sync::SemaphorePermit<'_>, tokio::sync::AcquireError> {
+        self.code_mode_message_tasks
+            .communication_boundary
+            .acquire()
+            .await
+    }
+
+    pub(crate) async fn capture_capacity_send(
+        &self,
+        step: &StepContext,
+        history: &ContextManager,
+    ) -> Option<CapacitySend> {
+        self.live_thread()?;
+        if crate::guardian::is_basic_session_source(&step.turn.session_source) {
+            return None;
+        }
+        let state = self.state.lock().await;
+        let generation = history.history_version();
+        if state.history.history_version() != generation {
+            return None;
+        }
+        Some(CapacitySend {
+            history: history.clone(),
+            anchor: self.current_window_from_state(&state).0,
+            generation,
+            auth_owner_generation: self.services.model_client.auth_owner_generation(),
+        })
+    }
+
+    pub(crate) async fn confirm_capacity_send(
+        self: &Arc<Self>,
+        step: &Arc<StepContext>,
+        sent: &CapacitySend,
+        response_id: &str,
+    ) {
+        let Some(token) = self.track_code_mode_message() else {
+            return;
+        };
+        let session = Arc::clone(self);
+        let step = Arc::clone(step);
+        let history = sent.history.clone();
+        let anchor = sent.anchor.clone();
+        let generation = sent.generation;
+        let auth_owner = sent.auth_owner_generation;
+        let response_id = response_id.to_owned();
+        let task = tokio::spawn(async move {
+            let _admission = token;
+            // Code Mode delivery reserves history before persisting its record.
+            // Take the existing boundary first so the flush cannot overtake it.
+            let _communication = session.acquire_capacity_persistence_boundary().await?;
+            let _settings_guard = thread_settings::acquire_persistence_lock(&session).await;
+            if session.state.lock().await.history.history_version() != generation
+                || session.services.model_client.auth_owner_generation() != auth_owner
+                || session.live_thread().is_none()
+            {
+                return Ok::<(), anyhow::Error>(());
+            }
+            session.flush_rollout().await?;
+            let home = step.turn.config.codex_home.clone();
+            let model = step.settings.model_info.slug.clone();
+            let provider = step.turn.config.model_provider_id.clone();
+            let thread = session.thread_id.to_string();
+            tokio::task::spawn_blocking(move || {
+                let binding = request_capacity::Binding::for_profile(
+                    &home, &thread, &model, &provider, &anchor,
+                )?;
+                let items = history.annotated_items();
+                let len = pair_safe_prefix(items, items.len());
+                if len == 0 {
+                    return Ok(());
+                }
+                let epoch = request_capacity::previous_epoch(&home, &binding)?
+                    .checked_add(1)
+                    .ok_or_else(|| anyhow::anyhow!("request-capacity epoch exhausted"))?;
+                request_capacity::save(
+                    &home,
+                    &request_capacity::Checkpoint {
+                        binding,
+                        prefix_len: len,
+                        prefix_hash: request_capacity::prefix_hash(&items[..len])?,
+                        response_id,
+                        completed_epoch: epoch,
+                        recovery_turn_id: None,
+                        origin: request_capacity::Origin::OrdinaryCompleted,
+                    },
+                )
+            })
+            .await?
+        });
+        if !matches!(task.await, Ok(Ok(()))) {
+            tracing::warn!("request-capacity completion checkpoint was not published");
+        }
+    }
+
+    pub(crate) async fn prepare_manual_capacity(
+        &self,
+        step: &StepContext,
+        source: &ContextManager,
+    ) -> anyhow::Result<Option<CapacityRecovery>> {
+        if self.live_thread().is_none()
+            || crate::guardian::is_basic_session_source(&step.turn.session_source)
+            || source.annotated_items().is_empty()
+        {
+            return Ok(None);
+        }
+        let sent = self
+            .capture_capacity_send(step, source)
+            .await
+            .ok_or_else(|| {
+                anyhow::anyhow!("Manual compaction history changed before it could be captured")
+            })?;
+        let source = source.clone();
+        tokio::task::spawn_blocking(move || {
+            let items = source.annotated_items();
+            let len = pair_safe_prefix(items, items.len());
+            anyhow::ensure!(
+                len > 0 && manual_prefix_has_input(&items[..len]),
+                "Manual compaction has no complete model input prefix. The unfinished history was preserved."
+            );
+            let selected = &items[..len];
+            let install_hash = exact_history_hash(selected)?;
+            let mut history = source.clone();
+            history.replace_annotated(selected.to_vec());
+            Ok(Some(CapacityRecovery {
+                history,
+                prefix: CompactionPrefix {
+                    generation: sent.generation,
+                    len,
+                    auth_owner_generation: sent.auth_owner_generation,
+                },
+                install_hash,
+                prefix_bytes: 0,
+                confirmed_len: 0,
+                authority: CapacityAuthority::Manual { anchor: sent.anchor, total: items.len() },
+                permit_token_reset: false,
+                old_gap: None,
+            }))
+        }).await?
+    }
+
+    /// Consumes the single in-memory proof on the next ordinary capacity
+    /// rejection. A resumed process cannot continue the unconfirmed old gap.
+    pub(crate) async fn load_capacity_continuation(
+        &self,
+        step: &StepContext,
+        sent: &CapacitySend,
+        proof: CapacityContinuation,
+    ) -> Option<CapacityRecovery> {
+        let turn = &step.turn.sub_id;
+        let checkpoint = proof.checkpoint;
+        if checkpoint.origin != request_capacity::Origin::TranslatedPrefix
+            || checkpoint.recovery_turn_id.as_deref() != Some(turn.as_str())
+            || checkpoint.binding.history_anchor != sent.anchor
+            || proof.generation != sent.generation
+            || proof.auth_owner_generation != sent.auth_owner_generation
+            || self.services.model_client.auth_owner_generation() != sent.auth_owner_generation
+        {
+            return None;
+        }
+
+        let token = self.track_code_mode_message()?;
+        let mut history = sent.history.clone();
+        let home = step.turn.config.codex_home.clone();
+        let model = step.settings.model_info.slug.clone();
+        let provider = step.turn.config.model_provider_id.clone();
+        let thread = self.thread_id.to_string();
+        let anchor = sent.anchor.clone();
+        let turn = turn.clone();
+        let generation = sent.generation;
+        let auth_owner_generation = sent.auth_owner_generation;
+        let result = tokio::task::spawn_blocking(move || -> anyhow::Result<Option<_>> {
+            let _admission = token;
+            let binding =
+                request_capacity::Binding::for_profile(&home, &thread, &model, &provider, &anchor)?;
+            let items = history.annotated_items();
+            let start = checkpoint.prefix_len;
+            if request_capacity::load(&home, &binding)?.as_ref() != Some(&checkpoint)
+                || !checkpoint.matches_prefix(items)?
+                || !proof.old_gap.matches(items, start, &turn)
+            {
+                return Ok(None);
+            }
+            let end = start + proof.old_gap.entries.len();
+            let prefix_bytes = serialized_item_bytes(items[..end].iter().map(|entry| &entry.item))?;
+            if end > MAX_RECOVERY_PREFIX_ITEMS || prefix_bytes > MAX_RECOVERY_PREFIX_BYTES {
+                return Ok(None);
+            }
+            let install_hash = exact_history_hash(&items[..end])?;
+            history.replace_annotated(items[..end].to_vec());
+            Ok(Some(CapacityRecovery {
+                history,
+                prefix: CompactionPrefix {
+                    generation,
+                    len: end,
+                    auth_owner_generation,
+                },
+                install_hash,
+                prefix_bytes,
+                confirmed_len: start,
+                authority: CapacityAuthority::Confirmed(checkpoint),
+                permit_token_reset: false,
+                old_gap: None,
+            }))
+        })
+        .await;
+        result.ok()?.ok()?
+    }
+
+    pub(crate) async fn load_capacity_recovery(
+        &self,
+        step: &StepContext,
+        sent: &CapacitySend,
+    ) -> Option<CapacityRecovery> {
+        let token = self.track_code_mode_message()?;
+        if self.state.lock().await.history.history_version() != sent.generation
+            || self.services.model_client.auth_owner_generation() != sent.auth_owner_generation
+        {
+            return None;
+        }
+        let home = step.turn.config.codex_home.clone();
+        let model = step.settings.model_info.slug.clone();
+        let provider = step.turn.config.model_provider_id.clone();
+        let thread = self.thread_id.to_string();
+        let turn = step.turn.sub_id.clone();
+        let anchor = sent.anchor.clone();
+        let mut history = sent.history.clone();
+        let generation = sent.generation;
+        let auth_owner_generation = sent.auth_owner_generation;
+        let result = tokio::task::spawn_blocking(move || -> anyhow::Result<Option<_>> {
+            let _admission = token;
+            let binding =
+                request_capacity::Binding::for_profile(&home, &thread, &model, &provider, &anchor)?;
+            let Some(checkpoint) = request_capacity::load(&home, &binding)? else {
+                return Ok(None);
+            };
+            let items = history.annotated_items();
+            if checkpoint.recovery_turn_id.as_deref() == Some(turn.as_str())
+                || !checkpoint.matches_prefix(items)?
+                || checkpoint.prefix_len != pair_safe_prefix(items, checkpoint.prefix_len)
+            {
+                return Ok(None);
+            }
+            let Some(len) = old_prefix_len(items, checkpoint.prefix_len) else {
+                return Ok(None);
+            };
+            let install_hash = exact_history_hash(&items[..len])?;
+            let prefix_bytes = serialized_item_bytes(items[..len].iter().map(|item| &item.item))?;
+            let old_gap = if len == checkpoint.prefix_len {
+                OldGap::capture(items, len, &turn)
+            } else {
+                None
+            };
+            // Fence this exact turn/epoch before calling the summarizer; a cold
+            // resume cannot repeatedly reuse an admitted failed attempt.
+            let checkpoint = request_capacity::fence(&home, &checkpoint, &turn)?;
+            history.replace_annotated(items[..len].to_vec());
+            Ok(Some(CapacityRecovery {
+                history,
+                prefix: CompactionPrefix {
+                    generation,
+                    len,
+                    auth_owner_generation,
+                },
+                install_hash,
+                prefix_bytes,
+                confirmed_len: len,
+                authority: CapacityAuthority::Confirmed(checkpoint),
+                permit_token_reset: true,
+                old_gap,
+            }))
+        })
+        .await;
+        match result {
+            Ok(Ok(recovery)) => recovery,
+            _ => {
+                tracing::warn!("request-capacity checkpoint could not authorize recovery");
+                None
+            }
+        }
+    }
+}
