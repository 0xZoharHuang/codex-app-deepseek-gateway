@@ -0,0 +1,1076 @@
+//! Conservative first-stage request-body recovery over an exact native send snapshot.
+//!
+//! Recovery can summarize only a bounded, previously confirmed old prefix. The
+//! native prefix installer retains everything after the cut, including all pending
+//! user/tool media. Missing checkpoint proof leaves the original 413 unchanged.
+use super::CompactionPrefix;
+use super::request_capacity;
+use super::session::Session;
+use super::step_context::StepContext;
+use super::thread_settings;
+use crate::context_manager::ContextManager;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::CodexErrorDetails;
+use codex_protocol::models::AudioReference;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::ImageDetail;
+use codex_protocol::models::ImageReference;
+use codex_protocol::models::ResponseItem;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::HashMap;
+use std::io::Write;
+use std::path::Path;
+use std::sync::Arc;
+use std::sync::OnceLock;
+use tokio_util::sync::CancellationToken;
+
+// Bounds the historical snapshot hash and projection work, not the provider's wire limit.
+const MAX_RECOVERY_PREFIX_BYTES: usize = 192 * 1024 * 1024;
+const MAX_RECOVERY_PREFIX_ITEMS: usize = 4096;
+
+pub(crate) fn request_body_rejection(error: &CodexErr) -> bool {
+    matches!(error.details(), CodexErrorDetails::UnexpectedStatus(response)
+        if response.status == http::StatusCode::PAYLOAD_TOO_LARGE)
+}
+
+pub(crate) struct CapacitySend {
+    history: ContextManager,
+    anchor: String,
+    generation: u64,
+    auth_owner_generation: Option<u64>,
+}
+
+impl CapacitySend {
+    pub(crate) fn preserves_media(&self, input: &[ResponseItem]) -> bool {
+        same_media_slots(self.history.raw_items(), input)
+    }
+}
+
+pub(crate) struct CapacityRecovery {
+    pub(crate) history: ContextManager,
+    pub(crate) prefix: CompactionPrefix,
+    pub(crate) install_hash: [u8; 32],
+    pub(crate) prefix_bytes: usize,
+    pub(crate) confirmed_len: usize,
+    authority: CapacityAuthority,
+    pub(crate) permit_token_reset: bool,
+    old_gap: Option<OldGap>,
+}
+
+enum CapacityAuthority {
+    Confirmed(request_capacity::Checkpoint),
+    Manual { anchor: String, total: usize },
+}
+
+pub(crate) enum CapacityRecoveryOutcome {
+    Unchanged,
+    InstalledWithoutRetry,
+    PersistenceFailed(CodexErr),
+    Installed(Option<CapacityContinuation>),
+}
+
+pub(crate) struct CapacityContinuation {
+    checkpoint: request_capacity::Checkpoint,
+    generation: u64,
+    auth_owner_generation: Option<u64>,
+    old_gap: OldGap,
+}
+
+struct OldGap {
+    entries: Vec<ResponseItemEnvelope>,
+    hash: [u8; 32],
+}
+
+pub(crate) struct CapacityInstallReceipt {
+    pub(crate) history: ContextManager,
+    pub(crate) anchor: String,
+    pub(crate) prefix_len: usize,
+}
+
+impl CapacityRecovery {
+    pub(crate) fn with_old_gap_for_summary(mut self) -> anyhow::Result<Option<Self>> {
+        let Some(gap) = self.old_gap.take() else {
+            return Ok(None);
+        };
+        let mut items = self.history.annotated_items().to_vec();
+        items.extend(gap.entries);
+        self.prefix.len = items.len();
+        self.install_hash = exact_history_hash(&items)?;
+        self.prefix_bytes = serialized_item_bytes(items.iter().map(|entry| &entry.item))?;
+        self.history.replace_annotated(items);
+        self.permit_token_reset = false;
+        Ok(Some(self))
+    }
+
+    pub(crate) fn history_anchor(&self) -> &str {
+        match &self.authority {
+            CapacityAuthority::Confirmed(checkpoint) => &checkpoint.binding.history_anchor,
+            CapacityAuthority::Manual { anchor, .. } => anchor,
+        }
+    }
+
+    pub(crate) fn is_manual(&self) -> bool {
+        matches!(&self.authority, CapacityAuthority::Manual { .. })
+    }
+
+    pub(crate) fn select_manual_prefix(
+        &mut self,
+        source: &ContextManager,
+        len: usize,
+    ) -> anyhow::Result<()> {
+        let selected = &source.annotated_items()[..len];
+        self.prefix.len = len;
+        self.install_hash = exact_history_hash(selected)?;
+        self.history.replace_annotated(selected.to_vec());
+        Ok(())
+    }
+
+    /// Translate the exact admitted source only after the native append and
+    /// flush succeeded. A compactor response never opens a new completion epoch.
+    pub(crate) async fn publish_install(
+        self,
+        step: &StepContext,
+        thread: codex_protocol::ThreadId,
+        installed: CapacityInstallReceipt,
+        token_reset: bool,
+        model_response_id: Option<String>,
+    ) -> CapacityRecoveryOutcome {
+        let home = step.turn.config.codex_home.clone();
+        let model = step.settings.model_info.slug.clone();
+        let provider = step.turn.config.model_provider_id.clone();
+        let result = tokio::task::spawn_blocking(move || -> anyhow::Result<_> {
+            let checkpoint = match self.authority {
+                CapacityAuthority::Confirmed(checkpoint) => {
+                    translate_checkpoint(&home, &checkpoint, &installed)?
+                }
+                CapacityAuthority::Manual { total, .. } => {
+                    publish_manual_checkpoint(
+                        &home,
+                        &thread.to_string(),
+                        &model,
+                        &provider,
+                        &installed,
+                        model_response_id
+                            .as_deref()
+                            .ok_or_else(|| anyhow::anyhow!("missing completed manual response"))?,
+                        self.prefix.len < total,
+                    )?;
+                    return Ok(None);
+                }
+            };
+            let proof = self.old_gap.filter(|gap| {
+                token_reset
+                    && checkpoint.recovery_turn_id.as_deref().is_some_and(|turn| {
+                        gap.matches(
+                            installed.history.annotated_items(),
+                            installed.prefix_len,
+                            turn,
+                        )
+                    })
+            });
+            Ok(proof.map(|old_gap| CapacityContinuation {
+                checkpoint,
+                generation: installed.history.history_version(),
+                auth_owner_generation: self.prefix.auth_owner_generation,
+                old_gap,
+            }))
+        })
+        .await;
+        match result {
+            Ok(Ok(continuation)) => CapacityRecoveryOutcome::Installed(continuation),
+            Ok(Err(error)) => CapacityRecoveryOutcome::PersistenceFailed(CodexErr::Fatal(format!(
+                "Failed to publish request-capacity checkpoint: {error}"
+            ))),
+            Err(error) => CapacityRecoveryOutcome::PersistenceFailed(CodexErr::Fatal(format!(
+                "Request-capacity checkpoint publication task failed: {error}"
+            ))),
+        }
+    }
+}
+
+impl OldGap {
+    fn capture(items: &[ResponseItemEnvelope], start: usize, turn: &str) -> Option<Self> {
+        let end = items
+            .iter()
+            .position(|envelope| envelope.item.turn_id() == Some(turn))?;
+        if start >= end || end > MAX_RECOVERY_PREFIX_ITEMS || pair_safe_prefix(items, end) != end {
+            return None;
+        }
+        let entries = &items[start..end];
+        if !Self::all_old(entries, turn)
+            || serialized_item_bytes(items[..end].iter().map(|envelope| &envelope.item)).ok()?
+                > MAX_RECOVERY_PREFIX_BYTES
+        {
+            return None;
+        }
+        Some(Self {
+            entries: entries.to_vec(),
+            hash: exact_history_hash(entries).ok()?,
+        })
+    }
+
+    fn all_old(items: &[ResponseItemEnvelope], turn: &str) -> bool {
+        items
+            .iter()
+            .all(|envelope| envelope.item.turn_id().is_some_and(|id| id != turn))
+    }
+
+    fn matches(&self, items: &[ResponseItemEnvelope], start: usize, turn: &str) -> bool {
+        let Some(end) = start.checked_add(self.entries.len()) else {
+            return false;
+        };
+        let Some(gap) = items.get(start..end) else {
+            return false;
+        };
+        gap == self.entries.as_slice()
+            && Self::all_old(gap, turn)
+            && exact_history_hash(gap).ok() == Some(self.hash)
+            && pair_safe_prefix(items, end) == end
+    }
+}
+
+/// The output's internal success flag is deliberately absent from the wire serializer.
+pub(super) fn exact_history_hash(items: &[ResponseItemEnvelope]) -> serde_json::Result<[u8; 32]> {
+    struct HashWriter(Sha256);
+    impl Write for HashWriter {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            self.0.update(bytes);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut writer = HashWriter(Sha256::new());
+    for envelope in items {
+        let success = match &envelope.item {
+            ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } => output.success,
+            _ => None,
+        };
+        serde_json::to_writer(&mut writer, &(&envelope.item, &envelope.metadata, success))?;
+        writer.0.update(b"\n");
+    }
+    Ok(writer.0.finalize().into())
+}
+
+fn translate_checkpoint(
+    home: &Path,
+    old: &request_capacity::Checkpoint,
+    installed: &CapacityInstallReceipt,
+) -> anyhow::Result<request_capacity::Checkpoint> {
+    let binding = request_capacity::Binding::for_profile(
+        home,
+        &old.binding.thread_id,
+        &old.binding.model,
+        &old.binding.provider,
+        &installed.anchor,
+    )?;
+    anyhow::ensure!(
+        old.binding.same_sampling_scope(&binding) && old.binding.history_anchor != installed.anchor,
+        "request-capacity install changed sampling scope"
+    );
+    let items = installed.history.annotated_items();
+    anyhow::ensure!(
+        installed.prefix_len > 0
+            && installed.prefix_len == pair_safe_prefix(items, installed.prefix_len),
+        "request-capacity install has no pair-safe translated prefix"
+    );
+    let checkpoint = request_capacity::Checkpoint {
+        binding,
+        prefix_len: installed.prefix_len,
+        prefix_hash: request_capacity::prefix_hash(&items[..installed.prefix_len])?,
+        response_id: old.response_id.clone(),
+        completed_epoch: old.completed_epoch,
+        recovery_turn_id: old.recovery_turn_id.clone(),
+        origin: request_capacity::Origin::TranslatedPrefix,
+    };
+    request_capacity::save_if_current(home, &checkpoint, old)?;
+    Ok(checkpoint)
+}
+
+fn publish_manual_checkpoint(
+    home: &Path,
+    thread: &str,
+    model: &str,
+    provider: &str,
+    installed: &CapacityInstallReceipt,
+    response_id: &str,
+    partitioned: bool,
+) -> anyhow::Result<()> {
+    let binding =
+        request_capacity::Binding::for_profile(home, thread, model, provider, &installed.anchor)?;
+    if let Some(previous) = request_capacity::previous_checkpoint_for_lineage(home, &binding)? {
+        // Fresh manual coverage authorizes the new prefix. The prior record
+        // supplies lineage only; it never re-arms the old ordinary epoch.
+        translate_checkpoint(home, &previous, installed)?;
+        return Ok(());
+    }
+    let items = installed.history.annotated_items();
+    anyhow::ensure!(
+        installed.prefix_len > 0
+            && installed.prefix_len == pair_safe_prefix(items, installed.prefix_len),
+        "manual compaction has no pair-safe installed prefix"
+    );
+    request_capacity::save(
+        home,
+        &request_capacity::Checkpoint {
+            binding,
+            prefix_len: installed.prefix_len,
+            prefix_hash: request_capacity::prefix_hash(&items[..installed.prefix_len])?,
+            response_id: response_id.to_owned(),
+            completed_epoch: 0,
+            recovery_turn_id: None,
+            origin: if partitioned {
+                request_capacity::Origin::ManualPrefixGenesis
+            } else {
+                request_capacity::Origin::FullManualGenesis
+            },
+        },
+    )
+}
