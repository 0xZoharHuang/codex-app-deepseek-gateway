+            "type": "function_call_output", "call_id": "call_test", "output": "甲乙丙丁"
+        }))?);
+        for envelope in [&mut call, &mut output] {
+            envelope.set_turn_id_if_missing("older-turn");
+        }
+        let original = [call.clone(), output];
+        let (left, right) = Projection::whole(0..2)
+            .split(&original, "current-turn", 0)
+            .ok_or_else(|| anyhow::anyhow!("unavailable typed tool projection"))?;
+        let mut reassembled = String::new();
+        for projection in [left, right] {
+            let sent = projection
+                .items(&original)
+                .ok_or_else(|| anyhow::anyhow!("projection lost the completed tool pair"))?;
+            assert_eq!(sent[0], call);
+            let ResponseItem::FunctionCallOutput {
+                call_id: Some(call_id),
+                output,
+                ..
+            } = &sent[1].item
+            else {
+                anyhow::bail!("projected output changed type");
+            };
+            assert_eq!(call_id, "call_test");
+            let FunctionCallOutputBody::Text(text) = &output.body else {
+                anyhow::bail!("projected output changed body type");
+            };
+            reassembled.push_str(text);
+        }
+        assert_eq!(reassembled, "甲乙丙丁");
+        Ok(())
+    }
+}
