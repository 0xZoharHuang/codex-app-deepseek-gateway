+enum CapacityInstallResult {
+    Finished(CapacityRecoveryOutcome),
+    ResetNoProgress(Box<CapacityRecovery>),
+}
+
+async fn install_capacity_replacement(
+    sess: &Arc<Session>,
+    step_context: &Arc<StepContext>,
+    recovery: CapacityRecovery,
+    mut replacement: CapacityReplacement,
+    compaction_item: TurnItem,
+    cancellation_token: &CancellationToken,
+) -> CodexResult<CapacityInstallResult> {
+    let world_state = sess
+        .build_world_state_for_step(step_context, /*new_window*/ true)
+        .await?;
+    let (initial_context, world_state_baseline) = sess
+        .build_initial_context_with_world_state(step_context, &world_state)
+        .await;
+    let (mut prefix_context, initial_context) = split_prefix_updates(initial_context);
+    let mut initial_context = merge_world_state_updates(initial_context)
+        .into_iter()
+        .map(ResponseItemEnvelope::new)
+        .collect::<Vec<_>>();
+    let new_context_window = replacement.response_id.is_none();
+    if new_context_window {
+        // Measure the same item IDs that the native install will send.
+        for item in &mut prefix_context {
+            Session::assign_missing_response_item_id(item);
+        }
+        for envelope in initial_context.iter_mut().chain(&mut replacement.items) {
+            Session::assign_missing_response_item_id(&mut envelope.item);
+        }
+        let rebuilt = prefix_context
+            .iter()
+            .cloned()
+            .map(ResponseItemEnvelope::new)
+            .chain(initial_context.iter().cloned())
+            .chain(replacement.items.iter().cloned())
+            .collect();
+        match capacity_reset_has_wire_progress(sess, step_context, &recovery, rebuilt).await? {
+            Some(true) => {}
+            Some(false) => return Ok(CapacityInstallResult::ResetNoProgress(Box::new(recovery))),
+            None => {
+                return Ok(CapacityInstallResult::Finished(
+                    CapacityRecoveryOutcome::Unchanged,
+                ));
+            }
+        }
+    }
+    let Some(token) = sess.track_code_mode_message() else {
+        return Ok(CapacityInstallResult::Finished(
+            CapacityRecoveryOutcome::Unchanged,
+        ));
+    };
+    let owner = Arc::clone(sess);
+    let owned_step = Arc::clone(step_context);
+    let cancel = cancellation_token.clone();
+    // A caller abort cannot drop an already-admitted native writer. The real
+    // cancellation tokens are rechecked with native history at the install point.
+    tokio::spawn(async move {
+        let _admission = token;
+        let turn = &owned_step.turn;
+        // Code Mode may append to the live history before its durable write.
+        // Wait for that boundary before writing a checkpoint with its suffix.
+        let Ok(communication) = owner.acquire_capacity_persistence_boundary().await else {
+            return CapacityRecoveryOutcome::Unchanged;
+        };
+        let model_response_id = recovery
+            .is_manual()
+            .then(|| replacement.response_id.clone())
+            .flatten();
+        let mut receipt = None;
+        let installed = owner
+            .replace_compacted_history(
+                replacement.items,
+                owned_step.to_turn_context_item(),
+                world_state_baseline,
+                CompactedHistoryInstallation::Prefix {
+                    prefix: recovery.prefix,
+                    prefix_context,
+                    initial_context,
+                    model_info: &owned_step.settings.model_info,
+                    compaction_response_id: replacement.response_id,
+                    reviewer_compaction_hash: replacement.reviewer_compaction_hash,
+                    turn_context: turn,
+                    started_item: Some(&compaction_item),
+                    capacity_commit: Some(CapacityCommit {
+                        install_hash: recovery.install_hash,
+                        history_anchor: recovery.history_anchor(),
+                        cancellation_token: &cancel,
+                        preempt: owned_step.preempt.as_ref(),
+                        new_context_window,
+                        installed: &mut receipt,
+                    }),
+                },
+            )
+            .await;
+        let trace_history = if installed && replacement.trace.is_some() {
+            receipt.as_ref().map(|receipt| receipt.history.clone())
+        } else {
+            None
+        };
+        let outcome = match (installed, receipt) {
+            (true, Some(receipt))
+                if owner.services.model_client.auth_owner_generation()
+                    == recovery.prefix.auth_owner_generation =>
+            {
+                recovery
+                    .publish_install(
+                        &owned_step,
+                        owner.thread_id,
+                        receipt,
+                        new_context_window,
+                        model_response_id,
+                    )
+                    .await
+            }
+            (true, Some(_)) => CapacityRecoveryOutcome::InstalledWithoutRetry,
+            (true, None) => CapacityRecoveryOutcome::PersistenceFailed(CodexErr::Fatal(
+                "The native compaction installation lost its persistence receipt.".into(),
+            )),
+            (false, _) => owner.capacity_persistence_error().map_or(
+                CapacityRecoveryOutcome::Unchanged,
+                CapacityRecoveryOutcome::PersistenceFailed,
+            ),
+        };
+        if let CapacityRecoveryOutcome::PersistenceFailed(error) = &outcome {
+            owner.fence_capacity_persistence(error.to_string());
+        }
+        drop(communication);
+        if installed {
+            if let Some(((trace, input_history), snapshot)) = replacement.trace.zip(trace_history) {
+                let replacement_history = snapshot.raw_items().cloned().collect::<Vec<_>>();
+                trace.record_installed(&CompactionCheckpointTracePayload {
+                    input_history: &input_history,
+                    replacement_history: &replacement_history,
+                });
+            }
+            owner.recompute_token_usage(turn).await;
+            owner.emit_turn_item_completed(turn, compaction_item).await;
+        }
+        owner.close_faulted_capacity_session_if_idle().await;
+        owner
+            .capacity_persistence_error()
+            .map_or(outcome, CapacityRecoveryOutcome::PersistenceFailed)
+    })
+    .await
+    .map(CapacityInstallResult::Finished)
+    .map_err(CodexErr::TokioJoin)
+}
