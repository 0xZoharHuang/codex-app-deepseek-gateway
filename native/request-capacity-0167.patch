+/// Recover a real body-size rejection with one model-backed native prefix install.
+/// No selected history is replaced until a fresh, complete summary and the live
+/// native prefix/cancellation checks have all succeeded.
+pub(crate) async fn run_capacity_recovery(
+    sess: &Arc<Session>,
+    step_context: &Arc<StepContext>,
+    mut recovery: CapacityRecovery,
+    cancellation_token: &CancellationToken,
+) -> CodexResult<CapacityRecoveryOutcome> {
+    let turn_context = &step_context.turn;
+    let preempt = step_context.preempt.clone().unwrap_or_default();
+    // The ordinary StepContext may have changed models since the local compactor's
+    // TurnContext was created. Never summarize the confirmed prefix on a different model.
+    if turn_context.model_info().slug != step_context.settings.model_info.slug
+        || turn_context.model_info().comp_hash != step_context.settings.model_info.comp_hash
+        || preempt.is_cancelled()
+    {
+        return Ok(CapacityRecoveryOutcome::Unchanged);
+    }
+    if cancellation_token.is_cancelled() {
+        return Err(CodexErr::TurnAborted);
+    }
+    if matches!(
+        run_pre_compact_hooks(sess, turn_context, CompactionTrigger::Auto).await,
+        PreCompactHookOutcome::Stopped
+    ) {
+        return Err(CodexErr::TurnAborted);
+    }
+
+    let outcome = loop {
+        let compaction_item = TurnItem::ContextCompaction(ContextCompactionItem::new());
+        let replacement = tokio::select! {
+            biased;
+            _ = cancellation_token.cancelled() => return Err(CodexErr::TurnAborted),
+            _ = preempt.cancelled() => return Ok(CapacityRecoveryOutcome::Unchanged),
+            result = Box::pin(async {
+                if recovery.permit_token_reset && turn_context.config.features.enabled(Feature::TokenBudget) {
+                    return Ok(Some(CapacityReplacement {
+                        items: sess.retained_client_items_for_context_window(&recovery.history),
+                        response_id: None,
+                        reviewer_compaction_hash: None,
+                        trace: None,
+                    }));
+                }
+                match turn_context.provider.capabilities().remote_compaction {
+                    RemoteCompactionSupport::Unsupported => {
+                        build_local_capacity_replacement(sess, step_context, &recovery).await
+                    }
+                    RemoteCompactionSupport::V2 => {
+                        crate::compact_remote_v2::build_capacity_replacement(
+                            sess,
+                            step_context,
+                            recovery.history.clone(),
+                            &compaction_item,
+                        )
+                        .await
+                        .map(Some)
+                    }
+                }
+            }) => result?,
+        };
+        let Some(replacement) = replacement else {
+            return Ok(CapacityRecoveryOutcome::Unchanged);
+        };
+        if replacement
+            .response_id
+            .as_deref()
+            .is_some_and(|id| id.trim().is_empty())
+            || (replacement.response_id.is_some()
+                && serialized_item_bytes(replacement.items.iter().map(|envelope| &envelope.item))?
+                    >= recovery.prefix_bytes)
+        {
+            return Ok(CapacityRecoveryOutcome::Unchanged);
+        }
+        match install_capacity_replacement(
+            sess,
+            step_context,
+            recovery,
+            replacement,
+            compaction_item,
+            cancellation_token,
+        )
+        .await?
+        {
+            CapacityInstallResult::Finished(outcome) => break outcome,
+            CapacityInstallResult::ResetNoProgress(original) => {
+                let Some(fresh) = original
+                    .with_old_gap_for_summary()
+                    .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?
+                else {
+                    break CapacityRecoveryOutcome::Unchanged;
+                };
+                recovery = fresh;
+            }
+        }
+    };
+    if matches!(&outcome, CapacityRecoveryOutcome::PersistenceFailed(_)) {
+        return Ok(outcome);
+    }
+    if cancellation_token.is_cancelled() {
+        return Err(CodexErr::TurnAborted);
+    }
+    if !matches!(&outcome, CapacityRecoveryOutcome::Unchanged)
+        && matches!(
+            run_post_compact_hooks(sess, turn_context, CompactionTrigger::Auto).await,
+            PostCompactHookOutcome::Stopped
+        )
+    {
+        return Err(CodexErr::TurnAborted);
+    }
+    Ok(outcome)
+}
+
+pub(crate) struct CapacityReplacement {
+    pub(crate) items: Vec<ResponseItemEnvelope>,
+    pub(crate) response_id: Option<String>,
+    pub(crate) reviewer_compaction_hash: Option<String>,
+    pub(crate) trace: Option<(CompactionTraceContext, Vec<ResponseItem>)>,
+}
+
+/// Explicit local compaction may summarize a newly read complete historical
+/// prefix. Only its actual completed response can create a manual checkpoint.
+async fn run_manual_capacity_compaction(
+    sess: &Arc<Session>,
+    step: &Arc<StepContext>,
+    source: ContextManager,
+    mut recovery: CapacityRecovery,
+    input: Vec<UserInput>,
+    metadata: CompactionTurnMetadata,
+    cancellation: &CancellationToken,
+) -> CodexResult<String> {
+    let turn = &step.turn;
+    let preempt = step.preempt.clone().unwrap_or_default();
+    let instruction: ResponseItem = ResponseInputItem::from(input).into();
+    let metadata = sess.compaction_responses_metadata(turn, metadata).await;
+    let max_retries = turn.provider.info().stream_max_retries();
+    let mut retries = 0;
+    let response = loop {
+        let attempt = async {
+            let prompt = capacity_local_prompt(sess, step, &recovery.history, instruction.clone())
+                .await
+                .ok_or_else(|| {
+                    CodexErr::InvalidRequest(
+                        "Native compaction input changed historical typed content".into(),
+                    )
+                })?;
+            let mut client_session = sess.services.model_client.new_session();
+            let mut rejected_before_stream = false;
+            let response = drain_to_completed(
+                sess,
+                turn,
+                &mut client_session,
+                &metadata,
+                &prompt,
+                /*record_live_output*/ false,
+                Some(&mut rejected_before_stream),
+            )
+            .await;
+            Ok::<_, CodexErr>((response, rejected_before_stream))
+        };
+        let (result, rejected_before_stream) = tokio::select! {
+            biased;
+            _ = cancellation.cancelled() => return Err(CodexErr::TurnAborted),
+            _ = preempt.cancelled() => return Err(CodexErr::TurnAborted),
+            result = attempt => result?,
+        };
+        let error = match result {
+            Ok(response) => break response,
+            Err(error) => error,
+        };
+        let context_capacity = matches!(error.details(), CodexErrorDetails::ContextWindowExceeded);
+        if context_capacity
+            || (rejected_before_stream && (error.retry_after().is_none() || retries >= max_retries))
+        {
+            let Some(len) =
+                smaller_manual_capacity_prefix(source.annotated_items(), recovery.prefix.len)
+            else {
+                return Err(error);
+            };
+            if let Some(advice) = error.retry_after() {
+                tokio::select! {
+                    biased;
+                    _ = cancellation.cancelled() => return Err(CodexErr::TurnAborted),
+                    _ = preempt.cancelled() => return Err(CodexErr::TurnAborted),
+                    _ = tokio::time::sleep_until(advice.deadline()) => {}
+                }
+            }
+            let owned_source = source.clone();
+            recovery = tokio::task::spawn_blocking(move || {
+                recovery.select_manual_prefix(&owned_source, len)?;
+                Ok::<_, anyhow::Error>(recovery)
+            })
+            .await
+            .map_err(CodexErr::TokioJoin)?
+            .map_err(|error| CodexErr::InvalidRequest(error.to_string()))?;
+            retries = 0;
+            sess.send_event(turn, EventMsg::Warning(codex_protocol::protocol::WarningEvent {
+                message: format!(
+                    "Manual compaction exceeded {}. Retrying a complete {len}/{}-item prefix. The remaining history is preserved.",
+                    if context_capacity { "model context capacity" } else { "request-byte capacity (HTTP 413)" },
+                    source.annotated_items().len(),
+                ),
+            })).await;
+            continue;
+        }
+        let Some(delay) = error
+            .retry_delay(retries.saturating_add(1))
+            .filter(|_| retries < max_retries)
+        else {
+            return Err(error);
+        };
+        retries += 1;
+        sess.notify_stream_error(
+            turn,
+            format!("Reconnecting... {retries}/{max_retries}"),
+            error,
+        )
+        .await;
+        tokio::select! {
+            biased;
+            _ = cancellation.cancelled() => return Err(CodexErr::TurnAborted),
+            _ = preempt.cancelled() => return Err(CodexErr::TurnAborted),
+            _ = tokio::time::sleep(delay) => {}
+        }
+    };
+
+    let summary = get_last_assistant_message_from_turn(response.output.iter())
+        .filter(|summary| !summary.trim().is_empty())
+        .ok_or_else(|| {
+            CodexErr::Stream("Manual compaction completed without a fresh summary".into())
+        })?;
+    if response.response_id.trim().is_empty() {
+        return Err(CodexErr::Stream(
+            "Manual compaction completed without a response ID".into(),
+        ));
+    }
+    let response_id = response.response_id;
+    let summary = format!("{SUMMARY_PREFIX}\n{summary}");
+    let retained_text = collect_annotated_user_messages(recovery.history.annotated_items());
+    let mut items = build_compacted_history(Vec::new(), &retained_text, &summary);
+    if let Some(item) = items.last_mut() {
+        item.set_turn_id_if_missing(&turn.sub_id);
+    }
+    let result = install_capacity_replacement(
+        sess,
+        step,
+        recovery,
+        CapacityReplacement {
+            items,
+            response_id: Some(response_id.clone()),
+            reviewer_compaction_hash: None,
+            trace: None,
+        },
+        TurnItem::ContextCompaction(ContextCompactionItem::new()),
+        cancellation,
+    )
+    .await?;
+    match result {
+        CapacityInstallResult::Finished(CapacityRecoveryOutcome::Installed(_)) => Ok(response_id),
+        CapacityInstallResult::Finished(CapacityRecoveryOutcome::PersistenceFailed(error)) => {
+            Err(error)
+        }
+        _ => Err(CodexErr::TurnAborted),
+    }
+}
+
+fn smaller_manual_capacity_prefix(source: &[ResponseItemEnvelope], len: usize) -> Option<usize> {
+    let candidate = |proposed| {
+        let cut = pair_safe_prefix(source, proposed);
+        (cut > 0
+            && cut < len
+            && !is_attached_notice(&source[cut].item)
+            && manual_prefix_has_input(&source[..cut]))
+        .then_some(cut)
+    };
+    candidate(len / 2).or_else(|| (1..len).rev().find_map(candidate))
+}
+
+async fn capacity_local_prompt(
+    sess: &Session,
+    step: &StepContext,
+    history: &ContextManager,
+    instruction: ResponseItem,
+) -> Option<Prompt> {
+    let turn = &step.turn;
+    let input = history
+        .clone()
+        .for_prompt_annotated(
+            &turn.model_info().input_modalities,
+            sess.services.image_store.as_ref(),
+        )
+        .await;
+    if !exact_projected_prompt(history.annotated_items(), &input) {
+        return None;
+    }
+    let mut input = input
+        .into_iter()
+        .map(|envelope| envelope.item)
+        .collect::<Vec<_>>();
+    sess.services
+        .executed_tool_calls
+        .attach_to_compaction_prompt(&mut input);
+    let mut base_instructions = sess.get_prompt_base_instructions().await;
+    if input
+        .iter()
+        .any(|item| BaseInstructionsFragment::text_from_item(item).is_some())
+        || history.has_tool_declarations()
+    {
+        base_instructions.text.clear();
+        base_instructions.provenance = None;
+    }
+    input.push(instruction);
+    Some(Prompt {
+        input,
+        base_instructions,
+        cyber_access_program: turn.cyber_access_program,
+        ..Default::default()
+    })
+}
+
+/// Every successful fragment advances the immutable original sequence. Later
+/// fragments carry the immediately previous actual summary. No fragment may
+/// replace live history independently, even after response.completed.
+async fn build_local_capacity_replacement(
+    sess: &Session,
+    step_context: &StepContext,
+    recovery: &CapacityRecovery,
+) -> CodexResult<Option<CapacityReplacement>> {
+    const DIRECT_ITEM_BYTES: usize = 16 * 1024 * 1024;
+    const MAX_ATTEMPTS: usize = 64;
+    let turn_context = &step_context.turn;
+    let source = recovery.history.annotated_items();
+    let mut unread = vec![capacity_projection::Projection::whole(0..source.len())];
+    let mut completed_ids = HashSet::new();
+    let mut carry = Vec::new();
+    let mut final_response_id = None;
+    let metadata = sess
+        .compaction_responses_metadata(
+            turn_context,
+            CompactionTurnMetadata::new(
+                CompactionTrigger::Auto,
+                CompactionReason::ContextLimit,
+                CompactionImplementation::Responses,
+                CompactionPhase::MidTurn,
+            ),
+        )
+        .await;
+    let mut attempts = 0;
+    while let Some(projection) = unread.pop() {
+        if attempts >= MAX_ATTEMPTS {
+            return Ok(None);
+        }
+        if projection.is_whole()
+            && serialized_item_bytes(
+                source[projection.original()]
+                    .iter()
+                    .map(|entry| &entry.item),
+            )? > DIRECT_ITEM_BYTES
+            && let Some((left, right)) =
+                projection.split(source, &turn_context.sub_id, recovery.confirmed_len)
+        {
+            unread.extend([right, left]);
+            continue;
+        }
+        let Some(projected) = projection.items(source) else {
+            return Ok(None);
+        };
+        let mut history = recovery.history.clone();
+        let original = carry.iter().cloned().chain(projected).collect::<Vec<_>>();
+        history.replace_annotated(original);
+        let instruction = turn_context
+            .config
+            .compact_prompt
+            .as_deref()
+            .unwrap_or(SUMMARIZATION_PROMPT);
+        let instruction = ResponseInputItem::from(vec![UserInput::Text {
+            text: format!("{instruction}{}", projection.instruction()),
+            text_elements: Vec::new(),
+        }]);
+        let Some(prompt) =
+            capacity_local_prompt(sess, step_context, &history, instruction.into()).await
+        else {
+            return Ok(None);
+        };
+        let mut client_session = sess.services.model_client.new_session();
+        let mut rejected_before_stream = false;
+        attempts += 1;
+        let response = match drain_to_completed(
+            sess,
+            turn_context,
+            &mut client_session,
+            &metadata,
+            &prompt,
+            /*record_live_output*/ false,
+            Some(&mut rejected_before_stream),
+        )
+        .await
+        {
+            Ok(response) => response,
+            Err(error) if rejected_before_stream => {
+                if let Some(advice) = error.retry_after() {
+                    tokio::time::sleep_until(advice.deadline()).await;
+                }
+                let Some((left, right)) =
+                    projection.split(source, &turn_context.sub_id, recovery.confirmed_len)
+                else {
+                    return Ok(None);
+                };
+                // Stack insertion keeps all original ranges and parts in their
+                // source order, with the right side unread until left succeeds.
+                unread.extend([right, left]);
+                continue;
+            }
+            Err(error) => return Err(error),
+        };
+        let Some(summary) = get_last_assistant_message_from_turn(response.output.iter())
+            .filter(|summary| !summary.trim().is_empty())
+        else {
+            return Ok(None);
+        };
+        if response.response_id.trim().is_empty()
+            || !completed_ids.insert(response.response_id.clone())
+        {
+            return Ok(None);
+        }
+        let summary = format!("{SUMMARY_PREFIX}\n{summary}");
+        carry = build_compacted_history(Vec::new(), &[], &summary);
+        if let Some(item) = carry.last_mut() {
+            item.set_turn_id_if_missing(&turn_context.sub_id);
+        }
+        final_response_id = Some(response.response_id);
+    }
+    Ok(final_response_id.map(|response_id| CapacityReplacement {
+        items: carry,
+        response_id: Some(response_id),
+        reviewer_compaction_hash: None,
+        trace: None,
+    }))
+}
+
+fn exact_projected_prompt(
+    expected: &[ResponseItemEnvelope],
+    actual: &[ResponseItemEnvelope],
+) -> bool {
+    if expected.len() != actual.len() {
+        return false;
+    }
+    expected.iter().zip(actual).all(|(expected, actual)| {
+        if expected.metadata != actual.metadata {
+            return false;
+        }
+        if expected.item == actual.item {
+            return true;
+        }
+        // A legacy message can gain positional defaults during the native
+        // modality pass. Canonicalize both sides without losing any real source
+        // attribution, typed parts, IDs, or the adjacent image labels.
+        fn canonical(mut item: ResponseItem) -> ResponseItem {
+            if let Some(parts) = to_annotated_content(&mut item) {
+                let _ = set_annotated_content(&mut item, parts);
+            }
+            item
+        }
+        canonical(expected.item.clone()) == canonical(actual.item.clone())
+    })
+}
+
+async fn capacity_reset_has_wire_progress(
+    sess: &Session,
+    step: &StepContext,
+    recovery: &CapacityRecovery,
+    rebuilt: Vec<ResponseItemEnvelope>,
+) -> CodexResult<Option<bool>> {
+    let model = &step.settings.model_info;
+    let images = sess.services.image_store.as_ref();
+    let old = recovery
+        .history
+        .clone()
+        .for_prompt(&model.input_modalities, images)
+        .await;
+    let mut rebuilt_history = recovery.history.clone();
+    rebuilt_history.replace_annotated(rebuilt);
+    let new = rebuilt_history
+        .clone()
+        .for_prompt(&model.input_modalities, images)
+        .await;
+    if !same_media_slots(recovery.history.raw_items(), &old)
+        || !same_media_slots(rebuilt_history.raw_items(), &new)
+    {
+        return Ok(None);
+    }
+
+    // The exact suffix and sampling settings are shared. Compare the changing
+    // prefix with the same native request builder and measure its JSON.
+    let metadata = sess
+        .responses_metadata(step, CodexResponsesRequestKind::Turn)
+        .await;
+    let size = |input| -> CodexResult<usize> {
+        let request = sess.services.model_client.build_responses_request(
+            &Prompt {
+                input,
+                ..Default::default()
+            },
+            model,
+            None,
+            step.settings.reasoning_summary,
+            step.settings.service_tier.clone(),
+            &metadata,
+            false,
+        )?;
+        Ok(serialized_json_bytes(&request)?)
+    };
+    Ok(Some(size(new)? < size(old)?))
+}
