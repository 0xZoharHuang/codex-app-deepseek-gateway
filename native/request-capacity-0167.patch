+//! Native-owned consumption metadata, never history, credentials or a tool runtime.
+//! A checkpoint proves replayable native input after an ordinary completion or a
+//! fresh manual summary, following the existing rollout flush barrier.
+use anyhow::{Context, Result, ensure};
+use codex_history::ResponseItemEnvelope;
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::fs::File;
+#[cfg(unix)]
+use std::fs::OpenOptions;
+use std::io::{Read, Seek, SeekFrom, Write};
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+const SCHEMA_VERSION: u32 = 1;
+const MAX_METADATA_BYTES: usize = 16 * 1024;
+const HASH_DOMAIN: &[u8] = b"codex.native.request-capacity.replay.envelope.v3\0";
+const LEGACY_HASH_DOMAIN: &[u8] = b"codex.native.request-capacity.replay.envelope.v2\0";
+const CACHE_NAME: &str = "request-capacity-v1";
+// This thread UUID is never reused. Keep its deletion fence in the already
+// retained lock inode so late admitted writers cannot recreate a checkpoint.
+const DELETED_LOCK_MAGIC: &[u8] = b"codex-capacity-deleted-v1\n";
+
+#[derive(Clone, Debug, Serialize, Deserialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Binding {
+    pub(super) thread_id: String,
+    pub(super) home_identity: String,
+    pub(super) owner_identity: String,
+    pub(super) model: String,
+    pub(super) provider: String,
+    pub(super) history_anchor: String,
+}
+
+impl Binding {
+    pub(super) fn for_profile(
+        home: &Path,
+        thread: &str,
+        model: &str,
+        provider: &str,
+        history_anchor: &str,
+    ) -> Result<Self> {
+        let thread_id = uuid::Uuid::parse_str(thread)
+            .context("invalid request-capacity thread identity")?
+            .to_string();
+        ensure!(
+            thread_id == thread,
+            "noncanonical request-capacity thread identity"
+        );
+        for value in [model, provider, history_anchor] {
+            ensure!(
+                !value.is_empty() && value.len() <= 2048,
+                "invalid request-capacity binding"
+            );
+        }
+        let physical = std::fs::canonicalize(home).context("resolve request-capacity profile")?;
+        let pinned = platform::Directory::open_home(&physical)?;
+        let owner_identity = platform::current_owner()?;
+        platform::validate_owner(&pinned.file, &owner_identity, true, false)?;
+        let home_identity = bound_home_identity(&pinned.file, &owner_identity)?;
+        Ok(Self {
+            thread_id,
+            home_identity,
+            owner_identity,
+            model: model.to_owned(),
+            provider: provider.to_owned(),
+            history_anchor: history_anchor.to_owned(),
+        })
+    }
+
+    fn same_profile(&self, other: &Self) -> bool {
+        self.thread_id == other.thread_id
+            && self.home_identity == other.home_identity
+            && self.owner_identity == other.owner_identity
+    }
+
+    pub(super) fn same_sampling_scope(&self, other: &Self) -> bool {
+        self.same_profile(other) && self.model == other.model && self.provider == other.provider
+    }
+}
+
+#[derive(Clone, Copy, Debug, Serialize, Deserialize, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub(crate) enum Origin {
+    OrdinaryCompleted,
+    FullManualGenesis,
+    ManualPrefixGenesis,
+    TranslatedPrefix,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize, Eq, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Checkpoint {
+    pub(super) binding: Binding,
+    pub(super) prefix_len: usize,
+    pub(super) prefix_hash: String,
+    pub(super) response_id: String,
+    pub(super) completed_epoch: u64,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub(super) recovery_turn_id: Option<String>,
+    pub(super) origin: Origin,
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Record {
+    schema_version: u32,
+    ordinary_scope: String,
+    checkpoint: Checkpoint,
+}
+
+impl Checkpoint {
+    pub(super) fn matches_prefix(&self, items: &[ResponseItemEnvelope]) -> Result<bool> {
+        if self.prefix_len > items.len() {
+            return Ok(false);
+        }
+        let prefix = &items[..self.prefix_len];
+        // Native compaction materializes absent metadata as exact Default. Accept
+        // only these two fixed v2 representations; never guess individual slots
+        // or rewrite history/checkpoints while checking eligibility.
+        Ok(prefix_hash(prefix)? == self.prefix_hash
+            || prefix_hash_with_metadata(prefix, MetadataHashMode::LegacyExact)?
+                == self.prefix_hash
+            || prefix_hash_with_metadata(prefix, MetadataHashMode::LegacyDefaultAsNone)?
+                == self.prefix_hash)
+    }
+
+    fn validate(&self) -> Result<()> {
+        ensure!(
+            self.prefix_len > 0 && self.prefix_len <= 10_000_000,
+            "invalid request-capacity prefix length"
+        );
+        ensure!(
+            match self.origin {
+                Origin::OrdinaryCompleted => self.completed_epoch > 0,
+                Origin::FullManualGenesis | Origin::ManualPrefixGenesis =>
+                    self.completed_epoch == 0,
+                Origin::TranslatedPrefix => true,
+            },
+            "invalid request-capacity consumption provenance or completion epoch"
+        );
+        if let Some(turn) = &self.recovery_turn_id {
+            ensure!(
+                uuid::Uuid::parse_str(turn)?.to_string() == *turn,
+                "invalid request-capacity recovery turn identity"
+            );
+        }
+        ensure!(
+            !self.response_id.is_empty()
+                && self.response_id.len() <= 512
+                && self
+                    .response_id
+                    .bytes()
+                    .all(|byte| byte.is_ascii_alphanumeric()
+                        || matches!(byte, b'-' | b'_' | b':' | b'.')),
+            "invalid request-capacity completion identity"
+        );
+        ensure!(
+            self.prefix_hash.len() == 74
+                && self.prefix_hash.starts_with("sha256-v1:")
+                && self.prefix_hash[10..]
+                    .bytes()
+                    .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte)),
+            "invalid request-capacity prefix hash"
+        );
+        ensure!(
+            uuid::Uuid::parse_str(&self.binding.thread_id)?.to_string() == self.binding.thread_id,
+            "invalid request-capacity thread identity"
+        );
+        for value in [
+            &self.binding.home_identity,
+            &self.binding.owner_identity,
+            &self.binding.model,
+            &self.binding.provider,
+            &self.binding.history_anchor,
+        ] {
+            ensure!(
+                !value.is_empty() && value.len() <= 2048,
+                "invalid request-capacity binding"
+            );
+        }
+        Ok(())
+    }
+}
+
+fn digest(domain: &[u8], bytes: &[u8]) -> String {
+    let mut hash = Sha256::new();
+    hash.update(domain);
+    hash.update(bytes);
+    format!("sha256-v1:{:x}", hash.finalize())
+}
+
+#[derive(Clone, Copy)]
+enum MetadataHashMode {
+    ReplayV3,
+    LegacyExact,
+    LegacyDefaultAsNone,
+}
+
+/// Hash native replayable envelope content and persistent metadata in sequence.
+/// The native deserializer discards warehouse-only execution annotations. Apply
+/// its existing clear helper only to an affected item's temporary hash projection;
+/// never mutate history or restore those annotations as trusted input. The v3
+/// domain also treats absent harness metadata as the exact native Default used
+/// by CompactedItem's parallel metadata serialization. All present nondefault
+/// metadata, roles, tool IDs, media details/bytes and ordering remain exact.
+pub(super) fn prefix_hash(items: &[ResponseItemEnvelope]) -> Result<String> {
+    prefix_hash_with_metadata(items, MetadataHashMode::ReplayV3)
+}
+
+fn prefix_hash_with_metadata(
+    items: &[ResponseItemEnvelope],
+    metadata_mode: MetadataHashMode,
+) -> Result<String> {
+    fn canonical(value: serde_json::Value) -> serde_json::Value {
+        match value {
+            serde_json::Value::Object(map) => {
+                let sorted: std::collections::BTreeMap<_, _> = map
+                    .into_iter()
+                    .map(|(key, value)| (key, canonical(value)))
+                    .collect();
+                serde_json::Value::Object(sorted.into_iter().collect())
+            }
+            serde_json::Value::Array(values) => {
+                serde_json::Value::Array(values.into_iter().map(canonical).collect())
+            }
+            value => value,
+        }
+    }
+    struct HashWriter(Sha256);
+    impl Write for HashWriter {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            self.0.update(bytes);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let default_metadata = codex_history::CodexHarnessMetadata::default();
+    let mut writer = HashWriter(Sha256::new());
+    writer.write_all(match metadata_mode {
+        MetadataHashMode::ReplayV3 => HASH_DOMAIN,
+        MetadataHashMode::LegacyExact | MetadataHashMode::LegacyDefaultAsNone => LEGACY_HASH_DOMAIN,
+    })?;
+    writer.write_all(b"[")?;
+    for (index, envelope) in items.iter().enumerate() {
+        if index > 0 {
+            writer.write_all(b",")?;
+        }
+        // ResponseItemEnvelope deliberately is not Serialize. Persisted semantic
+        // identity includes its native item and history-only harness metadata.
+        let needs_replay_projection =
+            envelope
+                .item
+                .executed_tool_call_metadata()
+                .is_some_and(|metadata| {
+                    metadata.cell_id.is_some()
+                        || metadata.executed_tool_calls.is_some()
+                        || metadata.tool_calls_complete.is_some()
+                        || metadata == &Default::default()
+                });
+        let item = if needs_replay_projection {
+            let mut projected = envelope.item.clone();
+            projected.clear_executed_tool_calls();
+            std::borrow::Cow::Owned(projected)
+        } else {
+            std::borrow::Cow::Borrowed(&envelope.item)
+        };
+        let metadata = match metadata_mode {
+            MetadataHashMode::ReplayV3 => {
+                Some(envelope.metadata.as_ref().unwrap_or(&default_metadata))
+            }
+            MetadataHashMode::LegacyExact => envelope.metadata.as_ref(),
+            MetadataHashMode::LegacyDefaultAsNone => envelope
+                .metadata
+                .as_ref()
+                .filter(|metadata| **metadata != default_metadata),
+        };
+        let value = canonical(serde_json::to_value((item.as_ref(), metadata))?);
+        serde_json::to_writer(&mut writer, &value)?;
+    }
+    writer.write_all(b"]")?;
+    Ok(format!("sha256-v1:{:x}", writer.0.finalize()))
+}
+
+fn bound_home_identity(file: &File, owner: &str) -> Result<String> {
+    let mut identity = owner.as_bytes().to_vec();
+    identity.push(0);
+    identity.extend(platform::object_identity(file)?);
+    Ok(digest(
+        b"codex.native.request-capacity.home.v1\0",
+        &identity,
+    ))
+}
+
+fn directory(home: &Path, binding: &Binding, create: bool) -> Result<Option<platform::Directory>> {
+    let physical = std::fs::canonicalize(home).context("resolve request-capacity profile")?;
+    let home = platform::Directory::open_home(&physical)?;
+    platform::validate_owner(&home.file, &binding.owner_identity, true, false)?;
+    ensure!(
+        bound_home_identity(&home.file, &binding.owner_identity)? == binding.home_identity,
+        "request-capacity physical home changed before storage access"
+    );
+    let Some(cache) = home.child("cache", create, false)? else {
+        return Ok(None);
+    };
+    cache.child(CACHE_NAME, create, true)
+}
+
+fn read_record(
+    directory: &platform::Directory,
+    thread: &str,
+    owner: &str,
+) -> Result<Option<Checkpoint>> {
+    let name = format!("{thread}.json");
+    let Some(mut file) = directory.open_existing(&name)? else {
+        return Ok(None);
+    };
+    platform::validate_owner(&file, owner, false, true)?;
+    let mut raw = Vec::new();
+    Read::by_ref(&mut file)
+        .take((MAX_METADATA_BYTES + 1) as u64)
+        .read_to_end(&mut raw)?;
+    ensure!(
+        raw.len() <= MAX_METADATA_BYTES,
+        "request-capacity metadata exceeds its bound"
+    );
+    let record: Record =
+        serde_json::from_slice(&raw).context("invalid request-capacity metadata")?;
+    ensure!(
+        record.schema_version == SCHEMA_VERSION && record.ordinary_scope == "ordinary_non_basic",
+        "unsupported request-capacity metadata"
+    );
+    record.checkpoint.validate()?;
+    Ok(Some(record.checkpoint))
+}
+
+/// Open and hold the existing per-thread OS lock; no new registry or lifecycle.
+fn thread_lock(
+    directory: &platform::Directory,
+    binding: &Binding,
+    create: bool,
+) -> Result<Option<File>> {
+    let name = format!("{}.lock", binding.thread_id);
+    let lock = if create {
+        Some(directory.open_lock(&name)?)
+    } else {
+        directory.open_existing_lock(&name)?
+    };
+    let Some(lock) = lock else {
+        return Ok(None);
+    };
+    platform::validate_owner(&lock, &binding.owner_identity, false, true)?;
+    let deadline = Instant::now() + Duration::from_secs(2);
+    loop {
+        match lock.try_lock() {
+            Ok(()) => return Ok(Some(lock)),
+            Err(std::fs::TryLockError::WouldBlock) if Instant::now() < deadline => {
+                std::thread::sleep(Duration::from_millis(10))
+            }
+            Err(error) => {
+                return Err(anyhow::anyhow!(
+                    "request-capacity metadata lock unavailable: {error}"
+                ));
+            }
+        }
+    }
+}
+
+/// Read only while holding thread_lock. Empty pre-fence locks remain compatible;
+/// partial, oversized or unknown contents never become a live authorization.
+fn lock_is_deleted(lock: &File) -> Result<bool> {
+    ensure!(
+        lock.metadata()?.len() <= DELETED_LOCK_MAGIC.len() as u64,
+        "request-capacity lock state exceeds its bound"
+    );
+    let mut reader = lock;
+    reader.seek(SeekFrom::Start(0))?;
+    let mut bytes = Vec::new();
+    Read::by_ref(&mut reader)
+        .take((DELETED_LOCK_MAGIC.len() + 1) as u64)
+        .read_to_end(&mut bytes)?;
+    ensure!(
+        bytes.is_empty() || bytes == DELETED_LOCK_MAGIC,
+        "invalid request-capacity lock state"
+    );
+    Ok(!bytes.is_empty())
+}
+
+/// A read must serialize with deletion too, including the crash cutpoint between
+/// marking the lock and unlinking an otherwise valid old checkpoint.
+fn readable_thread_lock(
+    directory: &platform::Directory,
+    binding: &Binding,
+) -> Result<Option<File>> {
+    let Some(lock) = thread_lock(directory, binding, false)? else {
+        ensure!(
+            read_record(directory, &binding.thread_id, &binding.owner_identity)?.is_none(),
+            "request-capacity checkpoint has no native lock domain"
+        );
+        return Ok(None);
+    };
+    if lock_is_deleted(&lock)? {
+        return Ok(None);
+    }
+    Ok(Some(lock))
+}
+
+pub(super) fn load(home: &Path, binding: &Binding) -> Result<Option<Checkpoint>> {
+    let actual = Binding::for_profile(
+        home,
+        &binding.thread_id,
+        &binding.model,
+        &binding.provider,
+        &binding.history_anchor,
+    )?;
+    ensure!(
+        &actual == binding,
+        "request-capacity profile binding changed"
+    );
+    let Some(directory) = directory(home, binding, false)? else {
+        return Ok(None);
+    };
+    let Some(_lock) = readable_thread_lock(&directory, binding)? else {
+        return Ok(None);
+    };
+    let Some(checkpoint) = read_record(&directory, &binding.thread_id, &binding.owner_identity)?
+    else {
+        return Ok(None);
+    };
+    ensure!(
+        &checkpoint.binding == binding,
+        "request-capacity checkpoint binding mismatch"
+    );
+    Ok(Some(checkpoint))
+}
+
+/// Allocate a monotone epoch only for a new, real ordinary completion.
+/// This intentionally is not an eligibility API: an old window's completion
+/// number does not authorize reading/trimming any current history prefix.
+/// A stale window's record may carry a completion epoch/fence lineage into a
+/// newly completed manual summary. This is NOT input eligibility: callers may
+/// only use it after fresh summarizer success plus guarded native installation.
+pub(super) fn previous_checkpoint_for_lineage(
+    home: &Path,
+    binding: &Binding,
+) -> Result<Option<Checkpoint>> {
+    let actual = Binding::for_profile(
+        home,
+        &binding.thread_id,
+        &binding.model,
+        &binding.provider,
+        &binding.history_anchor,
+    )?;
+    ensure!(
+        &actual == binding,
+        "request-capacity profile binding changed"
+    );
+    let Some(directory) = directory(home, binding, false)? else {
+        return Ok(None);
+    };
+    let Some(_lock) = readable_thread_lock(&directory, binding)? else {
+        return Ok(None);
+    };
+    let Some(previous) = read_record(&directory, &binding.thread_id, &binding.owner_identity)?
+    else {
+        return Ok(None);
+    };
+    ensure!(
+        previous.binding.same_profile(binding),
+        "request-capacity checkpoint owner mismatch"
+    );
+    Ok(previous
+        .binding
+        .same_sampling_scope(binding)
+        .then_some(previous))
+}
+
+pub(super) fn previous_epoch(home: &Path, binding: &Binding) -> Result<u64> {
+    Ok(previous_checkpoint_for_lineage(home, binding)?.map_or(0, |record| record.completed_epoch))
+}
+
+/// The caller serializes with the native per-thread persistence boundary, after
+/// the actual completion/flush ACK. The extra per-thread OS lock only protects
+/// this one small metadata file across accidental concurrent native owners.
+pub(super) fn save(home: &Path, checkpoint: &Checkpoint) -> Result<()> {
+    save_inner(home, checkpoint, None)
+}
+
+/// Persist an exact pre-attempt fence without changing consumption provenance.
+/// The native caller must validate its currently admitted turn before calling.
+/// A failed write must prevent durable-thread recovery from starting.
+pub(super) fn fence(home: &Path, expected: &Checkpoint, turn_id: &str) -> Result<Checkpoint> {
+    ensure!(
+        uuid::Uuid::parse_str(turn_id)?.to_string() == turn_id,
+        "invalid request-capacity recovery turn identity"
+    );
+    ensure!(
+        expected.recovery_turn_id.as_deref() != Some(turn_id),
+        "request-capacity recovery already attempted for this completion and turn"
+    );
+    let mut checkpoint = expected.clone();
+    checkpoint.recovery_turn_id = Some(turn_id.to_owned());
+    save_inner(home, &checkpoint, Some(expected))?;
+    Ok(checkpoint)
+}
+
+/// Persist a native Prefix installation only if its exact source checkpoint
+/// remains current. History generation/auth/suffix guards are owned by Session.
+pub(super) fn save_if_current(
+    home: &Path,
+    checkpoint: &Checkpoint,
+    expected: &Checkpoint,
+) -> Result<()> {
+    save_inner(home, checkpoint, Some(expected))
+}
+
+fn save_inner(home: &Path, checkpoint: &Checkpoint, expected: Option<&Checkpoint>) -> Result<()> {
+    checkpoint.validate()?;
+    let binding = &checkpoint.binding;
+    let actual = Binding::for_profile(
+        home,
+        &binding.thread_id,
+        &binding.model,
+        &binding.provider,
+        &binding.history_anchor,
+    )?;
+    ensure!(
+        &actual == binding,
+        "request-capacity profile binding changed"
+    );
+    let directory =
+        directory(home, binding, true)?.context("request-capacity directory unavailable")?;
+    let lock = thread_lock(&directory, binding, true)?
+        .context("request-capacity metadata lock unavailable")?;
+    ensure!(
+        !lock_is_deleted(&lock)?,
+        "deleted request-capacity thread cannot publish a checkpoint"
+    );
+    let previous = read_record(&directory, &binding.thread_id, &binding.owner_identity)?;
+    if let Some(expected) = expected {
+        ensure!(
+            previous.as_ref() == Some(expected),
+            "request-capacity metadata compare-and-swap lost its source checkpoint"
+        );
+    }
+    if let Some(previous) = previous {
+        ensure!(
+            previous.binding.same_profile(binding),
+            "request-capacity checkpoint owner mismatch"
+        );
+        if previous == *checkpoint {
+            return Ok(());
+        }
+        if previous.binding.same_sampling_scope(binding) {
+            ensure!(
+                checkpoint.completed_epoch >= previous.completed_epoch,
+                "request-capacity checkpoint epoch regressed"
+            );
+            if checkpoint.completed_epoch == previous.completed_epoch {
+                ensure!(
+                    expected.is_some(),
+                    "request-capacity same-epoch update requires exact CAS"
+                );
+                ensure!(
+                    previous.recovery_turn_id.is_none() || checkpoint.recovery_turn_id.is_some(),
+                    "request-capacity recovery fence cannot be cleared within its completion epoch"
+                );
+                let mut fence_only = checkpoint.clone();
+                fence_only.recovery_turn_id = previous.recovery_turn_id.clone();
+                if fence_only != previous {
+                    ensure!(
+                        checkpoint.origin == Origin::TranslatedPrefix
+                            && checkpoint.response_id == previous.response_id
+                            && checkpoint.recovery_turn_id == previous.recovery_turn_id,
+                        "request-capacity prefix translation changed its completion or recovery fence"
+                    );
+                }
+            } else {
+                ensure!(
+                    checkpoint.origin == Origin::OrdinaryCompleted
+                        && checkpoint.recovery_turn_id.is_none(),
+                    "only a new ordinary completion may advance and re-arm capacity recovery"
+                );
+            }
+        }
+    } else {
+        ensure!(
+            expected.is_none(),
+            "request-capacity expected checkpoint disappeared"
+        );
+        ensure!(
+            checkpoint.origin != Origin::TranslatedPrefix && checkpoint.recovery_turn_id.is_none(),
+            "request-capacity translation or fence has no confirmed source checkpoint"
+        );
+    }
+    let bytes = serde_json::to_vec(&Record {
+        schema_version: SCHEMA_VERSION,
+        ordinary_scope: "ordinary_non_basic".to_owned(),
+        checkpoint: checkpoint.clone(),
+    })?;
+    ensure!(
+        bytes.len() <= MAX_METADATA_BYTES,
+        "request-capacity metadata exceeds its bound"
+    );
+    directory.replace(
+        &format!("{}.json", binding.thread_id),
+        &bytes,
+        &binding.owner_identity,
+    )?;
+    Ok(())
+}
+
+/// Only called after native thread deletion succeeded. The existing bounded
+/// shutdown observation does not prove all admitted blocking writers have joined,
+/// so persist a lock-domain deletion fence before removing the checkpoint.
+/// Archive/close/resume must never call this.
+#[derive(Debug)]
+pub(crate) struct DeleteReport {
+    pub(crate) checkpoint_removed: bool,
+    pub(crate) lock_retained: bool,
+}
+
+pub(crate) fn delete_thread_data(home: &Path, thread_id: &str) -> Result<DeleteReport> {
+    // Logical model/window do not authorize cache deletion. Ownership is this
+    // physical native profile plus the explicitly deleted typed thread UUID.
+    let binding = Binding::for_profile(
+        home,
+        thread_id,
+        "native-delete",
+        "native-delete",
+        "native-delete",
+    )?;
+    // Even a not-yet-created cache needs a fence: an admitted writer can be
+    // paused before directory creation when native business deletion proceeds.
+    let directory =
+        directory(home, &binding, true)?.context("request-capacity directory unavailable")?;
+    let lock = thread_lock(&directory, &binding, true)?
+        .context("request-capacity cleanup lock unavailable")?;
+    if !lock_is_deleted(&lock)? {
+        let mut writer = &lock;
+        writer.seek(SeekFrom::Start(0))?;
+        writer.write_all(DELETED_LOCK_MAGIC)?;
+        // The existing metadata layer syncs its small file before publishing.
+        // This is not an atomic transaction with rollout/business deletion.
+        lock.sync_all()?;
+    }
+    let removed = directory.remove_owned(
+        &format!("{}.json", binding.thread_id),
+        &binding.owner_identity,
+    )?;
+    // Unlinking this inode can strand admitted waiters and create a new lock
+    // domain. Preserve its bounded deletion marker; every later save checks it
+    // under this same OS lock before replacing any checkpoint.
+    Ok(DeleteReport {
+        checkpoint_removed: removed,
+        lock_retained: true,
+    })
+}
