+    #[test]
+    fn completed_manual_prefix_creates_cold_genesis_then_translates_existing_lineage()
+    -> anyhow::Result<()> {
+        let home = request_capacity::TestProfile::new()?;
+        let thread = "018f3405-e835-71af-914a-7efb76abfa71";
+        let turn = "018f3405-e835-71af-914a-7efb76abfa72";
+        let retained = message("summarized manual input", thread)?;
+        let pending = message("unconsumed pending suffix", turn)?;
+        let mut history = ContextManager::new();
+        history.replace_annotated(vec![retained.clone(), pending]);
+        let mut receipt = CapacityInstallReceipt {
+            history,
+            anchor: "manual-1".into(),
+            prefix_len: 1,
+        };
+        publish_manual_checkpoint(
+            home.path(),
+            thread,
+            "model",
+            "provider",
+            &receipt,
+            "manual-413-completed",
+            true,
+        )?;
+        let binding = request_capacity::Binding::for_profile(
+            home.path(),
+            thread,
+            "model",
+            "provider",
+            &receipt.anchor,
+        )?;
+        let genesis = request_capacity::load(home.path(), &binding)?.unwrap();
+        assert_eq!(
+            genesis.origin,
+            request_capacity::Origin::ManualPrefixGenesis
+        );
+        assert_eq!(genesis.completed_epoch, 0);
+        assert_eq!(genesis.response_id, "manual-413-completed");
+        assert_eq!(genesis.prefix_len, 1);
+        assert!(genesis.matches_prefix(std::slice::from_ref(&retained))?);
+        request_capacity::fence(home.path(), &genesis, turn)?;
+        receipt.anchor = "manual-2".into();
+        publish_manual_checkpoint(
+            home.path(),
+            thread,
+            "model",
+            "provider",
+            &receipt,
+            "new-manual-completion",
+            false,
+        )?;
+        let binding = request_capacity::Binding::for_profile(
+            home.path(),
+            thread,
+            "model",
+            "provider",
+            &receipt.anchor,
+        )?;
+        let translated = request_capacity::load(home.path(), &binding)?.unwrap();
+        assert_eq!(
+            translated.origin,
+            request_capacity::Origin::TranslatedPrefix
+        );
+        assert_eq!(translated.response_id, genesis.response_id);
+        assert_eq!(translated.completed_epoch, genesis.completed_epoch);
+        assert_eq!(translated.recovery_turn_id.as_deref(), Some(turn));
+        Ok(())
+    }
