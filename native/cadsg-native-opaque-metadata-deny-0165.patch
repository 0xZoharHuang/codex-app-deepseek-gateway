+            let mut mapped_mask = raw_mask;
+            MapGenericMask(&mut mapped_mask, &mapping);
+            if (raw_mask | mapped_mask) & deny_mask != 0 {
+                return true;
+            }
+            continue;
+        }
         if hdr.AceType != ACCESS_DENIED_ACE_TYPE {
             continue; // ACCESS_DENIED_ACE_TYPE
         }
