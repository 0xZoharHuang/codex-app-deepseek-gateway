+    /// Resolves a Guardian callback using its exact live host scope.
+    ///
+    /// Internal threads stay hidden from ID-based public lookup.
+    pub async fn guardian_thread_for_scope(
+        &self,
+        thread_id: ThreadId,
+        scope: &codex_extension_api::ExtensionData,
+    ) -> Option<Arc<CodexThread>> {
+        self.state
+            .threads
+            .read()
+            .await
+            .get(&thread_id)
+            .filter(|thread| {
+                thread.is_running() && std::ptr::eq(scope, thread.thread_extension_data())
+            })
+            .cloned()
+    }
