+#[test]
+fn cdag_keyring_isolation_secrets_retains_native_home_masterkey_contract() -> Result<()> {
+    let env = TempCodexHome::new();
+    let store = ScopedFixtureStore::default();
+    let tokens = sample_tokens();
+    let first_home = select_fixture_home(&env, "first-secrets")?;
+    let first_account = compute_keyring_account(&first_home, LocalSecretsNamespace::McpOAuth);
+    std::assert_eq!(
+        first_account,
+        compute_keyring_account(&first_home, LocalSecretsNamespace::CodexAuth)
+    );
+    std::assert_eq!(
+        first_account,
+        compute_keyring_account(&first_home, LocalSecretsNamespace::ManagedSecrets)
+    );
+    save_oauth_tokens_to_secrets_keyring(&store, &tokens.server_name, &tokens)?;
+    assert!(
+        store
+            .values
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .contains_key(&("codex".into(), first_account.clone()))
+    );
+    let first_ciphertext = fs::read(first_home.join("secrets").join("mcp_oauth.age"))?;
+    let second_home = select_fixture_home(&env, "second-secrets")?;
+    let second_account = compute_keyring_account(&second_home, LocalSecretsNamespace::McpOAuth);
+    assert_ne!(first_account, second_account);
+    assert!(
+        load_oauth_tokens_from_secrets_keyring(&store, &tokens.server_name, &tokens.url)?.is_none()
+    );
+    save_oauth_tokens_to_secrets_keyring(&store, &tokens.server_name, &tokens)?;
+    assert!(delete_oauth_tokens_from_keyring_and_file(
+        &store,
+        OAuthCredentialsStoreMode::Auto,
+        AuthKeyringBackendKind::Secrets,
+        &tokens.server_name,
+        &tokens.url,
+    )?);
+    std::assert_eq!(
+        fs::read(first_home.join("secrets").join("mcp_oauth.age"))?,
+        first_ciphertext
+    );
+    unsafe {
+        std::env::set_var("CODEX_HOME", &first_home);
+    }
+    assert_tokens_match_without_expiry(
+        &load_oauth_tokens_from_secrets_keyring(&store, &tokens.server_name, &tokens.url)?
+            .expect("first Secrets profile remains readable"),
+        &tokens,
+    );
+    Ok(())
+}
