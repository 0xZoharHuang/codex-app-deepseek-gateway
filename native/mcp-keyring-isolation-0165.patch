+#[test]
+fn cdag_keyring_isolation_secrets_logout_preserves_stock_and_cds_direct_entries() -> Result<()> {
+    let _env = TempCodexHome::new();
+    let store = ScopedFixtureStore::default();
+    let tokens = sample_tokens();
+    let key = compute_store_key(&tokens.server_name, &tokens.url)?;
+    let home = find_codex_home()?.canonicalize()?;
+    let digest = format!("{:x}", Sha256::digest(home.to_string_lossy().as_bytes()));
+    let cds_service = format!("Codex DeepSeek MCP Credentials|{}", &digest[..32]);
+    {
+        let mut entries = store.values.lock().unwrap_or_else(PoisonError::into_inner);
+        entries.insert(
+            (UNSCOPED_SERVICE.into(), key.clone()),
+            "fixture-stock".into(),
+        );
+        entries.insert((cds_service.clone(), key.clone()), "fixture-cds".into());
+    }
+    // Secrets logout keeps the upstream Direct-legacy cleanup, within the CAG profile.
+    save_oauth_tokens_to_direct_keyring(&store, &tokens.server_name, &tokens)?;
+    save_oauth_tokens_to_secrets_keyring(&store, &tokens.server_name, &tokens)?;
+    save_oauth_tokens_to_file(&tokens)?;
+    assert!(delete_oauth_tokens_from_keyring_and_file(
+        &store,
+        OAuthCredentialsStoreMode::File,
+        AuthKeyringBackendKind::Secrets,
+        &tokens.server_name,
+        &tokens.url,
+    )?);
+    assert!(
+        load_oauth_tokens_from_direct_keyring(&store, &tokens.server_name, &tokens.url)?.is_none()
+    );
+    assert!(
+        load_oauth_tokens_from_secrets_keyring(&store, &tokens.server_name, &tokens.url)?.is_none()
+    );
+    assert!(load_oauth_tokens_from_file(&tokens.server_name, &tokens.url)?.is_none());
+    let entries = store.values.lock().unwrap_or_else(PoisonError::into_inner);
+    std::assert_eq!(
+        entries
+            .get(&(UNSCOPED_SERVICE.into(), key.clone()))
+            .map(String::as_str),
+        Some("fixture-stock")
+    );
+    std::assert_eq!(
+        entries.get(&(cds_service.clone(), key)).map(String::as_str),
+        Some("fixture-cds")
+    );
+    assert!(
+        store
+            .services
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .iter()
+            .all(|service| service != UNSCOPED_SERVICE && service != &cds_service)
+    );
+    Ok(())
+}
