+#[test]
+fn cdag_keyring_isolation_preserves_published_profile_identity() -> Result<()> {
+    let env = TempCodexHome::new();
+    let canonical = env.path().canonicalize()?;
+    let digest = format!(
+        "{:x}",
+        Sha256::digest(canonical.to_string_lossy().as_bytes())
+    );
+    std::assert_eq!(
+        keyring_service_name()?,
+        format!("Codex App DeepSeek MCP Credentials|{}", &digest[..32])
+    );
+    // Keep the existing native File and encrypted-secret record schemas unchanged.
+    let tokens = sample_tokens();
+    save_oauth_tokens_to_file(&tokens)?;
+    let _file_lock = OAuthStoreLock::acquire_for_read(OAuthStore::File)?;
+    let records = read_fallback_file_unlocked()?.expect("fixture file");
+    assert!(records.contains_key(&compute_store_key(&tokens.server_name, &tokens.url)?));
+    Ok(())
+}
