+/// Existing stores determine their own representation without consulting primary state.
+pub(crate) async fn migration_ledger_is_empty(
+    pool: &SqlitePool,
+    base: &Migrator,
+) -> Result<bool, MigrateError> {
+    let exists = sqlx::query_scalar::<_, i64>(
+        "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?",
+    )
+    .bind(base.table_name.as_ref())
+    .fetch_optional(pool)
+    .await?
+    .is_some();
+    if !exists {
+        return Ok(true);
+    }
+    let mut connection = pool.acquire().await?;
+    Ok(connection
+        .list_applied_migrations(&base.table_name)
+        .await?
+        .is_empty())
+}
