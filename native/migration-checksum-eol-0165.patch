+        .await
+        .unwrap();
+    eol_migrator(&super::STATE_MIGRATOR, false)
+        .run(&primary)
+        .await
+        .unwrap();
+    let primary_before = eol_ledger(&primary).await;
+    primary.close().await;
+
+    for (name, base) in eol_domains()
+        .into_iter()
+        .filter(|(name, _)| *name != "state")
+    {
+        let canonical = super::runtime_migrator(base);
+        let pool = match name {
+            "logs" => config.open_logs_db(&canonical, None).await.unwrap(),
+            "goals" => config.open_goals_db(&canonical, None).await.unwrap(),
+            "memory" => config.open_memories_v2_db().await.unwrap(),
+            "queue" => config.open_queue_db(&canonical, None).await.unwrap(),
+            "history" => config
+                .open_thread_history_db(&canonical, None)
+                .await
+                .unwrap(),
+            _ => unreachable!(),
+        };
+        let legacy = eol_migrator(base, false);
+        let created = eol_ledger(&pool).await;
+        assert_eq!(created.len(), legacy.migrations.len(), "{name}");
+        for row in &created {
+            let expected = legacy
+                .iter()
+                .find(|migration| migration.version == row.0)
+                .unwrap();
+            assert_eq!(row.4, expected.checksum.as_ref(), "{name}");
+        }
+        legacy
+            .run(&pool)
+            .await
+            .expect("old P6 opens newly created legacy-profile auxiliary store");
+        assert_eq!(
+            eol_ledger(&pool).await,
+            created,
+            "{name}: old reader must not add or rewrite rows"
+        );
+        pool.close().await;
+    }
+    let primary = config
+        .open_read_only_pool(&config.state_db_path(), None)
+        .await
+        .unwrap();
+    assert_eq!(eol_ledger(&primary).await, primary_before);
+    primary.close().await;
+}
+
+#[tokio::test]
+async fn eol_existing_auxiliary_ledger_does_not_depend_on_primary_health() {
+    for dirty in [false, true] {
+        let home = crate::runtime::test_support::unique_temp_dir();
+        tokio::fs::create_dir_all(&home).await.unwrap();
+        let _cleanup = scopeguard::guard(home.clone(), |home| {
+            let _ = std::fs::remove_dir_all(home);
+        });
+        let config = crate::SqliteConfig::new_for_testing(home.as_path().abs());
+        let primary = config
+            .open_read_write_pool(&config.state_db_path())
+            .await
+            .unwrap();
+        eol_migrator(&super::STATE_MIGRATOR, false)
+            .run(&primary)
+            .await
+            .unwrap();
+        let logs = config
+            .open_read_write_pool(&config.logs_db_path())
+            .await
+            .unwrap();
+        eol_migrator(&super::LOGS_MIGRATOR, false)
+            .run(&logs)
+            .await
+            .unwrap();
+        let logs_before = eol_ledger(&logs).await;
+        logs.close().await;
+        if dirty {
+            sqlx::query("UPDATE _sqlx_migrations SET success=0 WHERE version=1")
+                .execute(&primary)
+                .await
+                .unwrap();
+        } else {
+            sqlx::query("UPDATE _sqlx_migrations SET checksum=zeroblob(48) WHERE version=1")
+                .execute(&primary)
+                .await
+                .unwrap();
+        }
+        let primary_before = eol_ledger(&primary).await;
+        let canonical = super::runtime_logs_migrator();
+        let logs = config
+            .open_logs_db(&canonical, None)
+            .await
+            .expect("valid existing auxiliary store is independent of primary validation");
+        assert_eq!(eol_ledger(&logs).await, logs_before);
+        assert_eq!(eol_ledger(&primary).await, primary_before);
+        let error = super::runtime_migrator_for_database(
+            &primary,
+            &super::runtime_state_migrator(),
+            true,
+            false,
+        )
+        .await
+        .unwrap_err();
+        assert!(matches!(error, sqlx::migrate::MigrateError::Dirty(1)) == dirty);
+        assert!(matches!(error, sqlx::migrate::MigrateError::VersionMismatch(1)) != dirty);
+        logs.close().await;
+        primary.close().await;
+    }
+}
