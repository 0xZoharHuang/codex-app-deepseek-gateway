+#[tokio::test]
+async fn eol_legacy_38_to_39_repair_accepts_both_precise_forms() {
+    for crlf in [false, true] {
+        let pool = eol_pool().await;
+        let full = eol_migrator(&super::STATE_MIGRATOR, crlf);
+        let mut old = super::copy_migrator(&full);
+        old.migrations = Cow::Owned(
+            full.iter()
+                .filter(|migration| migration.version <= 37)
+                .cloned()
+                .collect(),
+        );
+        let mut recency = full
+            .iter()
+            .find(|migration| migration.version == 39)
+            .unwrap()
+            .clone();
+        recency.version = 38;
+        old.migrations.to_mut().push(recency);
+        old.run(&pool).await.unwrap();
+        let before = eol_ledger(&pool).await;
+        assert_eq!(before.len(), old.migrations.len());
+        let canonical = super::runtime_state_migrator();
+        let selected = super::runtime_migrator_for_database(&pool, &canonical, true, false)
+            .await
+            .unwrap();
+        repair_legacy_recency_migration_version(&pool, &selected)
+            .await
+            .unwrap();
+        selected.run(&pool).await.unwrap();
+        let created = eol_ledger(&pool).await;
+        assert_eq!(created.len(), full.migrations.len());
+        assert_eq!(
+            created.iter().map(|row| row.0).collect::<Vec<_>>(),
+            full.iter()
+                .map(|migration| migration.version)
+                .collect::<Vec<_>>()
+        );
+        for row in &created {
+            let expected = full
+                .iter()
+                .find(|migration| migration.version == row.0)
+                .unwrap();
+            assert_eq!(row.4, expected.checksum.as_ref());
+        }
+        for previous in &before {
+            let mut expected = previous.clone();
+            if expected.0 == 38 {
+                expected.0 = 39;
+                expected.1 = full
+                    .iter()
+                    .find(|migration| migration.version == 39)
+                    .unwrap()
+                    .description
+                    .to_string();
+            }
+            assert_eq!(
+                created.iter().find(|row| row.0 == expected.0).unwrap(),
+                &expected
+            );
+        }
+        full.run(&pool)
+            .await
+            .expect("same-format old reader after legacy metadata repair");
+        assert_eq!(
+            eol_ledger(&pool).await,
+            created,
+            "old reader must not add or rewrite migration rows"
+        );
+        pool.close().await;
+    }
+}
