+    path: &std::path::Path,
+    namespace: &crate::namespace::SandboxNamespace,
+    value: &T,
+) -> Result<()> {
+    let mut value = serde_json::to_value(value)?;
+    value
+        .as_object_mut()
+        .expect("native sandbox metadata is an object")
+        .insert("namespace".into(), namespace.key.id().into());
+    fs::create_dir_all(path.parent().expect("metadata parent"))?;
+    fs::write(path, serde_json::to_vec(&value)?)?;
+    Ok(())
+}
