+#[test]
+fn readonly_root_only_noop_succeeds_but_missing_ace_fails_without_changes() -> anyhow::Result<()> {
+    use std::os::windows::io::AsRawHandle;
+    use windows_sys::Win32::Security::Authorization::{
+        ConvertStringSecurityDescriptorToSecurityDescriptorW, SetSecurityInfo,
+    };
+    use windows_sys::Win32::Security::{
+        GetSecurityDescriptorDacl, PROTECTED_DACL_SECURITY_INFORMATION,
+    };
+
+    let fixture = tempfile::tempdir()?;
+    let child = fixture.path().join("child");
+    std::fs::create_dir(&child)?;
+    let mut restore = ReadonlyDaclFixtureRestore::capture(fixture.path())?;
+    let user = crate::runtime_ownership::current_setup_user()?;
+    let user_sid = crate::winutil::string_from_sid_bytes(&crate::winutil::resolve_sid(&user)?)
+        .map_err(anyhow::Error::msg)?;
+    let existing = LocalSid::from_string("S-1-5-21-915763429-1123581321-271828182-4404")?;
+    let missing = LocalSid::from_string("S-1-5-21-915763429-1123581321-271828182-4405")?;
+    // OWNER_RIGHTS suppresses the implicit owner's WRITE_DAC grant. Explicit
+    // READ_CONTROL plus the caller's other rights remain available.
+    let sddl = format!(
+        "D:P(D;;WD;;;OW)(A;;RC;;;OW)(A;OICI;FA;;;{user_sid})(A;;0x80;;;S-1-5-21-915763429-1123581321-271828182-4404)"
+    );
+    let mut descriptor = std::ptr::null_mut();
+    anyhow::ensure!(
+        unsafe {
+            ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                to_wide(sddl).as_ptr(),
+                SDDL_REVISION_1,
+                &mut descriptor,
+                std::ptr::null_mut(),
+            )
+        } != 0,
+        "build owned readonly fixture DACL"
+    );
+    let result = (|| -> anyhow::Result<()> {
+        let mut present = 0;
+        let mut defaulted = 0;
+        let mut dacl = std::ptr::null_mut();
+        anyhow::ensure!(
+            unsafe {
+                GetSecurityDescriptorDacl(descriptor, &mut present, &mut dacl, &mut defaulted)
+            } != 0
+                && present != 0,
+            "read readonly fixture DACL"
+        );
+        let status = unsafe {
+            SetSecurityInfo(
+                restore.handle.as_raw_handle() as _,
+                1,
+                DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION,
+                std::ptr::null_mut(),
+                std::ptr::null_mut(),
+                dacl,
+                std::ptr::null_mut(),
+            )
+        };
+        anyhow::ensure!(status == 0, "apply owned readonly fixture DACL: {status}");
+        // Keep this a real readonly parent despite the inheritable user ACE:
+        // OWNER_RIGHTS deny-WRITE_DAC applies to the root, not its children.
+        let denied = OpenOptions::new()
+            .access_mode(windows_sys::Win32::Storage::FileSystem::WRITE_DAC)
+            .share_mode(
+                windows_sys::Win32::Storage::FileSystem::FILE_SHARE_READ
+                    | windows_sys::Win32::Storage::FileSystem::FILE_SHARE_WRITE
+                    | windows_sys::Win32::Storage::FileSystem::FILE_SHARE_DELETE,
+            )
+            .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)
+            .open(fixture.path())
+            .expect_err("fresh root WRITE_DAC must still be denied");
+        anyhow::ensure!(
+            denied.raw_os_error() == Some(5),
+            "readonly fixture must deny WRITE_DAC with error5"
+        );
+        // Establish positive child READ_CONTROL/READ_ATTRIBUTES before using
+        // its unchanged ACL/control snapshot as an operation assertion.
+        let child_read = OpenOptions::new()
+            .access_mode(READ_CONTROL | FILE_READ_ATTRIBUTES)
+            .share_mode(
+                windows_sys::Win32::Storage::FileSystem::FILE_SHARE_READ
+                    | windows_sys::Win32::Storage::FileSystem::FILE_SHARE_WRITE
+                    | windows_sys::Win32::Storage::FileSystem::FILE_SHARE_DELETE,
+            )
+            .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)
+            .open(&child)?;
+        drop(child_read);
+        let root_before = acl_snapshot(fixture.path());
+        let child_before = acl_snapshot(&child);
+        anyhow::ensure!(
+            !unsafe {
+                ensure_allow_mask_aces_with_inheritance(
+                    fixture.path(),
+                    &[existing.as_ptr()],
+                    FILE_READ_ATTRIBUTES,
+                    0,
+                )
+            }?,
+            "existing readonly grant must be a successful no-op"
+        );
+        let failure = unsafe {
+            ensure_allow_mask_aces_with_inheritance(
+                fixture.path(),
+                &[missing.as_ptr()],
+                FILE_READ_ATTRIBUTES,
+                0,
+            )
+        }
+        .expect_err("missing grant must require denied WRITE_DAC");
+        anyhow::ensure!(
+            failure.chain().any(|cause| cause
+                .downcast_ref::<std::io::Error>()
+                .is_some_and(|error| error.raw_os_error() == Some(5))),
+            "missing grant must retain access denied"
+        );
+        anyhow::ensure!(
+            acl_snapshot(fixture.path()) == root_before,
+            "readonly parent DACL/control changed"
+        );
+        anyhow::ensure!(
+            acl_snapshot(&child) == child_before,
+            "readonly child DACL/control changed"
+        );
+        Ok(())
+    })();
+    unsafe { LocalFree(descriptor as HLOCAL) };
+    let cleanup = restore.restore();
+    result?;
+    cleanup?;
+    Ok(())
+}
