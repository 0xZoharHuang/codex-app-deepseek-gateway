+#[test]
+fn root_only_backend_matches_stock_maximum_acl_and_control() -> anyhow::Result<()> {
+    use std::os::windows::io::AsRawHandle;
+    use windows_sys::Win32::System::SystemServices::MAXIMUM_ALLOWED;
+
+    let fixture = tempfile::tempdir()?;
+    let stock = fixture.path().join("stock");
+    let adapted = fixture.path().join("adapted");
+    let marker = LocalSid::from_string("S-1-5-21-915763429-1123581321-271828182-4410")?;
+    let added = LocalSid::from_string("S-1-5-21-915763429-1123581321-271828182-4411")?;
+    let mut child_before = Vec::new();
+    for path in [&stock, &adapted] {
+        std::fs::create_dir(path)?;
+        let child = path.join("child");
+        std::fs::create_dir(&child)?;
+        let (_, descriptor) = unsafe { fetch_dacl_handle(&child)? };
+        let seeded = unsafe {
+            ensure_allow_mask_aces_with_inheritance(
+                path,
+                &[marker.as_ptr()],
+                FILE_READ_ATTRIBUTES,
+                super::CONTAINER_INHERIT_ACE | super::OBJECT_INHERIT_ACE,
+            )
+        };
+        let restored = unsafe {
+            SetFileSecurityW(
+                to_wide(&child).as_ptr(),
+                DACL_SECURITY_INFORMATION,
+                descriptor,
+            )
+        };
+        unsafe { LocalFree(descriptor as HLOCAL) };
+        anyhow::ensure!(seeded?, "fresh inheritable marker must be added");
+        anyhow::ensure!(
+            restored != 0,
+            "restore existing non-inheriting child fixture"
+        );
+        child_before.push(acl_snapshot(&child));
+    }
+    assert_eq!(acl_snapshot(&stock), acl_snapshot(&adapted));
+
+    let maximum = OpenOptions::new()
+        .access_mode(MAXIMUM_ALLOWED)
+        .share_mode(
+            windows_sys::Win32::Storage::FileSystem::FILE_SHARE_READ
+                | windows_sys::Win32::Storage::FileSystem::FILE_SHARE_WRITE
+                | windows_sys::Win32::Storage::FileSystem::FILE_SHARE_DELETE,
+        )
+        .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)
+        .open(&stock)?;
+    let (dacl, descriptor) = unsafe { fetch_dacl_handle(&stock)? };
+    let explicit = super::EXPLICIT_ACCESS_W {
+        grfAccessPermissions: FILE_READ_ATTRIBUTES,
+        grfAccessMode: super::GRANT_ACCESS,
+        grfInheritance: 0,
+        Trustee: super::TRUSTEE_W {
+            pMultipleTrustee: std::ptr::null_mut(),
+            MultipleTrusteeOperation: 0,
+            TrusteeForm: super::TRUSTEE_IS_SID,
+            TrusteeType: super::TRUSTEE_IS_UNKNOWN,
+            ptstrName: added.as_ptr().cast(),
+        },
+    };
+    let mut new_dacl = std::ptr::null_mut();
+    let baseline = (|| -> anyhow::Result<()> {
+        let status = unsafe { super::SetEntriesInAclW(1, &explicit, dacl, &mut new_dacl) };
+        anyhow::ensure!(status == 0, "stock SetEntriesInAclW failed: {status}");
+        let status = unsafe {
+            super::SetSecurityInfo(
+                maximum.as_raw_handle() as _,
+                1,
+                DACL_SECURITY_INFORMATION,
+                std::ptr::null_mut(),
+                std::ptr::null_mut(),
+                new_dacl,
+                std::ptr::null_mut(),
+            )
+        };
+        anyhow::ensure!(
+            status == 0,
+            "stock MAXIMUM_ALLOWED SetSecurityInfo failed: {status}"
+        );
+        Ok(())
+    })();
+    if !new_dacl.is_null() {
+        unsafe { LocalFree(new_dacl as HLOCAL) };
+    }
+    unsafe { LocalFree(descriptor as HLOCAL) };
+    baseline?;
+    anyhow::ensure!(
+        unsafe {
+            ensure_allow_mask_aces_with_inheritance(
+                &adapted,
+                &[added.as_ptr()],
+                FILE_READ_ATTRIBUTES,
+                0,
+            )
+        }?,
+        "adapted root-only grant must be added"
+    );
+    assert_eq!(acl_snapshot(&stock), acl_snapshot(&adapted));
+    assert_eq!(acl_snapshot(&stock.join("child")), child_before[0]);
+    assert_eq!(acl_snapshot(&adapted.join("child")), child_before[1]);
+    Ok(())
+}
