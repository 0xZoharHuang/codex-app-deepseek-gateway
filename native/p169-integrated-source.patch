+//! Home-scoped identities for the private App runtime. Native sandbox algorithms are unchanged.
+use crate::namespace_key::NamespaceKey;
+use anyhow::{Context, Result, ensure};
+use std::path::{Path, PathBuf};
+
+#[derive(Clone, Debug)]
+pub(crate) struct SandboxNamespace {
+    pub(crate) key: NamespaceKey,
+    pub(crate) home: PathBuf,
+    pub(crate) owner_sid: String,
+    volume: u64,
+    file_id: [u8; 16],
+}
+impl SandboxNamespace {
+    pub(crate) fn current(home: &Path) -> Result<Self> {
+        let namespace = Self::for_user(home, &crate::runtime_ownership::current_setup_user()?)?;
+        if !crate::registered_core_requested() {
+            namespace.ensure_legacy_runtime_unowned()?;
+        }
+        Ok(namespace)
+    }
+    pub(crate) fn for_user(home: &Path, real_user: &str) -> Result<Self> {
+        let sid = crate::winutil::resolve_sid(real_user).context("resolve namespace owner SID")?;
+        let owner_sid = crate::winutil::string_from_sid_bytes(&sid).map_err(anyhow::Error::msg)?;
+        Self::for_owner_sid(home, &owner_sid)
+    }
+    pub(crate) fn for_owner_sid(home: &Path, owner_sid: &str) -> Result<Self> {
+        ensure!(
+            home.is_absolute(),
+            "sandbox namespace requires an absolute home"
+        );
+        let home = dunce::canonicalize(home).context("resolve sandbox namespace home")?;
+        let canonical = home
+            .to_str()
+            .context("sandbox home is not valid Unicode")?
+            .to_lowercase();
+        let _sid = crate::token::LocalSid::from_string(owner_sid)?;
+        let owner_sid = owner_sid.to_owned();
+        let (volume, file_id) = directory_identity(&home)?;
+        Ok(Self {
+            key: NamespaceKey::for_directory(&canonical, &owner_sid, volume, file_id),
+            home,
+            owner_sid,
+            volume,
+            file_id,
+        })
+    }
+    pub(crate) fn ensure_legacy_runtime_unowned(&self) -> Result<()> {
+        if let Some(record) = crate::runtime_ownership::load_installation()?
+            && record.runtime.is_some()
+        {
+            let bound = record
+                .namespace_id
+                .as_deref()
+                .context("registered installation namespace is missing; repair required")?;
+            ensure!(
+                bound != self.key.id(),
+                "registered Core owns this namespace; use native package teardown before Legacy setup"
+            );
+        }
+        Ok(())
+    }
+    pub(crate) fn from_environment() -> Result<Self> {
+        let home = std::env::var_os("CODEX_HOME")
+            .context("isolated sandbox cleanup requires explicit CODEX_HOME")?;
+        Self::current(Path::new(&home))
+    }
+    pub(crate) fn validate_names(&self, offline: &str, online: &str) -> Result<()> {
+        ensure!(
+            offline == self.key.offline() && online == self.key.online(),
+            "sandbox identities belong to another home or legacy installation; refusing to adopt or modify them"
+        );
+        Ok(())
+    }
+    fn owner_path(&self) -> PathBuf {
+        crate::setup::sandbox_secrets_dir(&self.home).join("namespace_owner.json")
+    }
+    fn owner_record(&self) -> serde_json::Value {
+        serde_json::json!({"schema":1,"namespace":self.key.id(),"owner_sid":self.owner_sid,
+            "home":self.home.to_string_lossy().to_lowercase(),"volume":self.volume,"file_id":self.file_id,"offline":self.key.offline(),
+            "online":self.key.online(),"group":self.key.group()})
+    }
+    fn validate_owner_record(&self) -> Result<bool> {
+        let bytes = match std::fs::read(self.owner_path()) {
+            Ok(bytes) => bytes,
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(false),
+            Err(e) => return Err(e).context("read namespace owner record"),
+        };
+        let record: serde_json::Value =
+            serde_json::from_slice(&bytes).context("invalid namespace owner record")?;
+        ensure!(
+            record == self.owner_record(),
+            "sandbox owner record belongs to another installation"
+        );
+        Ok(true)
+    }
+    pub(crate) fn require_owned_state(&self) -> Result<()> {
+        self.validate_existing_state()?;
+        ensure!(
+            self.validate_owner_record()?,
+            "sandbox namespace has no owner reservation"
+        );
+        Ok(())
+    }
+    pub(crate) fn reserve_owner(&self) -> Result<()> {
+        // Caller holds the native machine-wide setup lock, and validation preceded every mutation.
+        self.validate_existing_state()?;
+        if self.validate_owner_record()? {
+            return Ok(());
+        }
+        std::fs::create_dir_all(crate::setup::sandbox_secrets_dir(&self.home))?;
+        let bytes = serde_json::to_vec(&self.owner_record())?;
+        crate::file_write::write_file_atomically(&self.owner_path(), &bytes)
+    }
+    /// Only schema/identity fields are inspected; encrypted credentials are never decoded here.
+    pub(crate) fn validate_existing_state(&self) -> Result<()> {
+        ensure!(
+            !crate::setup::sandbox_dir(&self.home)
+                .join("sandbox_users.json")
+                .try_exists()?,
+            "legacy sandbox credentials found; isolated runtime will not migrate or delete them"
+        );
+        let owned = self.validate_owner_record()?;
+        let has_state = crate::setup::setup_marker_path(&self.home).try_exists()?
+            || crate::setup::sandbox_users_path(&self.home).try_exists()?;
+        ensure!(
+            !has_state || owned,
+            "sandbox state exists without its owner reservation; refusing to adopt it"
+        );
+        if !has_state && !owned {
+            // No adoption: a first setup may only create absent namespace principals.
+            for name in [self.key.offline(), self.key.online()] {
+                ensure!(
+                    crate::winutil::local_user_flags(&name)?.is_none(),
+                    "namespace account already exists without owned state; refusing to change it"
+                );
+            }
+            ensure!(
+                !local_group_exists(&self.key.group())?,
+                "namespace group already exists without owned state; refusing to adopt it"
+            );
+        }
+        for (path, marker) in [
+            (crate::setup::setup_marker_path(&self.home), true),
+            (crate::setup::sandbox_users_path(&self.home), false),
+        ] {
+            let bytes = match std::fs::read(&path) {
+                Ok(bytes) => bytes,
+                Err(e) if e.kind() == std::io::ErrorKind::NotFound => continue,
+                Err(e) => return Err(e).context("read sandbox identity metadata"),
+            };
+            // Native setup creates an empty protected marker before committing it. Only our
+            // previously persisted owner reservation permits recovery of that interrupted state.
+            if marker && bytes.is_empty() && owned {
+                continue;
+            }
+            let value: serde_json::Value = serde_json::from_slice(&bytes)
+                .context("existing sandbox state is invalid; no implicit adoption")?;
+            ensure!(
+                value.get("namespace").and_then(|v| v.as_str()) == Some(self.key.id().as_str()),
+                "existing sandbox state is not owned by this home namespace; use a separate home"
+            );
+            let (offline, online) = if marker {
+                (value.get("offline_username"), value.get("online_username"))
+            } else {
+                (
+                    value.get("offline").and_then(|v| v.get("username")),
+                    value.get("online").and_then(|v| v.get("username")),
+                )
+            };
+            ensure!(
+                self.key.owns_state(
+                    value.get("namespace").and_then(|v| v.as_str()),
+                    offline.and_then(|v| v.as_str()),
+                    online.and_then(|v| v.as_str())
+                ),
+                "sandbox identity metadata does not match its namespace"
+            );
+        }
+        Ok(())
+    }
+}
+pub(crate) fn local_group_exists(name: &str) -> Result<bool> {
+    use windows_sys::Win32::NetworkManagement::NetManagement as net;
+    let mut data = std::ptr::null_mut();
+    let status = unsafe {
+        net::NetLocalGroupGetInfo(
+            std::ptr::null(),
+            crate::winutil::to_wide(name).as_ptr(),
+            0,
+            &mut data,
+        )
+    };
+    if !data.is_null() {
+        unsafe { net::NetApiBufferFree(data as _) };
+    }
+    match status {
+        net::NERR_Success => Ok(true),
+        net::NERR_GroupNotFound => Ok(false),
+        value => anyhow::bail!("read namespace group metadata failed: {value}"),
+    }
+}
+
+fn directory_identity(home: &Path) -> Result<(u64, [u8; 16])> {
+    use std::os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle};
+    use windows_sys::Win32::Foundation::INVALID_HANDLE_VALUE;
+    use windows_sys::Win32::Storage::FileSystem as fs;
+    let raw = unsafe {
+        fs::CreateFileW(
+            crate::winutil::to_wide(home).as_ptr(),
+            fs::FILE_READ_ATTRIBUTES,
+            fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE | fs::FILE_SHARE_DELETE,
+            std::ptr::null(),
+            fs::OPEN_EXISTING,
+            fs::FILE_FLAG_BACKUP_SEMANTICS,
+            std::ptr::null_mut(),
+        )
+    };
+    ensure!(
+        raw != INVALID_HANDLE_VALUE,
+        "open canonical sandbox home identity: {}",
+        std::io::Error::last_os_error()
+    );
+    let handle = unsafe { OwnedHandle::from_raw_handle(raw as _) };
+    let mut id = fs::FILE_ID_INFO::default();
+    let ok = unsafe {
+        fs::GetFileInformationByHandleEx(
+            handle.as_raw_handle() as _,
+            fs::FileIdInfo,
+            (&mut id as *mut fs::FILE_ID_INFO).cast(),
+            std::mem::size_of::<fs::FILE_ID_INFO>() as u32,
+        )
+    };
+    ensure!(
+        ok != 0,
+        "read canonical sandbox directory identity: {}",
+        std::io::Error::last_os_error()
+    );
+    ensure!(
+        id.FileId.Identifier != [0; 16],
+        "sandbox filesystem does not expose a stable directory identity"
+    );
+    Ok((id.VolumeSerialNumber, id.FileId.Identifier))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn correctly_named_marker_without_owner_is_not_adopted() -> Result<()> {
+        let temp = tempfile::tempdir()?;
+        let namespace = SandboxNamespace::current(temp.path())?;
+        let path = crate::setup::setup_marker_path(temp.path());
+        std::fs::create_dir_all(path.parent().unwrap())?;
+        let original = serde_json::to_vec(&serde_json::json!({"namespace":namespace.key.id(),
+            "offline_username":namespace.key.offline(),"online_username":namespace.key.online()}))?;
+        std::fs::write(&path, &original)?;
+        assert!(
+            namespace
+                .validate_existing_state()
+                .unwrap_err()
+                .to_string()
+                .contains("without its owner reservation")
+        );
+        assert!(!namespace.owner_path().exists());
+        assert_eq!(std::fs::read(path)?, original);
+        Ok(())
+    }
+    #[test]
+    fn owned_interrupted_marker_recovers_but_corruption_does_not() -> Result<()> {
+        let temp = tempfile::tempdir()?;
+        let namespace = SandboxNamespace::current(temp.path())?;
+        namespace.reserve_owner()?;
+        let path = crate::setup::setup_marker_path(temp.path());
+        std::fs::create_dir_all(path.parent().unwrap())?;
+        std::fs::write(&path, [])?;
+        namespace.validate_existing_state()?;
+        std::fs::write(&path, b"broken")?;
+        assert!(namespace.validate_existing_state().is_err());
+        assert_eq!(std::fs::read(path)?, b"broken");
+        Ok(())
+    }
+    #[test]
+    fn namespace_changes_for_a_different_directory_object_at_same_path() -> Result<()> {
+        let temp = tempfile::tempdir()?;
+        let home = temp.path().join("home");
+        std::fs::create_dir(&home)?;
+        let a = SandboxNamespace::current(&home)?;
+        std::fs::rename(&home, temp.path().join("retained-original-home"))?;
+        std::fs::create_dir(&home)?;
+        let b = SandboxNamespace::current(&home)?;
+        assert_ne!(a.key, b.key);
+        Ok(())
+    }
+}
diff --git a/codex-rs/windows-sandbox-rs/src/namespace_coordination.rs b/codex-rs/windows-sandbox-rs/src/namespace_coordination.rs
new file mode 100644
index 0000000..a169978
--- /dev/null
+++ b/codex-rs/windows-sandbox-rs/src/namespace_coordination.rs
@@ -0,0 +1,340 @@
+//! Read-only namespace identity from the runner's actual Windows token.
+//! No private-home reads, inherited environment values, or unauthenticated IPC identity.
+use crate::namespace_key::NamespaceKey;
+use crate::token::{get_user_sid_bytes, token_groups};
+use crate::winutil::to_wide;
+use anyhow::{Context, Result, ensure};
+use std::ptr::{null, null_mut};
+use windows_sys::Win32::Foundation::{ERROR_NON_DOMAIN_SID, GetLastError, HANDLE};
+use windows_sys::Win32::NetworkManagement::NetManagement::{
+    NERR_Success, NetApiBufferFree, NetUserGetInfo, USER_INFO_23,
+};
+use windows_sys::Win32::Security::{
+    CopySid, EqualDomainSid, EqualSid, GetLengthSid, IsValidSid, LookupAccountSidW, SidTypeAlias,
+    SidTypeUser,
+};
+use windows_sys::Win32::System::SystemServices::{SE_GROUP_ENABLED, SE_GROUP_USE_FOR_DENY_ONLY};
+
+#[derive(Debug)]
+struct GroupObservation {
+    name: String,
+    kind: i32,
+    attributes: u32,
+    local_domain: bool,
+}
+
+fn enabled(attributes: u32) -> bool {
+    attributes & (SE_GROUP_ENABLED as u32) != 0
+        && attributes & (SE_GROUP_USE_FOR_DENY_ONLY as u32) == 0
+}
+
+fn select_namespace(user_name: &str, groups: &[GroupObservation]) -> Result<NamespaceKey> {
+    namespace_role(user_name, groups, true)?
+        .context("runner token has no enabled local namespace alias")
+}
+
+fn namespace_role(
+    user_name: &str,
+    groups: &[GroupObservation],
+    require_enabled: bool,
+) -> Result<Option<NamespaceKey>> {
+    let mut selected = None;
+    for group in groups {
+        if (require_enabled && !enabled(group.attributes))
+            || !group.local_domain
+            || !NamespaceKey::claims_group_name(&group.name)
+        {
+            continue;
+        }
+        ensure!(
+            group.kind == SidTypeAlias,
+            "runner namespace membership is not a local alias"
+        );
+        let key = NamespaceKey::from_group_name(&group.name)
+            .context("runner namespace group name is invalid")?;
+        ensure!(
+            user_name.eq_ignore_ascii_case(&key.offline())
+                || user_name.eq_ignore_ascii_case(&key.online()),
+            "runner token user does not match namespace account"
+        );
+        ensure!(
+            selected.is_none(),
+            "runner token has ambiguous namespace memberships"
+        );
+        selected = Some(key);
+    }
+    Ok(selected)
+}
+
+pub(crate) fn account_name(sid: &[u8]) -> Result<(String, i32)> {
+    let mut name_len = 0;
+    let mut domain_len = 0;
+    let mut kind = 0;
+    unsafe {
+        LookupAccountSidW(
+            null(),
+            sid.as_ptr() as _,
+            null_mut(),
+            &mut name_len,
+            null_mut(),
+            &mut domain_len,
+            &mut kind,
+        )
+    };
+    ensure!(
+        name_len > 0 && name_len <= 32_768 && domain_len <= 32_768,
+        "cannot resolve runner token SID: {}",
+        unsafe { GetLastError() }
+    );
+    let mut name = vec![0; name_len as usize];
+    let mut domain = vec![0; domain_len.max(1) as usize];
+    ensure!(
+        unsafe {
+            LookupAccountSidW(
+                null(),
+                sid.as_ptr() as _,
+                name.as_mut_ptr(),
+                &mut name_len,
+                domain.as_mut_ptr(),
+                &mut domain_len,
+                &mut kind,
+            )
+        } != 0,
+        "LookupAccountSidW for runner failed: {}",
+        unsafe { GetLastError() }
+    );
+    ensure!(
+        name_len as usize <= name.len(),
+        "invalid runner account name size"
+    );
+    let name = String::from_utf16(&name[..name_len as usize])
+        .context("runner account name is not Unicode")?;
+    Ok((name.trim_end_matches('\0').to_string(), kind))
+}
+
+pub(crate) fn local_user_sid(name: &str) -> Result<Vec<u8>> {
+    let mut data = null_mut();
+    // NULL server binds this lookup to the local SAM, not a similarly named domain user.
+    let status = unsafe { NetUserGetInfo(null(), to_wide(name).as_ptr(), 23, &mut data) };
+    if status != NERR_Success {
+        if !data.is_null() {
+            unsafe { NetApiBufferFree(data as _) };
+        }
+        anyhow::bail!("resolve local runner user SID failed: {status}");
+    }
+    let result = (|| {
+        ensure!(
+            !data.is_null(),
+            "local runner user query returned no record"
+        );
+        let sid = unsafe { (*(data as *const USER_INFO_23)).usri23_user_sid };
+        ensure!(
+            !sid.is_null() && unsafe { IsValidSid(sid) } != 0,
+            "local runner user has invalid SID"
+        );
+        let length = unsafe { GetLengthSid(sid) };
+        ensure!(
+            length >= 8 && length <= 68,
+            "local runner user SID size is invalid"
+        );
+        let mut owned = vec![0; length as usize];
+        ensure!(
+            unsafe { CopySid(length, owned.as_mut_ptr().cast(), sid) } != 0,
+            "copy local runner SID failed"
+        );
+        Ok(owned)
+    })();
+    unsafe { NetApiBufferFree(data as _) };
+    result
+}
+
+pub(crate) fn same_domain(user: &[u8], group: &[u8]) -> Result<bool> {
+    let mut equal = 0;
+    if unsafe { EqualDomainSid(user.as_ptr() as _, group.as_ptr() as _, &mut equal) } != 0 {
+        return Ok(equal != 0);
+    }
+    let error = unsafe { GetLastError() };
+    // Builtin, logon-session and capability SIDs are not account-domain memberships.
+    if error == ERROR_NON_DOMAIN_SID {
+        return Ok(false);
+    }
+    anyhow::bail!("compare runner token account domains failed: {error}")
+}
+
+/// Read-only role classifier, including other homes. A user-name prefix alone is never enough.
+///
+/// # Safety
+/// The caller retains a valid TOKEN_QUERY handle through this call.
+pub unsafe fn token_is_home_sandbox_account(token: HANDLE) -> Result<bool> {
+    let user = unsafe { get_user_sid_bytes(token) }?;
+    let (user_name, kind) = account_name(&user)?;
+    let mut observations = Vec::new();
+    for group in unsafe { token_groups(token, 1_048_576) }? {
+        // A disabled/deny-only alias still identifies the native tool account.
+        // It grants no authority; the coordination selector separately requires enabled groups.
+        if !same_domain(&user, &group.sid)? {
+            continue;
+        }
+        let (name, kind) = account_name(&group.sid)?;
+        if NamespaceKey::claims_group_name(&name) {
+            observations.push(GroupObservation {
+                name,
+                kind,
+                attributes: group.attributes,
+                local_domain: true,
+            });
+        }
+    }
+    if !is_namespace_sandbox_role(&user_name, &observations)? {
+        return Ok(false);
+    }
+    ensure!(
+        kind == SidTypeUser,
+        "namespace token user is not a user account"
+    );
+    let local_user = local_user_sid(&user_name)?;
+    ensure!(
+        unsafe { EqualSid(user.as_ptr() as _, local_user.as_ptr() as _) } != 0,
+        "namespace token user is not the local SAM account"
+    );
+    Ok(true)
+}
+
+fn is_namespace_sandbox_role(name: &str, observations: &[GroupObservation]) -> Result<bool> {
+    Ok(namespace_role(name, observations, false)?.is_some())
+}
+
+/// Derives only a coordination name, after binding the actual user and local alias.
+///
+/// # Safety
+/// The caller retains a valid token HANDLE with TOKEN_QUERY rights for this call.
+pub unsafe fn sandbox_read_acl_mutex_name_for_token(token: HANDLE) -> Result<String> {
+    let user = unsafe { get_user_sid_bytes(token) }?;
+    let (name, kind) = account_name(&user)?;
+    ensure!(
+        kind == SidTypeUser,
+        "runner token user is not a user account"
+    );
+    let local_user = local_user_sid(&name)?;
+    ensure!(
+        unsafe { EqualSid(user.as_ptr() as _, local_user.as_ptr() as _) } != 0,
+        "runner token user is not the local SAM account"
+    );
+    let mut observations = Vec::new();
+    for group in unsafe { token_groups(token, 1_048_576) }? {
+        if !enabled(group.attributes) || !same_domain(&local_user, &group.sid)? {
+            continue;
+        }
+        let (name, kind) = account_name(&group.sid)?;
+        observations.push(GroupObservation {
+            name,
+            kind,
+            attributes: group.attributes,
+            local_domain: true,
+        });
+    }
+    Ok(select_namespace(&name, &observations)?.read_acl_mutex())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn key() -> NamespaceKey {
+        NamespaceKey::new(r"c:\qa-home", "S-1-5-21-1-1001")
+    }
+    fn group() -> GroupObservation {
+        GroupObservation {
+            name: key().group(),
+            kind: SidTypeAlias,
+            attributes: SE_GROUP_ENABLED as u32,
+            local_domain: true,
+        }
+    }
+    #[test]
+    fn namespace_coordination_reuses_account_and_mutex_factories() {
+        for user in [key().offline(), key().online().to_uppercase()] {
+            assert_eq!(select_namespace(&user, &[group()]).unwrap(), key());
+        }
+        assert_eq!(NamespaceKey::from_group_name(&key().group()), Some(key()));
+    }
+    #[test]
+    fn namespace_coordination_rejects_missing_ambiguous_or_wrong_user() {
+        assert!(select_namespace(&key().offline(), &[]).is_err());
+        assert!(select_namespace(&key().offline(), &[group(), group()]).is_err());
+        assert!(select_namespace("admin", &[group()]).is_err());
+    }
+    #[test]
+    fn namespace_coordination_rejects_disabled_deny_only_foreign_or_wrong_type() {
+        let mut value = group();
+        value.attributes = 0;
+        assert!(select_namespace(&key().offline(), &[value]).is_err());
+        let mut value = group();
+        value.attributes |= SE_GROUP_USE_FOR_DENY_ONLY as u32;
+        assert!(select_namespace(&key().offline(), &[value]).is_err());
+        let mut value = group();
+        value.local_domain = false;
+        assert!(select_namespace(&key().offline(), &[value]).is_err());
+        let mut value = group();
+        value.kind = SidTypeUser;
+        assert!(select_namespace(&key().offline(), &[value]).is_err());
+    }
+    #[test]
+    fn namespace_coordination_handles_non_account_domain_sids() {
+        fn sid(authority: u8, parts: &[u32]) -> Vec<u8> {
+            let mut value = vec![1, parts.len() as u8, 0, 0, 0, 0, 0, authority];
+            for part in parts {
+                value.extend_from_slice(&part.to_le_bytes());
+            }
+            value
+        }
+        let user = sid(5, &[21, 1, 2, 3, 1001]);
+        assert!(same_domain(&user, &sid(5, &[21, 1, 2, 3, 1014])).unwrap());
+        assert!(!same_domain(&user, &sid(5, &[21, 1, 2, 4, 1014])).unwrap());
+        for other in [sid(5, &[32, 545]), sid(5, &[5, 1, 2]), sid(15, &[3, 1])] {
+            assert!(!same_domain(&user, &other).unwrap());
+        }
+    }
+    #[test]
+    fn namespace_coordination_rejects_malformed_or_cross_namespace_labels() {
+        for name in [
+            "CodexAppDeepSeek-short".to_string(),
+            format!("CodexAppDeepSeek-{}", "A".repeat(64)),
+            key().group().to_uppercase(),
+            NamespaceKey::new("other", "owner").group(),
+        ] {
+            let mut value = group();
+            value.name = name;
+            assert!(select_namespace(&key().offline(), &[value]).is_err());
+        }
+    }
+    #[test]
+    fn service_role_does_not_confuse_packaged_owner_with_tool_accounts() {
+        assert!(!is_namespace_sandbox_role("normal_core_owner", &[]).unwrap());
+        assert!(is_namespace_sandbox_role(&key().offline(), &[group()]).unwrap());
+        assert!(is_namespace_sandbox_role(&key().online(), &[group()]).unwrap());
+        for attributes in [0, SE_GROUP_USE_FOR_DENY_ONLY as u32] {
+            let mut restricted = group();
+            restricted.attributes = attributes;
+            // Restrictions do not turn the account into a legitimate Core owner.
+            assert!(
+                is_namespace_sandbox_role(&key().offline(), std::slice::from_ref(&restricted))
+                    .unwrap()
+            );
+            assert!(
+                is_namespace_sandbox_role(&key().online(), std::slice::from_ref(&restricted))
+                    .unwrap()
+            );
+            // The same disabled membership still cannot authorize coordination.
+            assert!(select_namespace(&key().offline(), std::slice::from_ref(&restricted)).is_err());
+        }
+        // Another home's native key still classifies as a tool token; no target-home argument can adopt it.
+        let other =
+            NamespaceKey::for_directory("c:\\other-owned-home", "S-1-5-21-1-2-3-1001", 4, [8; 16]);
+        let mut other_group = group();
+        other_group.name = other.group();
+        assert!(is_namespace_sandbox_role(&other.offline(), &[other_group]).unwrap());
+        // A name alone is insufficient, and a conflicting observed namespace fails closed.
+        assert!(!is_namespace_sandbox_role(&key().offline(), &[]).unwrap());
+        assert!(is_namespace_sandbox_role("normal_core_owner", &[group()]).is_err());
+    }
+}
diff --git a/codex-rs/windows-sandbox-rs/src/namespace_key.rs b/codex-rs/windows-sandbox-rs/src/namespace_key.rs
new file mode 100644
index 0000000..0d1e5bc
--- /dev/null
+++ b/codex-rs/windows-sandbox-rs/src/namespace_key.rs
@@ -0,0 +1,241 @@
+//! Pure resource identity derivation. No Windows calls, filesystem writes, or process state.
+use sha2::{Digest, Sha256};
+
+const GROUP_PREFIX: &str = "CodexAppDeepSeek-";
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct NamespaceKey {
+    digest: [u8; 32],
+}
+impl NamespaceKey {
+    pub(crate) fn from_id(id: &str) -> Option<Self> {
+        Self::from_group_name(&format!("{GROUP_PREFIX}{id}"))
+    }
+    pub(crate) fn claims_group_name(name: &str) -> bool {
+        name.get(..GROUP_PREFIX.len())
+            .is_some_and(|prefix| prefix.eq_ignore_ascii_case(GROUP_PREFIX))
+    }
+    pub(crate) fn from_group_name(name: &str) -> Option<Self> {
+        let id = name.strip_prefix(GROUP_PREFIX)?;
+        if !is_namespace_id(id) {
+            return None;
+        }
+        let mut digest = [0; 32];
+        for (index, byte) in digest.iter_mut().enumerate() {
+            *byte = u8::from_str_radix(&id[index * 2..index * 2 + 2], 16).ok()?;
+        }
+        Some(Self { digest })
+    }
+    pub(crate) fn new(canonical_home: &str, owner_sid: &str) -> Self {
+        let mut hash = Sha256::new();
+        hash.update(b"codex-app-deepseek/windows-sandbox/v1\0");
+        for value in [canonical_home, owner_sid] {
+            hash.update((value.len() as u64).to_le_bytes());
+            hash.update(value.as_bytes());
+        }
+        Self {
+            digest: hash.finalize().into(),
+        }
+    }
+    pub(crate) fn for_directory(
+        canonical_home: &str,
+        owner_sid: &str,
+        volume: u64,
+        file_id: [u8; 16],
+    ) -> Self {
+        let id: String = file_id.iter().map(|byte| format!("{byte:02x}")).collect();
+        // A case-sensitive Windows directory can contain different objects whose lowercase
+        // paths match. Bind the actual canonical directory object as well as its spelling.
+        Self::new(&format!("{canonical_home}\0{volume:016x}:{id}"), owner_sid)
+    }
+    pub(crate) fn owns_state(
+        &self,
+        namespace: Option<&str>,
+        offline: Option<&str>,
+        online: Option<&str>,
+    ) -> bool {
+        namespace == Some(self.id().as_str())
+            && offline == Some(self.offline().as_str())
+            && online == Some(self.online().as_str())
+    }
+    pub(crate) fn id(&self) -> String {
+        self.digest
+            .iter()
+            .map(|byte| format!("{byte:02x}"))
+            .collect()
+    }
+    fn account_id(&self) -> String {
+        const ALPHABET: &[u8; 32] = b"abcdefghijklmnopqrstuvwxyz234567";
+        let mut value = 0_u128;
+        for byte in &self.digest[..10] {
+            value = (value << 8) | *byte as u128;
+        }
+        (0..16)
+            .rev()
+            .map(|n| ALPHABET[((value >> (n * 5)) & 31) as usize] as char)
+            .collect()
+    }
+    pub(crate) fn offline(&self) -> String {
+        format!("Cdx{}f", self.account_id())
+    }
+    pub(crate) fn online(&self) -> String {
+        format!("Cdx{}n", self.account_id())
+    }
+    pub(crate) fn group(&self) -> String {
+        format!("{GROUP_PREFIX}{}", self.id())
+    }
+    pub(crate) fn read_acl_mutex(&self) -> String {
+        read_acl_mutex_for_id(&self.id()).expect("digest is hex")
+    }
+    pub(crate) fn firewall(&self, original: &str) -> String {
+        format!("{original}-cdag-{}", self.id())
+    }
+    pub(crate) fn guid(&self, original: u128) -> u128 {
+        let mut hash = Sha256::new();
+        hash.update(b"codex-app-deepseek/windows-sandbox/wfp/v1\0");
+        hash.update(self.digest);
+        hash.update(original.to_be_bytes());
+        let bytes = hash.finalize();
+        let mut uuid: [u8; 16] = bytes[..16].try_into().expect("fixed digest size");
+        uuid[6] = (uuid[6] & 0x0f) | 0x80;
+        uuid[8] = (uuid[8] & 0x3f) | 0x80;
+        u128::from_be_bytes(uuid)
+    }
+}
+fn is_namespace_id(id: &str) -> bool {
+    id.len() == 64
+        && id
+            .bytes()
+            .all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase())
+}
+pub(crate) fn read_acl_mutex_for_id(id: &str) -> Option<String> {
+    is_namespace_id(id).then(|| format!(r"Local\CodexAppDeepSeekReadAcl-{id}"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn stable_identity() {
+        let a = NamespaceKey::new(r"c:\codex\home", "S-1-5-21-1-1001");
+        assert_eq!(a, NamespaceKey::new(r"c:\codex\home", "S-1-5-21-1-1001"));
+        assert_eq!(a.offline().len(), 20);
+        assert_eq!(a.online().len(), 20);
+        assert_ne!(a.offline(), a.online());
+        assert!(a.offline().bytes().all(|b| b.is_ascii_alphanumeric()));
+        assert_ne!(a.offline(), "CodexSandboxOffline");
+        assert_ne!(a.group(), "CodexSandboxUsers");
+    }
+    #[test]
+    fn every_resource_changes_with_home_and_owner() {
+        let a = NamespaceKey::new(r"c:\a", "S-1-5-21-1-1001");
+        for b in [
+            NamespaceKey::new(r"c:\b", "S-1-5-21-1-1001"),
+            NamespaceKey::new(r"c:\a", "S-1-5-21-1-1002"),
+        ] {
+            assert_ne!(a.id(), b.id());
+            assert_ne!(a.offline(), b.offline());
+            assert_ne!(a.online(), b.online());
+            assert_ne!(a.group(), b.group());
+            assert_ne!(a.read_acl_mutex(), b.read_acl_mutex());
+            assert_ne!(a.firewall("rule"), b.firewall("rule"));
+            assert_ne!(a.guid(1), b.guid(1));
+        }
+    }
+    #[test]
+    fn resource_classes_and_input_boundaries_do_not_alias() {
+        let a = NamespaceKey::new("ab", "c");
+        let b = NamespaceKey::new("a", "bc");
+        assert_ne!(a, b);
+        assert_ne!(a.guid(1), a.guid(2));
+        assert_ne!(a.firewall("a"), a.firewall("b"));
+        assert_eq!((a.guid(1) >> 76) & 15, 8);
+        assert_eq!((a.guid(1) >> 62) & 3, 2);
+    }
+    #[test]
+    fn marker_cannot_choose_arbitrary_named_object() {
+        for id in [
+            "",
+            "Global\\CodexSandboxSetup",
+            &"0".repeat(63),
+            &"G".repeat(64),
+            &"A".repeat(64),
+        ] {
+            assert!(read_acl_mutex_for_id(id).is_none());
+        }
+    }
+}
+
+#[cfg(test)]
+mod isolation_regressions {
+    use super::*;
+    #[test]
+    fn fixed_version_identity_vector() {
+        let key = NamespaceKey::new(r"c:\codex\home", "S-1-5-21-1-1001");
+        assert_eq!(
+            key.id(),
+            "bb0079331ec29687adf304fda911f1cb63faea80e3926c1f11c05322c0bfde08"
+        );
+    }
+    #[test]
+    fn legacy_missing_cross_home_and_swapped_state_are_rejected() {
+        let key = NamespaceKey::new(r"c:\codex\home", "S-1-5-21-1-1001");
+        let other = NamespaceKey::new(r"c:\codex\other", "S-1-5-21-1-1001");
+        assert!(key.owns_state(Some(&key.id()), Some(&key.offline()), Some(&key.online())));
+        assert!(!key.owns_state(
+            None,
+            Some("CodexSandboxOffline"),
+            Some("CodexSandboxOnline")
+        ));
+        assert!(!key.owns_state(
+            Some(&other.id()),
+            Some(&other.offline()),
+            Some(&other.online())
+        ));
+        assert!(!key.owns_state(Some(&key.id()), Some(&key.online()), Some(&key.offline())));
+        assert!(!key.owns_state(Some(&key.id()), None, Some(&key.online())));
+    }
+    #[test]
+    fn every_fixed_native_wfp_object_is_disjoint() {
+        let native: [u128; 14] = [
+            0x9f5f3812_79f0_4fe9_9615_4c2c92d2f0ff,
+            0x87498484_45ab_4510_845e_ece8b791b3bc,
+            0xaf4751de_f874_4a7b_a34d_f0d0f22d1d9b,
+            0xea10db66_a928_4b2e_a82e_a376a54f93ba,
+            0x83172805_f6be_4ae1_9dc6_6847aef04e7f,
+            0xd23b2efb_1efb_46b2_96f3_b0ccda5690c8,
+            0x420b026f_9dc9_4aea_88f4_0f2b9feab39a,
+            0x8d917c81_99cc_45e7_84d6_824df860cfb8,
+            0xe1d6e0af_ce5f_471b_b2d3_15ca00e966f3,
+            0xc2bceca4_66ef_4a0f_ba80_f4f761b8c6f0,
+            0xba10c618_84e7_4b83_8f74_36e22b2fa1ff,
+            0xfe7f22b8_5cf5_4adb_b2aa_71fc0a8f5d44,
+            0x2e31d31c_3948_4753_9117_e5d1a6496f41,
+            0xe65054fd_4d32_4c7c_95ef_621f0cf6431a,
