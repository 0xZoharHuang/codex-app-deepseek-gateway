+async fn capacity_install_append_failure_fences_session_and_preserves_exact_pending_suffix() {
+    let (mut session, turn_context) = make_session_and_context().await;
+    attach_thread_persistence(&mut session).await;
+    let old = ResponseItemEnvelope::new(user_message("confirmed history"));
+    let pending = ResponseItemEnvelope::new(user_message("legacy pending without id"));
+    assert!(pending.item.id().is_none());
+    let (generation, anchor, old, pending) = {
+        let mut state = session.state.lock().await;
+        state
+            .history
+            .replace_annotated(vec![old.clone(), pending.clone()]);
+        (
+            state.history.history_version(),
+            session.current_window_from_state(&state).0,
+            state.history.annotated_items()[0].clone(),
+            state.history.annotated_items()[1].clone(),
+        )
+    };
+    session
+        .live_thread()
+        .expect("test thread persistence")
+        .shutdown()
+        .await
+        .expect("close the test writer to force append failure");
+    let cancellation = CancellationToken::new();
+    let mut receipt = None;
+    let installed = session
+        .replace_compacted_history(
+            vec![ResponseItemEnvelope::new(user_message(
+                "replacement prefix",
+            ))],
+            turn_context.to_turn_context_item(),
+            WorldStateSnapshot::default(),
+            /*rejected_audio_file_ids*/ Default::default(),
+            CompactedHistoryInstallation::Prefix {
+                prefix: CompactionPrefix {
+                    generation,
+                    len: 1,
+                    auth_owner_generation: session.services.model_client.auth_owner_generation(),
+                },
+                prefix_context: Vec::new(),
+                initial_context: Vec::new(),
+                model_info: turn_context.model_info(),
+                compaction_response_id: Some("test-compaction-response".into()),
+                reviewer_compaction_hash: None,
+                turn_context: &turn_context,
+                started_item: None,
+                capacity_commit: Some(capacity_recovery::CapacityCommit {
+                    install_hash: capacity_recovery::exact_history_hash(&[old]).unwrap(),
+                    history_anchor: &anchor,
+                    cancellation_token: &cancellation,
+                    preempt: None,
+                    new_context_window: false,
+                    installed: &mut receipt,
+                }),
+            },
+        )
+        .await;
+    assert!(!installed);
+    let receipt = receipt.expect("live prefix install preceded the failed append");
+    assert_eq!(receipt.history.annotated_items().last(), Some(&pending));
+    assert_eq!(
+        session.clone_history().await.annotated_items().last(),
