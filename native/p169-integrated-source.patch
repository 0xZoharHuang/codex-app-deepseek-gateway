+    use serde_json::json;
+
+    #[test]
+    fn projected_image_views_keep_atomic_labels_and_positional_provenance() -> anyhow::Result<()> {
+        let image = |id: &str| -> anyhow::Result<_> {
+            Ok(AnnotatedContent::from_parts(
+                serde_json::from_value(json!({
+                    "type": "input_image", "file_id": id, "detail": "high"
+                }))?,
+                ContentItemKind("capacity-image-source".to_owned()),
+                ContentItemMetadata::harness(),
+            ))
+        };
+        let label = |text| {
+            AnnotatedContent::text(
+                text,
+                ContentItemKind("capacity-image-label".to_owned()),
+                ContentItemMetadata::harness(),
+            )
+        };
+        let parts = vec![
+            label(image_open_tag_text()),
+            image("first-file")?,
+            label(image_close_tag_text()),
+            label(image_open_tag_text()),
+            image("second-file")?,
+            label(image_close_tag_text()),
+        ];
+        let mut source = ResponseItemEnvelope::new(message_from_parts("user", parts.clone()));
+        source.set_turn_id_if_missing("original-turn");
+        source.metadata = Some(codex_history::CodexHarnessMetadata {
+            client_authored: true,
+            ..Default::default()
+        });
+        let original = [source.clone()];
+        let (left, right) = Projection::whole(0..1)
+            .split(&original, "current-turn", 0)
+            .ok_or_else(|| anyhow::anyhow!("unavailable typed image projection"))?;
+        for (projection, expected) in [(left, &parts[..3]), (right, &parts[3..])] {
+            let mut projected = projection
+                .items(&original)
+                .ok_or_else(|| anyhow::anyhow!("projection lost typed content"))?;
+            assert_eq!(projected[0].metadata, source.metadata);
+            assert_eq!(
+                to_annotated_content(&mut projected[0].item).as_deref(),
+                Some(expected)
+            );
+            assert!(projection.split(&original, "current-turn", 0).is_none());
+        }
+        assert_eq!(original[0], source);
+        assert!(
+            Projection::whole(0..1)
+                .split(&original, "original-turn", 0)
+                .is_none()
+        );
+        assert!(
+            Projection::whole(0..1)
+                .split(&original, "original-turn", 1)
+                .is_some()
+        );
+        Ok(())
+    }
+
+    #[test]
+    fn projected_completed_tool_pair_keeps_ids_and_utf8_coverage() -> anyhow::Result<()> {
+        let mut call = ResponseItemEnvelope::new(serde_json::from_value(json!({
+            "type": "function_call", "name": "read", "arguments": "{}", "call_id": "call_test"
+        }))?);
+        let mut output = ResponseItemEnvelope::new(serde_json::from_value(json!({
+            "type": "function_call_output", "call_id": "call_test", "output": "甲乙丙丁"
+        }))?);
+        for envelope in [&mut call, &mut output] {
+            envelope.set_turn_id_if_missing("older-turn");
+        }
+        let original = [call.clone(), output];
+        let (left, right) = Projection::whole(0..2)
+            .split(&original, "current-turn", 0)
+            .ok_or_else(|| anyhow::anyhow!("unavailable typed tool projection"))?;
+        let mut reassembled = String::new();
+        for projection in [left, right] {
+            let sent = projection
+                .items(&original)
+                .ok_or_else(|| anyhow::anyhow!("projection lost the completed tool pair"))?;
+            assert_eq!(sent[0], call);
+            let ResponseItem::FunctionCallOutput {
+                call_id: Some(call_id),
+                output,
+                ..
+            } = &sent[1].item
+            else {
+                anyhow::bail!("projected output changed type");
+            };
+            assert_eq!(call_id, "call_test");
+            let FunctionCallOutputBody::Text(text) = &output.body else {
+                anyhow::bail!("projected output changed body type");
+            };
+            reassembled.push_str(text);
+        }
+        assert_eq!(reassembled, "甲乙丙丁");
+        Ok(())
+    }
+}
