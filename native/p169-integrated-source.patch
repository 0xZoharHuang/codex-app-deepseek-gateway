+        .unwrap();
+    let changed = Migrator::with_migrations(vec![Migration::new(
+        1,
+        "changed SQL".into(),
+        sqlx::migrate::MigrationType::Simple,
+        "CREATE TABLE content_changed(value TEXT);".into_sql_str(),
+        false,
+    )]);
+    let error = super::runtime_migrator_for_database(&pool, &changed, false, false)
+        .await
+        .unwrap_err();
+    assert!(matches!(
+        error,
+        sqlx::migrate::MigrateError::VersionMismatch(1)
+    ));
+    pool.close().await;
