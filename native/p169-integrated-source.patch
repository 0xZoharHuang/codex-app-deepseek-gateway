+    for dirty in [false, true] {
+        let pool = eol_pool().await;
+        let legacy = eol_migrator(&super::QUEUE_MIGRATOR, false);
+        legacy.run(&pool).await.unwrap();
+        if dirty {
+            sqlx::query("UPDATE _sqlx_migrations SET success=0 WHERE version=1")
+                .execute(&pool)
+                .await
+                .unwrap();
+        } else {
+            sqlx::query("UPDATE _sqlx_migrations SET checksum=zeroblob(48) WHERE version=1")
+                .execute(&pool)
+                .await
+                .unwrap();
+        }
+        let before = eol_ledger(&pool).await;
+        let canonical = super::runtime_migrator(&super::QUEUE_MIGRATOR);
+        let error = super::runtime_migrator_for_database(&pool, &canonical, false, false)
+            .await
+            .unwrap_err();
+        assert!(matches!(error, sqlx::migrate::MigrateError::Dirty(1)) == dirty);
+        assert!(matches!(error, sqlx::migrate::MigrateError::VersionMismatch(1)) != dirty);
+        assert_eq!(eol_ledger(&pool).await, before);
+        pool.close().await;
+    }
+    let pool = eol_pool().await;
+    eol_migrator(&super::QUEUE_MIGRATOR, false)
+        .run(&pool)
