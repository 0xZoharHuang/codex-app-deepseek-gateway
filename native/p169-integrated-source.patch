+/// Missing lazy stores inherit an already established LF primary profile.
+pub(crate) async fn profile_uses_legacy_lf(pool: &SqlitePool) -> Result<bool, MigrateError> {
+    let base = runtime_state_migrator();
+    let mut connection = pool.acquire().await?;
+    let compatible = runtime_migrator_for_connection(&mut connection, &base, true, false).await?;
+    Ok(compatible
+        .iter()
+        .all(|migration| migration.checksum == migration_form(migration, false).checksum))
