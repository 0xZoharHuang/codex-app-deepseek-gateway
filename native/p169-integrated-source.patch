+pub(crate) struct CapacityInstallReceipt {
+    pub(crate) history: ContextManager,
+    pub(crate) anchor: String,
+    pub(crate) prefix_len: usize,
+}
+
+impl CapacityRecovery {
+    pub(crate) fn with_old_gap_for_summary(mut self) -> anyhow::Result<Option<Self>> {
+        let Some(gap) = self.old_gap.take() else {
+            return Ok(None);
+        };
+        let mut items = self.history.annotated_items().to_vec();
+        items.extend(gap.entries);
+        self.prefix.len = items.len();
+        self.install_hash = exact_history_hash(&items)?;
+        self.prefix_bytes = serialized_item_bytes(items.iter().map(|entry| &entry.item))?;
+        self.history.replace_annotated(items);
+        self.permit_token_reset = false;
+        Ok(Some(self))
+    }
+
+    pub(crate) fn history_anchor(&self) -> &str {
+        match &self.authority {
+            CapacityAuthority::Confirmed(checkpoint) => &checkpoint.binding.history_anchor,
+            CapacityAuthority::Manual { anchor, .. } => anchor,
+        }
+    }
+
+    pub(crate) fn is_manual(&self) -> bool {
+        matches!(&self.authority, CapacityAuthority::Manual { .. })
+    }
+
+    pub(crate) fn select_manual_prefix(
+        &mut self,
+        source: &ContextManager,
+        len: usize,
+    ) -> anyhow::Result<()> {
+        let selected = &source.annotated_items()[..len];
+        self.prefix.len = len;
+        self.install_hash = exact_history_hash(selected)?;
+        self.history.replace_annotated(selected.to_vec());
+        Ok(())
+    }
+
+    /// Translate the exact admitted source only after the native append and
+    /// flush succeeded. A compactor response never opens a new completion epoch.
+    pub(crate) async fn publish_install(
+        self,
+        step: &StepContext,
+        thread: codex_protocol::ThreadId,
+        installed: CapacityInstallReceipt,
+        token_reset: bool,
+        model_response_id: Option<String>,
+    ) -> CapacityRecoveryOutcome {
+        let home = step.turn.config.codex_home.clone();
+        let model = step.settings.model_info.slug.clone();
+        let provider = step.turn.config.model_provider_id.clone();
+        let result = tokio::task::spawn_blocking(move || -> anyhow::Result<_> {
+            let checkpoint = match self.authority {
+                CapacityAuthority::Confirmed(checkpoint) => {
+                    translate_checkpoint(&home, &checkpoint, &installed)?
+                }
+                CapacityAuthority::Manual { total, .. } => {
+                    publish_manual_checkpoint(
+                        &home,
+                        &thread.to_string(),
+                        &model,
+                        &provider,
+                        &installed,
+                        model_response_id
+                            .as_deref()
+                            .ok_or_else(|| anyhow::anyhow!("missing completed manual response"))?,
+                        self.prefix.len < total,
+                    )?;
+                    return Ok(None);
+                }
+            };
+            let proof = self.old_gap.filter(|gap| {
+                token_reset
+                    && checkpoint.recovery_turn_id.as_deref().is_some_and(|turn| {
+                        gap.matches(
+                            installed.history.annotated_items(),
+                            installed.prefix_len,
+                            turn,
+                        )
+                    })
+            });
+            Ok(proof.map(|old_gap| CapacityContinuation {
+                checkpoint,
+                generation: installed.history.history_version(),
+                auth_owner_generation: self.prefix.auth_owner_generation,
+                old_gap,
+            }))
+        })
+        .await;
+        match result {
+            Ok(Ok(continuation)) => CapacityRecoveryOutcome::Installed(continuation),
+            Ok(Err(error)) => CapacityRecoveryOutcome::PersistenceFailed(CodexErr::Fatal(format!(
+                "Failed to publish request-capacity checkpoint: {error}"
+            ))),
+            Err(error) => CapacityRecoveryOutcome::PersistenceFailed(CodexErr::Fatal(format!(
+                "Request-capacity checkpoint publication task failed: {error}"
+            ))),
+        }
+    }
+}
+
+impl OldGap {
+    fn capture(items: &[ResponseItemEnvelope], start: usize, turn: &str) -> Option<Self> {
+        let end = items
+            .iter()
+            .position(|envelope| envelope.item.turn_id() == Some(turn))?;
+        if start >= end || end > MAX_RECOVERY_PREFIX_ITEMS || pair_safe_prefix(items, end) != end {
+            return None;
+        }
+        let entries = &items[start..end];
+        if !Self::all_old(entries, turn)
+            || serialized_item_bytes(items[..end].iter().map(|envelope| &envelope.item)).ok()?
+                > MAX_RECOVERY_PREFIX_BYTES
+        {
+            return None;
+        }
+        Some(Self {
+            entries: entries.to_vec(),
+            hash: exact_history_hash(entries).ok()?,
+        })
+    }
+
+    fn all_old(items: &[ResponseItemEnvelope], turn: &str) -> bool {
+        items
+            .iter()
+            .all(|envelope| envelope.item.turn_id().is_some_and(|id| id != turn))
+    }
+
+    fn matches(&self, items: &[ResponseItemEnvelope], start: usize, turn: &str) -> bool {
+        let Some(end) = start.checked_add(self.entries.len()) else {
+            return false;
+        };
+        let Some(gap) = items.get(start..end) else {
+            return false;
+        };
+        gap == self.entries.as_slice()
+            && Self::all_old(gap, turn)
+            && exact_history_hash(gap).ok() == Some(self.hash)
+            && pair_safe_prefix(items, end) == end
+    }
+}
+
+/// The output's internal success flag is deliberately absent from the wire serializer.
+pub(super) fn exact_history_hash(items: &[ResponseItemEnvelope]) -> serde_json::Result<[u8; 32]> {
+    struct HashWriter(Sha256);
+    impl Write for HashWriter {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            self.0.update(bytes);
+            Ok(bytes.len())
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let mut writer = HashWriter(Sha256::new());
+    for envelope in items {
+        let success = match &envelope.item {
+            ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } => output.success,
+            _ => None,
+        };
+        serde_json::to_writer(&mut writer, &(&envelope.item, &envelope.metadata, success))?;
+        writer.0.update(b"\n");
+    }
+    Ok(writer.0.finalize().into())
+}
+
+fn translate_checkpoint(
+    home: &Path,
+    old: &request_capacity::Checkpoint,
+    installed: &CapacityInstallReceipt,
+) -> anyhow::Result<request_capacity::Checkpoint> {
+    let binding = request_capacity::Binding::for_profile(
+        home,
+        &old.binding.thread_id,
+        &old.binding.model,
+        &old.binding.provider,
+        &installed.anchor,
+    )?;
+    anyhow::ensure!(
+        old.binding.same_sampling_scope(&binding) && old.binding.history_anchor != installed.anchor,
+        "request-capacity install changed sampling scope"
+    );
+    let items = installed.history.annotated_items();
+    anyhow::ensure!(
+        installed.prefix_len > 0
+            && installed.prefix_len == pair_safe_prefix(items, installed.prefix_len),
+        "request-capacity install has no pair-safe translated prefix"
+    );
+    let checkpoint = request_capacity::Checkpoint {
+        binding,
+        prefix_len: installed.prefix_len,
+        prefix_hash: request_capacity::prefix_hash(&items[..installed.prefix_len])?,
+        response_id: old.response_id.clone(),
+        completed_epoch: old.completed_epoch,
+        recovery_turn_id: old.recovery_turn_id.clone(),
+        origin: request_capacity::Origin::TranslatedPrefix,
+    };
+    request_capacity::save_if_current(home, &checkpoint, old)?;
+    Ok(checkpoint)
+}
+
+fn publish_manual_checkpoint(
+    home: &Path,
+    thread: &str,
+    model: &str,
+    provider: &str,
+    installed: &CapacityInstallReceipt,
+    response_id: &str,
+    partitioned: bool,
+) -> anyhow::Result<()> {
+    let binding =
+        request_capacity::Binding::for_profile(home, thread, model, provider, &installed.anchor)?;
+    if let Some(previous) = request_capacity::previous_checkpoint_for_lineage(home, &binding)? {
+        // Fresh manual coverage authorizes the new prefix. The prior record
+        // supplies lineage only; it never re-arms the old ordinary epoch.
+        translate_checkpoint(home, &previous, installed)?;
+        return Ok(());
+    }
+    let items = installed.history.annotated_items();
+    anyhow::ensure!(
+        installed.prefix_len > 0
+            && installed.prefix_len == pair_safe_prefix(items, installed.prefix_len),
+        "manual compaction has no pair-safe installed prefix"
+    );
+    request_capacity::save(
+        home,
+        &request_capacity::Checkpoint {
+            binding,
+            prefix_len: installed.prefix_len,
+            prefix_hash: request_capacity::prefix_hash(&items[..installed.prefix_len])?,
+            response_id: response_id.to_owned(),
+            completed_epoch: 0,
+            recovery_turn_id: None,
+            origin: if partitioned {
+                request_capacity::Origin::ManualPrefixGenesis
+            } else {
+                request_capacity::Origin::FullManualGenesis
+            },
+        },
+    )
+}
+
+/// Admission checked at the native install linearization point, not when the
+/// summary request is launched. The existing Prefix installation remains the
+/// sole mutator of the live annotated history.
+pub(crate) struct CapacityCommit<'a> {
+    pub(crate) install_hash: [u8; 32],
+    pub(crate) history_anchor: &'a str,
+    pub(crate) cancellation_token: &'a CancellationToken,
+    pub(crate) preempt: Option<&'a CancellationToken>,
+    pub(crate) new_context_window: bool,
+    pub(crate) installed: &'a mut Option<CapacityInstallReceipt>,
+}
+
+#[derive(Clone, Copy, Eq, Hash, PartialEq)]
+enum PairKind {
+    Function,
+    ToolSearch,
+    Custom,
+}
+
+fn pair_endpoint(item: &ResponseItem) -> Option<(PairKind, &str, bool)> {
+    match item {
+        ResponseItem::FunctionCall { call_id, .. }
+        | ResponseItem::LocalShellCall {
+            call_id: Some(call_id),
+            ..
+        } => Some((PairKind::Function, call_id, true)),
+        ResponseItem::FunctionCallOutput {
+            call_id: Some(call_id),
+            ..
+        } => Some((PairKind::Function, call_id, false)),
+        ResponseItem::ToolSearchCall {
+            call_id: Some(call_id),
+            ..
+        } => Some((PairKind::ToolSearch, call_id, true)),
+        ResponseItem::ToolSearchOutput {
+            call_id: Some(call_id),
+            execution,
+            ..
+        } if execution != "server" => Some((PairKind::ToolSearch, call_id, false)),
+        ResponseItem::CustomToolCall { call_id, .. } => Some((PairKind::Custom, call_id, true)),
+        ResponseItem::CustomToolCallOutput { call_id, .. } => {
+            Some((PairKind::Custom, call_id, false))
+        }
+        _ => None,
+    }
+}
+
+pub(crate) fn pair_safe_prefix(items: &[ResponseItemEnvelope], proposed: usize) -> usize {
+    let mut pairs = HashMap::<_, (Option<usize>, Option<usize>)>::new();
+    for (index, envelope) in items.iter().enumerate() {
+        if let Some((kind, id, call)) = pair_endpoint(&envelope.item) {
+            let endpoints = pairs.entry((kind, id)).or_default();
+            let slot = if call {
+                &mut endpoints.0
+            } else {
+                &mut endpoints.1
+            };
+            if slot.replace(index).is_some() {
+                return 0;
+            }
+        }
+    }
+    let mut cut = proposed.min(items.len());
+    loop {
+        let previous = cut;
+        for &(call, output) in pairs.values() {
+            match (call, output) {
+                (Some(call), Some(output)) if call < output => {
+                    if call < cut && output >= cut {
+                        cut = call;
+                    }
+                }
+                (Some(call), Some(output)) => cut = cut.min(call.min(output)),
+                (Some(call), None) => cut = cut.min(call),
+                (None, Some(output)) => cut = cut.min(output),
+                (None, None) => {}
+            }
+        }
+        if previous == cut {
+            return cut;
+        }
+    }
+}
+
+pub(crate) fn manual_prefix_has_input(items: &[ResponseItemEnvelope]) -> bool {
+    items.iter().any(|envelope| {
+        crate::compact::is_real_user_or_agent_message(&envelope.item)
+            || matches!(
+                envelope.item,
+                ResponseItem::FunctionCallOutput { .. }
+                    | ResponseItem::CustomToolCallOutput { .. }
+                    | ResponseItem::ToolSearchOutput { .. }
+            )
+    })
+}
+
+#[derive(Default)]
+struct CountBytes(usize);
+impl Write for CountBytes {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        self.0 = self.0.saturating_add(bytes.len());
+        Ok(bytes.len())
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+pub(crate) fn serialized_json_bytes(value: &impl serde::Serialize) -> serde_json::Result<usize> {
+    let mut size = CountBytes::default();
+    serde_json::to_writer(&mut size, value)?;
+    Ok(size.0)
+}
+
+pub(crate) fn serialized_item_bytes<'a>(
+    items: impl IntoIterator<Item = &'a ResponseItem>,
+) -> serde_json::Result<usize> {
+    let mut size = CountBytes::default();
+    for item in items {
+        serde_json::to_writer(&mut size, item)?;
+    }
+    Ok(size.0)
+}
+
+fn old_prefix_len(items: &[ResponseItemEnvelope], confirmed: usize) -> Option<usize> {
+    // A real prior completion can confirm earlier sampling steps in this turn.
+    // The exact checkpoint boundary still excludes every unsent input item.
+    let limit = confirmed.min(items.len()).min(MAX_RECOVERY_PREFIX_ITEMS);
+    // An unlabelled real input or tool cannot be proved old merely because
+    // it precedes the first explicit current-turn item in restored history.
+    let limit = items[..limit]
+        .iter()
+        .position(|envelope| {
+            envelope.item.turn_id().is_none()
+                && (crate::compact::is_real_user_or_agent_message(&envelope.item)
+                    || pair_endpoint(&envelope.item).is_some())
+        })
+        .unwrap_or(limit);
+    let mut size = CountBytes::default();
+    let mut cut = 0;
+    for envelope in &items[..limit] {
+        serde_json::to_writer(&mut size, &envelope.item).ok()?;
+        if size.0 > MAX_RECOVERY_PREFIX_BYTES {
+            break;
+        }
+        cut += 1;
+    }
+    let cut = pair_safe_prefix(items, cut);
+    // Refuse zero progress and context-only prefixes. The live suffix is never
+    // recoded, squeezed, or treated as input proven by the old completion.
+    items[..cut]
+        .iter()
+        .any(|envelope| crate::compact::is_real_user_or_agent_message(&envelope.item))
+        .then_some(cut)
+}
+
+#[derive(PartialEq)]
+enum Media<'a> {
+    Image(&'a ImageReference, Option<ImageDetail>),
+    Audio(&'a AudioReference),
+    ToolAudio(&'a AudioReference),
+    GeneratedImage(&'a ResponseItem),
+}
+
+type MediaSlot<'a> = (usize, usize, Media<'a>);
+fn media_slots<'a>(items: impl Iterator<Item = &'a ResponseItem>) -> Vec<MediaSlot<'a>> {
+    let mut slots = Vec::new();
+    for (item_index, item) in items.enumerate() {
+        match item {
+            ResponseItem::Message { content, .. } => {
+                for (content_index, part) in content.iter().enumerate() {
+                    let media = match part {
+                        ContentItem::InputImage { image, detail } => Media::Image(image, *detail),
+                        ContentItem::InputAudio { audio } => Media::Audio(audio),
+                        _ => continue,
+                    };
+                    slots.push((item_index, content_index, media));
+                }
+            }
+            ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } => {
+                if let Some(content) = output.content_items() {
+                    for (content_index, part) in content.iter().enumerate() {
+                        let media = match part {
+                            FunctionCallOutputContentItem::InputImage { image, detail } => {
+                                Media::Image(image, *detail)
+                            }
+                            FunctionCallOutputContentItem::InputAudio { audio } => {
+                                Media::ToolAudio(audio)
+                            }
+                            _ => continue,
+                        };
+                        slots.push((item_index, content_index, media));
+                    }
+                }
+            }
+            ResponseItem::ImageGenerationCall { .. } => {
+                slots.push((item_index, 0, Media::GeneratedImage(item)));
+            }
+            _ => {}
+        }
+    }
+    slots
+}
+
+pub(crate) fn same_media_slots<'a>(
+    history: impl Iterator<Item = &'a ResponseItem>,
+    wire: &[ResponseItem],
+) -> bool {
+    media_slots(history) == media_slots(wire.iter())
+}
+
+#[derive(Default)]
+pub(crate) struct CapacityPersistenceFault {
+    cause: OnceLock<String>,
+    pub(super) close: CancellationToken,
+}
+
+impl Session {
+    pub(crate) fn fence_capacity_persistence(&self, cause: impl Into<String>) {
+        let _ = self.capacity_persistence_fault.cause.set(cause.into());
+    }
+
+    pub(crate) fn capacity_persistence_faulted(&self) -> bool {
+        self.capacity_persistence_fault.cause.get().is_some()
+    }
+
+    pub(crate) fn capacity_persistence_error(&self) -> Option<CodexErr> {
+        self.capacity_persistence_fault.cause.get().map(|cause| {
+            CodexErr::Fatal(format!(
+                "Request-capacity compaction could not verify saved history. Reopen this thread to recover from its rollout. {cause}"
+            ))
+        })
+    }
+
+    pub(crate) fn close_faulted_capacity_session(&self) {
+        if self.capacity_persistence_faulted() {
+            self.capacity_persistence_fault.close.cancel();
+        }
+    }
+
+    pub(crate) async fn close_faulted_capacity_session_if_idle(&self) {
+        if self.capacity_persistence_faulted() && self.active_turn.lock().await.is_none() {
+            self.close_faulted_capacity_session();
+        }
+    }
+
+    pub(crate) async fn acquire_capacity_persistence_boundary(
+        &self,
+    ) -> Result<tokio::sync::SemaphorePermit<'_>, tokio::sync::AcquireError> {
+        self.code_mode_message_tasks
+            .communication_boundary
+            .acquire()
+            .await
+    }
+
+    pub(crate) async fn capture_capacity_send(
+        &self,
+        step: &StepContext,
+        history: &ContextManager,
+    ) -> Option<CapacitySend> {
+        self.live_thread()?;
+        if crate::guardian::is_basic_session_source(&step.turn.session_source) {
+            return None;
+        }
+        let state = self.state.lock().await;
+        let generation = history.history_version();
+        if state.history.history_version() != generation {
+            return None;
+        }
+        Some(CapacitySend {
+            history: history.clone(),
+            anchor: self.current_window_from_state(&state).0,
+            generation,
+            auth_owner_generation: self.services.model_client.auth_owner_generation(),
+        })
+    }
+
+    pub(crate) async fn confirm_capacity_send(
+        self: &Arc<Self>,
+        step: &Arc<StepContext>,
+        sent: &CapacitySend,
+        response_id: &str,
+    ) {
+        let Some(token) = self.track_code_mode_message() else {
+            return;
+        };
+        let session = Arc::clone(self);
+        let step = Arc::clone(step);
+        let history = sent.history.clone();
+        let anchor = sent.anchor.clone();
+        let generation = sent.generation;
+        let auth_owner = sent.auth_owner_generation;
+        let response_id = response_id.to_owned();
+        let task = tokio::spawn(async move {
+            let _admission = token;
+            // Code Mode delivery reserves history before persisting its record.
+            // Take the existing boundary first so the flush cannot overtake it.
+            let _communication = session.acquire_capacity_persistence_boundary().await?;
+            let _settings_guard = thread_settings::acquire_persistence_lock(&session).await;
+            if session.state.lock().await.history.history_version() != generation
+                || session.services.model_client.auth_owner_generation() != auth_owner
+                || session.live_thread().is_none()
+            {
+                return Ok::<(), anyhow::Error>(());
+            }
+            session.flush_rollout().await?;
+            let home = step.turn.config.codex_home.clone();
+            let model = step.settings.model_info.slug.clone();
+            let provider = step.turn.config.model_provider_id.clone();
+            let thread = session.thread_id.to_string();
+            tokio::task::spawn_blocking(move || {
+                let binding = request_capacity::Binding::for_profile(
+                    &home, &thread, &model, &provider, &anchor,
+                )?;
+                let items = history.annotated_items();
+                let len = pair_safe_prefix(items, items.len());
+                if len == 0 {
+                    return Ok(());
+                }
+                let epoch = request_capacity::previous_epoch(&home, &binding)?
+                    .checked_add(1)
+                    .ok_or_else(|| anyhow::anyhow!("request-capacity epoch exhausted"))?;
+                request_capacity::save(
+                    &home,
+                    &request_capacity::Checkpoint {
+                        binding,
+                        prefix_len: len,
+                        prefix_hash: request_capacity::prefix_hash(&items[..len])?,
+                        response_id,
+                        completed_epoch: epoch,
+                        recovery_turn_id: None,
+                        origin: request_capacity::Origin::OrdinaryCompleted,
+                    },
+                )
+            })
+            .await?
+        });
+        if !matches!(task.await, Ok(Ok(()))) {
+            tracing::warn!("request-capacity completion checkpoint was not published");
+        }
+    }
+
+    pub(crate) async fn prepare_manual_capacity(
+        &self,
+        step: &StepContext,
+        source: &ContextManager,
+    ) -> anyhow::Result<Option<CapacityRecovery>> {
+        if self.live_thread().is_none()
+            || crate::guardian::is_basic_session_source(&step.turn.session_source)
+            || source.annotated_items().is_empty()
+        {
+            return Ok(None);
+        }
+        let sent = self
+            .capture_capacity_send(step, source)
+            .await
+            .ok_or_else(|| {
+                anyhow::anyhow!("Manual compaction history changed before it could be captured")
+            })?;
+        let source = source.clone();
+        tokio::task::spawn_blocking(move || {
+            let items = source.annotated_items();
+            let len = pair_safe_prefix(items, items.len());
+            anyhow::ensure!(
+                len > 0 && manual_prefix_has_input(&items[..len]),
+                "Manual compaction has no complete model input prefix. The unfinished history was preserved."
+            );
+            let selected = &items[..len];
+            let install_hash = exact_history_hash(selected)?;
+            let mut history = source.clone();
+            history.replace_annotated(selected.to_vec());
+            Ok(Some(CapacityRecovery {
+                history,
+                prefix: CompactionPrefix {
+                    generation: sent.generation,
+                    len,
+                    auth_owner_generation: sent.auth_owner_generation,
+                },
+                install_hash,
+                prefix_bytes: 0,
+                confirmed_len: 0,
+                authority: CapacityAuthority::Manual { anchor: sent.anchor, total: items.len() },
+                permit_token_reset: false,
+                old_gap: None,
+            }))
+        }).await?
+    }
+
+    /// Consumes the single in-memory proof on the next ordinary capacity
+    /// rejection. A resumed process cannot continue the unconfirmed old gap.
+    pub(crate) async fn load_capacity_continuation(
+        &self,
+        step: &StepContext,
+        sent: &CapacitySend,
+        proof: CapacityContinuation,
+    ) -> Option<CapacityRecovery> {
+        let turn = &step.turn.sub_id;
+        let checkpoint = proof.checkpoint;
+        if checkpoint.origin != request_capacity::Origin::TranslatedPrefix
+            || checkpoint.recovery_turn_id.as_deref() != Some(turn.as_str())
+            || checkpoint.binding.history_anchor != sent.anchor
+            || proof.generation != sent.generation
+            || proof.auth_owner_generation != sent.auth_owner_generation
+            || self.services.model_client.auth_owner_generation() != sent.auth_owner_generation
+        {
+            return None;
+        }
+
+        let token = self.track_code_mode_message()?;
+        let mut history = sent.history.clone();
+        let home = step.turn.config.codex_home.clone();
+        let model = step.settings.model_info.slug.clone();
+        let provider = step.turn.config.model_provider_id.clone();
+        let thread = self.thread_id.to_string();
+        let anchor = sent.anchor.clone();
+        let turn = turn.clone();
+        let generation = sent.generation;
+        let auth_owner_generation = sent.auth_owner_generation;
+        let result = tokio::task::spawn_blocking(move || -> anyhow::Result<Option<_>> {
+            let _admission = token;
+            let binding =
+                request_capacity::Binding::for_profile(&home, &thread, &model, &provider, &anchor)?;
+            let items = history.annotated_items();
+            let start = checkpoint.prefix_len;
+            if request_capacity::load(&home, &binding)?.as_ref() != Some(&checkpoint)
+                || !checkpoint.matches_prefix(items)?
+                || !proof.old_gap.matches(items, start, &turn)
+            {
+                return Ok(None);
+            }
+            let end = start + proof.old_gap.entries.len();
+            let prefix_bytes = serialized_item_bytes(items[..end].iter().map(|entry| &entry.item))?;
+            if end > MAX_RECOVERY_PREFIX_ITEMS || prefix_bytes > MAX_RECOVERY_PREFIX_BYTES {
+                return Ok(None);
+            }
+            let install_hash = exact_history_hash(&items[..end])?;
+            history.replace_annotated(items[..end].to_vec());
+            Ok(Some(CapacityRecovery {
+                history,
+                prefix: CompactionPrefix {
+                    generation,
+                    len: end,
+                    auth_owner_generation,
+                },
+                install_hash,
+                prefix_bytes,
+                confirmed_len: start,
+                authority: CapacityAuthority::Confirmed(checkpoint),
+                permit_token_reset: false,
+                old_gap: None,
+            }))
+        })
+        .await;
+        result.ok()?.ok()?
+    }
+
+    pub(crate) async fn load_capacity_recovery(
+        &self,
+        step: &StepContext,
+        sent: &CapacitySend,
+    ) -> Option<CapacityRecovery> {
+        let token = self.track_code_mode_message()?;
+        if self.state.lock().await.history.history_version() != sent.generation
+            || self.services.model_client.auth_owner_generation() != sent.auth_owner_generation
+        {
+            return None;
+        }
+        let home = step.turn.config.codex_home.clone();
+        let model = step.settings.model_info.slug.clone();
+        let provider = step.turn.config.model_provider_id.clone();
+        let thread = self.thread_id.to_string();
+        let turn = step.turn.sub_id.clone();
+        let anchor = sent.anchor.clone();
+        let mut history = sent.history.clone();
+        let generation = sent.generation;
+        let auth_owner_generation = sent.auth_owner_generation;
+        let result = tokio::task::spawn_blocking(move || -> anyhow::Result<Option<_>> {
+            let _admission = token;
+            let binding =
+                request_capacity::Binding::for_profile(&home, &thread, &model, &provider, &anchor)?;
+            let Some(checkpoint) = request_capacity::load(&home, &binding)? else {
+                return Ok(None);
+            };
+            let items = history.annotated_items();
+            if checkpoint.recovery_turn_id.as_deref() == Some(turn.as_str())
+                || !checkpoint.matches_prefix(items)?
+                || checkpoint.prefix_len != pair_safe_prefix(items, checkpoint.prefix_len)
+            {
+                return Ok(None);
+            }
+            let Some(len) = old_prefix_len(items, checkpoint.prefix_len) else {
+                return Ok(None);
+            };
+            let install_hash = exact_history_hash(&items[..len])?;
+            let prefix_bytes = serialized_item_bytes(items[..len].iter().map(|item| &item.item))?;
+            let old_gap = if len == checkpoint.prefix_len {
+                OldGap::capture(items, len, &turn)
+            } else {
+                None
+            };
+            // Fence this exact turn/epoch before calling the summarizer; a cold
+            // resume cannot repeatedly reuse an admitted failed attempt.
+            let checkpoint = request_capacity::fence(&home, &checkpoint, &turn)?;
+            history.replace_annotated(items[..len].to_vec());
+            Ok(Some(CapacityRecovery {
+                history,
+                prefix: CompactionPrefix {
+                    generation,
+                    len,
+                    auth_owner_generation,
+                },
+                install_hash,
+                prefix_bytes,
+                confirmed_len: len,
+                authority: CapacityAuthority::Confirmed(checkpoint),
+                permit_token_reset: true,
+                old_gap,
+            }))
+        })
+        .await;
+        match result {
+            Ok(Ok(recovery)) => recovery,
+            _ => {
+                tracing::warn!("request-capacity checkpoint could not authorize recovery");
+                None
+            }
+        }
+    }
+}
