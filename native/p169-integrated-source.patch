+struct Descriptor {
+    pointer: *mut c_void,
+    blob: FWP_BYTE_BLOB,
+}
+impl Descriptor {
+    fn new(sddl: &str) -> Self {
+        let text = to_wide(OsStr::new(sddl));
+        let mut pointer = null_mut();
+        let mut length = 0;
+        assert_ne!(
+            unsafe {
+                ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                    text.as_ptr(),
+                    1,
+                    &mut pointer,
+                    &mut length,
+                )
+            },
+            0
+        );
+        Self {
+            pointer,
+            blob: FWP_BYTE_BLOB {
+                size: length,
+                data: pointer.cast(),
+            },
+        }
+    }
+}
+impl Drop for Descriptor {
+    fn drop(&mut self) {
+        unsafe { LocalFree(self.pointer as HLOCAL) };
+    }
