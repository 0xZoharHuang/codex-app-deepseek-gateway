+#[cfg(unix)]
+mod platform {
+    use super::*;
+    use std::ffi::CString;
+    use std::os::fd::{AsRawFd, FromRawFd};
+    use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+
+    pub(super) struct Directory {
+        pub(super) file: File,
+        path: PathBuf,
+    }
+    pub(super) fn current_owner() -> Result<String> {
+        Ok(unsafe { libc::geteuid() }.to_string())
+    }
+
+    pub(super) fn object_identity(file: &File) -> Result<Vec<u8>> {
+        let metadata = file.metadata()?;
+        Ok([metadata.dev().to_le_bytes(), metadata.ino().to_le_bytes()].concat())
+    }
+    pub(super) fn validate_owner(
+        file: &File,
+        owner: &str,
+        directory: bool,
+        private: bool,
+    ) -> Result<()> {
+        let metadata = file.metadata()?;
+        ensure!(
+            metadata.uid().to_string() == owner
+                && metadata.is_dir() == directory
+                && (directory || metadata.is_file()),
+            "untrusted request-capacity object owner or type"
+        );
+        ensure!(
+            directory || metadata.nlink() == 1,
+            "request-capacity file has multiple links"
+        );
+        ensure!(
+            metadata.mode() & if private { 0o077 } else { 0o022 } == 0,
+            "request-capacity object has unsafe permissions"
+        );
+        Ok(())
+    }
+    fn name(value: &str) -> Result<CString> {
+        ensure!(
+            !value.contains('/') && !value.contains('\\') && value != "." && value != "..",
+            "invalid request-capacity component"
+        );
+        Ok(CString::new(value)?)
+    }
+    impl Directory {
+        pub(super) fn open_home(path: &Path) -> Result<Self> {
+            let file = OpenOptions::new()
+                .read(true)
+                .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)
+                .open(path)?;
+            Ok(Self {
+                file,
+                path: path.to_owned(),
+            })
+        }
+        pub(super) fn child(
+            &self,
+            component: &str,
+            create: bool,
+            private: bool,
+        ) -> Result<Option<Self>> {
+            let component_c = name(component)?;
+            if create {
+                let result =
+                    unsafe { libc::mkdirat(self.file.as_raw_fd(), component_c.as_ptr(), 0o700) };
+                if result != 0
+                    && std::io::Error::last_os_error().kind() != std::io::ErrorKind::AlreadyExists
+                {
+                    return Err(std::io::Error::last_os_error().into());
+                }
+            }
+            let fd = unsafe {
+                libc::openat(
+                    self.file.as_raw_fd(),
+                    component_c.as_ptr(),
+                    libc::O_RDONLY | libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+                )
+            };
+            if fd < 0 {
+                let error = std::io::Error::last_os_error();
+                if !create && error.kind() == std::io::ErrorKind::NotFound {
+                    return Ok(None);
+                }
+                return Err(error.into());
+            }
+            let file = unsafe { File::from_raw_fd(fd) };
+            validate_owner(&file, &current_owner()?, true, private)?;
+            Ok(Some(Self {
+                file,
+                path: self.path.join(component),
+            }))
+        }
+        fn open(&self, component: &str, flags: i32) -> Result<Option<File>> {
+            let component = name(component)?;
+            let fd = unsafe {
+                libc::openat(
+                    self.file.as_raw_fd(),
+                    component.as_ptr(),
+                    flags | libc::O_NOFOLLOW | libc::O_CLOEXEC | libc::O_NONBLOCK,
+                    0o600,
+                )
+            };
+            if fd < 0 {
+                let error = std::io::Error::last_os_error();
+                if error.kind() == std::io::ErrorKind::NotFound {
+                    return Ok(None);
+                }
+                return Err(error.into());
+            }
+            Ok(Some(unsafe { File::from_raw_fd(fd) }))
+        }
+        pub(super) fn open_existing(&self, component: &str) -> Result<Option<File>> {
+            self.open(component, libc::O_RDONLY)
+        }
+        pub(super) fn open_lock(&self, component: &str) -> Result<File> {
+            self.open(component, libc::O_RDWR | libc::O_CREAT)?
+                .context("capacity lock unavailable")
+        }
+        pub(super) fn open_existing_lock(&self, component: &str) -> Result<Option<File>> {
+            self.open(component, libc::O_RDWR)
+        }
+        pub(super) fn remove_owned(&self, component: &str, owner: &str) -> Result<bool> {
+            let Some(file) = self.open_existing(component)? else {
+                return Ok(false);
+            };
+            validate_owner(&file, owner, false, true)?;
+            ensure!(
+                file.metadata()?.len() <= MAX_METADATA_BYTES as u64,
+                "reserved request-capacity metadata exceeds cleanup bound"
+            );
+            let identity = object_identity(&file)?;
+            let current = self
+                .open_existing(component)?
+                .context("capacity cleanup target disappeared")?;
+            ensure!(
+                object_identity(&current)? == identity,
+                "capacity cleanup target changed"
+            );
+            let component = name(component)?;
+            ensure!(
+                unsafe { libc::unlinkat(self.file.as_raw_fd(), component.as_ptr(), 0) } == 0,
+                "remove owned request-capacity checkpoint: {}",
+                std::io::Error::last_os_error()
+            );
+            Ok(true)
+        }
+
+        pub(super) fn replace(&self, component: &str, bytes: &[u8], owner: &str) -> Result<()> {
+            let temporary = format!(".capacity-{}.tmp", uuid::Uuid::new_v4());
+            let mut file = self
+                .open(&temporary, libc::O_WRONLY | libc::O_CREAT | libc::O_EXCL)?
+                .context("capacity temporary file unavailable")?;
+            let from = name(&temporary)?;
+            let to = name(component)?;
+            let result = (|| -> Result<()> {
+                validate_owner(&file, owner, false, true)?;
+                file.write_all(bytes)?;
+                file.sync_all()?;
+                ensure!(
+                    unsafe {
+                        libc::renameat(
+                            self.file.as_raw_fd(),
+                            from.as_ptr(),
+                            self.file.as_raw_fd(),
+                            to.as_ptr(),
+                        )
+                    } == 0,
+                    "replace request-capacity checkpoint: {}",
+                    std::io::Error::last_os_error()
+                );
+                match self.file.sync_all() {
+                    Ok(()) => {}
+                    // Some native filesystems do not implement directory fsync.
+                    // The temporary file was synced before its atomic rename;
+                    // cold reconstruction still requires the exact rollout hash.
+                    Err(error)
+                        if matches!(
+                            error.raw_os_error(),
+                            Some(libc::EINVAL) | Some(libc::ENOTSUP)
+                        ) => {}
+                    Err(error) => return Err(error.into()),
+                }
+                Ok(())
+            })();
+            if result.is_err() {
+                unsafe {
+                    libc::unlinkat(self.file.as_raw_fd(), from.as_ptr(), 0);
+                }
+            }
+            result
+        }
+    }
+}
