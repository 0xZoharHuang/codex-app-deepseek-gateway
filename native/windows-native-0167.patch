new file mode 100644
index 0000000000000000000000000000000000000000..b226c1cf29fec3db2d9941afe2047aaefe883d2d
--- /dev/null
+++ b/codex-rs/windows-sandbox-rs/src/setup_provisioning/cwd_metadata.rs
@@ -0,0 +1,854 @@
+//! Materialize only metadata needed to enter an owned-home writable workspace.
+//! The namespace owns the principal; existing native uninstall retains ACLs.
+use super::Payload;
+use crate::DirectoryOpenDisposition;
+use crate::namespace::SandboxNamespace;
+use crate::no_reparse_dir::validate_local_directory_path;
+use crate::open_directory_no_reparse;
+use anyhow::{Context, Result, ensure};
+use codex_utils_absolute_path::AbsolutePathBuf;
+use std::ffi::c_void;
+use std::path::{Path, PathBuf};
+use windows_sys::Win32::Storage::FileSystem::{
+    FILE_READ_ATTRIBUTES, FILE_SHARE_READ, FILE_SHARE_WRITE, FILE_TRAVERSE, READ_CONTROL,
+    SYNCHRONIZE,
+};
+
+// Attribute handles also need SYNCHRONIZE; this grants no list or file data access.
+const METADATA_ACCESS: u32 = FILE_READ_ATTRIBUTES | SYNCHRONIZE;
+
+fn checked_path(path: &Path) -> Result<PathBuf> {
+    Ok(AbsolutePathBuf::from_absolute_path_checked(path)?.to_path_buf())
+}
+
+fn contains(root: &Path, path: &Path) -> bool {
+    let mut parts = path.components();
+    root.components().all(|component| {
+        parts.next().is_some_and(|part| {
+            component
+                .as_os_str()
+                .as_encoded_bytes()
+                .eq_ignore_ascii_case(part.as_os_str().as_encoded_bytes())
+        })
+    })
+}
+
+pub(super) fn ensure_owned_cwd_parent_metadata(
+    payload: &Payload,
+    namespace: &SandboxNamespace,
+    sandbox_group_psid: *mut c_void,
+    log: &mut dyn std::io::Write,
+) -> Result<usize> {
+    let home = checked_path(&payload.codex_home)?;
+    let cwd = checked_path(&payload.command_cwd)?;
+    if !contains(&home, &cwd) || contains(&cwd, &home) {
+        return Ok(0);
+    }
+    let authorised = payload.write_roots.iter().any(|root| {
+        checked_path(root).is_ok_and(|root| contains(&home, &root) && contains(&root, &cwd))
+    });
+    if !authorised {
+        return Ok(0);
+    }
+    // Nonlocal homes/cwds keep the pre-existing setup behavior. This materializer
+    // is only for local directories inside this native installation's home.
+    if validate_local_directory_path(&home).is_err() {
+        return Ok(0);
+    }
+    validate_local_directory_path(&payload.codex_home)?;
+    validate_local_directory_path(&payload.command_cwd)?;
+
+    // Keep the complete necessary path stable, including ancestors outside home.
+    // These are read-only pins; only parents inside home may receive an ACE.
+    let mut pins = Vec::new();
+    for path in cwd.ancestors().collect::<Vec<_>>().into_iter().rev() {
+        pins.push(
+            open_directory_no_reparse(
+                path,
+                READ_CONTROL | FILE_READ_ATTRIBUTES | FILE_TRAVERSE,
+                FILE_SHARE_READ | FILE_SHARE_WRITE,
+                DirectoryOpenDisposition::OpenExisting,
+            )
+            .with_context(|| format!("pin cwd metadata directory {}", path.display()))?,
+        );
+    }
+    let current = SandboxNamespace::for_user(&home, &payload.real_user)?;
+    ensure!(
+        current.key.id() == namespace.key.id() && current.owner_sid == namespace.owner_sid,
+        "cwd metadata namespace directory identity changed"
+    );
+    namespace.require_owned_state()?;
+
+    let mut changed = 0;
+    for path in cwd
+        .ancestors()
+        .skip(1)
+        .take_while(|path| contains(&home, path))
+    {
+        let added = unsafe {
+            crate::ensure_allow_mask_aces_with_inheritance(
+                path,
+                &[sandbox_group_psid],
+                METADATA_ACCESS,
+                0,
+            )
+        }?;
+        // This is the primitive's ACL-mask readback, not a full token access proof.
+        ensure!(
+            crate::path_mask_allows(path, &[sandbox_group_psid], METADATA_ACCESS, true,)?,
+            "required cwd-parent metadata ACE was not materialized on {}",
+            path.display()
+        );
+        if added {
+            changed += 1;
+            super::log_line(
+                log,
+                &format!(
+                    "granted non-inheriting cwd-parent metadata-handle ACE on {}",
+                    path.display()
+                ),
+            )?;
+        }
+    }
+    drop(pins);
+    Ok(changed)
+}
