+        drop(child_read);
+        let root_before = acl_snapshot(fixture.path());
+        let child_before = acl_snapshot(&child);
+        anyhow::ensure!(
+            !unsafe {
+                ensure_allow_mask_aces_with_inheritance(
+                    fixture.path(),
+                    &[existing.as_ptr()],
+                    FILE_READ_ATTRIBUTES,
+                    0,
+                )
+            }?,
+            "existing readonly grant must be a successful no-op"
+        );
+        let failure = unsafe {
+            ensure_allow_mask_aces_with_inheritance(
+                fixture.path(),
+                &[missing.as_ptr()],
+                FILE_READ_ATTRIBUTES,
+                0,
+            )
+        }
+        .expect_err("missing grant must require denied WRITE_DAC");
+        anyhow::ensure!(
+            failure.chain().any(|cause| cause
+                .downcast_ref::<std::io::Error>()
+                .is_some_and(|error| error.raw_os_error() == Some(5))),
+            "missing grant must retain access denied"
+        );
+        anyhow::ensure!(
+            acl_snapshot(fixture.path()) == root_before,
+            "readonly parent DACL/control changed"
+        );
+        anyhow::ensure!(
+            acl_snapshot(&child) == child_before,
+            "readonly child DACL/control changed"
+        );
+        Ok(())
+    })();
+    unsafe { LocalFree(descriptor as HLOCAL) };
+    let cleanup = restore.restore();
+    result?;
+    cleanup?;
+    Ok(())
+}
