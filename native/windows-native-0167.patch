+//! Materialize one version-pinned App executable through the existing helper store.
+//! This does not implement a compiler or alter permissions, arguments or retries.
+
+use std::fs::{self, File};
+use std::io::Read;
+use std::os::windows::fs::MetadataExt;
+use std::path::{Component, Path, PathBuf};
+use std::time::{Duration, Instant};
+
+use crate::private_acl_lock::PrivateLockDirectory;
+
+use anyhow::{Context, Result, ensure};
+use sha2::{Digest, Sha256};
+
+use crate::app_package::{registered_core_requested, staged_package_root};
+use crate::logging::log_note;
+use crate::resolved_permissions::ResolvedWindowsSandboxPermissions;
+use crate::winutil::to_wide;
+
+use super::{copy::copy_from_source_if_needed, helper_bin_dir};
+
+const PACKAGE: &str = "OpenAI.Codex_26.1103.4239.0_x64__2p2nqsd0c76g0";
+const RELATIVE_EXE: &str = "app/resources/tectonic/tectonic.exe";
+const SHA256: &str = "8221eb899fbe013ae792385ebdb367835a90395cbafd52b950ff37d842d6e816";
+const REPARSE_POINT: u32 = 0x400;
+
+fn checked_path(path: &Path) -> Result<&Path> {
+    let path = dunce::simplified(path);
+    ensure!(
+        path.is_absolute(),
+        "component permission path is not absolute"
+    );
+    ensure!(
+        !path
+            .components()
+            .any(|part| matches!(part, Component::ParentDir)),
+        "ambiguous component permission path"
+    );
+    Ok(path)
+}
+
+// Use component boundaries, retain non-Unicode names, and do not require a deny
+// path or the as-yet-uncreated destination to exist.
+fn contains(root: &Path, path: &Path) -> Result<bool> {
+    let root = checked_path(root)?;
+    let path = checked_path(path)?;
+    let mut parts = path.components();
+    Ok(root.components().all(|component| {
+        parts.next().is_some_and(|part| {
+            component
+                .as_os_str()
+                .as_encoded_bytes()
+                .eq_ignore_ascii_case(part.as_os_str().as_encoded_bytes())
+        })
+    }))
+}
+
+fn same_path(left: &Path, right: &Path) -> Result<bool> {
+    Ok(contains(left, right)? && contains(right, left)?)
+}
+
+fn allowed(
+    path: &Path,
+    extra_denied: &[PathBuf],
+    can_read: &impl Fn(&Path) -> Result<bool>,
+) -> Result<bool> {
+    checked_path(path)?;
+    for denied in extra_denied {
+        if contains(denied, path)? {
+            return Ok(false);
+        }
+        // If a deny alias exists, also respect its resolved identity.
+        match dunce::canonicalize(denied) {
+            Ok(resolved) if contains(&resolved, path)? => return Ok(false),
+            Ok(_) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error).context("resolve component deny path"),
+        }
+    }
+    can_read(path)
+}
+
+fn digest(path: &Path) -> Result<String> {
+    let mut file = File::open(path).context("open pinned App component")?;
+    let mut hash = Sha256::new();
+    let mut buffer = [0u8; 64 * 1024];
+    loop {
+        let count = file
+            .read(&mut buffer)
+            .context("hash pinned App component")?;
+        if count == 0 {
+            break;
+        }
+        hash.update(&buffer[..count]);
+    }
+    Ok(format!("{:x}", hash.finalize()))
+}
+
+fn verify_leaf(path: &Path, expected_sha: &str) -> Result<()> {
+    let metadata = fs::symlink_metadata(path).context("inspect pinned component file")?;
+    ensure!(
+        metadata.is_file() && metadata.file_attributes() & REPARSE_POINT == 0,
+        "pinned component file was redirected"
+    );
+    let canonical = dunce::canonicalize(path).context("resolve pinned component file")?;
+    ensure!(
+        same_path(path, &canonical)?,
+        "pinned component path was redirected"
+    );
+    ensure!(
+        digest(path)? == expected_sha,
+        "pinned App component SHA-256 mismatch"
+    );
+    Ok(())
+}
+
+fn copy_verified_locked(source: &Path, destination: &Path, expected_sha: &str) -> Result<()> {
+    verify_leaf(source, expected_sha)?;
+    match fs::symlink_metadata(destination) {
+        Ok(_) => verify_leaf(destination, expected_sha)?,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+        Err(error) => return Err(error).context("inspect pinned component cache"),
+    }
+    // Reuse native atomic copying and destination-inherited namespace RX.
+    // Never call an outer resolver that can fall back to source execution.
+    copy_from_source_if_needed(source, destination).context("materialize pinned App component")?;
+    verify_leaf(source, expected_sha)?;
+    verify_leaf(destination, expected_sha)
+}
+
+fn copy_verified(source: &Path, destination: &Path, expected_sha: &str) -> Result<()> {
+    // Reuse the native owner-private, non-delete-shared lock store. A distinct
+    // home/component key prevents two cold App previews replacing a live image.
+    let key = crate::path_normalization::canonical_path_key(destination);
+    let name = format!("app-component-{:x}.lock", Sha256::digest(key.as_bytes()));
+    let locks = PrivateLockDirectory::open()?;
+    let result = (|| -> Result<()> {
+        let lock = locks.open_leaf(&name)?;
+        let deadline = Instant::now() + Duration::from_secs(10);
+        loop {
+            match lock.try_lock() {
+                Ok(()) => break,
+                Err(std::fs::TryLockError::WouldBlock) if Instant::now() < deadline => {
+                    std::thread::sleep(Duration::from_millis(5));
+                }
+                Err(std::fs::TryLockError::WouldBlock) => {
+                    anyhow::bail!("timed out waiting for pinned App component materialization");
+                }
+                Err(std::fs::TryLockError::Error(error)) => {
+                    return Err(error).context("lock pinned App component");
+                }
+            }
+        }
+        copy_verified_locked(source, destination, expected_sha)
+        // Dropping this exact file releases the lock on success and every error.
+    })();
+    let _ = locks.try_cleanup(&name); // Existing native cleanup refuses live split locks.
+    result
+}
+
+fn resolve_pinned(
+    source: &Path,
+    package_root: &Path,
+    codex_home: &Path,
+    read_roots_override: Option<&[PathBuf]>,
+    extra_denied: &[PathBuf],
+    can_read: impl Fn(&Path) -> Result<bool>,
+    expected_sha: &str,
+) -> Result<Option<PathBuf>> {
+    let expected = package_root.join(RELATIVE_EXE);
+    if !same_path(source, &expected)? {
+        return Ok(None);
+    }
+    ensure!(
+        read_roots_override.is_none(),
+        "pinned App component requires the native root-read policy, not read-root overrides"
+    );
+    ensure!(
+        allowed(source, extra_denied, &can_read)?,
+        "original App component is denied"
+    );
+    let canonical = dunce::canonicalize(source).context("resolve pinned App component")?;
+    ensure!(
+        same_path(&canonical, &expected)?,
+        "pinned App component escaped its registered path"
+    );
+    ensure!(
+        allowed(&canonical, extra_denied, &can_read)?,
+        "resolved App component is denied"
+    );
+
+    let bin = helper_bin_dir(codex_home);
+    let metadata = fs::symlink_metadata(&bin).context("inspect native helper store")?;
+    ensure!(
+        metadata.is_dir() && metadata.file_attributes() & REPARSE_POINT == 0,
+        "native helper store was redirected"
+    );
+    let canonical_home = dunce::canonicalize(codex_home).context("resolve native home")?;
+    let canonical_bin = dunce::canonicalize(&bin).context("resolve native helper store")?;
+    ensure!(
+        same_path(&canonical_bin, &canonical_home.join(".sandbox-bin"))?,
+        "native helper store escaped its home"
+    );
+    let destination = canonical_bin.join(format!("tectonic-{expected_sha}.exe"));
+    ensure!(
+        allowed(&destination, extra_denied, &can_read)?,
+        "materialized App component is denied"
+    );
+    copy_verified(&canonical, &destination, expected_sha)?;
+    Ok(Some(destination))
+}
+
+/// Called after ordinary native setup has secured the helper store, and before
+/// the first SpawnRequest. Only argv[0] can change. No process has run or failed.
+pub(crate) fn materialize_command(
+    mut command: Vec<String>,
+    permissions: &ResolvedWindowsSandboxPermissions,
+    codex_home: &Path,
+    cwd: &Path,
+    read_roots_override: Option<&[PathBuf]>,
+    extra_denied: &[PathBuf],
+) -> Result<Vec<String>> {
+    if registered_core_requested() {
+        return Ok(command);
+    }
+    let Some(program) = command.first() else {
+        return Ok(command);
+    };
+    let source = PathBuf::from(program);
+    if !source.is_absolute()
+        || !source.file_name().is_some_and(|name| {
+            name.as_encoded_bytes()
+                .eq_ignore_ascii_case(b"tectonic.exe")
+        })
+    {
+        return Ok(command);
+    }
+    if checked_path(&source).is_err() {
+        return Ok(command); // Ordinary noncanonical commands retain native behavior.
+    }
+    let package_root = match staged_package_root(&to_wide(PACKAGE)) {
+        Ok(root) => root,
+        Err(_) => return Ok(command), // No known installed package; no adaptation claimed.
+    };
+    if let Some(destination) = resolve_pinned(
+        &source,
+        &package_root,
+        codex_home,
+        read_roots_override,
+        extra_denied,
+        |path| permissions.can_read_for_materialization(path, cwd),
+        SHA256,
+    )? {
+        let effective = destination
+            .to_str()
+            .context("non-Unicode materialized executable")?;
+        log_note(
+            &format!(
+                "pinned App executable materialized: original={} effective={} sha256={SHA256}",
+                source.display(),
+                destination.display()
+            ),
+            Some(&codex_home.join(".sandbox")),
+        );
+        command[0] = effective.to_owned();
+    }
+    Ok(command)
+}
