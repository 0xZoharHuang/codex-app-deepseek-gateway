+use sqlx::AssertSqlSafe;
+use sqlx::SqlSafeStr;
+use sqlx::migrate::Migrate;
+use sqlx::migrate::MigrateError;
+use sqlx::migrate::Migration;
+
+fn migration_form(migration: &Migration, crlf: bool) -> Migration {
+    let lf = migration.sql.as_str().replace("\r\n", "\n");
+    let sql = if crlf { lf.replace('\n', "\r\n") } else { lf };
+    // This is exclusively an EOL representation of the trusted embedded SQL.
+    Migration::new(
+        migration.version,
+        migration.description.clone(),
+        migration.migration_type,
+        AssertSqlSafe(sql).into_sql_str(),
+        migration.no_tx,
+    )
+}
+
+fn copy_migrator(base: &Migrator) -> Migrator {
+    Migrator {
+        migrations: Cow::Owned(base.migrations.to_vec()),
+        ignore_missing: base.ignore_missing,
+        locking: base.locking,
+        no_tx: base.no_tx,
+        table_name: base.table_name.clone(),
+        create_schemas: base.create_schemas.clone(),
+    }
+}
+
+/// Match only exact LF/CRLF forms of the same version's embedded SQL.
+/// Select RAM SQL and checksum together; never rewrite an existing ledger value.
+pub(crate) async fn runtime_migrator_for_database(
+    pool: &SqlitePool,
+    base: &Migrator,
+    allow_legacy_recency: bool,
+    prefer_lf_for_empty: bool,
+) -> Result<Migrator, MigrateError> {
+    let mut result = copy_migrator(base);
+    for migration in base.iter() {
+        let lf = migration_form(migration, false);
+        let crlf = migration_form(migration, true);
+        if migration.checksum != lf.checksum && migration.checksum != crlf.checksum {
+            return Err(MigrateError::VersionMismatch(migration.version));
+        }
+    }
+    let exists = sqlx::query_scalar::<_, i64>(
+        "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?",
+    )
+    .bind(base.table_name.as_ref())
+    .fetch_optional(pool)
+    .await?
+    .is_some();
+    let applied = if exists {
+        let mut connection = pool.acquire().await?;
+        if let Some(version) = connection.dirty_version(&base.table_name).await? {
+            return Err(MigrateError::Dirty(version));
+        }
+        connection.list_applied_migrations(&base.table_name).await?
+    } else {
+        Vec::new()
+    };
+    let recorded: HashMap<_, _> = applied
+        .iter()
+        .map(|migration| (migration.version, migration.checksum.as_ref()))
+        .collect();
+    let recency = base.iter().find(|migration| migration.version == 39);
+    let legacy_recency = if allow_legacy_recency && !recorded.contains_key(&39) {
+        recency.and_then(|migration| {
+            let checksum = *recorded.get(&38)?;
+            let lf = migration_form(migration, false);
+            let crlf = migration_form(migration, true);
+            (checksum == lf.checksum.as_ref() || checksum == crlf.checksum.as_ref())
+                .then_some(checksum)
+        })
+    } else {
+        None
+    };
+    let mut has_lf = false;
+    let mut has_crlf = false;
+    for applied in &applied {
+        let Some(migration) = base.iter().find(|migration| {
+            migration.version == applied.version && !migration.migration_type.is_down_migration()
+        }) else {
+            continue; // Leave unknown versions to SQLx's original ignore_missing policy.
+        };
+        let expected = if applied.version == 38 && legacy_recency.is_some() {
+            recency.expect("recognized legacy recency migration")
+        } else {
+            migration
+        };
+        let lf = migration_form(expected, false);
+        let crlf = migration_form(expected, true);
+        if applied.checksum != lf.checksum && applied.checksum != crlf.checksum {
+            return Err(MigrateError::VersionMismatch(applied.version));
+        }
+        if lf.checksum != crlf.checksum {
+            has_lf |= applied.checksum == lf.checksum;
+            has_crlf |= applied.checksum == crlf.checksum;
+        }
+    }
+    let pending_lf = has_lf && !has_crlf || !has_lf && !has_crlf && prefer_lf_for_empty;
+    for migration in result.migrations.to_mut() {
+        if migration.migration_type.is_down_migration() {
+            continue;
+        }
+        let checksum = if migration.version == 39 && legacy_recency.is_some() {
+            legacy_recency
+        } else if migration.version == 38 && legacy_recency.is_some() {
+            None // The existing repair moves the known old 38 row to 39 before run.
+        } else {
+            recorded.get(&migration.version).copied()
+        };
+        *migration = if let Some(checksum) = checksum {
+            let lf = migration_form(migration, false);
+            if checksum == lf.checksum.as_ref() {
+                lf
+            } else {
+                migration_form(migration, true)
+            }
+        } else if pending_lf {
+            migration_form(migration, false)
+        } else {
+            migration.clone()
+        };
+    }
+    Ok(result)
+}
