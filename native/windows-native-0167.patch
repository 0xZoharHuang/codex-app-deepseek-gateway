+        // renamed or disabled account name, and without creating/logging in users.
+        use windows_sys::Win32::NetworkManagement::NetManagement as net;
+        use windows_sys::Win32::Security::{GetLengthSid, IsValidSid};
+        let mut buffer = std::ptr::null_mut();
+        let status = unsafe { net::NetUserModalsGet(std::ptr::null(), 2, &mut buffer) };
+        let domain_result = (|| -> anyhow::Result<String> {
+            anyhow::ensure!(
+                status == net::NERR_Success,
+                "read local account domain: {status}"
+            );
+            anyhow::ensure!(!buffer.is_null(), "missing local account-domain metadata");
+            let info = unsafe { &*buffer.cast::<net::USER_MODALS_INFO_2>() };
+            anyhow::ensure!(
+                unsafe { IsValidSid(info.usrmod2_domain_id) } != 0,
+                "invalid local account-domain SID"
+            );
+            let length = unsafe { GetLengthSid(info.usrmod2_domain_id) } as usize;
+            let bytes =
+                unsafe { std::slice::from_raw_parts(info.usrmod2_domain_id.cast::<u8>(), length) };
+            crate::winutil::string_from_sid_bytes(bytes).map_err(anyhow::Error::msg)
+        })();
+        if !buffer.is_null() {
+            unsafe { net::NetApiBufferFree(buffer.cast()) };
+        }
+        let domain = domain_result?;
+        let administrator = format!("{domain}-500");
+        let target_sid = if caller_sid == administrator {
+            format!("{domain}-501")
+        } else {
+            administrator
+        };
+        anyhow::ensure!(
+            target_sid != caller_sid,
+            "fixture target must differ from actual caller"
+        );
+        let target_sid = crate::token::LocalSid::from_string(&target_sid)?;
+        let target = unsafe { crate::winutil::account_name_from_sid(target_sid.as_ptr()) }?;
+        let namespace = crate::namespace::SandboxNamespace::for_user(home.path(), &target)?;
+        namespace.reserve_owner()?;
+        std::fs::create_dir_all(crate::setup::sandbox_dir(home.path()))?;
+        // Native 0.165 keeps namespace ownership in the serialized sidecar
+        // checked by SandboxNamespace, not a field on these public structs.
+        // Preserve that actual on-disk format without restoring 0.164 fields.
+        let marker = serde_json::json!({
+            "namespace": namespace.key.id(),
+            "version": crate::setup::SETUP_VERSION,
+            "offline_username": namespace.key.offline(),
+            "online_username": namespace.key.online(),
+            "created_at": null,
+            "proxy_ports": [],
+            "allow_local_binding": false,
+        });
+        let users = serde_json::json!({
+            "namespace": namespace.key.id(),
+            "version": crate::setup::SETUP_VERSION,
+            "offline": {"username":namespace.key.offline(), "password":""},
+            "online": {"username":namespace.key.online(), "password":""},
+        });
+        std::fs::write(
+            crate::setup::setup_marker_path(home.path()),
+            serde_json::to_vec(&marker)?,
+        )?;
+        std::fs::write(
+            crate::setup::sandbox_users_path(home.path()),
+            serde_json::to_vec(&users)?,
+        )?;
+        Ok((home, caller, target, namespace))
+    }
