+        );
+        let status = unsafe {
+            SetSecurityInfo(
+                restore.handle.as_raw_handle() as _,
+                1,
+                DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION,
+                std::ptr::null_mut(),
+                std::ptr::null_mut(),
+                dacl,
+                std::ptr::null_mut(),
+            )
