+        let seeded = unsafe {
+            ensure_allow_mask_aces_with_inheritance(
+                path,
+                &[marker.as_ptr()],
+                FILE_READ_ATTRIBUTES,
+                super::CONTAINER_INHERIT_ACE | super::OBJECT_INHERIT_ACE,
+            )
+        };
+        let restored = unsafe {
+            SetFileSecurityW(
+                to_wide(&child).as_ptr(),
+                DACL_SECURITY_INFORMATION,
+                descriptor,
