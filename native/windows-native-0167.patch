+    crate::namespace::SandboxNamespace,
+    String,
+)> {
+    let home = tempfile::tempdir()?;
+    std::fs::create_dir(crate::sandbox_dir(home.path()))?;
+    let user = crate::runtime_ownership::current_setup_user()?;
+    let namespace = crate::namespace::SandboxNamespace::for_user(home.path(), &user)?;
+    namespace.reserve_owner()?;
+    namespace.require_owned_state()?;
+    Ok((home, namespace, user))
+}
+
+#[test]
+fn provision_marker_retains_native_exclusive_handle_until_commit() -> Result<()> {
+    let (home, namespace, user) = admitted_marker_fixture()?;
+    let marker = super::prepare_setup_marker(home.path(), &user, super::SetupMode::ProvisionOnly)?;
+    assert!(matches!(&marker, super::PreparedSetupMarker::Retained(_)));
+    // Ordinary readers retain full validation: the native marker is still
+    // exclusive, and no sharing-violation bypass is installed in namespace.rs.
+    let error = namespace.require_owned_state().unwrap_err();
+    assert_eq!(
+        error
+            .downcast_ref::<std::io::Error>()
+            .unwrap()
+            .raw_os_error(),
+        Some(32)
+    );
+    super::commit_setup_marker(
+        marker,
+        home.path(),
+        &namespace.key.offline(),
+        &namespace.key.online(),
+        &[53216],
+        false,
+        &namespace,
+    )?;
+    namespace.require_owned_state()?;
+    let value: serde_json::Value = serde_json::from_slice(&std::fs::read(
+        crate::setup::setup_marker_path(home.path()),
+    )?)?;
+    assert_eq!(value["version"], crate::SETUP_VERSION);
+    assert_eq!(value["namespace"], namespace.key.id());
+    assert_eq!(value["proxy_ports"], serde_json::json!([53216]));
+    Ok(())
+}
+
+#[test]
+fn owned_empty_native_marker_remains_recoverable_after_interrupted_setup() -> Result<()> {
+    let (home, namespace, user) = admitted_marker_fixture()?;
+    let marker = super::prepare_setup_marker(home.path(), &user, super::SetupMode::ProvisionOnly)?;
+    drop(marker);
+    assert!(std::fs::read(crate::setup::setup_marker_path(home.path()))?.is_empty());
+    // The existing owner reservation, not a relaxed parser, authorizes retry.
+    let recovered = crate::namespace::SandboxNamespace::for_user(home.path(), &user)?;
+    recovered.require_owned_state()?;
