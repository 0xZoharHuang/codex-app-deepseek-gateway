+fn sd_bytes(sd: &LocalMemory) -> Vec<u8> {
+    let len = unsafe { GetSecurityDescriptorLength(sd.0) } as usize;
+    assert!(len > 0 && len <= 1024 * 1024);
+    unsafe { std::slice::from_raw_parts(sd.0.cast::<u8>(), len) }.to_vec()
+}
+struct ExclusiveFixtureRestore {
+    station: HANDLE,
+    original: LocalMemory,
+    acl: *mut ACL,
+    out: PathBuf,
+    restored: bool,
+}
+impl ExclusiveFixtureRestore {
+    fn restore(&mut self) -> Result<()> {
+        if self.restored {
+            return Ok(());
+        }
+        let error = unsafe {
+            SetSecurityInfo(
+                self.station,
+                SE_WINDOW_OBJECT,
+                DACL_SECURITY_INFORMATION,
+                ptr::null_mut(),
+                ptr::null_mut(),
+                self.acl,
+                ptr::null_mut(),
+            )
+        };
+        ensure!(
+            error == ERROR_SUCCESS,
+            "exclusive test fixture restore: {error}"
+        );
+        let (actual, _, _) = station_security(self.station)?;
+        let equal = sd_bytes(&actual) == sd_bytes(&self.original);
+        std::fs::write(
+            self.out.join("exclusive-fixture-restore.json"),
+            serde_json::to_vec_pretty(
+                &json!({"test_fixture_only_not_production_cleanup":true,"original_SD_byte_equal":equal}),
+            )?,
+        )?;
+        ensure!(equal, "exclusive test station was not restored");
+        self.restored = true;
+        Ok(())
+    }
+}
+impl Drop for ExclusiveFixtureRestore {
+    fn drop(&mut self) {
+        if !self.restored {
+            let _ = self.restore();
+        }
+    }
+}
+fn fixture_merge(station: HANDLE, sid: &str, mask: u32, deny: bool) -> Result<()> {
+    let bytes = sid_bytes_from_string(sid)?;
+    let (_sd, _, acl) = station_security(station)?;
+    ensure!(
+        !acl.is_null(),
+        "test requires a concrete original station DACL"
+    );
+    let entry = EXPLICIT_ACCESS_W {
+        grfAccessPermissions: mask,
+        grfAccessMode: if deny { DENY_ACCESS } else { GRANT_ACCESS },
+        grfInheritance: 0,
+        Trustee: TRUSTEE_W {
+            pMultipleTrustee: ptr::null_mut(),
+            MultipleTrusteeOperation: 0,
+            TrusteeForm: TRUSTEE_IS_SID,
+            TrusteeType: TRUSTEE_IS_USER,
+            ptstrName: bytes.as_ptr().cast_mut().cast(),
+        },
+    };
+    let mut updated = ptr::null_mut();
+    let error = unsafe { SetEntriesInAclW(1, &entry, acl, &mut updated) };
+    ensure!(error == ERROR_SUCCESS, "merge test fixture ACL: {error}");
+    let _updated = LocalMemory(updated.cast());
+    let error = unsafe {
+        SetSecurityInfo(
+            station,
+            SE_WINDOW_OBJECT,
+            DACL_SECURITY_INFORMATION,
+            ptr::null_mut(),
+            ptr::null_mut(),
+            updated,
+            ptr::null_mut(),
+        )
+    };
+    ensure!(error == ERROR_SUCCESS, "install test fixture ACE: {error}");
+    Ok(())
+}
+fn other_aces(acl: *const ACL, excluded: &[Vec<u8>]) -> Result<Vec<Vec<u8>>> {
+    let mut result = vec![];
+    for index in 0..unsafe { (*acl).AceCount } {
+        let mut raw = ptr::null_mut();
+        ensure!(
+            unsafe { GetAce(acl, index as u32, &mut raw) } != 0,
+            "read test ACE"
+        );
+        let head = unsafe { &*raw.cast::<ACE_HEADER>() };
+        let own = if matches!(head.AceType, 0 | 1) && head.AceSize >= 16 {
+            let ace = unsafe { &*raw.cast::<ACCESS_ALLOWED_ACE>() };
+            let sid = ptr::addr_of!(ace.SidStart).cast_mut().cast();
+            excluded
+                .iter()
+                .any(|s| unsafe { EqualSid(sid, s.as_ptr().cast_mut().cast()) } != 0)
+        } else {
+            false
+        };
+        if !own {
+            result.push(
+                unsafe { std::slice::from_raw_parts(raw.cast::<u8>(), head.AceSize as usize) }
+                    .to_vec(),
+            );
+        }
+    }
+    result.sort();
+    Ok(result)
+}
+fn native_readonly(
+    home: &Path,
+    cwd: &Path,
+    label: &str,
+    target: &str,
+) -> Result<serde_json::Value> {
+    let output_name = format!("native-station-forbidden-{label}.txt");
+    ensure!(
+        !cwd.join(&output_name).exists(),
+        "forbidden test destination pre-exists"
+    );
+    let nonce = format!("CDS_NATIVE_AUTOMATIC_STATION_{label}");
+    let command = vec![
+        std::env::var("SystemRoot")? + "\\System32\\cmd.exe",
+        "/d".into(),
+        "/c".into(),
+        format!(
+            "type native-station-input.txt & (echo forbidden> {output_name}) 2>nul & if exist {output_name} (exit /b 21) else (echo {nonce} & whoami /user)"
+        ),
+    ];
+    let profile = PermissionProfile::read_only();
+    let capture = crate::run_windows_sandbox_capture_for_permission_profile_elevated(
+        crate::ElevatedSandboxProfileCaptureRequest {
+            permission_profile: &profile,
+            workspace_roots: &[],
+            codex_home: home,
+            command,
+            cwd,
+            env_map: std::env::vars().collect::<HashMap<_, _>>(),
+            timeout_ms: Some(60000),
+            cancellation: None,
+            proxy_enforced: false,
+            network_proxy_restricting_sid: None,
+            read_roots_override: None,
+            read_roots_include_platform_defaults: false,
+            write_roots_override: None,
+            deny_read_paths_override: &[],
+            deny_write_paths_override: &[],
+        },
+    )?;
+    let stdout = String::from_utf8_lossy(&capture.stdout);
+    let stderr = String::from_utf8_lossy(&capture.stderr);
+    ensure!(
+        capture.exit_code == 0
+            && !capture.timed_out
+            && stdout.contains(&nonce)
+            && stdout.contains("CDS_NATIVE_READ_ALLOWED")
+            && stdout.contains(target),
+        "native readonly command failed: rc={} timedout={} stdout={stdout} stderr={stderr}",
+        capture.exit_code,
+        capture.timed_out
+    );
+    ensure!(
+        !cwd.join(&output_name).exists(),
+        "readonly sandbox wrote forbidden file"
+    );
+    Ok(
+        json!({"label":label,"exit_code":capture.exit_code,"timed_out":capture.timed_out,"stdout":stdout,"stderr":stderr,"forbidden_file_absent":true}),
+    )
+}
