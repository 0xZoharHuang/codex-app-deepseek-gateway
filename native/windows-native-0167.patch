+        anyhow::ensure!(status == 0, "apply owned readonly fixture DACL: {status}");
+        // Keep this a real readonly parent despite the inheritable user ACE:
+        // OWNER_RIGHTS deny-WRITE_DAC applies to the root, not its children.
+        let denied = OpenOptions::new()
+            .access_mode(windows_sys::Win32::Storage::FileSystem::WRITE_DAC)
+            .share_mode(
+                windows_sys::Win32::Storage::FileSystem::FILE_SHARE_READ
+                    | windows_sys::Win32::Storage::FileSystem::FILE_SHARE_WRITE
+                    | windows_sys::Win32::Storage::FileSystem::FILE_SHARE_DELETE,
+            )
+            .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)
+            .open(fixture.path())
+            .expect_err("fresh root WRITE_DAC must still be denied");
+        anyhow::ensure!(
