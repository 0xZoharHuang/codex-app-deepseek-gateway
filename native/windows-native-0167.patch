+++ b/codex-rs/windows-sandbox-rs/src/namespace_coordination.rs
@@ -0,0 +1,340 @@
+//! Read-only namespace identity from the runner's actual Windows token.
+//! No private-home reads, inherited environment values, or unauthenticated IPC identity.
+use crate::namespace_key::NamespaceKey;
+use crate::token::{get_user_sid_bytes, token_groups};
+use crate::winutil::to_wide;
+use anyhow::{Context, Result, ensure};
+use std::ptr::{null, null_mut};
+use windows_sys::Win32::Foundation::{ERROR_NON_DOMAIN_SID, GetLastError, HANDLE};
+use windows_sys::Win32::NetworkManagement::NetManagement::{
+    NERR_Success, NetApiBufferFree, NetUserGetInfo, USER_INFO_23,
+};
+use windows_sys::Win32::Security::{
+    CopySid, EqualDomainSid, EqualSid, GetLengthSid, IsValidSid, LookupAccountSidW, SidTypeAlias,
+    SidTypeUser,
+};
+use windows_sys::Win32::System::SystemServices::{SE_GROUP_ENABLED, SE_GROUP_USE_FOR_DENY_ONLY};
+
+#[derive(Debug)]
+struct GroupObservation {
+    name: String,
+    kind: i32,
+    attributes: u32,
+    local_domain: bool,
+}
+
+fn enabled(attributes: u32) -> bool {
+    attributes & (SE_GROUP_ENABLED as u32) != 0
+        && attributes & (SE_GROUP_USE_FOR_DENY_ONLY as u32) == 0
+}
+
+fn select_namespace(user_name: &str, groups: &[GroupObservation]) -> Result<NamespaceKey> {
+    namespace_role(user_name, groups, true)?
+        .context("runner token has no enabled local namespace alias")
+}
+
+fn namespace_role(
+    user_name: &str,
+    groups: &[GroupObservation],
+    require_enabled: bool,
+) -> Result<Option<NamespaceKey>> {
+    let mut selected = None;
+    for group in groups {
+        if (require_enabled && !enabled(group.attributes))
+            || !group.local_domain
+            || !NamespaceKey::claims_group_name(&group.name)
+        {
+            continue;
+        }
+        ensure!(
+            group.kind == SidTypeAlias,
+            "runner namespace membership is not a local alias"
+        );
+        let key = NamespaceKey::from_group_name(&group.name)
+            .context("runner namespace group name is invalid")?;
+        ensure!(
+            user_name.eq_ignore_ascii_case(&key.offline())
+                || user_name.eq_ignore_ascii_case(&key.online()),
+            "runner token user does not match namespace account"
+        );
+        ensure!(
+            selected.is_none(),
+            "runner token has ambiguous namespace memberships"
+        );
+        selected = Some(key);
+    }
+    Ok(selected)
+}
+
+pub(crate) fn account_name(sid: &[u8]) -> Result<(String, i32)> {
+    let mut name_len = 0;
+    let mut domain_len = 0;
+    let mut kind = 0;
+    unsafe {
+        LookupAccountSidW(
+            null(),
+            sid.as_ptr() as _,
+            null_mut(),
+            &mut name_len,
+            null_mut(),
+            &mut domain_len,
+            &mut kind,
+        )
+    };
+    ensure!(
+        name_len > 0 && name_len <= 32_768 && domain_len <= 32_768,
+        "cannot resolve runner token SID: {}",
+        unsafe { GetLastError() }
+    );
+    let mut name = vec![0; name_len as usize];
+    let mut domain = vec![0; domain_len.max(1) as usize];
+    ensure!(
+        unsafe {
+            LookupAccountSidW(
+                null(),
+                sid.as_ptr() as _,
+                name.as_mut_ptr(),
+                &mut name_len,
+                domain.as_mut_ptr(),
+                &mut domain_len,
+                &mut kind,
+            )
+        } != 0,
+        "LookupAccountSidW for runner failed: {}",
+        unsafe { GetLastError() }
+    );
+    ensure!(
+        name_len as usize <= name.len(),
+        "invalid runner account name size"
+    );
+    let name = String::from_utf16(&name[..name_len as usize])
+        .context("runner account name is not Unicode")?;
+    Ok((name.trim_end_matches('\0').to_string(), kind))
+}
+
+pub(crate) fn local_user_sid(name: &str) -> Result<Vec<u8>> {
+    let mut data = null_mut();
+    // NULL server binds this lookup to the local SAM, not a similarly named domain user.
+    let status = unsafe { NetUserGetInfo(null(), to_wide(name).as_ptr(), 23, &mut data) };
+    if status != NERR_Success {
+        if !data.is_null() {
+            unsafe { NetApiBufferFree(data as _) };
+        }
+        anyhow::bail!("resolve local runner user SID failed: {status}");
+    }
+    let result = (|| {
+        ensure!(
+            !data.is_null(),
+            "local runner user query returned no record"
+        );
+        let sid = unsafe { (*(data as *const USER_INFO_23)).usri23_user_sid };
+        ensure!(
+            !sid.is_null() && unsafe { IsValidSid(sid) } != 0,
+            "local runner user has invalid SID"
+        );
+        let length = unsafe { GetLengthSid(sid) };
+        ensure!(
+            length >= 8 && length <= 68,
+            "local runner user SID size is invalid"
+        );
+        let mut owned = vec![0; length as usize];
+        ensure!(
+            unsafe { CopySid(length, owned.as_mut_ptr().cast(), sid) } != 0,
+            "copy local runner SID failed"
+        );
+        Ok(owned)
+    })();
+    unsafe { NetApiBufferFree(data as _) };
+    result
+}
+
+pub(crate) fn same_domain(user: &[u8], group: &[u8]) -> Result<bool> {
+    let mut equal = 0;
+    if unsafe { EqualDomainSid(user.as_ptr() as _, group.as_ptr() as _, &mut equal) } != 0 {
+        return Ok(equal != 0);
+    }
+    let error = unsafe { GetLastError() };
+    // Builtin, logon-session and capability SIDs are not account-domain memberships.
+    if error == ERROR_NON_DOMAIN_SID {
+        return Ok(false);
+    }
+    anyhow::bail!("compare runner token account domains failed: {error}")
+}
+
+/// Read-only role classifier, including other homes. A user-name prefix alone is never enough.
+///
+/// # Safety
+/// The caller retains a valid TOKEN_QUERY handle through this call.
+pub unsafe fn token_is_home_sandbox_account(token: HANDLE) -> Result<bool> {
+    let user = unsafe { get_user_sid_bytes(token) }?;
+    let (user_name, kind) = account_name(&user)?;
+    let mut observations = Vec::new();
+    for group in unsafe { token_groups(token, 1_048_576) }? {
+        // A disabled/deny-only alias still identifies the native tool account.
+        // It grants no authority; the coordination selector separately requires enabled groups.
+        if !same_domain(&user, &group.sid)? {
+            continue;
+        }
+        let (name, kind) = account_name(&group.sid)?;
+        if NamespaceKey::claims_group_name(&name) {
+            observations.push(GroupObservation {
+                name,
+                kind,
+                attributes: group.attributes,
+                local_domain: true,
+            });
+        }
+    }
+    if !is_namespace_sandbox_role(&user_name, &observations)? {
+        return Ok(false);
+    }
+    ensure!(
+        kind == SidTypeUser,
+        "namespace token user is not a user account"
+    );
+    let local_user = local_user_sid(&user_name)?;
+    ensure!(
+        unsafe { EqualSid(user.as_ptr() as _, local_user.as_ptr() as _) } != 0,
+        "namespace token user is not the local SAM account"
+    );
+    Ok(true)
+}
+
+fn is_namespace_sandbox_role(name: &str, observations: &[GroupObservation]) -> Result<bool> {
+    Ok(namespace_role(name, observations, false)?.is_some())
+}
+
+/// Derives only a coordination name, after binding the actual user and local alias.
+///
+/// # Safety
+/// The caller retains a valid token HANDLE with TOKEN_QUERY rights for this call.
+pub unsafe fn sandbox_read_acl_mutex_name_for_token(token: HANDLE) -> Result<String> {
+    let user = unsafe { get_user_sid_bytes(token) }?;
+    let (name, kind) = account_name(&user)?;
+    ensure!(
+        kind == SidTypeUser,
+        "runner token user is not a user account"
+    );
+    let local_user = local_user_sid(&name)?;
+    ensure!(
+        unsafe { EqualSid(user.as_ptr() as _, local_user.as_ptr() as _) } != 0,
+        "runner token user is not the local SAM account"
+    );
+    let mut observations = Vec::new();
+    for group in unsafe { token_groups(token, 1_048_576) }? {
+        if !enabled(group.attributes) || !same_domain(&local_user, &group.sid)? {
+            continue;
+        }
+        let (name, kind) = account_name(&group.sid)?;
+        observations.push(GroupObservation {
+            name,
+            kind,
+            attributes: group.attributes,
+            local_domain: true,
+        });
+    }
+    Ok(select_namespace(&name, &observations)?.read_acl_mutex())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn key() -> NamespaceKey {
+        NamespaceKey::new(r"c:\qa-home", "S-1-5-21-1-1001")
+    }
+    fn group() -> GroupObservation {
+        GroupObservation {
+            name: key().group(),
+            kind: SidTypeAlias,
+            attributes: SE_GROUP_ENABLED as u32,
+            local_domain: true,
+        }
+    }
+    #[test]
+    fn namespace_coordination_reuses_account_and_mutex_factories() {
+        for user in [key().offline(), key().online().to_uppercase()] {
+            assert_eq!(select_namespace(&user, &[group()]).unwrap(), key());
+        }
+        assert_eq!(NamespaceKey::from_group_name(&key().group()), Some(key()));
+    }
+    #[test]
+    fn namespace_coordination_rejects_missing_ambiguous_or_wrong_user() {
+        assert!(select_namespace(&key().offline(), &[]).is_err());
+        assert!(select_namespace(&key().offline(), &[group(), group()]).is_err());
+        assert!(select_namespace("admin", &[group()]).is_err());
+    }
+    #[test]
+    fn namespace_coordination_rejects_disabled_deny_only_foreign_or_wrong_type() {
+        let mut value = group();
+        value.attributes = 0;
+        assert!(select_namespace(&key().offline(), &[value]).is_err());
+        let mut value = group();
+        value.attributes |= SE_GROUP_USE_FOR_DENY_ONLY as u32;
+        assert!(select_namespace(&key().offline(), &[value]).is_err());
+        let mut value = group();
+        value.local_domain = false;
+        assert!(select_namespace(&key().offline(), &[value]).is_err());
+        let mut value = group();
+        value.kind = SidTypeUser;
+        assert!(select_namespace(&key().offline(), &[value]).is_err());
+    }
+    #[test]
+    fn namespace_coordination_handles_non_account_domain_sids() {
+        fn sid(authority: u8, parts: &[u32]) -> Vec<u8> {
+            let mut value = vec![1, parts.len() as u8, 0, 0, 0, 0, 0, authority];
+            for part in parts {
+                value.extend_from_slice(&part.to_le_bytes());
+            }
+            value
+        }
+        let user = sid(5, &[21, 1, 2, 3, 1001]);
+        assert!(same_domain(&user, &sid(5, &[21, 1, 2, 3, 1014])).unwrap());
+        assert!(!same_domain(&user, &sid(5, &[21, 1, 2, 4, 1014])).unwrap());
+        for other in [sid(5, &[32, 545]), sid(5, &[5, 1, 2]), sid(15, &[3, 1])] {
+            assert!(!same_domain(&user, &other).unwrap());
+        }
+    }
+    #[test]
+    fn namespace_coordination_rejects_malformed_or_cross_namespace_labels() {
+        for name in [
+            "CodexAppDeepSeek-short".to_string(),
+            format!("CodexAppDeepSeek-{}", "A".repeat(64)),
+            key().group().to_uppercase(),
+            NamespaceKey::new("other", "owner").group(),
+        ] {
+            let mut value = group();
+            value.name = name;
+            assert!(select_namespace(&key().offline(), &[value]).is_err());
+        }
+    }
+    #[test]
+    fn service_role_does_not_confuse_packaged_owner_with_tool_accounts() {
+        assert!(!is_namespace_sandbox_role("normal_core_owner", &[]).unwrap());
+        assert!(is_namespace_sandbox_role(&key().offline(), &[group()]).unwrap());
+        assert!(is_namespace_sandbox_role(&key().online(), &[group()]).unwrap());
+        for attributes in [0, SE_GROUP_USE_FOR_DENY_ONLY as u32] {
+            let mut restricted = group();
+            restricted.attributes = attributes;
+            // Restrictions do not turn the account into a legitimate Core owner.
+            assert!(
+                is_namespace_sandbox_role(&key().offline(), std::slice::from_ref(&restricted))
+                    .unwrap()
+            );
+            assert!(
+                is_namespace_sandbox_role(&key().online(), std::slice::from_ref(&restricted))
+                    .unwrap()
+            );
+            // The same disabled membership still cannot authorize coordination.
+            assert!(select_namespace(&key().offline(), std::slice::from_ref(&restricted)).is_err());
+        }
+        // Another home's native key still classifies as a tool token; no target-home argument can adopt it.
+        let other =
+            NamespaceKey::for_directory("c:\\other-owned-home", "S-1-5-21-1-2-3-1001", 4, [8; 16]);
+        let mut other_group = group();
+        other_group.name = other.group();
+        assert!(is_namespace_sandbox_role(&other.offline(), &[other_group]).unwrap());
+        // A name alone is insufficient, and a conflicting observed namespace fails closed.
+        assert!(!is_namespace_sandbox_role(&key().offline(), &[]).unwrap());
+        assert!(is_namespace_sandbox_role("normal_core_owner", &[group()]).is_err());
+    }
+}
diff --git a/codex-rs/windows-sandbox-rs/src/namespace_key.rs b/codex-rs/windows-sandbox-rs/src/namespace_key.rs
