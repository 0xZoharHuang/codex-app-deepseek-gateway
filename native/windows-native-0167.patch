+// Restoring through an already-authorized handle works even after the owned
+// fixture explicitly denies its current owner WRITE_DAC. No privilege change.
+struct ReadonlyDaclFixtureRestore {
+    handle: std::fs::File,
+    descriptor: *mut c_void,
+    dacl: *mut windows_sys::Win32::Security::ACL,
+    control: u16,
+    restored: bool,
+}
+
+impl ReadonlyDaclFixtureRestore {
+    fn capture(path: &Path) -> anyhow::Result<Self> {
+        let handle = OpenOptions::new()
+            .access_mode(READ_CONTROL | windows_sys::Win32::Storage::FileSystem::WRITE_DAC)
+            .share_mode(
+                windows_sys::Win32::Storage::FileSystem::FILE_SHARE_READ
+                    | windows_sys::Win32::Storage::FileSystem::FILE_SHARE_WRITE
+                    | windows_sys::Win32::Storage::FileSystem::FILE_SHARE_DELETE,
+            )
+            .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)
+            .open(path)?;
+        let (dacl, descriptor) = unsafe { fetch_dacl_handle(path)? };
+        let mut control = 0;
+        let mut revision = 0;
+        if unsafe { GetSecurityDescriptorControl(descriptor, &mut control, &mut revision) } == 0 {
+            unsafe { LocalFree(descriptor as HLOCAL) };
+            return Err(std::io::Error::last_os_error().into());
+        }
+        Ok(Self {
+            handle,
+            descriptor,
+            dacl,
+            control,
+            restored: false,
+        })
+    }
+
+    fn restore(&mut self) -> anyhow::Result<()> {
+        use std::os::windows::io::AsRawHandle;
+        use windows_sys::Win32::Security::Authorization::SetSecurityInfo;
+        use windows_sys::Win32::Security::{
+            PROTECTED_DACL_SECURITY_INFORMATION, UNPROTECTED_DACL_SECURITY_INFORMATION,
+        };
+        let protection = if self.control & SE_DACL_PROTECTED != 0 {
+            PROTECTED_DACL_SECURITY_INFORMATION
+        } else {
+            UNPROTECTED_DACL_SECURITY_INFORMATION
+        };
+        let status = unsafe {
+            SetSecurityInfo(
+                self.handle.as_raw_handle() as _,
+                1,
+                DACL_SECURITY_INFORMATION | protection,
+                std::ptr::null_mut(),
+                std::ptr::null_mut(),
+                self.dacl,
+                std::ptr::null_mut(),
+            )
+        };
+        anyhow::ensure!(status == 0, "restore owned readonly fixture DACL: {status}");
+        self.restored = true;
+        Ok(())
+    }
+}
+
+impl Drop for ReadonlyDaclFixtureRestore {
+    fn drop(&mut self) {
+        if !self.restored {
+            if let Err(error) = self.restore() {
+                eprintln!("owned readonly fixture restoration failed: {error:#}");
+            }
+        }
+        unsafe { LocalFree(self.descriptor as HLOCAL) };
+    }
+}
