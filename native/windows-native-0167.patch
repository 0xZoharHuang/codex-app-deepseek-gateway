+            codex_windows_sandbox::sandbox_group_name_for_installation(previous)?;
+            previous
+                .namespace_id
+                .clone()
+                .context("protected installation has no namespace binding")?
+        }
+        Err(error) => return Err(error).context("inspect the registered namespace home"),
+    };
+    if let Some(previous) = previous {
+        ensure!(
+            previous.namespace_id.as_deref() == Some(namespace_id.as_str()),
+            crate::ipc::ServiceUnavailable(
+                "registered home directory namespace differs from the protected owner record"
+            )
+        );
+    }
+    Ok(namespace_id)
