+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum RunnerProcessObservation {
+    Exited(u32),
+    StillActive,
+    InspectionFailed { operation: &'static str, code: u32 },
+    UnexpectedWait(u32),
+}
+
+impl std::fmt::Display for RunnerProcessObservation {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Exited(code) => write!(
+                f,
+                "runner exited before IPC readiness (exit_code=0x{code:08x})"
+            ),
+            Self::StillActive => {
+                f.write_str("runner was still active when IPC startup failure was inspected")
+            }
+            Self::InspectionFailed { operation, code } => write!(
+                f,
+                "runner state inspection failed during {operation} (Windows error {code})"
+            ),
+            Self::UnexpectedWait(value) => write!(
+                f,
+                "runner state inspection returned unexpected wait result {value}"
+            ),
+        }
+    }
+}
+
+fn classify_runner_process(
+    wait_result: u32,
+    wait_error: u32,
+    read_exit_code: impl FnOnce() -> std::result::Result<u32, u32>,
+) -> RunnerProcessObservation {
+    match wait_result {
+        WAIT_OBJECT_0 => match read_exit_code() {
+            Ok(code) => RunnerProcessObservation::Exited(code),
+            Err(code) => RunnerProcessObservation::InspectionFailed {
+                operation: "GetExitCodeProcess",
+                code,
+            },
+        },
+        WAIT_TIMEOUT => RunnerProcessObservation::StillActive,
+        WAIT_FAILED => RunnerProcessObservation::InspectionFailed {
+            operation: "WaitForSingleObject",
+            code: wait_error,
+        },
+        other => RunnerProcessObservation::UnexpectedWait(other),
+    }
+}
+
+fn observe_runner_process(process: HANDLE) -> RunnerProcessObservation {
+    let wait_result = unsafe { WaitForSingleObject(process, 0) };
+    let wait_error = if wait_result == WAIT_FAILED {
+        unsafe { GetLastError() }
+    } else {
+        0
+    };
+    classify_runner_process(wait_result, wait_error, || {
+        let mut code = 0_u32;
+        if unsafe { GetExitCodeProcess(process, &mut code) } == 0 {
+            Err(unsafe { GetLastError() })
+        } else {
+            Ok(code)
+        }
+    })
+}
