+        unsafe { LocalFree(descriptor as HLOCAL) };
+        anyhow::ensure!(seeded?, "fresh inheritable marker must be added");
+        anyhow::ensure!(
+            restored != 0,
+            "restore existing non-inheriting child fixture"
+        );
+        child_before.push(acl_snapshot(&child));
+    }
+    assert_eq!(acl_snapshot(&stock), acl_snapshot(&adapted));
