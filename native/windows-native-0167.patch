+    fn snapshot(path: &Path) -> (u16, Vec<Vec<u8>>) {
+        unsafe {
+            let (dacl, descriptor) = crate::fetch_dacl_handle(path).unwrap();
+            assert!(!dacl.is_null());
+            let mut control = 0;
+            let mut revision = 0;
+            assert_ne!(
+                GetSecurityDescriptorControl(descriptor, &mut control, &mut revision),
+                0
+            );
+            let mut aces = Vec::new();
+            for index in 0..u32::from((*dacl).AceCount) {
+                let mut ace = std::ptr::null_mut();
+                assert_ne!(GetAce(dacl, index, &mut ace), 0);
+                let header = &*ace.cast::<ACE_HEADER>();
+                aces.push(
+                    std::slice::from_raw_parts(ace.cast::<u8>(), usize::from(header.AceSize))
+                        .to_vec(),
+                );
+            }
+            LocalFree(descriptor as HLOCAL);
+            (control, aces)
+        }
+    }
+
+    fn protect(path: &Path, owner: &str, deny: Option<&str>) {
+        let deny = deny
+            .map(|sid| format!("(D;;0x2;;;{sid})"))
+            .unwrap_or_default();
+        let sddl = format!("D:P{deny}(A;OICI;FA;;;{owner})(A;OICI;FA;;;SY)");
+        protect_sddl(path, &sddl);
+    }
+
+    fn protect_sddl(path: &Path, sddl: &str) {
+        unsafe {
+            let mut descriptor = std::ptr::null_mut();
+            assert_ne!(
+                ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                    to_wide(sddl).as_ptr(),
+                    SDDL_REVISION_1,
+                    &mut descriptor,
+                    std::ptr::null_mut(),
+                ),
+                0
+            );
+            assert_ne!(
+                SetFileSecurityW(
+                    to_wide(path).as_ptr(),
+                    DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION,
+                    descriptor
+                ),
+                0
+            );
+            LocalFree(descriptor as HLOCAL);
+
+            // SetFileSecurityW initially drops AI even from SDDL D:PAI.
+            // Prime the same DACL through the stock root-only SetSecurityInfo
+            // path before taking the regression baseline. This changes only
+            // Windows inheritance bookkeeping, never any ACE or permission.
+            let initial = snapshot(path);
+            let directory = std::fs::OpenOptions::new()
+                .access_mode(MAXIMUM_ALLOWED)
+                .share_mode(FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE)
+                .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)
+                .open(path)
+                .unwrap();
+            let mut current_acl = std::ptr::null_mut();
+            let mut current_descriptor = std::ptr::null_mut();
+            assert_eq!(
+                GetSecurityInfo(
+                    directory.as_raw_handle() as _,
+                    1,
+                    DACL_SECURITY_INFORMATION,
+                    std::ptr::null_mut(),
+                    std::ptr::null_mut(),
+                    &mut current_acl,
+                    std::ptr::null_mut(),
+                    &mut current_descriptor,
+                ),
+                0
+            );
+            let status = SetSecurityInfo(
+                directory.as_raw_handle() as _,
+                1,
+                DACL_SECURITY_INFORMATION,
+                std::ptr::null_mut(),
+                std::ptr::null_mut(),
+                current_acl,
+                std::ptr::null_mut(),
+            );
+            LocalFree(current_descriptor as HLOCAL);
+            assert_eq!(status, 0);
+            let canonical = snapshot(path);
+            assert_eq!(canonical.1, initial.1, "fixture priming cannot change ACEs");
+            assert_eq!(canonical.0, initial.0 | 0x0400, "stock AI bookkeeping only");
+        }
+    }
