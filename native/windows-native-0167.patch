+#[test]
+fn root_only_waits_for_cooperating_process_before_writing() -> anyhow::Result<()> {
+    use std::process::{Command, Stdio};
+    use std::sync::mpsc;
+    use std::time::{Duration, Instant};
+
+    let fixture = tempfile::tempdir()?;
+    let target = fixture.path().join("target");
+    let ready = fixture.path().join("ready");
+    let release = fixture.path().join("release");
+    std::fs::create_dir(&target)?;
+    let child_dir = target.join("child");
+    std::fs::create_dir(&child_dir)?;
+    let root_before = acl_snapshot(&target);
+    let child_before = acl_snapshot(&child_dir);
+    let mut child = Command::new(std::env::current_exe()?)
+        .args([
+            "--exact",
+            "acl::tests::root_only_cooperating_domain_child",
+            "--test-threads=1",
+        ])
+        .env("CAG_ACL_UNIT_ROOT_ONLY_TARGET", &target)
+        .env("CAG_ACL_UNIT_ROOT_ONLY_READY", &ready)
+        .env("CAG_ACL_UNIT_ROOT_ONLY_RELEASE", &release)
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()?;
+    let wait_until = Instant::now() + Duration::from_secs(3);
+    while !ready.exists() && Instant::now() < wait_until && child.try_wait()?.is_none() {
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    if !ready.exists() {
+        std::fs::write(&release, b"release after failed admission")?;
+        let status = child.wait()?;
+        anyhow::bail!("cooperating child did not acquire its domain: {status}");
+    }
+    let worker_target = target.clone();
+    let (started_tx, started_rx) = mpsc::channel();
+    let (done_tx, done_rx) = mpsc::channel();
+    let worker = std::thread::spawn(move || {
+        let result = (|| -> anyhow::Result<bool> {
+            let sid = LocalSid::from_string("S-1-5-21-915763429-1123581321-271828182-4403")?;
+            started_tx.send(())?;
+            unsafe {
+                ensure_allow_mask_aces_with_inheritance(
+                    &worker_target,
+                    &[sid.as_ptr()],
+                    FILE_READ_ATTRIBUTES,
+                    0,
+                )
+            }
+        })();
+        let _ = done_tx.send(result);
+    });
+    let while_held = (|| -> anyhow::Result<()> {
+        started_rx.recv_timeout(Duration::from_secs(2))?;
+        anyhow::ensure!(
+            matches!(
+                done_rx.recv_timeout(Duration::from_millis(200)),
+                Err(mpsc::RecvTimeoutError::Timeout)
+            ),
+            "root-only update must wait, not fail sharing or pass the held domain"
+        );
+        anyhow::ensure!(
+            acl_snapshot(&target) == root_before,
+            "root changed before domain admission"
+        );
+        Ok(())
+    })();
+    // Always release/wait the exact owned child and join the worker before
+    // surfacing a failed assertion; no process-name kill or detached helper.
+    std::fs::write(&release, b"release strict domain")?;
+    let child_status = child.wait()?;
+    worker.join().expect("root-only worker");
+    while_held?;
+    anyhow::ensure!(
+        child_status.success(),
+        "cooperating child failed: {child_status}"
+    );
+    anyhow::ensure!(
+        done_rx.recv_timeout(Duration::from_secs(2))??,
+        "grant was not added"
+    );
+    assert_eq!(acl_snapshot(&child_dir), child_before);
+    Ok(())
+}
