diff --git a/codex-rs/windows-sandbox-rs/src/app_package/project_mode.rs b/codex-rs/windows-sandbox-rs/src/app_package/project_mode.rs
new file mode 100644
index 0000000000000000000000000000000000000000..026c3841a27ede3b8c82f82ac034065fd021fe40
--- /dev/null
+++ b/codex-rs/windows-sandbox-rs/src/app_package/project_mode.rs
@@ -0,0 +1,162 @@
+//! Process-local mode request from the OS activation identity, never an authorization substitute.
+use anyhow::{Context, Result, ensure};
+use std::sync::OnceLock;
+
+const PACKAGE_NAME: &str = "CADSG.NativeRuntime";
+const SELECTOR: &str = "CODEX_WINDOWS_REGISTERED_CORE";
+static MODE: OnceLock<Option<bool>> = OnceLock::new();
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Role {
+    Cli,
+    Host,
+    Runner,
+}
+
+fn select(family: &str, application: &str, role: Role, inherited: Option<&str>) -> Result<bool> {
+    let (name, _) = family
+        .rsplit_once('_')
+        .context("invalid runtime package family")?;
+    ensure!(
+        name == PACKAGE_NAME,
+        "activation belongs to another runtime package"
+    );
+    let (actual_family, id) = application
+        .split_once('!')
+        .context("runtime activation has no application ID")?;
+    ensure!(
+        actual_family == family,
+        "runtime activation family differs from kernel package family"
+    );
+    let registered = match (role, id) {
+        (Role::Cli, "RuntimeRegisteredCore")
+        | (Role::Host, "RuntimeRegisteredCore" | "CodeModeHostRegistered")
+        | (Role::Runner, "CodexCoreCommandRunner") => true,
+        (Role::Cli, "RuntimeLegacy")
+        | (Role::Host, "RuntimeLegacy" | "CodeModeHostLegacy")
+        | (Role::Runner, "RuntimeLegacy") => false,
+        _ => anyhow::bail!("unknown or mismatched native runtime activation role"),
+    };
+    if let Some(inherited) = inherited {
+        ensure!(
+            matches!(inherited, "0" | "1"),
+            "invalid inherited native runtime mode"
+        );
+        ensure!(
+            (inherited == "1") == registered,
+            "inherited native runtime mode conflicts with OS activation"
+        );
+    }
+    Ok(registered)
+}
+
+/// Capture before native configuration, task or helper admission. No global environment write.
+pub fn initialize() -> Result<()> {
+    if MODE.get().is_some() {
+        return Ok(());
+    }
+    let image = std::env::current_exe().context("query native runtime image")?;
+    let name = image
+        .file_name()
+        .and_then(|n| n.to_str())
+        .unwrap_or_default();
+    let role = if name.eq_ignore_ascii_case("codex.exe") {
+        Some(Role::Cli)
+    } else if name.eq_ignore_ascii_case("codex-code-mode-host.exe") {
+        Some(Role::Host)
+    } else if name.eq_ignore_ascii_case("codex-command-runner.exe") {
+        Some(Role::Runner)
+    } else {
+        None
+    };
+    let family = unsafe {
+        crate::package_identity::process_package_family(
+            windows_sys::Win32::System::Threading::GetCurrentProcess(),
+        )
+    }?;
+    let selected = if let (Some(role), Some(family)) = (role, family) {
+        if family
+            .rsplit_once('_')
+            .is_some_and(|(name, _)| name == PACKAGE_NAME)
+        {
+            let application =
+                super::query_application_id()?.context("own runtime has no OS application ID")?;
+            let package = super::current_package_full_name()?
+                .context("own runtime has no package identity")?;
+            let root = super::staged_package_root(&crate::winutil::to_wide(package))?;
+            let expected = root.join("runtime").join(name);
+            ensure!(
+                dunce::canonicalize(image)?
+                    .as_os_str()
+                    .eq_ignore_ascii_case(dunce::canonicalize(expected)?.as_os_str()),
+                "own runtime image is outside its exact installed version directory"
+            );
+            let inherited = std::env::var(SELECTOR).ok();
+            Some(select(&family, &application, role, inherited.as_deref())?)
+        } else {
+            None
+        }
+    } else {
+        None
+    };
+    if MODE.set(selected).is_err() {
+        ensure!(
+            MODE.get() == Some(&selected),
+            "native runtime activation changed during capture"
+        );
+    }
+    Ok(())
+}
+
+pub(super) fn selected() -> Option<bool> {
+    MODE.get().copied().flatten()
+}
+
+/// A parent's captured request is carried only to its native host command and checked there.
+pub fn host_selector() -> Option<&'static str> {
+    selected().map(|mode| if mode { "1" } else { "0" })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    const FAMILY: &str = "CADSG.NativeRuntime_123456789abcd";
+    fn check(role: Role, id: &str, inherited: Option<&str>) -> Result<bool> {
+        select(FAMILY, &format!("{FAMILY}!{id}"), role, inherited)
+    }
+    #[test]
+    fn explicit_legacy_and_registered_cli_do_not_cross() {
+        assert_eq!(check(Role::Cli, "RuntimeLegacy", None).unwrap(), false);
+        assert_eq!(
+            check(Role::Cli, "RuntimeRegisteredCore", None).unwrap(),
+            true
+        );
+        assert!(check(Role::Cli, "RuntimeLegacy", Some("1")).is_err());
+        assert!(check(Role::Cli, "RuntimeRegisteredCore", Some("0")).is_err());
+    }
+    #[test]
+    fn host_checks_parent_mode_and_kernel_role() {
+        assert!(check(Role::Host, "RuntimeRegisteredCore", Some("1")).unwrap());
+        assert!(!check(Role::Host, "RuntimeLegacy", Some("0")).unwrap());
+        assert!(check(Role::Host, "CodeModeHostRegistered", Some("1")).unwrap());
+        assert!(!check(Role::Host, "CodeModeHostLegacy", Some("0")).unwrap());
+        assert!(check(Role::Host, "CodeModeHostLegacy", Some("1")).is_err());
+        assert!(check(Role::Host, "CodeModeHostRegistered", Some("0")).is_err());
+    }
+    #[test]
+    fn unknown_role_family_and_selector_fail_closed() {
+        assert!(check(Role::Cli, "Unknown", None).is_err());
+        assert!(check(Role::Host, "CodexCoreCommandRunner", None).is_err());
+        assert!(check(Role::Runner, "RuntimeRegisteredCore", None).is_err());
+        assert!(check(Role::Host, "RuntimeLegacy", Some("yes")).is_err());
+        assert!(
+            select(
+                "Other.Runtime_123456789abcd",
+                &format!("{FAMILY}!RuntimeLegacy"),
+                Role::Cli,
+                None
+            )
+            .is_err()
+        );
+    }
+}
