+    // Test-only native conditional-ACE context. SKIP_TOKEN_GROUPS admits an
+    // application SID without SAM lookup, S4U, or process-token changes.
+    struct NativeConditionalContext {
+        resource: windows_sys::Win32::Security::Authorization::AUTHZ_RESOURCE_MANAGER_HANDLE,
+        context: windows_sys::Win32::Security::Authorization::AUTHZ_CLIENT_CONTEXT_HANDLE,
+    }
+    impl Drop for NativeConditionalContext {
+        fn drop(&mut self) {
+            unsafe {
+                if !self.context.is_null() {
+                    windows_sys::Win32::Security::Authorization::AuthzFreeContext(self.context);
+                }
+                if !self.resource.is_null() {
+                    windows_sys::Win32::Security::Authorization::AuthzFreeResourceManager(
+                        self.resource,
+                    );
+                }
+            }
+        }
+    }
+    impl NativeConditionalContext {
+        fn new(sid: *mut c_void) -> Result<Self> {
+            use windows_sys::Win32::Security::Authorization::{
+                AUTHZ_RM_FLAG_NO_AUDIT, AUTHZ_SKIP_TOKEN_GROUPS, AuthzInitializeContextFromSid,
+                AuthzInitializeResourceManager,
+            };
+            let mut value = Self {
+                resource: std::ptr::null_mut(),
+                context: std::ptr::null_mut(),
+            };
+            ensure!(
+                unsafe {
+                    AuthzInitializeResourceManager(
+                        AUTHZ_RM_FLAG_NO_AUDIT,
+                        None,
+                        None,
+                        None,
+                        std::ptr::null(),
+                        &mut value.resource,
+                    )
+                } != 0,
+                "initialize own conditional-ACE context: {}",
+                std::io::Error::last_os_error()
+            );
+            ensure!(
+                unsafe {
+                    AuthzInitializeContextFromSid(
+                        AUTHZ_SKIP_TOKEN_GROUPS,
+                        sid,
+                        value.resource,
+                        std::ptr::null(),
+                        windows_sys::Win32::Foundation::LUID::default(),
+                        std::ptr::null(),
+                        &mut value.context,
+                    )
+                } != 0,
+                "initialize application-SID context: {}",
+                std::io::Error::last_os_error()
+            );
+            Ok(value)
+        }
+        fn check(&self, path: &Path, desired: u32) -> Result<(u32, u32)> {
+            use windows_sys::Win32::Security::Authorization::{
+                AUTHZ_ACCESS_REPLY, AUTHZ_ACCESS_REQUEST, AuthzAccessCheck,
+            };
+            let (descriptor, _) = native_descriptor(path)?;
+            let request = AUTHZ_ACCESS_REQUEST {
+                DesiredAccess: desired,
+                ..Default::default()
+            };
+            let (mut granted, mut audit, mut error) = (0, 0, 0);
+            let mut reply = AUTHZ_ACCESS_REPLY {
+                ResultListLength: 1,
+                GrantedAccessMask: &mut granted,
+                SaclEvaluationResults: &mut audit,
+                Error: &mut error,
+            };
+            ensure!(
+                unsafe {
+                    AuthzAccessCheck(
+                        0,
+                        self.context,
+                        &request,
+                        std::ptr::null_mut(),
+                        descriptor.as_ptr().cast_mut().cast(),
+                        std::ptr::null(),
+                        0,
+                        &mut reply,
+                        std::ptr::null_mut(),
+                    )
+                } != 0,
+                "native conditional access check: {}",
+                std::io::Error::last_os_error()
+            );
+            Ok((granted, error))
+        }
+    }
+    fn native_descriptor(path: &Path) -> Result<(Vec<u32>, u32)> {
+        use windows_sys::Win32::Security::{
+            GROUP_SECURITY_INFORMATION, GetKernelObjectSecurity, OWNER_SECURITY_INFORMATION,
+        };
+        let directory = std::fs::OpenOptions::new()
+            .access_mode(READ_CONTROL)
+            .share_mode(FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE)
+            .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)
+            .open(path)?;
+        let flags =
+            OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION;
+        let mut needed = 0;
+        unsafe {
+            GetKernelObjectSecurity(
+                directory.as_raw_handle() as _,
+                flags,
+                std::ptr::null_mut(),
+                0,
+                &mut needed,
+            );
+        }
+        ensure!(
+            (20..=1_048_576).contains(&needed),
+            "conditional descriptor size"
+        );
+        let mut data = vec![0_u32; (needed as usize).div_ceil(size_of::<u32>())];
+        ensure!(
+            unsafe {
+                GetKernelObjectSecurity(
+                    directory.as_raw_handle() as _,
+                    flags,
+                    data.as_mut_ptr().cast(),
+                    (data.len() * size_of::<u32>()) as u32,
+                    &mut needed,
+                )
+            } != 0,
+            "read raw conditional descriptor: {}",
+            std::io::Error::last_os_error()
+        );
+        Ok((data, needed))
+    }
+    fn descriptor_bytes(path: &Path) -> Result<Vec<u8>> {
+        let (data, bytes) = native_descriptor(path)?;
+        Ok(
+            unsafe { std::slice::from_raw_parts(data.as_ptr().cast::<u8>(), bytes as usize) }
+                .to_vec(),
+        )
+    }
+    fn install_inherited_conditional_parent(
+        path: &Path,
+        owner: &str,
+        subject: &str,
+        denied: u32,
+        complete: bool,
+    ) -> Result<()> {
+        use windows_sys::Win32::Security::{
+            GetSecurityDescriptorDacl, UNPROTECTED_DACL_SECURITY_INFORMATION,
+        };
+        use windows_sys::Win32::Storage::FileSystem::WRITE_DAC;
+        let source = path
+            .parent()
+            .context("conditional fixture needs a real parent")?;
+        // Windows supplies INHERITED_ACE on the child. Never forge an ID flag
+        // which SetSecurityInfo can legitimately remove during re-inheritance.
+        let source_sddl = format!(
+            "D:P(A;OICI;FA;;;{owner})(A;OICI;FA;;;SY)(A;;0x100080;;;{subject})(XD;CIIO;0x{denied:x};;;{subject};(@User.CADSGMissing == \"p17\"))(A;CIIO;0x{denied:x};;;{subject})"
+        );
+        protect_sddl(source, &source_sddl);
+        let initial = if complete {
+            METADATA_ACCESS
+        } else {
+            FILE_READ_ATTRIBUTES
+        };
+        let child_sddl =
+            format!("D:(A;OICI;FA;;;{owner})(A;OICI;FA;;;SY)(A;;0x{initial:x};;;{subject})");
+        unsafe {
+            let mut descriptor = std::ptr::null_mut();
+            ensure!(
+                ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                    to_wide(child_sddl).as_ptr(),
+                    SDDL_REVISION_1,
+                    &mut descriptor,
+                    std::ptr::null_mut()
+                ) != 0,
+                "create child inheritance fixture descriptor: {}",
+                std::io::Error::last_os_error()
+            );
+            let result = (|| -> Result<()> {
+                let (mut present, mut defaulted) = (0, 0);
+                let mut acl = std::ptr::null_mut();
+                ensure!(
+                    GetSecurityDescriptorDacl(descriptor, &mut present, &mut acl, &mut defaulted)
+                        != 0
+                        && present != 0
+                        && !acl.is_null(),
+                    "read explicit child fixture DACL"
+                );
+                let directory = std::fs::OpenOptions::new()
+                    .access_mode(READ_CONTROL | WRITE_DAC)
+                    .share_mode(FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE)
+                    .custom_flags(FILE_FLAG_BACKUP_SEMANTICS)
+                    .open(path)?;
+                let status = SetSecurityInfo(
+                    directory.as_raw_handle() as _,
+                    1,
+                    DACL_SECURITY_INFORMATION | UNPROTECTED_DACL_SECURITY_INFORMATION,
+                    std::ptr::null_mut(),
+                    std::ptr::null_mut(),
+                    acl,
+                    std::ptr::null_mut(),
+                );
+                ensure!(
+                    status == 0,
+                    "inherit real conditional parent DACL: {status}"
+                );
+                Ok(())
+            })();
+            LocalFree(descriptor as HLOCAL);
+            result
+        }
+    }
