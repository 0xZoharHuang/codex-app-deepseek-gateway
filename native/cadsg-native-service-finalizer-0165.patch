+/// Restore only the existing authenticated owner when a home is truly absent.
+/// No namespace is minted and no files are written for that watcher-only path.
+pub(crate) fn registration_namespace_binding(
+    record: &InstallationRecord,
+    previous: Option<&InstallationRecord>,
+) -> Result<String> {
+    if let Some(previous) = previous {
+        ensure!(
+            previous.user_sid == record.user_sid && previous.codex_home == record.codex_home,
+            crate::ipc::ServiceUnavailable(
+                "installation is already registered to a different owner or home"
+            )
+        );
+    }
+    let namespace_id = match std::fs::symlink_metadata(&record.codex_home) {
+        Ok(_) => {
+            codex_windows_sandbox::namespace_id_for_owner(&record.codex_home, &record.user_sid)?
+        }
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {
+            let previous = previous.context("missing home has no protected installation owner")?;
+            // Validate the persisted native factory input without querying or creating SAM state.
+            codex_windows_sandbox::sandbox_group_name_for_installation(previous)?;
+            previous
+                .namespace_id
+                .clone()
+                .context("protected installation has no namespace binding")?
+        }
+        Err(error) => return Err(error).context("inspect the registered namespace home"),
+    };
+    if let Some(previous) = previous {
+        ensure!(
+            previous.namespace_id.as_deref() == Some(namespace_id.as_str()),
+            crate::ipc::ServiceUnavailable(
+                "registered home directory namespace differs from the protected owner record"
+            )
+        );
+    }
+    Ok(namespace_id)
+}
