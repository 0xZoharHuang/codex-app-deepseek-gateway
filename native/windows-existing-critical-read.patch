+    #[test]
+    fn critical_read_builtin_rx_preserves_acl_without_namespace_grant() {
+        let temp = tempfile::tempdir().unwrap();
+        let leaf = temp.path().join("already-public.txt");
+        let sibling = temp.path().join("private-sibling.txt");
+        fs::write(&leaf, "synthetic readable input").unwrap();
+        fs::write(&sibling, "synthetic private sibling").unwrap();
+        let everyone = LocalSid::from_string("S-1-1-0").unwrap();
+        let namespace =
+            LocalSid::from_string("S-1-5-21-915763429-1123581321-271828182-4249").unwrap();
+        unsafe {
+            crate::acl::grant_read_execute_aces(&leaf, &[everyone.as_ptr()], 0).unwrap();
+        }
+        let before = acl_entries(&leaf);
+        let sibling_before = acl_entries(&sibling);
+        assert!(!path_mask_allows(&leaf, &[namespace.as_ptr()], FILE_GENERIC_READ, false).unwrap());
+        let mut value = payload_json();
+        value["read_roots"] = json!([leaf]);
+        value["critical_read_roots"] = json!([leaf]);
+        let payload: Payload = serde_json::from_value(value).unwrap();
+        super::grant_critical_read_acls(&payload, &[], namespace.as_ptr(), &mut Vec::new())
+            .expect("already-readable root is a no-op");
+        assert_eq!(acl_entries(&leaf), before);
+        assert_eq!(acl_entries(&sibling), sibling_before);
+        assert!(!path_mask_allows(&leaf, &[namespace.as_ptr()], FILE_GENERIC_READ, false).unwrap());
+    }
