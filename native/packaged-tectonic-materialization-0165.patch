+#[test]
+fn redirected_helper_directory_is_rejected() -> Result<()> {
+    let f = Fixture::new()?;
+    let bin = helper_bin_dir(&f.home);
+    let other = f.home.join("other");
+    fs::create_dir(&other)?;
+    fs::remove_dir(&bin)?;
+    let output = Command::new("cmd")
