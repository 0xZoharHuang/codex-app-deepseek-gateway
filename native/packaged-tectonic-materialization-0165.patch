+#[test]
+fn concurrent_cold_materializations_share_one_verified_cache() -> Result<()> {
+    let f = Fixture::new()?;
+    std::thread::scope(|scope| -> Result<()> {
+        let workers: Vec<_> = (0..8).map(|_| scope.spawn(|| f.resolve())).collect();
+        for worker in workers {
+            let destination = worker.join().expect("materialization worker")?;
+            assert_eq!(digest(&destination)?, f.sha);
+        }
+        Ok(())
+    })?;
+    assert_eq!(fs::read_dir(helper_bin_dir(&f.home))?.count(), 1);
+    Ok(())
+}
