+#[test]
+fn source_hash_mismatch_does_not_create_cache() -> Result<()> {
+    let f = Fixture::new()?;
+    fs::write(&f.source, b"changed source")?;
+    assert!(f.resolve().is_err());
+    assert!(f.cache_empty());
+    Ok(())
+}
