+use super::*;
+use std::cell::Cell;
+use std::process::Command;
+use tempfile::{TempDir, tempdir};
+
+struct Fixture {
+    _temp: TempDir,
+    root: PathBuf,
+    home: PathBuf,
+    source: PathBuf,
+    sha: String,
+}
+
+impl Fixture {
+    fn new() -> Result<Self> {
+        let temporary = tempdir()?;
+        let root = temporary.path().join("package");
+        let home = temporary.path().join("home");
+        let source = root.join(RELATIVE_EXE);
+        fs::create_dir_all(source.parent().unwrap())?;
+        fs::create_dir_all(helper_bin_dir(&home))?;
+        fs::write(&source, b"pinned component test bytes")?;
+        let sha = digest(&source)?;
+        Ok(Self {
+            _temp: temporary,
+            root,
+            home,
+            source,
+            sha,
+        })
+    }
+
+    fn resolve(&self) -> Result<PathBuf> {
+        Ok(resolve_pinned(
+            &self.source,
+            &self.root,
+            &self.home,
+            None,
+            &[],
+            |_| Ok(true),
+            &self.sha,
+        )?
+        .expect("known component"))
+    }
+
+    fn destination(&self) -> PathBuf {
+        helper_bin_dir(&self.home).join(format!("tectonic-{}.exe", self.sha))
+    }
+
+    fn cache_empty(&self) -> bool {
+        fs::read_dir(helper_bin_dir(&self.home))
+            .unwrap()
+            .next()
+            .is_none()
+    }
+}
+
+#[test]
+fn known_component_is_byte_identical_and_reuses_verified_cache() -> Result<()> {
+    let f = Fixture::new()?;
+    let first = f.resolve()?;
+    assert_eq!(fs::read(&first)?, fs::read(&f.source)?);
+    assert_eq!(digest(&first)?, f.sha);
+    let time = fs::metadata(&first)?.modified()?;
+    assert_eq!(f.resolve()?, first);
+    assert_eq!(fs::metadata(first)?.modified()?, time);
+    Ok(())
+}
+
+#[test]
+fn same_name_and_bytes_outside_registered_path_are_not_selected() -> Result<()> {
+    let f = Fixture::new()?;
+    let other = f.home.join("tectonic.exe");
+    fs::copy(&f.source, &other)?;
+    let called = Cell::new(false);
+    assert!(
+        resolve_pinned(
+            &other,
+            &f.root,
+            &f.home,
+            None,
+            &[],
+            |_| {
+                called.set(true);
+                Ok(true)
+            },
+            &f.sha,
+        )?
+        .is_none()
+    );
+    assert!(!called.get() && f.cache_empty());
+    Ok(())
+}
