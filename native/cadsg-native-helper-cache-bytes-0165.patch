+#[test]
+fn copy_replaces_cached_bytes_when_size_and_timestamps_match() {
+    let tmp = TempDir::new().expect("tempdir");
+    let source = tmp.path().join("source.exe");
+    let destination = tmp.path().join("cached.exe");
+    let first = vec![3u8; 160 * 1024];
+    let mut second = first.clone();
+    *second.last_mut().unwrap() = 8;
+    let stamp = std::time::SystemTime::UNIX_EPOCH + std::time::Duration::from_secs(1_700_000_000);
+    for (path, bytes) in [(&source, &first), (&destination, &second)] {
+        fs::write(path, bytes).unwrap();
+        fs::OpenOptions::new()
+            .write(true)
+            .open(path)
+            .unwrap()
+            .set_modified(stamp)
+            .unwrap();
+    }
+
+    assert!(!destination_is_fresh(&source, &destination).unwrap());
+    assert_eq!(
+        copy_from_source_if_needed(&source, &destination).unwrap(),
+        CopyOutcome::ReCopied
+    );
+    assert_eq!(fs::read(&destination).unwrap(), first);
+    assert_eq!(
+        copy_from_source_if_needed(&source, &destination).unwrap(),
+        CopyOutcome::Reused
+    );
+}
+
+#[cfg(windows)]
+#[test]
+fn locked_stale_helper_is_preserved_until_replacement_can_succeed() {
+    use std::os::windows::fs::OpenOptionsExt;
+
+    let tmp = TempDir::new().expect("tempdir");
+    let source = tmp.path().join("source.exe");
+    let destination = tmp.path().join("cached.exe");
+    fs::write(&source, b"new-binary").unwrap();
+    fs::write(&destination, b"old-binary").unwrap();
+    // FILE_SHARE_READ lets the content comparison run, but denies deletion/replacement.
+    let held = fs::OpenOptions::new()
+        .read(true)
+        .share_mode(1)
+        .open(&destination)
+        .unwrap();
+    assert!(copy_from_source_if_needed(&source, &destination).is_err());
+    assert_eq!(fs::read(&destination).unwrap(), b"old-binary");
+    drop(held);
+    assert_eq!(
+        copy_from_source_if_needed(&source, &destination).unwrap(),
+        CopyOutcome::ReCopied
+    );
+    assert_eq!(fs::read(&destination).unwrap(), b"new-binary");
+}
