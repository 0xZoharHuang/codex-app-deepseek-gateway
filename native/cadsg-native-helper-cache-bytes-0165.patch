+
+fn helper_contents_match(source: fs::File, destination: fs::File) -> std::io::Result<bool> {
+    const BUFFER_SIZE: usize = 64 * 1024;
+    let mut source = BufReader::with_capacity(BUFFER_SIZE, source);
+    let mut destination = BufReader::with_capacity(BUFFER_SIZE, destination);
+    loop {
+        let left = source.fill_buf()?;
+        let right = destination.fill_buf()?;
+        let count = left.len().min(right.len());
+        if count == 0 {
+            return Ok(left.is_empty() && right.is_empty());
+        }
+        if left[..count] != right[..count] {
+            return Ok(false);
+        }
+        source.consume(count);
+        destination.consume(count);
+    }
 }
 
