+fn current_token_identity() -> Result<TokenIdentity> {
+    let mut raw = null_mut();
+    ensure!(
+        unsafe { OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut raw) } != 0,
+        "query own token"
+    );
+    let token = unsafe { OwnedHandle::from_raw_handle(raw) };
+    let mut needed = 0;
+    unsafe { GetTokenInformation(token.as_raw_handle(), TokenUser, null_mut(), 0, &mut needed) };
+    ensure!(needed != 0, "missing token user size");
+    let mut buffer = vec![0usize; (needed as usize).div_ceil(size_of::<usize>())];
+    ensure!(
+        unsafe {
+            GetTokenInformation(
+                token.as_raw_handle(),
+                TokenUser,
+                buffer.as_mut_ptr().cast(),
+                needed,
+                &mut needed,
+            )
+        } != 0,
+        "query token user"
+    );
+    let user = unsafe { &*buffer.as_ptr().cast::<TOKEN_USER>() };
+    let mut text = null_mut();
+    ensure!(
+        unsafe { ConvertSidToStringSidW(user.User.Sid, &mut text) } != 0,
+        "format own SID"
+    );
+    let sid = unsafe {
+        let mut length = 0;
+        while *text.add(length) != 0 {
+            length += 1;
+        }
+        let result = String::from_utf16(std::slice::from_raw_parts(text, length));
+        LocalFree(text.cast());
+        result?
+    };
+    let mut elevation_type = 0u32;
+    ensure!(
+        unsafe {
+            GetTokenInformation(
+                token.as_raw_handle(),
+                TokenElevationType,
+                (&mut elevation_type as *mut u32).cast(),
+                4,
+                &mut needed,
+            )
+        } != 0,
+        "query token elevation type"
+    );
+    Ok(TokenIdentity {
+        sid,
+        elevation_type,
+    })
+}
