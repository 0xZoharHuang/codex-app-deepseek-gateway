+fn own_pipe() -> Result<(OwnedHandle, OwnedHandle)> {
+    let attributes = SECURITY_ATTRIBUTES {
+        nLength: size_of::<SECURITY_ATTRIBUTES>() as u32,
+        lpSecurityDescriptor: null_mut(),
+        bInheritHandle: 1,
+    };
+    let mut read = null_mut();
+    let mut write = null_mut();
+    ensure!(
+        unsafe { CreatePipe(&mut read, &mut write, &attributes, 0) } != 0,
+        "create isolated anonymous pipe: {}",
+        std::io::Error::last_os_error()
+    );
+    // SAFETY: CreatePipe returned two distinct, uniquely owned handles.
+    let read = unsafe { OwnedHandle::from_raw_handle(read) };
+    let write = unsafe { OwnedHandle::from_raw_handle(write) };
+    ensure!(
+        unsafe { SetHandleInformation(read.as_raw_handle(), HANDLE_FLAG_INHERIT, 0) } != 0,
+        "make own pipe reader non-inheritable: {}",
+        std::io::Error::last_os_error()
+    );
+    Ok((read, write))
+}
+
+fn pipe_eof(read: &OwnedHandle) -> Result<bool> {
+    let mut available = 0;
+    let ok = unsafe {
+        PeekNamedPipe(
+            read.as_raw_handle(),
+            null_mut(),
+            0,
+            null_mut(),
+            &mut available,
+            null_mut(),
+        )
+    };
+    if ok != 0 {
+        ensure!(
+            available == 0,
+            "unrelated fixture pipe unexpectedly carried data"
+        );
+        return Ok(false);
+    }
+    let error = unsafe { GetLastError() };
+    if error == ERROR_BROKEN_PIPE {
+        return Ok(true);
+    }
+    bail!(
+        "inspect isolated fixture pipe: {}",
+        std::io::Error::from_raw_os_error(error as i32)
+    )
+}
+
+fn wait_eof(read: &OwnedHandle, bound: Duration) -> Result<bool> {
+    let deadline = Instant::now() + bound;
+    loop {
+        if pipe_eof(read)? {
+            return Ok(true);
+        }
+        if Instant::now() >= deadline {
+            return Ok(false);
+        }
+        thread::sleep(Duration::from_millis(5));
+    }
+}
+
+enum ForegroundOwned {
+    Native(OwnedHandle),
+    Original(Child),
+}
+
+impl ForegroundOwned {
+    fn as_raw_handle(&self) -> HANDLE {
+        match self {
+            Self::Native(process) => process.as_raw_handle(),
+            Self::Original(child) => child.as_raw_handle(),
+        }
+    }
+}
+
+struct ReleaseGate {
+    release: PathBuf,
+    nonce: String,
+    foreground: Option<ForegroundOwned>,
+    foreground_identity: Option<(u32, u64)>,
+    process: Option<OwnedHandle>,
+    finished: bool,
+}
+
+impl ReleaseGate {
+    fn new(root: &Path, nonce: &str) -> Self {
+        Self {
+            release: root.join("release"),
+            nonce: nonce.into(),
+            foreground: None,
+            foreground_identity: None,
+            process: None,
+            finished: false,
+        }
+    }
+
+    fn adopt_foreground(&mut self, process: OwnedHandle) -> Result<()> {
+        self.foreground = Some(ForegroundOwned::Native(process));
+        let handle = self
+            .foreground
+            .as_ref()
+            .context("missing foreground handle")?
+            .as_raw_handle();
+        let pid = unsafe { GetProcessId(handle) };
+        let birth = process_birth(handle)?;
+        ensure!(pid != 0, "foreground process identifier missing");
+        self.foreground_identity = Some((pid, birth));
+        Ok(())
+    }
+
+    fn adopt_original_foreground(&mut self, child: Child) -> Result<()> {
+        self.foreground = Some(ForegroundOwned::Original(child));
+        let handle = self
+            .foreground
+            .as_ref()
+            .context("missing original foreground")?
+            .as_raw_handle();
+        let pid = unsafe { GetProcessId(handle) };
+        let birth = process_birth(handle)?;
+        ensure!(pid != 0, "original foreground process identifier missing");
+        self.foreground_identity = Some((pid, birth));
+        Ok(())
+    }
+
+    fn observe_grandchild(&mut self) -> Result<()> {
+        if self.process.is_some() {
+            return Ok(());
+        }
+        let path = self
+            .release
+            .parent()
+            .context("missing fixture root")?
+            .join("foreground.json");
+        let raw = match fs::read(path) {
+            Ok(raw) => raw,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+            Err(error) => return Err(error.into()),
+        };
+        let family: Foreground = serde_json::from_slice(&raw)?;
+        ensure!(
+            family.own.nonce == self.nonce
+                && family.own.role == "foreground"
+                && Some((family.own.pid, family.own.creation_time)) == self.foreground_identity,
+            "foreground receipt does not identify our returned process"
+        );
+        if let (Some(pid), Some(birth)) = (family.grandchild_pid, family.grandchild_birth) {
+            self.process = Some(open_own_process(pid, birth)?);
+        }
+        Ok(())
+    }
+
+    fn finish(&mut self) -> Result<()> {
+        fs::write(&self.release, b"release")?;
+        let process = self
+            .process
+            .as_ref()
+            .context("own child was not admitted")?;
+        ensure!(
+            unsafe { WaitForSingleObject(process.as_raw_handle(), 3_000) } == WAIT_OBJECT_0,
+            "own child did not finish after its release gate"
+        );
+        let mut code = 0;
+        ensure!(
+            unsafe { GetExitCodeProcess(process.as_raw_handle(), &mut code) } != 0 && code == 0,
+            "own gated child did not exit successfully; code={code}"
+        );
+        self.finished = true;
+        Ok(())
+    }
+}
+
+impl Drop for ReleaseGate {
+    fn drop(&mut self) {
+        if !self.finished {
+            let _ = fs::write(&self.release, b"release");
+            let _ = self.observe_grandchild();
+            for (role, process) in [
+                (
+                    "foreground",
+                    self.foreground.as_ref().map(ForegroundOwned::as_raw_handle),
+                ),
+                (
+                    "grandchild",
+                    self.process.as_ref().map(AsRawHandle::as_raw_handle),
+                ),
+            ] {
+                if let Some(process) = process {
+                    if unsafe { WaitForSingleObject(process, 3_000) } != WAIT_OBJECT_0 {
+                        let pid = unsafe { GetProcessId(process) };
+                        let birth = process_birth(process).ok();
+                        // Every handle is owned from the actual spawn or exact verified birth.
+                        unsafe {
+                            TerminateProcess(process, 0xee);
+                            WaitForSingleObject(process, 3_000);
+                        }
+                        eprintln!("failed fixture exact {role} cleanup pid={pid} birth={birth:?}");
+                    }
+                }
+            }
+        }
+    }
+}
+
+fn role_command(payload: &Payload) -> Result<Command> {
+    let mut command = Command::new(std::env::current_exe()?);
+    command.args([
+        "--ignored",
+        "--exact",
+        ROLE_TEST,
+        "--nocapture",
+        "--test-threads",
+        "1",
+        "--",
+    ]);
+    command.current_dir(&payload.root);
+    crate::launch_environment::configure_command(
+        &mut command,
+        &BASE64.encode(serde_json::to_vec(payload)?),
+    )?;
+    Ok(command)
+}
+
+fn open_own_process(pid: u32, birth: u64) -> Result<OwnedHandle> {
+    let handle = unsafe {
+        OpenProcess(
+            PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE_ACCESS | 1,
+            0,
+            pid,
+        )
+    };
+    ensure!(!handle.is_null(), "open own process");
+    let process = unsafe { OwnedHandle::from_raw_handle(handle) };
+    ensure!(
+        process_birth(process.as_raw_handle())? == birth,
+        "PID was reused"
+    );
+    Ok(process)
+}
+
+fn bounded_foreground_wait(release: &mut ReleaseGate) -> Result<std::process::ExitStatus> {
+    let deadline = Instant::now() + Duration::from_secs(4);
+    loop {
+        release.observe_grandchild()?;
+        let handle = release
+            .foreground
+            .as_ref()
+            .context("foreground was not adopted immediately")?
+            .as_raw_handle();
+        let wait = unsafe { WaitForSingleObject(handle, 20) };
+        if wait == WAIT_OBJECT_0 {
+            release.observe_grandchild()?;
+            return match release
+                .foreground
+                .as_mut()
+                .context("foreground handle lost")?
+            {
+                ForegroundOwned::Native(process) => {
+                    super::wait_process(process).map_err(Into::into)
+                }
+                ForegroundOwned::Original(child) => child.wait().map_err(Into::into),
+            };
+        }
+        ensure!(
+            wait == 0x102,
+            "foreground wait failed: {}",
+            std::io::Error::last_os_error()
+        );
+        ensure!(
+            Instant::now() < deadline,
+            "owned foreground exceeded fixture deadline pid={} birth={}; cleanup owns the exact handle",
+            unsafe { GetProcessId(handle) },
+            process_birth(handle)?
+        );
+    }
+}
+
+fn publish(path: &Path, value: &impl Serialize) -> Result<()> {
+    let temporary = path.with_extension("tmp");
+    fs::write(&temporary, serde_json::to_vec(value)?)?;
+    fs::rename(temporary, path)?;
+    Ok(())
+}
+
+fn load_ready(root: &Path, nonce: &str) -> Result<Ready> {
+    let deadline = Instant::now() + Duration::from_secs(3);
+    loop {
+        if let Ok(raw) = fs::read(root.join("grandchild.json")) {
+            let ready: Ready = serde_json::from_slice(&raw)?;
+            ensure!(
+                ready.nonce == nonce && ready.role == "grandchild",
+                "grandchild nonce or role mismatch"
+            );
+            return Ok(ready);
+        }
+        ensure!(Instant::now() < deadline, "grandchild readiness missing");
+        thread::sleep(Duration::from_millis(5));
+    }
+}
+
+fn run_family_case(original_foreground: bool, large_payload: bool) -> Result<()> {
+    let root = tempfile::Builder::new().prefix(PREFIX).tempdir()?;
+    let nonce = format!(
+        "{}-{}",
+        std::process::id(),
+        SystemTime::now().duration_since(UNIX_EPOCH)?.as_nanos()
+    );
+    let payload = Payload {
+        root: root.path().to_path_buf(),
+        nonce,
+        role: "foreground".into(),
+        padding: if large_payload {
+            "payload-中文-".repeat(4_000)
+        } else {
+            String::new()
+        },
+        exit_code: 0,
+    };
+    let parent_token = current_token_identity()?;
+    let before_parent = std::env::var_os("CODEX_SANDBOX_LAUNCH_COUNT");
+    let parent_utf16 = std::env::var_os("CAG_COMPONENT_NONUNICODE")
+        .map(|value| value.encode_wide().collect::<Vec<_>>() == [0xd800]);
+    ensure!(
+        parent_utf16 != Some(false),
+        "optional UTF16 fixture marker contains an unexpected value"
+    );
+    let (read, write) = own_pipe()?;
+    let mut release = ReleaseGate::new(root.path(), &payload.nonce);
+    let mut command = role_command(&payload)?;
+    if original_foreground {
+        // Old status() is exactly this std::Command spawn followed by Child::wait.
+        release.adopt_original_foreground(
+            command
+                .stdin(Stdio::null())
+                .stdout(Stdio::null())
+                .stderr(Stdio::null())
+                .creation_flags(0x0800_0000)
+                .spawn()?,
+        )?;
+    } else {
+        release.adopt_foreground(super::spawn_with_null_stdio(&command)?)?;
+    }
+    let (foreground_pid, foreground_birth) = release
+        .foreground_identity
+        .context("missing owned foreground identity")?;
+    drop(write);
+    let status = bounded_foreground_wait(&mut release)?;
+    ensure!(status.success(), "foreground status was {status}");
+    let family: Foreground =
+        serde_json::from_slice(&fs::read(root.path().join("foreground.json"))?)?;
+    ensure!(
+        family.own.pid == foreground_pid && family.own.creation_time == foreground_birth,
+        "foreground receipt differs from returned handle"
+    );
+    let grandchild = load_ready(root.path(), &payload.nonce)?;
+    ensure!(
+        family.grandchild_pid == Some(grandchild.pid)
+            && family.grandchild_birth == Some(grandchild.creation_time),
+        "grandchild chain identity mismatch"
+    );
+    let observed_grandchild = release
+        .process
+        .as_ref()
+        .context("grandchild was not adopted when first observed")?;
+    ensure!(
+        unsafe { GetProcessId(observed_grandchild.as_raw_handle()) } == grandchild.pid
+            && process_birth(observed_grandchild.as_raw_handle())? == grandchild.creation_time,
+        "observed grandchild identity differs from readiness"
+    );
+    for ready in [&family.own, &grandchild] {
+        ensure!(
+            ready.token == parent_token && ready.cwd == root.path().canonicalize()?,
+            "caller token/elevation/cwd changed"
+        );
+        ensure!(
+            ready.stdio_valid && ready.read_eof && ready.writes_succeeded,
+            "NUL standard stream contract failed"
+        );
+        ensure!(
+            ready.environment_transport == large_payload
+                && ready.unrelated_utf16_preserved == parent_utf16,
+            "payload/environment contract failed"
+        );
+    }
+    ensure!(
+        std::env::var_os("CODEX_SANDBOX_LAUNCH_COUNT") == before_parent,
+        "parent transport environment changed"
+    );
+    let eof = wait_eof(&read, Duration::from_millis(500))?;
+    ensure!(
+        child_running(
+            release
+                .process
+                .as_ref()
+                .context("missing grandchild")?
+                .as_raw_handle()
+        )?,
+        "grandchild not alive at EOF observation"
+    );
+    ensure!(
+        eof != original_foreground,
+        "unexpected caller pipe EOF while grandchild alive"
+    );
+    println!(
+        "family foreground={:?} grandchild={:?} original_foreground={original_foreground} caller_pipe_EOF={eof}",
+        family.own, grandchild
+    );
+    release.finish()?;
+    ensure!(
+        wait_eof(&read, Duration::from_millis(500))?,
+        "caller pipe not released after grandchild natural exit"
+    );
+    Ok(())
+}
+
