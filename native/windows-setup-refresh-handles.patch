+#[test]
+#[ignore = "Own component helper/grandchild role; never a product setup entrypoint"]
+fn component_role() -> Result<()> {
+    let argument = std::env::args()
+        .last()
+        .context("component payload absent")?;
+    let environment_transport = argument == crate::launch_environment::ARG;
+    let encoded = if environment_transport {
+        crate::environment_transport::decode(std::env::vars_os())?
+    } else {
+        ensure!(
+            !std::env::vars_os().any(|(key, _)| crate::environment_transport::is_key(&key)),
+            "stale launcher keys leaked"
+        );
+        argument
+    };
+    let payload: Payload = serde_json::from_slice(&BASE64.decode(encoded)?)?;
+    ensure!(
+        payload.padding
+            == if environment_transport {
+                "payload-中文-".repeat(4_000)
+            } else {
+                String::new()
+            },
+        "payload content changed"
+    );
+    let root = payload.root.canonicalize()?;
+    ensure!(
+        root.parent() == Some(std::env::temp_dir().canonicalize()?.as_path())
+            && root
+                .file_name()
+                .is_some_and(|n| n.to_string_lossy().starts_with(PREFIX))
+            && fs::symlink_metadata(&payload.root)?.file_attributes() & 0x400 == 0,
+        "fixture root is redirected or outside own temp"
+    );
+    let handles = [STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE]
+        .map(|which| unsafe { GetStdHandle(which) });
+    let stdio_valid = handles
+        .iter()
+        .all(|handle| !handle.is_null() && *handle != -1isize as HANDLE);
+    ensure!(stdio_valid, "NUL stdio handles absent");
+    let mut input = [0u8; 1];
+    let read_eof = std::io::stdin().read(&mut input)? == 0;
+    std::io::stdout().write_all(b"ignored component output")?;
+    std::io::stderr().write_all(b"ignored component error")?;
+    std::io::stdout().flush()?;
+    std::io::stderr().flush()?;
+    let unrelated_utf16_preserved = std::env::var_os("CAG_COMPONENT_NONUNICODE")
+        .map(|v| v.encode_wide().collect::<Vec<_>>() == [0xd800]);
+    let own = Ready {
+        nonce: payload.nonce.clone(),
+        role: payload.role.clone(),
+        pid: std::process::id(),
+        creation_time: process_birth(unsafe { GetCurrentProcess() })?,
+        token: current_token_identity()?,
+        cwd: std::env::current_dir()?.canonicalize()?,
+        stdio_valid,
+        read_eof,
+        writes_succeeded: true,
+        environment_transport,
+        unrelated_utf16_preserved,
+    };
+    match payload.role.as_str() {
+        "foreground" => {
+            if payload.exit_code != 0 {
+                publish(
+                    &root.join("foreground.json"),
+                    &Foreground {
+                        own,
+                        grandchild_pid: None,
+                        grandchild_birth: None,
+                    },
+                )?;
+                std::process::exit(payload.exit_code as i32);
+            }
+            let mut next = payload.clone();
+            next.role = "grandchild".into();
+            // Unchanged J17 spawning primitive: std::Command/null stdio/no-window.
+            let child = role_command(&next)?
+                .stdin(Stdio::null())
+                .stdout(Stdio::null())
+                .stderr(Stdio::null())
+                .creation_flags(0x0800_0000)
+                .spawn()?;
+            let grandchild_pid = child.id();
+            let grandchild_birth = process_birth(child.as_raw_handle())?;
+            publish(
+                &root.join("foreground.json"),
+                &Foreground {
+                    own,
+                    grandchild_pid: Some(grandchild_pid),
+                    grandchild_birth: Some(grandchild_birth),
+                },
+            )?;
+            drop(child); // Closing a process handle does not terminate native background work.
+        }
+        "grandchild" => {
+            publish(&root.join("grandchild.json"), &own)?;
+            let deadline = Instant::now() + Duration::from_secs(8);
+            while !root.join("release").exists() {
+                ensure!(
+                    Instant::now() < deadline,
+                    "owned grandchild release deadline exceeded"
+                );
+                thread::sleep(Duration::from_millis(5));
+            }
+        }
+        _ => bail!("unknown component role"),
+    }
+    Ok(())
+}
