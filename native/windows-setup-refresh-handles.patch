+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn CompareStringOrdinal(
+        a: *const u16,
+        na: i32,
+        b: *const u16,
+        nb: i32,
+        ignore_case: i32,
+    ) -> i32;
+}
+
+fn compare_keys(a: &std::ffi::OsStr, b: &std::ffi::OsStr) -> io::Result<Ordering> {
+    let a: Vec<_> = a.encode_wide().collect();
+    let b: Vec<_> = b.encode_wide().collect();
+    let na = i32::try_from(a.len()).map_err(|_| io::ErrorKind::InvalidInput)?;
+    let nb = i32::try_from(b.len()).map_err(|_| io::ErrorKind::InvalidInput)?;
+    // SAFETY: Both counted UTF-16 slices are valid throughout this call.
+    match unsafe { CompareStringOrdinal(a.as_ptr(), na, b.as_ptr(), nb, 1) } {
+        1 => Ok(Ordering::Less),
+        2 => Ok(Ordering::Equal),
+        3 => Ok(Ordering::Greater),
+        _ => Err(io::Error::last_os_error()),
+    }
+}
+
+fn environment_with_payload_overrides(command: &Command) -> io::Result<Vec<u16>> {
+    // configure_command only adds/removes its invocation-scoped payload keys.
+    // Preserve every other inherited value as UTF-16, including non-UTF-8 values.
+    let mut entries: Vec<(OsString, OsString)> = std::env::vars_os().collect();
+    for (key, value) in command.get_envs() {
+        if !crate::environment_transport::is_key(key) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "setup helper may only override launch-payload environment keys",
+            ));
+        }
+        let mut kept = Vec::with_capacity(entries.len() + 1);
+        for (old_key, old_value) in entries {
+            if compare_keys(&old_key, key)? != Ordering::Equal {
+                kept.push((old_key, old_value));
+            }
+        }
+        if let Some(value) = value {
+            kept.push((key.to_os_string(), value.to_os_string()));
+        }
+        entries = kept;
+    }
+    let mut error = None;
+    entries.sort_by(|a, b| match compare_keys(&a.0, &b.0) {
+        Ok(order) => order,
+        Err(value) => {
+            error = Some(value);
+            Ordering::Equal
+        }
+    });
+    if let Some(error) = error {
+        return Err(error);
+    }
+    let mut block = Vec::new();
+    for (key, value) in entries {
+        block.extend(key.encode_wide());
+        block.push(b'=' as u16);
+        block.extend(value.encode_wide());
+        block.push(0);
+    }
+    if block.is_empty() {
+        block.push(0);
+    }
+    block.push(0);
+    Ok(block)
+}
+
+// Mirror the existing CRT quoting rules over UTF-16 code units so a valid
+// Windows OsStr (including unpaired surrogates) never passes through UTF-8.
+fn command_line(command: &Command) -> io::Result<Vec<u16>> {
+    let mut line = Vec::new();
+    for (index, value) in std::iter::once(command.get_program())
+        .chain(command.get_args())
+        .enumerate()
+    {
+        let value: Vec<u16> = value.encode_wide().collect();
+        if value.contains(&0) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "NUL in setup argument",
+            ));
+        }
+        if index > 0 {
+            line.push(b' ' as u16);
+        }
+        let quoted = value.is_empty() || value.iter().any(|x| matches!(*x, 9 | 10 | 13 | 32 | 34));
+        if !quoted {
+            line.extend(value);
+            continue;
+        }
+        line.push(b'"' as u16);
+        let mut slashes = 0;
+        for unit in value {
+            if unit == b'\\' as u16 {
+                slashes += 1;
+                continue;
+            }
+            if unit == b'"' as u16 {
+                line.extend(std::iter::repeat_n(b'\\' as u16, slashes * 2 + 1));
+            } else {
+                line.extend(std::iter::repeat_n(b'\\' as u16, slashes));
+            }
+            line.push(unit);
+            slashes = 0;
+        }
+        line.extend(std::iter::repeat_n(b'\\' as u16, slashes * 2));
+        line.push(b'"' as u16);
+    }
+    line.push(0);
+    Ok(line)
+}
+
+fn spawn_with_null_stdio(command: &Command) -> io::Result<OwnedHandle> {
+    let program = resolve_program(command.get_program())?;
+    let mut command_line = command_line(command)?;
+    let environment = environment_with_payload_overrides(command)?;
+    let cwd = command.get_current_dir().map(to_wide);
+    let null = OpenOptions::new().read(true).write(true).open("NUL")?;
+    let mut inherited = std::ptr::null_mut();
+    // SAFETY: Duplicate only the newly opened NUL handle, never caller stdio.
+    if unsafe {
+        DuplicateHandle(
+            GetCurrentProcess(),
+            null.as_raw_handle(),
+            GetCurrentProcess(),
+            &mut inherited,
+            0,
+            1,
+            DUPLICATE_SAME_ACCESS,
+        )
+    } == 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: A successful DuplicateHandle returned a uniquely owned handle.
+    let inherited = unsafe { OwnedHandle::from_raw_handle(inherited) };
+    let mut attributes = ProcThreadAttributeList::new(1)?;
+    attributes.set_handle_list(vec![inherited.as_raw_handle()])?;
+    let mut startup: STARTUPINFOEXW = unsafe { std::mem::zeroed() };
+    startup.StartupInfo.cb = std::mem::size_of::<STARTUPINFOEXW>() as u32;
+    startup.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
+    startup.StartupInfo.hStdInput = inherited.as_raw_handle();
+    startup.StartupInfo.hStdOutput = inherited.as_raw_handle();
+    startup.StartupInfo.hStdError = inherited.as_raw_handle();
+    startup.lpAttributeList = attributes.as_mut_ptr();
+    let mut child: PROCESS_INFORMATION = unsafe { std::mem::zeroed() };
+    // SAFETY: All strings, environment, allowed handle and attributes outlive creation.
+    // bInheritHandles must be TRUE for the explicit HANDLE_LIST, which excludes all
+    // other handles. The caller waits on the exact returned process handle.
+    if unsafe {
+        CreateProcessW(
+            program.as_ptr(),
+            command_line.as_mut_ptr(),
+            std::ptr::null(),
+            std::ptr::null(),
+            1,
+            CREATE_NO_WINDOW | CREATE_UNICODE_ENVIRONMENT | EXTENDED_STARTUPINFO_PRESENT,
+            environment.as_ptr().cast(),
+            cwd.as_ref().map_or(std::ptr::null(), |x| x.as_ptr()),
+            &startup.StartupInfo,
+            &mut child,
+        )
+    } == 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: Successful CreateProcessW returns these two uniquely owned handles.
+    let _thread = unsafe { OwnedHandle::from_raw_handle(child.hThread) };
+    Ok(unsafe { OwnedHandle::from_raw_handle(child.hProcess) })
+}
+
+// Fixed-helper resolution and Windows path conversion are a narrow port of Rust
+// 1.99.1, commit 58cf8f9c35b355199727627d07ae34a4e2846d67:
+// library/std/src/sys/process/windows.rs:468-600,
+// library/std/src/sys/args/windows.rs:351-409,
+// library/std/src/sys/path/windows.rs:94-181.
+// Copyright The Rust Project Developers; used under the Apache-2.0 option.
+// Only find_setup_exe's absolute *.exe or its one fixed bare name is accepted.
+// configure_command never overrides PATH; unsupported overrides fail before launch.
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    #[link_name = "GetSystemDirectoryW"]
+    fn get_system_directory(buffer: *mut u16, size: u32) -> u32;
+    #[link_name = "GetWindowsDirectoryW"]
+    fn get_windows_directory(buffer: *mut u16, size: u32) -> u32;
+}
+
+fn query_utf16(mut query: impl FnMut(*mut u16, u32) -> u32) -> io::Result<Vec<u16>> {
+    let mut buffer = vec![0; 512];
+    loop {
+        let size = u32::try_from(buffer.len()).map_err(|_| io::ErrorKind::InvalidInput)?;
+        let count = query(buffer.as_mut_ptr(), size);
+        if count == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        if count < size {
+            buffer.truncate(count as usize);
+            return Ok(buffer);
+        }
+        buffer.resize(count as usize + 1, 0);
+    }
+}
+
+fn full_path(path: &[u16]) -> io::Result<Vec<u16>> {
+    query_utf16(|buffer, size| unsafe {
+        GetFullPathNameW(path.as_ptr(), size, buffer, std::ptr::null_mut())
+    })
+}
+
+fn terminated_path(path: &Path) -> io::Result<Vec<u16>> {
+    let mut wide: Vec<_> = path.as_os_str().encode_wide().collect();
+    if wide.contains(&0) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "file name contains NUL",
+        ));
+    }
+    wide.push(0);
+    Ok(wide)
+}
+
+fn long_user_path(mut path: Vec<u16>) -> io::Result<Vec<u16>> {
+    const SEP: u16 = b'\\' as u16;
+    const ALT: u16 = b'/' as u16;
+    const QUERY: u16 = b'?' as u16;
+    const COLON: u16 = b':' as u16;
+    const DOT: u16 = b'.' as u16;
+    const VERBATIM: &[u16] = &[SEP, SEP, QUERY, SEP];
+    const NT: &[u16] = &[SEP, QUERY, QUERY, SEP];
+    const UNC: &[u16] = &[
+        SEP,
+        SEP,
+        QUERY,
+        SEP,
+        b'U' as u16,
+        b'N' as u16,
+        b'C' as u16,
+        SEP,
+    ];
+    if path.starts_with(VERBATIM) || path.starts_with(NT) || path == [0] {
+        return Ok(path);
+    }
+    if path.len() < 248 {
+        match path.as_slice() {
+            [drive, COLON, 0] | [drive, COLON, SEP | ALT, ..] if *drive != SEP && *drive != ALT => {
+                return Ok(path);
+            }
+            [SEP | ALT, SEP | ALT, ..] => return Ok(path),
+            _ => {}
+        }
+    }
+    let absolute = full_path(&path)?;
+    let mut tail = absolute.as_slice();
+    path.clear();
+    if absolute.len() + 1 >= 248 {
+        let prefix = match tail {
+            [_, COLON, SEP, ..] => VERBATIM,
+            [SEP, SEP, DOT, SEP, ..] => {
+                tail = &tail[4..];
+                VERBATIM
+            }
+            [SEP, SEP, QUERY, SEP, ..] | [SEP, QUERY, QUERY, SEP, ..] => &[],
+            [SEP, SEP, ..] => {
+                tail = &tail[2..];
+                UNC
+            }
+            _ => &[],
+        };
+        path.extend_from_slice(prefix);
+    }
+    path.extend_from_slice(tail);
+    path.push(0);
+    Ok(path)
+}
+
+fn user_path(path: &Path) -> io::Result<Vec<u16>> {
+    const SEP: u16 = b'\\' as u16;
+    const QUERY: u16 = b'?' as u16;
+    const COLON: u16 = b':' as u16;
+    let mut wide = terminated_path(path)?;
+    if wide.len() > 260 {
+        return Ok(wide);
+    }
+    match wide.as_slice() {
+        [SEP, SEP, QUERY, SEP, _, COLON, SEP, ..] => {
+            let full = full_path(&wide[4..])?;
+            if full == wide[4..wide.len() - 1] {
+                let mut full = full;
+                full.push(0);
+                Ok(full)
+            } else {
+                Ok(wide)
+            }
+        }
+        [SEP, SEP, QUERY, SEP, 85, 78, 67, SEP, ..] => {
+            wide[6] = SEP;
+            let full = full_path(&wide[6..])?;
+            if full == wide[6..wide.len() - 1] {
+                let mut full = full;
+                full.push(0);
+                Ok(full)
+            } else {
+                wide[6] = b'C' as u16;
+                Ok(wide)
+            }
+        }
+        _ => long_user_path(wide),
+    }
+}
+
+fn find_in_directories(file: &OsStr, directories: &[PathBuf]) -> Option<Vec<u16>> {
+    for directory in directories {
+        if let Ok(candidate) = user_path(&directory.join(file))
+            && unsafe { GetFileAttributesW(candidate.as_ptr()) } != INVALID_FILE_ATTRIBUTES
+        {
+            return Some(candidate);
+        }
+    }
+    None
+}
+
+fn search_directories(
+    application: Option<PathBuf>,
+    system: Option<PathBuf>,
+    windows: Option<PathBuf>,
+    parent_path: Option<OsString>,
+) -> Vec<PathBuf> {
+    let mut directories = Vec::new();
+    directories.extend(application);
+    directories.extend(system);
+    directories.extend(windows);
+    if let Some(paths) = parent_path {
+        directories
+            .extend(std::env::split_paths(&paths).filter(|path| !path.as_os_str().is_empty()));
+    }
+    directories
+}
+
+fn resolve_program(program: &OsStr) -> io::Result<Vec<u16>> {
+    let path = Path::new(program);
+    if path.is_absolute() {
+        return user_path(path);
+    }
+    if program != OsStr::new(super::SETUP_EXE_FILENAME) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "unsupported setup executable form",
+        ));
+    }
+    let application = std::env::current_exe()
+        .ok()
+        .and_then(|exe| exe.parent().map(Path::to_path_buf));
+    let system = query_utf16(|buffer, size| unsafe { get_system_directory(buffer, size) })
+        .ok()
+        .map(|wide| PathBuf::from(OsString::from_wide(&wide)));
+    let windows = query_utf16(|buffer, size| unsafe { get_windows_directory(buffer, size) })
+        .ok()
+        .map(|wide| PathBuf::from(OsString::from_wide(&wide)));
+    let directories = search_directories(application, system, windows, std::env::var_os("PATH"));
+    find_in_directories(program, &directories)
+        .ok_or_else(|| io::Error::new(io::ErrorKind::NotFound, "program not found"))
+}
+
+fn wait_process(process: &OwnedHandle) -> io::Result<ExitStatus> {
+    if unsafe { WaitForSingleObject(process.as_raw_handle(), INFINITE) } != WAIT_OBJECT_0 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut code = 0;
+    if unsafe { GetExitCodeProcess(process.as_raw_handle(), &mut code) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(ExitStatus::from_raw(code))
+}
+
+pub(super) fn status(command: &Command) -> io::Result<ExitStatus> {
+    let process = spawn_with_null_stdio(command)?;
+    wait_process(&process)
+}
