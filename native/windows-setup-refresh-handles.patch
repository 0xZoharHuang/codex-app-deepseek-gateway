+        |buffer, size| unsafe { super::get_windows_directory(buffer, size) },
+    )?));
+    for directory in [&app, &system, &windows] {
+        let candidate = super::user_path(&directory.join(name))?;
+        ensure!(
+            unsafe { super::GetFileAttributesW(candidate.as_ptr()) }
+                == super::INVALID_FILE_ATTRIBUTES,
+            "fixed helper exists outside owned CWD; fixture admission rejected"
+        );
+    }
+    let mode = std::env::var("CAG_RESOLVER_CWD_PATH_MODE")?;
+    let parent_path = std::env::var_os("PATH");
+    match mode.as_str() {
+        "excluded" => {
+            ensure!(
+                parent_path.as_ref().is_none_or(|value| value.is_empty()),
+                "excluded CWD process did not have an empty PATH"
+            );
+            let error =
+                super::resolve_program(name).expect_err("actual resolver searched default CWD");
+            ensure!(
+                error.kind() == std::io::ErrorKind::NotFound,
+                "actual resolver error changed"
+            );
+        }
+        "explicit" => {
+            ensure!(
+                parent_path == Some(OsString::from(".")),
+                "explicit CWD process did not inherit PATH dot"
+            );
+            let found = super::resolve_program(name)?;
+            ensure!(
+                found == super::user_path(&PathBuf::from(".").join(name))?,
+                "actual resolver lost explicit relative PATH"
+            );
+        }
+        _ => bail!("unknown isolated CWD fixture mode"),
+    }
+    println!(
+        "actual_resolver_CWD mode={mode} application={} system={} windows={}",
+        app.display(),
+        system.display(),
+        windows.display()
+    );
+    Ok(())
+}
+
+#[test]
+fn resolver_preserves_nonunicode_existing_names_and_rejects_nul() -> Result<()> {
+    let root = tempfile::tempdir()?;
+    let name = OsString::from_wide(&[111, 119, 110, 101, 100, 45, 0xd800, 46, 101, 120, 101]);
+    let target = root.path().join(&name);
+    fs::write(&target, b"metadata-only UTF16 fixture, never executed")?;
+    let selected = super::find_in_directories(&name, &[root.path().to_path_buf()])
+        .context("non-Unicode fake path not found")?;
+    ensure!(selected == super::user_path(&target)?, "UTF16 name changed");
+    let invalid = PathBuf::from(OsString::from_wide(&[0]));
+    ensure!(
+        super::user_path(&invalid)
+            .expect_err("NUL path accepted")
+            .kind()
+            == std::io::ErrorKind::InvalidInput
+    );
+    Ok(())
+}
