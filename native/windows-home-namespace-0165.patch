+    fn siblings_share_ancestors_but_parent_and_alias_wait() -> Result<()> {
+        let temp = tempfile::tempdir()?;
+        let a = temp.path().join("a");
+        let b = temp.path().join("b");
+        std::fs::create_dir(&a)?;
+        std::fs::create_dir(&b)?;
+        let (_file, scope) = acquire_path(&a, deadline())?;
+        let (_other, other_scope) =
+            acquire_path(&b, Some(Instant::now() + Duration::from_millis(100)))?;
+        drop(other_scope);
+        let (tx, rx) = mpsc::channel();
+        let a2 = a.join(".");
+        let parent = temp.path().to_path_buf();
+        let worker = std::thread::spawn(move || {
+            tx.send(acquire_path(&a2, Some(Instant::now() + Duration::from_millis(40))).is_err())
+                .unwrap();
+            tx.send(
+                acquire_path(&parent, Some(Instant::now() + Duration::from_millis(40))).is_err(),
+            )
+            .unwrap();
+        });
+        assert!(rx.recv_timeout(Duration::from_secs(2))?);
+        assert!(rx.recv_timeout(Duration::from_secs(2))?);
+        worker.join().unwrap();
+        drop(scope);
+        let _released = acquire_path(&a, deadline())?;
+        Ok(())
+    }
