+mod tests {
+    use super::*;
+    use windows_sys::Win32::Security::{
+        ACCESS_ALLOWED_ACE, ACL, EqualSid, GetAce, GetSecurityDescriptorDacl,
+    };
+    use windows_sys::Win32::Storage::FileSystem::READ_CONTROL;
+    #[test]
+    fn read_acl_mutex_security_grants_group_query_only_and_preserves_owner() {
+        let owner = crate::token::LocalSid::from_string("S-1-5-21-1-2-3-1001").unwrap();
+        let group = crate::token::LocalSid::from_string("S-1-5-21-1-2-3-1002").unwrap();
+        let descriptor =
+            read_acl_mutex_security("S-1-5-21-1-2-3-1001", "S-1-5-21-1-2-3-1002").unwrap();
+        let mut present = 0;
+        let mut defaulted = 0;
+        let mut acl: *mut ACL = std::ptr::null_mut();
+        assert_ne!(
+            unsafe {
+                GetSecurityDescriptorDacl(descriptor.0, &mut present, &mut acl, &mut defaulted)
+            },
+            0
+        );
+        assert_eq!(present, 1);
+        assert!(!acl.is_null());
+        let mut owner_masks = Vec::new();
+        let mut group_masks = Vec::new();
+        for index in 0..unsafe { (*acl).AceCount } {
+            let mut entry = std::ptr::null_mut();
+            assert_ne!(unsafe { GetAce(acl, u32::from(index), &mut entry) }, 0);
+            let entry = unsafe { &*(entry as *const ACCESS_ALLOWED_ACE) };
+            assert_eq!(entry.Header.AceType, 0);
+            assert_eq!(entry.Header.AceFlags, 0);
+            let sid = &entry.SidStart as *const u32 as *mut std::ffi::c_void;
+            if unsafe { EqualSid(sid, group.as_ptr()) } != 0 {
+                group_masks.push(entry.Mask);
+            }
+            if unsafe { EqualSid(sid, owner.as_ptr()) } != 0 {
+                owner_masks.push(entry.Mask);
+            }
+        }
+        assert_eq!(group_masks, [READ_CONTROL]);
+        assert_eq!(owner_masks, [0x1000_0000]);
+        assert_eq!(unsafe { (*acl).AceCount }, 4);
+    }
+}
