+        let key = NamespaceKey::new(r"c:\codex\home", "S-1-5-21-1-1001");
+        let other = NamespaceKey::new(r"c:\codex\other", "S-1-5-21-1-1001");
+        let derived: std::collections::HashSet<_> = native.iter().map(|id| key.guid(*id)).collect();
