+        Ok(())
+    }
+    #[test]
+    fn native_related_wait_exceeds_five_seconds_without_blocking_sibling() -> Result<()> {
+        let temp = tempfile::tempdir()?;
+        let parent = temp.path().join("parent");
+        let child = parent.join("child");
+        let other = temp.path().join("sibling");
+        std::fs::create_dir_all(&child)?;
+        std::fs::create_dir(&other)?;
+        let (_p, parent_scope) = acquire_path(&parent, deadline())?;
+        let (tx, rx) = mpsc::channel();
+        let worker = std::thread::spawn(move || {
+            let start = Instant::now();
+            let (_child, scope) = acquire_path(&child, deadline()).unwrap();
+            tx.send(start.elapsed()).unwrap();
+            drop(scope);
+        });
+        let start = Instant::now();
+        let _sibling = acquire_path(&other, Some(Instant::now() + Duration::from_millis(200)))?;
+        assert!(start.elapsed() < Duration::from_secs(1));
+        assert!(rx.recv_timeout(Duration::from_millis(5200)).is_err());
+        drop(parent_scope);
+        assert!(rx.recv_timeout(Duration::from_secs(2))? >= Duration::from_secs(5));
+        worker.join().unwrap();
+        Ok(())
+    }
+    #[test]
+    fn replacing_file_alias_cannot_redirect_the_locked_writer() -> Result<()> {
+        let temp = tempfile::tempdir()?;
+        let original = temp.path().join("original");
+        let alias = temp.path().join("alias");
+        std::fs::write(&original, b"original")?;
+        std::fs::hard_link(&original, &alias)?;
+        let (target, _scope) = acquire_path(&alias, deadline())?;
+        // The same file must be writable before the adversarial alias change.
+        // A blanket refusal therefore cannot satisfy this negative test.
+        let initial = write_handle(&target)?;
+        assert_eq!(
+            Identity::read(initial.as_raw_handle() as _)?,
+            Identity::read(target.as_raw_handle() as _)?
+        );
+        drop(initial);
+        std::fs::remove_file(&alias)?;
+        std::fs::write(&alias, b"replacement")?;
+        match write_handle(&target) {
+            Ok(writable) => assert_eq!(
+                Identity::read(writable.as_raw_handle() as _)?,
+                Identity::read(target.as_raw_handle() as _)?
+            ),
+            Err(error) => eprintln!("changed alias was rejected before ACL mutation: {error:#}"),
+        }
+        assert_eq!(std::fs::read(alias)?, b"replacement");
+        assert_eq!(std::fs::read(original)?, b"original");
+        Ok(())
+    }
+}
