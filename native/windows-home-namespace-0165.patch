+        assert!(!key.owns_state(Some(&key.id()), None, Some(&key.online())));
+    }
+    #[test]
+    fn every_fixed_native_wfp_object_is_disjoint() {
+        let native: [u128; 14] = [
+            0x9f5f3812_79f0_4fe9_9615_4c2c92d2f0ff,
+            0x87498484_45ab_4510_845e_ece8b791b3bc,
+            0xaf4751de_f874_4a7b_a34d_f0d0f22d1d9b,
