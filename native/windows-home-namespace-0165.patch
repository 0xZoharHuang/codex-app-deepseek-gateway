+//! Home-scoped identities for the private App runtime. Native sandbox algorithms are unchanged.
+use crate::namespace_key::NamespaceKey;
+use anyhow::{Context, Result, ensure};
+use std::path::{Path, PathBuf};
+
+#[derive(Clone, Debug)]
+pub(crate) struct SandboxNamespace {
+    pub(crate) key: NamespaceKey,
+    pub(crate) home: PathBuf,
+    pub(crate) owner_sid: String,
+    volume: u64,
+    file_id: [u8; 16],
+}
+impl SandboxNamespace {
+    pub(crate) fn current(home: &Path) -> Result<Self> {
+        Self::for_user(home, &crate::runtime_ownership::current_setup_user()?)
+    }
+    pub(crate) fn for_user(home: &Path, real_user: &str) -> Result<Self> {
+        ensure!(
+            !crate::registered_core_requested(),
+            "home-isolated runtime cannot use the shared RegisteredCore service"
+        );
+        ensure!(
+            home.is_absolute(),
+            "sandbox namespace requires an absolute home"
+        );
+        let home = dunce::canonicalize(home).context("resolve sandbox namespace home")?;
+        let canonical = home
+            .to_str()
+            .context("sandbox home is not valid Unicode")?
+            .to_lowercase();
+        let sid = crate::winutil::resolve_sid(real_user).context("resolve namespace owner SID")?;
+        let owner_sid = crate::winutil::string_from_sid_bytes(&sid).map_err(anyhow::Error::msg)?;
+        ensure!(owner_sid.starts_with("S-1-"), "invalid namespace owner SID");
+        let (volume, file_id) = directory_identity(&home)?;
+        Ok(Self {
+            key: NamespaceKey::for_directory(&canonical, &owner_sid, volume, file_id),
+            home,
+            owner_sid,
+            volume,
+            file_id,
+        })
+    }
+    pub(crate) fn from_environment() -> Result<Self> {
+        let home = std::env::var_os("CODEX_HOME")
+            .context("isolated sandbox cleanup requires explicit CODEX_HOME")?;
+        Self::current(Path::new(&home))
+    }
+    pub(crate) fn validate_names(&self, offline: &str, online: &str) -> Result<()> {
+        ensure!(
+            offline == self.key.offline() && online == self.key.online(),
+            "sandbox identities belong to another home or legacy installation; refusing to adopt or modify them"
+        );
+        Ok(())
+    }
+    fn owner_path(&self) -> PathBuf {
+        crate::setup::sandbox_secrets_dir(&self.home).join("namespace_owner.json")
+    }
+    fn owner_record(&self) -> serde_json::Value {
+        serde_json::json!({"schema":1,"namespace":self.key.id(),"owner_sid":self.owner_sid,
+            "home":self.home.to_string_lossy().to_lowercase(),"volume":self.volume,"file_id":self.file_id,"offline":self.key.offline(),
+            "online":self.key.online(),"group":self.key.group()})
+    }
+    fn validate_owner_record(&self) -> Result<bool> {
+        let bytes = match std::fs::read(self.owner_path()) {
+            Ok(bytes) => bytes,
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(false),
+            Err(e) => return Err(e).context("read namespace owner record"),
+        };
+        let record: serde_json::Value =
+            serde_json::from_slice(&bytes).context("invalid namespace owner record")?;
+        ensure!(
+            record == self.owner_record(),
+            "sandbox owner record belongs to another installation"
+        );
+        Ok(true)
+    }
+    pub(crate) fn require_owned_state(&self) -> Result<()> {
+        self.validate_existing_state()?;
+        ensure!(
+            self.validate_owner_record()?,
+            "sandbox namespace has no owner reservation"
+        );
+        Ok(())
+    }
+    pub(crate) fn reserve_owner(&self) -> Result<()> {
+        // Caller holds the native machine-wide setup lock, and validation preceded every mutation.
+        self.validate_existing_state()?;
+        if self.validate_owner_record()? {
+            return Ok(());
+        }
+        std::fs::create_dir_all(crate::setup::sandbox_secrets_dir(&self.home))?;
+        let bytes = serde_json::to_vec(&self.owner_record())?;
+        crate::file_write::write_file_atomically(&self.owner_path(), &bytes)
+    }
+    /// Only schema/identity fields are inspected; encrypted credentials are never decoded here.
+    pub(crate) fn validate_existing_state(&self) -> Result<()> {
+        ensure!(
+            !crate::setup::sandbox_dir(&self.home)
+                .join("sandbox_users.json")
+                .try_exists()?,
+            "legacy sandbox credentials found; isolated runtime will not migrate or delete them"
+        );
+        let owned = self.validate_owner_record()?;
+        let has_state = crate::setup::setup_marker_path(&self.home).try_exists()?
+            || crate::setup::sandbox_users_path(&self.home).try_exists()?;
+        ensure!(
+            !has_state || owned,
+            "sandbox state exists without its owner reservation; refusing to adopt it"
+        );
+        if !has_state && !owned {
+            // No adoption: a first setup may only create absent namespace principals.
+            for name in [self.key.offline(), self.key.online()] {
+                ensure!(
+                    crate::winutil::local_user_flags(&name)?.is_none(),
+                    "namespace account already exists without owned state; refusing to change it"
+                );
+            }
+            ensure!(
+                !local_group_exists(&self.key.group())?,
+                "namespace group already exists without owned state; refusing to adopt it"
+            );
+        }
+        for (path, marker) in [
+            (crate::setup::setup_marker_path(&self.home), true),
+            (crate::setup::sandbox_users_path(&self.home), false),
+        ] {
+            let bytes = match std::fs::read(&path) {
+                Ok(bytes) => bytes,
+                Err(e) if e.kind() == std::io::ErrorKind::NotFound => continue,
+                Err(e) => return Err(e).context("read sandbox identity metadata"),
+            };
+            // Native setup creates an empty protected marker before committing it. Only our
+            // previously persisted owner reservation permits recovery of that interrupted state.
+            if marker && bytes.is_empty() && owned {
+                continue;
+            }
+            let value: serde_json::Value = serde_json::from_slice(&bytes)
+                .context("existing sandbox state is invalid; no implicit adoption")?;
+            ensure!(
+                value.get("namespace").and_then(|v| v.as_str()) == Some(self.key.id().as_str()),
+                "existing sandbox state is not owned by this home namespace; use a separate home"
+            );
+            let (offline, online) = if marker {
+                (value.get("offline_username"), value.get("online_username"))
+            } else {
+                (
+                    value.get("offline").and_then(|v| v.get("username")),
+                    value.get("online").and_then(|v| v.get("username")),
+                )
+            };
+            ensure!(
+                self.key.owns_state(
+                    value.get("namespace").and_then(|v| v.as_str()),
+                    offline.and_then(|v| v.as_str()),
+                    online.and_then(|v| v.as_str())
+                ),
+                "sandbox identity metadata does not match its namespace"
+            );
+        }
+        Ok(())
+    }
+}
+pub(crate) fn local_group_exists(name: &str) -> Result<bool> {
+    use windows_sys::Win32::NetworkManagement::NetManagement as net;
+    let mut data = std::ptr::null_mut();
+    let status = unsafe {
+        net::NetLocalGroupGetInfo(
+            std::ptr::null(),
+            crate::winutil::to_wide(name).as_ptr(),
+            0,
+            &mut data,
+        )
+    };
+    if !data.is_null() {
+        unsafe { net::NetApiBufferFree(data as _) };
+    }
+    match status {
+        net::NERR_Success => Ok(true),
+        net::NERR_GroupNotFound => Ok(false),
+        value => anyhow::bail!("read namespace group metadata failed: {value}"),
+    }
+}
+
+fn directory_identity(home: &Path) -> Result<(u64, [u8; 16])> {
+    use std::os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle};
+    use windows_sys::Win32::Foundation::INVALID_HANDLE_VALUE;
+    use windows_sys::Win32::Storage::FileSystem as fs;
+    let raw = unsafe {
+        fs::CreateFileW(
+            crate::winutil::to_wide(home).as_ptr(),
+            fs::FILE_READ_ATTRIBUTES,
+            fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE | fs::FILE_SHARE_DELETE,
+            std::ptr::null(),
+            fs::OPEN_EXISTING,
+            fs::FILE_FLAG_BACKUP_SEMANTICS,
+            std::ptr::null_mut(),
+        )
+    };
+    ensure!(
+        raw != INVALID_HANDLE_VALUE,
+        "open canonical sandbox home identity: {}",
+        std::io::Error::last_os_error()
+    );
+    let handle = unsafe { OwnedHandle::from_raw_handle(raw as _) };
+    let mut id = fs::FILE_ID_INFO::default();
+    let ok = unsafe {
+        fs::GetFileInformationByHandleEx(
+            handle.as_raw_handle() as _,
+            fs::FileIdInfo,
+            (&mut id as *mut fs::FILE_ID_INFO).cast(),
+            std::mem::size_of::<fs::FILE_ID_INFO>() as u32,
+        )
+    };
+    ensure!(
+        ok != 0,
+        "read canonical sandbox directory identity: {}",
+        std::io::Error::last_os_error()
+    );
+    ensure!(
+        id.FileId.Identifier != [0; 16],
+        "sandbox filesystem does not expose a stable directory identity"
+    );
+    Ok((id.VolumeSerialNumber, id.FileId.Identifier))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn correctly_named_marker_without_owner_is_not_adopted() -> Result<()> {
+        let temp = tempfile::tempdir()?;
+        let namespace = SandboxNamespace::current(temp.path())?;
+        let path = crate::setup::setup_marker_path(temp.path());
+        std::fs::create_dir_all(path.parent().unwrap())?;
+        let original = serde_json::to_vec(&serde_json::json!({"namespace":namespace.key.id(),
+            "offline_username":namespace.key.offline(),"online_username":namespace.key.online()}))?;
+        std::fs::write(&path, &original)?;
+        assert!(
+            namespace
+                .validate_existing_state()
+                .unwrap_err()
+                .to_string()
+                .contains("without its owner reservation")
+        );
+        assert!(!namespace.owner_path().exists());
+        assert_eq!(std::fs::read(path)?, original);
+        Ok(())
+    }
+    #[test]
+    fn owned_interrupted_marker_recovers_but_corruption_does_not() -> Result<()> {
+        let temp = tempfile::tempdir()?;
+        let namespace = SandboxNamespace::current(temp.path())?;
+        namespace.reserve_owner()?;
+        let path = crate::setup::setup_marker_path(temp.path());
+        std::fs::create_dir_all(path.parent().unwrap())?;
+        std::fs::write(&path, [])?;
+        namespace.validate_existing_state()?;
+        std::fs::write(&path, b"broken")?;
+        assert!(namespace.validate_existing_state().is_err());
+        assert_eq!(std::fs::read(path)?, b"broken");
+        Ok(())
+    }
+    #[test]
+    fn namespace_changes_for_a_different_directory_object_at_same_path() -> Result<()> {
+        let temp = tempfile::tempdir()?;
+        let home = temp.path().join("home");
+        std::fs::create_dir(&home)?;
+        let a = SandboxNamespace::current(&home)?;
+        std::fs::rename(&home, temp.path().join("retained-original-home"))?;
+        std::fs::create_dir(&home)?;
+        let b = SandboxNamespace::current(&home)?;
+        assert_ne!(a.key, b.key);
+        Ok(())
+    }
+}
