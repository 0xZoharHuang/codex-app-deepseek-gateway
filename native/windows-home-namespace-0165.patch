+//! Pure resource identity derivation. No Windows calls, filesystem writes, or process state.
+use sha2::{Digest, Sha256};
+
+const GROUP_PREFIX: &str = "CodexAppDeepSeek-";
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct NamespaceKey {
+    digest: [u8; 32],
+}
+impl NamespaceKey {
+    pub(crate) fn claims_group_name(name: &str) -> bool {
+        name.get(..GROUP_PREFIX.len())
+            .is_some_and(|prefix| prefix.eq_ignore_ascii_case(GROUP_PREFIX))
+    }
+    pub(crate) fn from_group_name(name: &str) -> Option<Self> {
+        let id = name.strip_prefix(GROUP_PREFIX)?;
+        if !is_namespace_id(id) {
+            return None;
+        }
+        let mut digest = [0; 32];
+        for (index, byte) in digest.iter_mut().enumerate() {
+            *byte = u8::from_str_radix(&id[index * 2..index * 2 + 2], 16).ok()?;
+        }
+        Some(Self { digest })
+    }
+    pub(crate) fn new(canonical_home: &str, owner_sid: &str) -> Self {
+        let mut hash = Sha256::new();
+        hash.update(b"codex-app-deepseek/windows-sandbox/v1\0");
+        for value in [canonical_home, owner_sid] {
+            hash.update((value.len() as u64).to_le_bytes());
+            hash.update(value.as_bytes());
+        }
+        Self {
+            digest: hash.finalize().into(),
+        }
+    }
+    pub(crate) fn for_directory(
+        canonical_home: &str,
+        owner_sid: &str,
+        volume: u64,
+        file_id: [u8; 16],
+    ) -> Self {
+        let id: String = file_id.iter().map(|byte| format!("{byte:02x}")).collect();
+        // A case-sensitive Windows directory can contain different objects whose lowercase
+        // paths match. Bind the actual canonical directory object as well as its spelling.
+        Self::new(&format!("{canonical_home}\0{volume:016x}:{id}"), owner_sid)
+    }
+    pub(crate) fn owns_state(
+        &self,
+        namespace: Option<&str>,
+        offline: Option<&str>,
+        online: Option<&str>,
+    ) -> bool {
+        namespace == Some(self.id().as_str())
+            && offline == Some(self.offline().as_str())
+            && online == Some(self.online().as_str())
+    }
+    pub(crate) fn id(&self) -> String {
+        self.digest
+            .iter()
+            .map(|byte| format!("{byte:02x}"))
+            .collect()
+    }
+    fn account_id(&self) -> String {
+        const ALPHABET: &[u8; 32] = b"abcdefghijklmnopqrstuvwxyz234567";
+        let mut value = 0_u128;
+        for byte in &self.digest[..10] {
+            value = (value << 8) | *byte as u128;
+        }
+        (0..16)
+            .rev()
+            .map(|n| ALPHABET[((value >> (n * 5)) & 31) as usize] as char)
+            .collect()
+    }
+    pub(crate) fn offline(&self) -> String {
+        format!("Cdx{}f", self.account_id())
+    }
+    pub(crate) fn online(&self) -> String {
+        format!("Cdx{}n", self.account_id())
+    }
+    pub(crate) fn group(&self) -> String {
+        format!("{GROUP_PREFIX}{}", self.id())
+    }
+    pub(crate) fn read_acl_mutex(&self) -> String {
+        read_acl_mutex_for_id(&self.id()).expect("digest is hex")
+    }
+    pub(crate) fn firewall(&self, original: &str) -> String {
+        format!("{original}-cdag-{}", self.id())
+    }
+    pub(crate) fn guid(&self, original: u128) -> u128 {
+        let mut hash = Sha256::new();
+        hash.update(b"codex-app-deepseek/windows-sandbox/wfp/v1\0");
+        hash.update(self.digest);
+        hash.update(original.to_be_bytes());
+        let bytes = hash.finalize();
+        let mut uuid: [u8; 16] = bytes[..16].try_into().expect("fixed digest size");
+        uuid[6] = (uuid[6] & 0x0f) | 0x80;
+        uuid[8] = (uuid[8] & 0x3f) | 0x80;
+        u128::from_be_bytes(uuid)
+    }
+}
+fn is_namespace_id(id: &str) -> bool {
+    id.len() == 64
+        && id
+            .bytes()
+            .all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase())
+}
+pub(crate) fn read_acl_mutex_for_id(id: &str) -> Option<String> {
+    is_namespace_id(id).then(|| format!(r"Local\CodexAppDeepSeekReadAcl-{id}"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn stable_identity() {
+        let a = NamespaceKey::new(r"c:\codex\home", "S-1-5-21-1-1001");
+        assert_eq!(a, NamespaceKey::new(r"c:\codex\home", "S-1-5-21-1-1001"));
+        assert_eq!(a.offline().len(), 20);
+        assert_eq!(a.online().len(), 20);
+        assert_ne!(a.offline(), a.online());
+        assert!(a.offline().bytes().all(|b| b.is_ascii_alphanumeric()));
+        assert_ne!(a.offline(), "CodexSandboxOffline");
+        assert_ne!(a.group(), "CodexSandboxUsers");
+    }
+    #[test]
+    fn every_resource_changes_with_home_and_owner() {
+        let a = NamespaceKey::new(r"c:\a", "S-1-5-21-1-1001");
+        for b in [
+            NamespaceKey::new(r"c:\b", "S-1-5-21-1-1001"),
+            NamespaceKey::new(r"c:\a", "S-1-5-21-1-1002"),
+        ] {
+            assert_ne!(a.id(), b.id());
+            assert_ne!(a.offline(), b.offline());
+            assert_ne!(a.online(), b.online());
+            assert_ne!(a.group(), b.group());
+            assert_ne!(a.read_acl_mutex(), b.read_acl_mutex());
+            assert_ne!(a.firewall("rule"), b.firewall("rule"));
+            assert_ne!(a.guid(1), b.guid(1));
+        }
+    }
+    #[test]
+    fn resource_classes_and_input_boundaries_do_not_alias() {
+        let a = NamespaceKey::new("ab", "c");
+        let b = NamespaceKey::new("a", "bc");
+        assert_ne!(a, b);
+        assert_ne!(a.guid(1), a.guid(2));
+        assert_ne!(a.firewall("a"), a.firewall("b"));
+        assert_eq!((a.guid(1) >> 76) & 15, 8);
+        assert_eq!((a.guid(1) >> 62) & 3, 2);
+    }
+    #[test]
+    fn marker_cannot_choose_arbitrary_named_object() {
+        for id in [
+            "",
+            "Global\\CodexSandboxSetup",
+            &"0".repeat(63),
+            &"G".repeat(64),
+            &"A".repeat(64),
+        ] {
+            assert!(read_acl_mutex_for_id(id).is_none());
+        }
+    }
+}
+
+#[cfg(test)]
+mod isolation_regressions {
+    use super::*;
+    #[test]
+    fn fixed_version_identity_vector() {
+        let key = NamespaceKey::new(r"c:\codex\home", "S-1-5-21-1-1001");
+        assert_eq!(
+            key.id(),
+            "bb0079331ec29687adf304fda911f1cb63faea80e3926c1f11c05322c0bfde08"
+        );
+    }
+    #[test]
+    fn legacy_missing_cross_home_and_swapped_state_are_rejected() {
