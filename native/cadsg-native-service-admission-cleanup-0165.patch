+/// Match the native finish-side canonical form without requiring a deleted home to reappear.
+pub(crate) fn cleanup_home_for_installation(
+    installation: &crate::InstallationRecord,
+) -> Result<std::path::PathBuf> {
+    if installation.codex_home.exists() {
+        Ok(dunce::canonicalize(&installation.codex_home)?)
+    } else {
+        Ok(installation.codex_home.clone())
+    }
+}
