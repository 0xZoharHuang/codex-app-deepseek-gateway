+use super::*;
+use crate::to_wide;
+use std::ffi::OsStr;
+use windows_sys::Win32::Security::Authorization::ConvertStringSecurityDescriptorToSecurityDescriptorW;
+
+struct Descriptor {
+    pointer: *mut c_void,
+    blob: FWP_BYTE_BLOB,
+}
+impl Descriptor {
+    fn new(sddl: &str) -> Self {
+        let text = to_wide(OsStr::new(sddl));
+        let mut pointer = null_mut();
+        let mut length = 0;
+        assert_ne!(
+            unsafe {
+                ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                    text.as_ptr(),
+                    1,
+                    &mut pointer,
+                    &mut length,
+                )
+            },
+            0
+        );
+        Self {
+            pointer,
+            blob: FWP_BYTE_BLOB {
+                size: length,
+                data: pointer.cast(),
+            },
+        }
+    }
+}
+impl Drop for Descriptor {
+    fn drop(&mut self) {
+        unsafe { LocalFree(self.pointer as HLOCAL) };
+    }
+}
+fn fixture(rule: LegacyRule, inspect: impl FnOnce(&mut FWPM_FILTER0, &NamespaceKey, &[u16])) {
+    // No real SAM account, filesystem/home or WFP object is created by these unit fixtures.
+    let namespace = NamespaceKey::from_id(&"11".repeat(32)).unwrap();
+    let mut provider = namespaced_guid(&namespace, super::super::PROVIDER_KEY);
+    let name = to_wide(OsStr::new(LEGACY_NAME));
+    let mut descriptor = Descriptor::new("D:(A;;CC;;;SY)");
+    let expected = user_descriptor(&descriptor.blob).unwrap();
+    let mut conditions = vec![
+        FWPM_FILTER_CONDITION0 {
+            fieldKey: FWPM_CONDITION_ALE_USER_ID,
+            matchType: FWP_MATCH_EQUAL,
+            conditionValue: FWP_CONDITION_VALUE0 {
+                r#type: FWP_SECURITY_DESCRIPTOR_TYPE,
+                Anonymous: FWP_CONDITION_VALUE0_0 {
+                    sd: &mut descriptor.blob,
+                },
+            },
+        },
+        FWPM_FILTER_CONDITION0 {
+            fieldKey: FWPM_CONDITION_FLAGS,
+            matchType: FWP_MATCH_FLAGS_ALL_SET,
+            conditionValue: FWP_CONDITION_VALUE0 {
+                r#type: FWP_UINT32,
+                Anonymous: FWP_CONDITION_VALUE0_0 {
+                    uint32: FWP_CONDITION_FLAG_IS_LOOPBACK,
+                },
+            },
+        },
+        FWPM_FILTER_CONDITION0 {
+            fieldKey: FWPM_CONDITION_IP_PROTOCOL,
+            matchType: FWP_MATCH_EQUAL,
+            conditionValue: FWP_CONDITION_VALUE0 {
+                r#type: FWP_UINT8,
+                Anonymous: FWP_CONDITION_VALUE0_0 {
+                    uint8: rule.protocol,
+                },
+            },
+        },
+    ];
+    let (first, last) = rule.ports.unwrap_or((0, 0));
+    let mut range = FWP_RANGE0 {
+        valueLow: FWP_VALUE0 {
+            r#type: FWP_UINT16,
+            Anonymous: FWP_VALUE0_0 { uint16: first },
+        },
+        valueHigh: FWP_VALUE0 {
+            r#type: FWP_UINT16,
+            Anonymous: FWP_VALUE0_0 { uint16: last },
+        },
+    };
+    if rule.ports.is_some() {
+        conditions.push(FWPM_FILTER_CONDITION0 {
+            fieldKey: FWPM_CONDITION_IP_REMOTE_PORT,
+            matchType: FWP_MATCH_RANGE,
+            conditionValue: FWP_CONDITION_VALUE0 {
+                r#type: FWP_RANGE_TYPE,
+                Anonymous: FWP_CONDITION_VALUE0_0 {
+                    rangeValue: &mut range,
+                },
+            },
+        });
+    }
+    let mut item: FWPM_FILTER0 = unsafe { std::mem::zeroed() };
+    item.filterKey = namespaced_guid(&namespace, GUID::from_u128(rule.key()));
+    item.providerKey = &mut provider;
+    item.subLayerKey = namespaced_guid(&namespace, LEGACY_SUBLAYER);
+    item.layerKey = match (rule.inbound, rule.ipv6) {
+        (false, false) => FWPM_LAYER_ALE_AUTH_CONNECT_V4,
+        (false, true) => FWPM_LAYER_ALE_AUTH_CONNECT_V6,
+        (true, false) => FWPM_LAYER_ALE_AUTH_RECV_ACCEPT_V4,
+        (true, true) => FWPM_LAYER_ALE_AUTH_RECV_ACCEPT_V6,
+    };
+    item.displayData.name = name.as_ptr() as *mut _;
+    item.flags = FWPM_FILTER_FLAG_PERSISTENT;
+    item.action.r#type = FWP_ACTION_BLOCK;
+    item.numFilterConditions = conditions.len() as u32;
+    item.filterCondition = conditions.as_mut_ptr();
+    inspect(&mut item, &namespace, &expected);
+}
