+//! Apply the already reviewed native ALE loopback rules to the effective profile.
+//! No tool execution, proxy implementation, or agent scheduling lives here.
+use super::legacy_loopback_migration::LEGACY_SUBLAYER;
+use super::{
+    PROVIDER_KEY, UserMatchCondition, empty_blob, empty_value, ensure_success, loopback_policy,
+    namespaced_guid, zero_guid,
+};
+use crate::namespace_key::NamespaceKey;
+use crate::to_wide;
+use anyhow::Result;
+use std::ffi::OsStr;
+use std::ptr::null_mut;
+use windows_sys::Win32::Foundation::HANDLE;
+use windows_sys::Win32::NetworkManagement::WindowsFilteringPlatform::*;
+use windows_sys::core::GUID;
+
+pub(super) fn install(
+    engine: HANDLE,
+    namespace: &NamespaceKey,
+    user: &UserMatchCondition,
+    proxy_ports: &[u16],
+    allow_local_binding: bool,
+) -> Result<usize> {
+    let rules = loopback_policy::rules(proxy_ports, allow_local_binding);
+    if rules.is_empty() {
+        return Ok(0);
+    }
+    let mut provider = namespaced_guid(namespace, PROVIDER_KEY);
+    let sublayer_key = namespaced_guid(namespace, LEGACY_SUBLAYER);
+    let name = to_wide(OsStr::new("Codex offline loopback policy"));
+    let sublayer = FWPM_SUBLAYER0 {
+        subLayerKey: sublayer_key,
+        displayData: FWPM_DISPLAY_DATA0 {
+            name: name.as_ptr() as *mut _,
+            description: null_mut(),
+        },
+        flags: FWPM_SUBLAYER_FLAG_PERSISTENT,
+        providerKey: &mut provider,
+        providerData: empty_blob(),
+        weight: 0x8001,
+    };
+    ensure_success(
+        unsafe { FwpmSubLayerAdd0(engine, &sublayer, null_mut()) },
+        "add owned loopback sublayer after validated migration",
+    )?;
+    for rule in &rules {
+        let mut conditions = vec![
+            FWPM_FILTER_CONDITION0 {
+                fieldKey: FWPM_CONDITION_ALE_USER_ID,
+                matchType: FWP_MATCH_EQUAL,
+                conditionValue: FWP_CONDITION_VALUE0 {
+                    r#type: FWP_SECURITY_DESCRIPTOR_TYPE,
+                    Anonymous: FWP_CONDITION_VALUE0_0 {
+                        sd: &user.blob as *const _ as *mut _,
+                    },
+                },
+            },
+            FWPM_FILTER_CONDITION0 {
+                fieldKey: FWPM_CONDITION_FLAGS,
+                matchType: FWP_MATCH_FLAGS_ALL_SET,
+                conditionValue: FWP_CONDITION_VALUE0 {
+                    r#type: FWP_UINT32,
+                    Anonymous: FWP_CONDITION_VALUE0_0 {
+                        uint32: FWP_CONDITION_FLAG_IS_LOOPBACK,
+                    },
+                },
+            },
+            FWPM_FILTER_CONDITION0 {
+                fieldKey: FWPM_CONDITION_IP_PROTOCOL,
+                matchType: FWP_MATCH_EQUAL,
+                conditionValue: FWP_CONDITION_VALUE0 {
+                    r#type: FWP_UINT8,
+                    Anonymous: FWP_CONDITION_VALUE0_0 {
+                        uint8: rule.protocol,
+                    },
+                },
+            },
+        ];
+        let (first, last) = rule.ports.unwrap_or((0, 0));
+        let mut range = FWP_RANGE0 {
+            valueLow: FWP_VALUE0 {
+                r#type: FWP_UINT16,
+                Anonymous: FWP_VALUE0_0 { uint16: first },
+            },
+            valueHigh: FWP_VALUE0 {
+                r#type: FWP_UINT16,
+                Anonymous: FWP_VALUE0_0 { uint16: last },
+            },
+        };
+        if rule.ports.is_some() {
+            conditions.push(FWPM_FILTER_CONDITION0 {
+                fieldKey: FWPM_CONDITION_IP_REMOTE_PORT,
+                matchType: FWP_MATCH_RANGE,
+                conditionValue: FWP_CONDITION_VALUE0 {
+                    r#type: FWP_RANGE_TYPE,
+                    Anonymous: FWP_CONDITION_VALUE0_0 {
+                        rangeValue: &mut range,
+                    },
+                },
+            });
+        }
+        let filter = FWPM_FILTER0 {
+            filterKey: namespaced_guid(namespace, GUID::from_u128(rule.key())),
+            displayData: FWPM_DISPLAY_DATA0 {
+                name: name.as_ptr() as *mut _,
+                description: null_mut(),
+            },
+            flags: FWPM_FILTER_FLAG_PERSISTENT,
+            providerKey: &mut provider,
+            providerData: empty_blob(),
+            layerKey: match (rule.inbound, rule.ipv6) {
+                (false, false) => FWPM_LAYER_ALE_AUTH_CONNECT_V4,
+                (false, true) => FWPM_LAYER_ALE_AUTH_CONNECT_V6,
+                (true, false) => FWPM_LAYER_ALE_AUTH_RECV_ACCEPT_V4,
+                (true, true) => FWPM_LAYER_ALE_AUTH_RECV_ACCEPT_V6,
+            },
+            subLayerKey: sublayer_key,
+            weight: empty_value(),
+            numFilterConditions: conditions.len() as u32,
+            filterCondition: conditions.as_mut_ptr(),
+            action: FWPM_ACTION0 {
+                r#type: FWP_ACTION_BLOCK,
+                Anonymous: FWPM_ACTION0_0 {
+                    filterType: zero_guid(),
+                },
+            },
+            Anonymous: FWPM_FILTER0_0 { rawContext: 0 },
+            reserved: null_mut(),
+            filterId: 0,
+            effectiveWeight: empty_value(),
+        };
+        ensure_success(
+            unsafe { FwpmFilterAdd0(engine, &filter, null_mut(), null_mut()) },
+            "add owned loopback block",
+        )?;
+    }
+    Ok(rules.len())
+}
