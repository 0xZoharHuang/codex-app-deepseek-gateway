+//! Retire only the superseded, home-scoped loopback objects from earlier gateway builds.
+//! Stock 0.165 remains responsible for the current network policy; this is not a new policy.
+use super::{UserMatchCondition, delete_filter_if_present, ensure_success, namespaced_guid};
+use crate::namespace_key::NamespaceKey;
+use anyhow::{Context, Result, ensure};
+use std::ffi::c_void;
+use std::ptr::null_mut;
+use windows_sys::Win32::Foundation::{
+    FWP_E_NOT_FOUND, FWP_E_SUBLAYER_NOT_FOUND, GetLastError, HANDLE, HLOCAL, LocalFree,
+};
+use windows_sys::Win32::NetworkManagement::WindowsFilteringPlatform::*;
+use windows_sys::Win32::Security::Authorization::ConvertSecurityDescriptorToStringSecurityDescriptorW;
+use windows_sys::Win32::Security::{GetSecurityDescriptorLength, IsValidSecurityDescriptor};
+use windows_sys::core::GUID;
+
+pub(super) const LEGACY_SUBLAYER: GUID = GUID::from_u128(0xd26d371d_8cef_4e6c_ae77_73b4677e0cac);
+const LEGACY_NAME: &str = "Codex offline loopback policy";
+
+struct WfpMemory(*mut c_void);
+impl Drop for WfpMemory {
+    fn drop(&mut self) {
+        if !self.0.is_null() {
+            unsafe { FwpmFreeMemory0(&mut self.0) };
+        }
+    }
+}
+struct LocalMemory(HLOCAL);
+impl Drop for LocalMemory {
+    fn drop(&mut self) {
+        if !self.0.is_null() {
+            unsafe { LocalFree(self.0) };
+        }
+    }
+}
+struct Enumeration {
+    engine: HANDLE,
+    handle: HANDLE,
+}
+impl Drop for Enumeration {
+    fn drop(&mut self) {
+        unsafe { FwpmFilterDestroyEnumHandle0(self.engine, self.handle) };
+    }
+}
+fn same_guid(a: GUID, b: GUID) -> bool {
+    a.data1 == b.data1 && a.data2 == b.data2 && a.data3 == b.data3 && a.data4 == b.data4
+}
+// BFE owns the valid NUL-terminated strings. Stop at the first mismatch/NUL.
+unsafe fn wide_equals(value: *const u16, expected: &str) -> bool {
+    if value.is_null() {
+        return expected.is_empty();
+    }
+    for (offset, character) in expected.encode_utf16().chain([0]).enumerate() {
+        if unsafe { *value.add(offset) } != character {
+            return false;
+        }
+    }
+    true
+}
+fn user_descriptor(blob: &FWP_BYTE_BLOB) -> Result<Vec<u16>> {
+    ensure!(
+        !blob.data.is_null() && blob.size >= 20,
+        "legacy user descriptor is missing"
+    );
+    let descriptor = blob.data.cast();
+    ensure!(
+        unsafe { IsValidSecurityDescriptor(descriptor) } != 0,
+        "invalid legacy user descriptor"
+    );
+    ensure!(
+        unsafe { GetSecurityDescriptorLength(descriptor) } == blob.size,
+        "unexpected legacy descriptor size"
+    );
+    let mut text = null_mut();
+    let mut length = 0;
+    // Compare the entire native SD's canonical representation, not just a matching trustee.
+    // Extra grants, denies, owner/group/SACL changes must not authorize deletion.
+    let ok = unsafe {
+        ConvertSecurityDescriptorToStringSecurityDescriptorW(
+            descriptor,
+            1,
+            0xf,
+            &mut text,
+            &mut length,
+        )
+    };
+    let _text = LocalMemory(text as HLOCAL);
+    if ok == 0 {
+        // Failure must remain failure even if an anomalous provider leaves LastError zero.
+        anyhow::bail!("format legacy user descriptor failed: {}", unsafe {
+            GetLastError()
+        });
+    }
+    ensure!(
+        !text.is_null() && length != 0,
+        "empty legacy user descriptor conversion"
+    );
+    let result = unsafe { std::slice::from_raw_parts(text, length as usize).to_vec() };
+    Ok(result)
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct LegacyRule {
+    ipv6: bool,
+    inbound: bool,
+    protocol: u8,
+    ports: Option<(u16, u16)>,
+}
+impl LegacyRule {
+    fn key(self) -> u128 {
+        let (first, last) = self.ports.unwrap_or((0, 0));
+        0x126c0bde_1df2_4bc1_8d00_000000000000_u128
+            | ((self.ipv6 as u128) << 40)
+            | ((self.inbound as u128) << 41)
+            | ((self.protocol as u128) << 32)
+            | ((first as u128) << 16)
+            | last as u128
+    }
+}
+fn validate_rule(
+    item: &FWPM_FILTER0,
+    namespace: &NamespaceKey,
+    expected_user: &[u16],
+) -> Result<LegacyRule> {
+    let provider = namespaced_guid(namespace, super::PROVIDER_KEY);
+    let sublayer = namespaced_guid(namespace, LEGACY_SUBLAYER);
+    ensure!(
+        !item.providerKey.is_null()
+            && same_guid(unsafe { *item.providerKey }, provider)
+            && same_guid(item.subLayerKey, sublayer),
+        "foreign legacy loopback ownership"
+    );
+    ensure!(
+        item.flags == FWPM_FILTER_FLAG_PERSISTENT
+            && item.action.r#type == FWP_ACTION_BLOCK
+            && item.weight.r#type == FWP_EMPTY
+            && item.providerData.size == 0
+            && unsafe { item.Anonymous.rawContext } == 0
+            && same_guid(
+                unsafe { item.action.Anonymous.filterType },
+                GUID::from_u128(0)
+            )
+            && unsafe { wide_equals(item.displayData.name, LEGACY_NAME) }
+            && unsafe { wide_equals(item.displayData.description, "") },
+        "ambiguous legacy loopback filter"
+    );
+    let mut rule = if same_guid(item.layerKey, FWPM_LAYER_ALE_AUTH_CONNECT_V4) {
+        LegacyRule {
+            ipv6: false,
+            inbound: false,
+            protocol: 0,
+            ports: None,
+        }
+    } else if same_guid(item.layerKey, FWPM_LAYER_ALE_AUTH_CONNECT_V6) {
+        LegacyRule {
+            ipv6: true,
+            inbound: false,
+            protocol: 0,
+            ports: None,
+        }
+    } else if same_guid(item.layerKey, FWPM_LAYER_ALE_AUTH_RECV_ACCEPT_V4) {
+        LegacyRule {
+            ipv6: false,
+            inbound: true,
+            protocol: 0,
+            ports: None,
+        }
+    } else if same_guid(item.layerKey, FWPM_LAYER_ALE_AUTH_RECV_ACCEPT_V6) {
+        LegacyRule {
+            ipv6: true,
+            inbound: true,
+            protocol: 0,
+            ports: None,
+        }
+    } else {
+        anyhow::bail!("unknown legacy loopback layer");
+    };
+    ensure!(
+        (3..=4).contains(&item.numFilterConditions) && !item.filterCondition.is_null(),
+        "unknown legacy condition count"
+    );
+    let mut user = false;
+    let mut flags = false;
+    let mut protocol = false;
+    for condition in unsafe {
+        std::slice::from_raw_parts(item.filterCondition, item.numFilterConditions as usize)
+    } {
+        let value = condition.conditionValue;
+        if same_guid(condition.fieldKey, FWPM_CONDITION_ALE_USER_ID) {
+            ensure!(
+                !user
+                    && condition.matchType == FWP_MATCH_EQUAL
+                    && value.r#type == FWP_SECURITY_DESCRIPTOR_TYPE,
+                "ambiguous legacy user condition"
+            );
+            let sd = unsafe { value.Anonymous.sd };
+            ensure!(!sd.is_null(), "missing legacy user descriptor");
+            ensure!(
+                user_descriptor(unsafe { &*sd })? == expected_user,
+                "legacy filter targets another identity or descriptor"
+            );
+            user = true;
+        } else if same_guid(condition.fieldKey, FWPM_CONDITION_FLAGS) {
+            ensure!(
+                !flags
+                    && condition.matchType == FWP_MATCH_FLAGS_ALL_SET
+                    && value.r#type == FWP_UINT32
+                    && unsafe { value.Anonymous.uint32 } == FWP_CONDITION_FLAG_IS_LOOPBACK,
+                "ambiguous legacy loopback flag"
+            );
+            flags = true;
+        } else if same_guid(condition.fieldKey, FWPM_CONDITION_IP_PROTOCOL) {
+            ensure!(
+                !protocol && condition.matchType == FWP_MATCH_EQUAL && value.r#type == FWP_UINT8,
+                "ambiguous legacy protocol"
+            );
+            rule.protocol = unsafe { value.Anonymous.uint8 };
+            protocol = true;
+        } else if same_guid(condition.fieldKey, FWPM_CONDITION_IP_REMOTE_PORT) {
+            ensure!(
+                rule.ports.is_none()
+                    && condition.matchType == FWP_MATCH_RANGE
+                    && value.r#type == FWP_RANGE_TYPE,
+                "ambiguous legacy port condition"
+            );
+            let range = unsafe { value.Anonymous.rangeValue };
+            ensure!(!range.is_null(), "missing legacy port range");
+            let range = unsafe { &*range };
+            ensure!(
+                range.valueLow.r#type == FWP_UINT16 && range.valueHigh.r#type == FWP_UINT16,
+                "unknown legacy port range type"
+            );
+            let first = unsafe { range.valueLow.Anonymous.uint16 };
+            let last = unsafe { range.valueHigh.Anonymous.uint16 };
+            ensure!(first != 0 && first <= last, "invalid legacy port range");
+            rule.ports = Some((first, last));
+        } else {
+            anyhow::bail!("unknown condition in legacy loopback sublayer");
+        }
+    }
+    ensure!(
+        user && flags && protocol,
+        "incomplete legacy loopback conditions"
+    );
+    ensure!(
+        matches!(rule.protocol, 6 | 17)
+            && if rule.inbound || rule.protocol == 17 {
+                rule.ports.is_none()
+            } else {
+                rule.ports.is_some()
+            },
+        "unknown legacy loopback rule shape"
+    );
+    ensure!(
+        same_guid(
+            item.filterKey,
+            namespaced_guid(namespace, GUID::from_u128(rule.key()))
+        ),
+        "legacy loopback key does not match its rule"
+    );
+    Ok(rule)
+}
+
+#[cfg(test)]
+fn validate_filter(
+    item: &FWPM_FILTER0,
+    namespace: &NamespaceKey,
+    expected_user: &[u16],
+) -> Result<()> {
+    validate_rule(item, namespace, expected_user).map(|_| ())
+}
+
+fn validate_collection(rules: &[LegacyRule]) -> Result<()> {
+    if rules.is_empty() {
+        return Ok(());
+    }
+    // Historical replacement was atomic: both address families share a complete policy.
+    // A partial/de-synchronized collection cannot be attributed to that old transaction.
+    for ipv6 in [false, true] {
+        for (inbound, protocol) in [(false, 17), (true, 6), (true, 17)] {
+            ensure!(
+                rules
+                    .iter()
+                    .filter(|r| r.ipv6 == ipv6
+                        && r.inbound == inbound
+                        && r.protocol == protocol
+                        && r.ports.is_none())
+                    .count()
+                    == 1,
+                "incomplete legacy loopback fixed rule set"
+            );
+        }
+    }
+    let ranges = |ipv6| {
+        let mut spans = rules
+            .iter()
+            .filter(|r| r.ipv6 == ipv6 && !r.inbound && r.protocol == 6)
+            .map(|r| r.ports.expect("validated TCP range"))
+            .collect::<Vec<_>>();
+        spans.sort_unstable();
+        spans
+    };
+    let ipv4 = ranges(false);
+    let ipv6 = ranges(true);
+    ensure!(ipv4 == ipv6, "legacy loopback IPv4/IPv6 policies differ");
+    ensure!(
+        ipv4.windows(2)
+            .all(|pair| u32::from(pair[0].1) + 1 < u32::from(pair[1].0)),
+        "legacy TCP ranges are not a canonical proxy-port complement"
+    );
+    ensure!(
+        rules.len() == 6 + 2 * ipv4.len(),
+        "unknown legacy loopback collection"
+    );
+    Ok(())
+}
+
+fn validate_sublayer(old: &FWPM_SUBLAYER0, namespace: &NamespaceKey) -> Result<()> {
+    let provider = namespaced_guid(namespace, super::PROVIDER_KEY);
+    let sublayer = namespaced_guid(namespace, LEGACY_SUBLAYER);
+    // Weight is runtime ordering, not ownership: real old objects requested at
+    // 0x8001 were read back at different weights. Durable identity/shape stays exact.
+    ensure!(
+        same_guid(old.subLayerKey, sublayer)
+            && !old.providerKey.is_null()
+            && same_guid(unsafe { *old.providerKey }, provider)
+            && old.flags == FWPM_SUBLAYER_FLAG_PERSISTENT
+            && old.providerData.size == 0
+            && unsafe { wide_equals(old.displayData.name, LEGACY_NAME) }
+            && unsafe { wide_equals(old.displayData.description, "") },
+        "ambiguous legacy loopback sublayer ownership"
+    );
+    Ok(())
+}
+
+pub(super) fn validate_provider(engine: HANDLE, namespace: &NamespaceKey) -> Result<()> {
+    let provider = namespaced_guid(namespace, super::PROVIDER_KEY);
+    let mut object: *mut FWPM_PROVIDER0 = null_mut();
+    ensure_success(
+        unsafe { FwpmProviderGetByKey0(engine, &provider, &mut object) },
+        "query legacy loopback provider",
+    )?;
+    let _object = WfpMemory(object.cast());
+    ensure!(!object.is_null(), "missing legacy provider result");
+    let object = unsafe { &*object };
+    ensure!(
+        same_guid(object.providerKey, provider)
+            && object.flags == FWPM_PROVIDER_FLAG_PERSISTENT
+            && object.providerData.size == 0
+            && unsafe { wide_equals(object.serviceName, "") }
+            && unsafe { wide_equals(object.displayData.name, super::PROVIDER_NAME) }
+            && unsafe { wide_equals(object.displayData.description, super::PROVIDER_DESCRIPTION) },
+        "ambiguous legacy loopback provider ownership"
+    );
+    Ok(())
+}
+
+/// Called only while the existing WFP transaction is held. Validate the whole collection
+/// before deleting anything; an error anywhere rolls back both migration and uninstall.
+pub(super) fn retire(engine: HANDLE, namespace: &NamespaceKey) -> Result<usize> {
+    let provider = namespaced_guid(namespace, super::PROVIDER_KEY);
+    let sublayer = namespaced_guid(namespace, LEGACY_SUBLAYER);
+    let mut old: *mut FWPM_SUBLAYER0 = null_mut();
+    let status = unsafe { FwpmSubLayerGetByKey0(engine, &sublayer, &mut old) };
+    if [FWP_E_SUBLAYER_NOT_FOUND as u32, FWP_E_NOT_FOUND as u32].contains(&status) {
+        return Ok(0);
+    }
+    ensure_success(status, "query legacy loopback sublayer")?;
+    let _old = WfpMemory(old.cast());
+    ensure!(!old.is_null(), "missing legacy sublayer result");
+    let old = unsafe { &*old };
+    validate_sublayer(old, namespace)?;
+    validate_provider(engine, namespace)?;
+    // Resolve the current validated account, rather than trusting a SID found in an old rule.
+    let user = UserMatchCondition::for_account(&namespace.offline())?;
+    let expected_user = user_descriptor(&user.blob)?;
+    let mut keys = Vec::new();
+    let mut rules = Vec::new();
+    for layer in [
+        FWPM_LAYER_ALE_AUTH_CONNECT_V4,
+        FWPM_LAYER_ALE_AUTH_CONNECT_V6,
+        FWPM_LAYER_ALE_AUTH_RECV_ACCEPT_V4,
+        FWPM_LAYER_ALE_AUTH_RECV_ACCEPT_V6,
+    ] {
+        let mut provider = provider;
+        let template = FWPM_FILTER_ENUM_TEMPLATE0 {
+            providerKey: &mut provider,
+            layerKey: layer,
+            enumType: FWP_FILTER_ENUM_FULLY_CONTAINED,
+            flags: FWP_FILTER_ENUM_FLAG_INCLUDE_DISABLED,
+            actionMask: u32::MAX,
+            ..unsafe { std::mem::zeroed() }
+        };
+        let mut handle = HANDLE::default();
+        ensure_success(
+            unsafe { FwpmFilterCreateEnumHandle0(engine, &template, &mut handle) },
+            "enumerate legacy loopback scope",
+        )?;
+        let enumeration = Enumeration { engine, handle };
+        loop {
+            let mut entries: *mut *mut FWPM_FILTER0 = null_mut();
+            let mut count = 0;
+            let status = unsafe {
+                FwpmFilterEnum0(engine, enumeration.handle, 128, &mut entries, &mut count)
+            };
+            let _entries = WfpMemory(entries.cast());
+            ensure_success(status, "read legacy loopback filters")?;
+            if count == 0 {
+                break;
+            }
+            ensure!(!entries.is_null(), "missing legacy filter enumeration");
+            for entry in unsafe { std::slice::from_raw_parts(entries, count as usize) } {
+                ensure!(!entry.is_null(), "missing legacy filter");
+                let item = unsafe { &**entry };
+                if same_guid(item.subLayerKey, sublayer) {
+                    rules.push(
+                        validate_rule(item, namespace, &expected_user)
+                            .context("refuse ambiguous legacy loopback migration")?,
+                    );
+                    keys.push(item.filterKey);
+                }
+            }
+        }
+    }
+    validate_collection(&rules)?;
+    for key in &keys {
+        delete_filter_if_present(engine, key)?;
+    }
+    // Unexpected layers/foreign provider objects cause IN_USE and transaction rollback.
+    ensure_success(
+        unsafe { FwpmSubLayerDeleteByKey0(engine, &sublayer) },
+        "retire legacy loopback sublayer",
+    )?;
+    Ok(keys.len())
+}
