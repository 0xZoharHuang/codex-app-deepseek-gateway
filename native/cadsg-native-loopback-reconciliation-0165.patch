+//! Pure native proxy-port complement; shared by Firewall COM and WFP.
+pub(crate) fn blocked_port_ranges(proxy_ports: &[u16]) -> Vec<(u16, u16)> {
+    let mut allowed = proxy_ports
+        .iter()
+        .copied()
+        .filter(|port| *port != 0)
+        .collect::<Vec<_>>();
+    allowed.sort_unstable();
+    allowed.dedup();
+    let mut result = Vec::new();
+    let mut start = 1_u32;
+    for port in allowed {
+        let port = u32::from(port);
+        if port > start {
+            result.push((start as u16, (port - 1) as u16));
+        }
+        start = port + 1;
+    }
+    if start <= u32::from(u16::MAX) {
+        result.push((start as u16, u16::MAX));
+    }
+    result
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct LoopbackRule {
+    pub(super) ipv6: bool,
+    pub(super) inbound: bool,
+    pub(super) protocol: u8,
+    pub(super) ports: Option<(u16, u16)>,
+}
+impl LoopbackRule {
+    pub(super) fn key(self) -> u128 {
+        let (start, end) = self.ports.unwrap_or((0, 0));
+        0x126c0bde_1df2_4bc1_8d00_000000000000_u128
+            | ((self.ipv6 as u128) << 40)
+            | ((self.inbound as u128) << 41)
+            | ((self.protocol as u128) << 32)
+            | ((start as u128) << 16)
+            | end as u128
+    }
+}
+pub(super) fn rules(proxy_ports: &[u16], allow_local_binding: bool) -> Vec<LoopbackRule> {
+    if allow_local_binding {
+        return Vec::new();
+    }
+    let ports = blocked_port_ranges(proxy_ports);
+    [false, true]
+        .into_iter()
+        .flat_map(|ipv6| {
+            std::iter::once(LoopbackRule {
+                ipv6,
+                inbound: false,
+                protocol: 17,
+                ports: None,
+            })
+            .chain(ports.iter().copied().map(move |ports| LoopbackRule {
+                ipv6,
+                inbound: false,
+                protocol: 6,
+                ports: Some(ports),
+            }))
+            // Proxy exceptions authorize connections initiated by the sandbox only.
+            // A restricted sandbox listener must not accept arbitrary local clients.
+            .chain([6, 17].into_iter().map(move |protocol| LoopbackRule {
+                ipv6,
+                inbound: true,
+                protocol,
+                ports: None,
+            }))
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{blocked_port_ranges, rules};
+    #[test]
+    fn empty_proxy_set_blocks_every_tcp_port() {
+        assert_eq!(blocked_port_ranges(&[]), vec![(1, 65535)]);
+    }
+    #[test]
+    fn ports_zero_duplicates_and_extremes_preserve_exact_complement() {
+        assert_eq!(
+            blocked_port_ranges(&[65535, 443, 0, 1, 443]),
+            vec![(2, 442), (444, 65534)]
+        );
+    }
+    #[test]
+    fn each_port_is_either_explicitly_allowed_or_blocked_once() {
+        let allowed = [1, 2, 17, 18, 8080, 32768, 65534, 65535];
+        let ranges = blocked_port_ranges(&allowed);
+        for port in 1..=u16::MAX {
+            let count = ranges
+                .iter()
+                .filter(|(first, last)| (*first..=*last).contains(&port))
+                .count();
+            assert_eq!(count, usize::from(!allowed.contains(&port)));
+        }
+    }
+    #[test]
+    fn explicitly_allowing_all_ports_leaves_no_tcp_block() {
+        assert!(blocked_port_ranges(&(1..=u16::MAX).collect::<Vec<_>>()).is_empty());
+    }
+    #[test]
+    fn local_binding_removes_all_loopback_restrictions() {
+        assert!(rules(&[], true).is_empty());
+        assert!(rules(&[3128, 8080], true).is_empty());
+    }
+    #[test]
+    fn proxy_tcp_exceptions_never_allow_udp_and_keys_do_not_alias() {
+        let result = rules(&[3128, 8080], false);
+        let keys = result
+            .iter()
+            .map(|rule| rule.key())
+            .collect::<std::collections::BTreeSet<_>>();
+        assert_eq!(keys.len(), result.len());
+        for ipv6 in [false, true] {
+            assert_eq!(
+                result
+                    .iter()
+                    .filter(|r| r.ipv6 == ipv6
+                        && !r.inbound
+                        && r.protocol == 17
+                        && r.ports.is_none())
+                    .count(),
+                1
+            );
+            for port in [3128, 8080] {
+                assert!(!result.iter().any(|r| r.ipv6 == ipv6
+                    && r.protocol == 6
+                    && r.ports.is_some_and(|(a, b)| (a..=b).contains(&port))));
+            }
+        }
+        assert_eq!(rules(&[], false).len(), 8);
+        assert_eq!(
+            result
+                .iter()
+                .filter(|r| r.inbound && r.ports.is_none())
+                .count(),
+            4
+        );
+    }
+}
