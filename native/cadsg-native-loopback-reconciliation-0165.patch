+/// Effective loopback policy is mandatory on Win10, where COM rules alone do not
+/// enforce the per-account local restriction. Retire validated old/current rules
+/// and install the exact desired profile in one existing native WFP transaction.
+pub(crate) fn reconcile_loopback_policy(
+    namespace: &crate::namespace_key::NamespaceKey,
+    proxy_ports: &[u16],
+    allow_local_binding: bool,
+) -> Result<(usize, usize)> {
+    let engine = Engine::open(INFINITE)?;
+    let mut transaction = engine.begin_transaction()?;
+    let retired = legacy_loopback_migration::retire(engine.handle, namespace)?;
+    let installed = if allow_local_binding {
+        0
+    } else {
+        ensure_provider(engine.handle, namespace)?;
+        legacy_loopback_migration::validate_provider(engine.handle, namespace)?;
+        let user = UserMatchCondition::for_account(&namespace.offline())?;
+        loopback_reconcile::install(
+            engine.handle,
+            namespace,
+            &user,
+            proxy_ports,
+            allow_local_binding,
+        )?
+    };
+    transaction.commit()?;
+    Ok((retired, installed))
+}
