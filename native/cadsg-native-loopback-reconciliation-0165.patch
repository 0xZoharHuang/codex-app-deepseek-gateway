 pub(crate) fn remove_namespaced_wfp_filters(
     namespace: &crate::namespace_key::NamespaceKey,
 ) -> Result<()> {
     // Leave time for other cleanup if a WFP policy writer holds the transaction lock.
     let engine = Engine::open(/*transaction_wait_timeout_ms*/ 1_000)?;
     let mut transaction = engine.begin_transaction()?;
+    legacy_loopback_migration::retire(engine.handle, namespace)?;
     for spec in FILTER_SPECS {
         delete_filter_if_present(engine.handle, &namespaced_guid(namespace, spec.key))?;
     }
