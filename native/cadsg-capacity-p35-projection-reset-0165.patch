+impl CapacityPrefix {
+    /// Called under the same state lock as the live replacement and its receipt.
+    pub(super) fn stage_reset_continuation(
+        &self,
+        receipt: &CapacitySendSnapshot,
+        installed: &ContextManager,
+    ) {
+        let Some(completion) = &self.reset_completion else {
+            return;
+        };
+        let start = receipt.history.annotated_items().len();
+        let Some(end) = start.checked_add(completion.gap.len()) else {
+            return;
+        };
+        if receipt.generation != installed.history_version()
+            || installed.annotated_items().get(..start) != Some(receipt.history.annotated_items())
+            || installed.annotated_items().get(start..end) != Some(completion.gap.as_slice())
+            || installed.pair_safe_prefix_len(end) != end
+        {
+            return;
+        }
+        if let Ok(mut staged) = completion.staged.lock() {
+            *staged = Some(receipt.clone());
+        }
+    }
+
+    /// Called only after the existing rollout ACK and checkpoint CAS succeeded.
+    pub(super) fn publish_reset_continuation(&self, checkpoint: request_capacity::Checkpoint) {
+        let Some(completion) = &self.reset_completion else {
+            return;
+        };
+        let Some(reset) = completion
+            .staged
+            .lock()
+            .ok()
+            .and_then(|mut staged| staged.take())
+        else {
+            return;
+        };
+        if !checkpoint
+            .binding
+            .same_sampling_scope(&self.checkpoint.binding)
+            || checkpoint.binding.history_anchor != reset.history_anchor
+            || checkpoint.binding.history_anchor == self.checkpoint.binding.history_anchor
+            || checkpoint.prefix_len != reset.history.annotated_items().len()
+            || checkpoint.completed_epoch != self.checkpoint.completed_epoch
+            || checkpoint.response_id != self.checkpoint.response_id
+            || checkpoint.recovery_turn_id != self.checkpoint.recovery_turn_id
+            || checkpoint.recovery_turn_id.is_none()
+            || checkpoint.origin != request_capacity::Origin::TranslatedPrefix
+            || !matches!(
+                checkpoint.matches_prefix(reset.history.annotated_items()),
+                Ok(true)
+            )
+        {
+            return;
+        }
+        let proof = CapacityResetContinuation {
+            original: self.checkpoint.clone(),
+            checkpoint,
+            home: self.home.clone(),
+            reset,
+            auth_owner_generation: self.prefix.auth_owner_generation,
+            gap: Arc::clone(&completion.gap),
+            gap_hash: completion.gap_hash,
+        };
+        if let Some(sender) = completion
+            .sender
+            .lock()
+            .ok()
+            .and_then(|mut sender| sender.take())
+        {
+            // A dropped/cancelled receiver does not create a usable continuation.
+            let _ = sender.send(proof);
+        }
+    }
+}
