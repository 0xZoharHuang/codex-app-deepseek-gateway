+        .await;
+    let mut source = typed_source(scenario)?;
+    if scenario == "text_confirmed" {
+        // A second real ordinary completion grants only this exact captured
+        // prefix authority. The pending/current suffix is appended afterwards.
+        session
+            .record_conversation_items(&turn, turn.model_info(), &source)
+            .await;
+        session
+            .confirm_capacity_completion(
+                &turn,
+                &turn.model_info().slug,
