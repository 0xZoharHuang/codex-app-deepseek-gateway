+#[test]
+fn historical_projection_requires_fresh_summary_exact_parts_and_carry_chain() -> anyhow::Result<()>
+{
+    let original = target(exact_pair()?);
+    let mut work = CapacitySummaryWork::new(original.clone());
+    assert!(work.reduce(false, "current-turn")?);
+    let input = native_input();
+    let _ = prepare(&mut work, &input)?;
+    let no_summary = CompactionResponse {
+        response_id: "first".to_owned(),
+        summary: None,
+    };
+    assert!(work.complete_selected(&no_summary, None).is_err());
+    let first = CompactionResponse {
+        response_id: "first".to_owned(),
+        summary: Some("first original parts".to_owned()),
+    };
+    assert!(!work.complete_selected(&first, None)?);
+    assert_eq!(
+        work.coverage.covered, 0,
+        "partial parts are not a consumed pair"
+    );
+    let summary = work.coverage.carry_summary.clone().unwrap();
+    work.advance(build_compacted_history(Vec::new(), &[], &summary))?;
+    let mut prompt = prepare(&mut work, &input)?;
+    assert_eq!(
+        work.coverage.prompt_carry(&prompt)?,
+        Some("first".to_owned())
+    );
+    let final_response = CompactionResponse {
+        response_id: "final".to_owned(),
+        summary: Some("all original parts".to_owned()),
+    };
+    assert!(
+        work.complete_selected(&final_response, None).is_err(),
+        "missing carry proof"
+    );
+    // An invalid completion must not consume the prepared projection.
+    assert!(work.complete_selected(&final_response, Some("first".to_owned()))?);
+    assert!(work.coverage.matches_target(&original, "final"));
+    work.coverage.segments[1]
+        .projection
+        .as_mut()
+        .unwrap()
+        .part_start += 1;
+    assert!(
+        !work.coverage.matches_target(&original, "final"),
+        "missing original part"
+    );
+    work.coverage.segments[1]
+        .projection
+        .as_mut()
+        .unwrap()
+        .part_start -= 1;
+    work.coverage.segments[1]
+        .projection
+        .as_mut()
+        .unwrap()
+        .part_start = 0;
+    assert!(
+        !work.coverage.matches_target(&original, "final"),
+        "duplicated original part"
+    );
+    prompt.retain(|item| !matches!(item, ResponseItem::Message { content, .. }
+        if content.iter().any(|part| matches!(part, ContentItem::InputText { text } if text == &summary))));
+    assert!(work.coverage.prompt_carry(&prompt).is_err());
+    Ok(())
+}
