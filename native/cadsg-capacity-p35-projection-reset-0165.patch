+            turn.model_info(),
+            &[message("user", "CURRENT_UNCONSUMED_CANARY", &turn.sub_id)],
+        )
+        .await;
+    let prefix = session
+        .capacity_prefix(&turn, &turn.model_info().slug)
+        .await
+        .unwrap();
+    assert!(prefix.needs_fresh_summary());
+    let before = session.clone_history().await;
+    let suffix = before.annotated_items()[prefix.prefix.len..].to_vec();
+    let before_window = session.current_window().await;
+    let before_cp = session.capacity_checkpoint_for_test().await.unwrap();
+    let token = CancellationToken::new();
+    let step = session
+        .capture_step_context(Arc::clone(&turn), &token)
+        .await?;
+    let world = Arc::new(session.build_world_state_for_step(&step, true).await?);
+    let result = crate::compact_token_budget::run_inline_capacity_reset_with_old_gap(
+        Arc::clone(&session),
+        step,
+        world,
+        prefix,
+        codex_protocol::error::UnexpectedResponseError {
+            status: http::StatusCode::PAYLOAD_TOO_LARGE,
+            body: "Synthetic known pre-response capacity rejection".into(),
+            user_message: None,
+            url: None,
+            cf_ray: None,
+            request_id: None,
+            identity_authorization_error: None,
+            identity_error_code: None,
+        },
+        token,
+    )
+    .await;
+    assert_eq!(counts.pre.load(Ordering::SeqCst), 1);
+    assert!(
+        server.received_requests().await.unwrap().is_empty(),
+        "local reset/STOP sends no model request"
+    );
+    if stop {
+        assert!(
+            matches!(result,Err(ref e) if matches!(e.details(),codex_protocol::error::CodexErrorDetails::TurnAborted))
+        );
+        assert_eq!(
+            session.clone_history().await.annotated_items(),
+            before.annotated_items()
+        );
+        assert_eq!(session.current_window().await, before_window);
+        assert_eq!(
+            serde_json::to_value(session.capacity_checkpoint_for_test().await.unwrap())?,
+            serde_json::to_value(before_cp)?
+        );
+        assert_eq!(counts.post.load(Ordering::SeqCst), 0);
+        assert_eq!(compacted_count(&session, &rollout).await?, 0);
+    } else {
+        let crate::compact_token_budget::CapacityResetOutcome::Reset(proof) = result? else {
+            panic!("real local reset required")
+        };
+        assert!(
+            proof.is_some(),
+            "real ACK/CAS must mint old-gap continuation"
+        );
+        let after = session.clone_history().await;
+        assert_eq!(
+            &after.annotated_items()[after.annotated_items().len() - suffix.len()..],
+            suffix.as_slice()
+        );
+        assert!(
+            contains_text(&after, "POST_NATIVE_PREHOOK_CONTEXT_1"),
+            "context must be built after the actual native pre-hook"
+        );
+        assert_eq!(session.current_window().await.1, before_window.1 + 1);
+        assert_eq!(counts.post.load(Ordering::SeqCst), 1);
+        assert_eq!(compacted_count(&session, &rollout).await?, 1);
+        assert!(
+            session
+                .capacity_prefix(&turn, &turn.model_info().slug)
+                .await
+                .is_none(),
+            "same fence cannot be claimed again"
+        );
+    }
