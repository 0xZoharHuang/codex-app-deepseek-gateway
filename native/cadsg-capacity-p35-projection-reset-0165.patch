+    let rollout =
+        attach_real_writer(Arc::get_mut(&mut session).expect("unique native fixture session"))
+            .await?;
+    assert!(session.live_thread().is_some());
+    let mut consumed = user_message("CONFIRMED-ANCHOR-BEFORE-TYPED-OUTPUT");
+    consumed.set_turn_id_if_missing(OLD_TURN);
+    session
+        .record_conversation_items(&turn, turn.model_info(), &[consumed])
+        .await;
+    session
+        .confirm_capacity_completion(
+            &turn,
