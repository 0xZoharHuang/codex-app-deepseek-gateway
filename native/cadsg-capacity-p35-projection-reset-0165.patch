+impl Session {
+    /// Build the original native reset plan after the native pre-compact hook. An unchanged or
+    /// larger request prefix cannot consume a recovery attempt by installing it.
+    pub(crate) async fn prepare_capacity_reset_for_recovery(
+        self: &Arc<Self>,
+        step: &StepContext,
+        world_state: Arc<WorldState>,
+        mut prefix: CapacityPrefix,
+        token: &CancellationToken,
+    ) -> CapacityResetPreparation {
+        if token.is_cancelled() {
+            return CapacityResetPreparation::Invalid;
+        }
+        let retained = self.retained_client_items_for_context_window(&prefix.history);
+        let (updates, baseline) = tokio::select! {
+            biased;
+            _ = token.cancelled() => return CapacityResetPreparation::Invalid,
+            value = self.build_initial_context_with_world_state(step, world_state.as_ref()) => value,
+        };
+        let mut items = crate::context_manager::updates::merge_world_state_updates(updates)
+            .into_iter()
+            .map(ResponseItemEnvelope::new)
+            .chain(retained)
+            .collect::<Vec<_>>();
+        for envelope in &mut items {
+            Self::assign_missing_response_item_id(&mut envelope.item);
+        }
+        {
+            let state = self.state.lock().await;
+            if token.is_cancelled()
+                || state.history.history_version() != prefix.prefix.generation
+                || self.services.model_client.auth_owner_generation()
+                    != prefix.prefix.auth_owner_generation
+                || self.current_window_from_state(&state).0
+                    != prefix.checkpoint.binding.history_anchor
+                || state.request_capacity_checkpoint.as_ref() != Some(&prefix.checkpoint)
+                || !matches!(
+                    prefix
+                        .checkpoint
+                        .matches_prefix(state.history.annotated_items()),
+                    Ok(true)
+                )
+            {
+                return CapacityResetPreparation::Invalid;
+            }
+        }
+        // The exact preserved suffix and non-input settings are identical. Use
+        // the original native builder, including its provider metadata and image
+        // policies, to compare only the changing nonempty prefix contribution.
+        let metadata = crate::responses_metadata::CodexResponsesMetadata::new(
+            String::new(),
+            self.session_id().to_string(),
+            self.thread_id.to_string(),
+            prefix.checkpoint.binding.history_anchor.clone(),
+        );
+        let size = |history: ContextManager| {
+            let prompt = crate::Prompt {
+                input: history.for_prompt(&step.settings.model_info.input_modalities),
+                ..Default::default()
+            };
+            let request = self
+                .services
+                .model_client
+                .build_responses_request(
+                    &prompt,
+                    step.settings.model_info.as_ref(),
+                    None,
+                    step.turn.reasoning_summary(),
+                    step.turn.config.service_tier.clone(),
+                    &metadata,
+                    false,
+                )
+                .ok()?;
+            serde_json::to_vec(&request).ok().map(|bytes| bytes.len())
+        };
+        let mut reset_history = prefix.history.clone();
+        reset_history.replace_annotated(items.clone());
+        let Some((after, before)) = size(reset_history).zip(size(prefix.history.clone())) else {
+            return CapacityResetPreparation::Invalid;
+        };
+        if after >= before {
+            return CapacityResetPreparation::NoProgress(prefix);
+        }
+        let mut receiver = None;
+        if let Some(historical) = &prefix.fresh_summary_history {
+            let start = prefix.prefix.len;
+            let end = historical.annotated_items().len();
+            if historical.annotated_items().get(..start) != Some(prefix.history.annotated_items()) {
+                return CapacityResetPreparation::Invalid;
+            }
+            if end > start {
+                let gap = historical.annotated_items()[start..end].to_vec();
+                if gap.iter().any(|item| {
+                    item.item.turn_id().is_none()
+                        || item.item.turn_id() == Some(step.turn.sub_id.as_str())
+                }) {
+                    return CapacityResetPreparation::Invalid;
+                }
+                let Some(gap_hash) = exact_gap_hash(&gap) else {
+                    return CapacityResetPreparation::Invalid;
+                };
+                let (sender, completion) = tokio::sync::oneshot::channel();
+                prefix.reset_completion = Some(CapacityResetCompletion {
+                    gap: Arc::new(gap),
+                    gap_hash,
+                    staged: std::sync::Mutex::new(None),
+                    sender: std::sync::Mutex::new(Some(sender)),
+                });
+                receiver = Some(completion);
+            }
+        }
+        prefix.prepared_reset = Some(PreparedCapacityReset { items, baseline });
+        CapacityResetPreparation::Ready {
+            prefix,
+            completion: receiver,
+        }
+    }
+
+    /// Consume a one-turn reset continuation without claiming or writing a fence.
+    pub(crate) async fn capacity_prefix_from_reset_continuation(
+        &self,
+        proof: CapacityResetContinuation,
+        turn: &TurnContext,
+        model: &str,
+        token: &CancellationToken,
+    ) -> Option<CapacityPrefix> {
+        if token.is_cancelled()
+            || proof.checkpoint.recovery_turn_id.as_deref() != Some(turn.sub_id.as_str())
+            || proof.original.recovery_turn_id != proof.checkpoint.recovery_turn_id
+            || proof.original.completed_epoch != proof.checkpoint.completed_epoch
+            || proof.original.response_id != proof.checkpoint.response_id
+            || !proof
+                .original
+                .binding
+                .same_sampling_scope(&proof.checkpoint.binding)
+            || self.services.model_client.auth_owner_generation() != proof.auth_owner_generation
+        {
+            return None;
+        }
+        let snapshot = self.capture_capacity_send().await;
+        let start = proof.reset.history.annotated_items().len();
+        let end = start.checked_add(proof.gap.len())?;
+        if snapshot.generation != proof.reset.generation
+            || snapshot.history_anchor != proof.reset.history_anchor
+            || snapshot.history.annotated_items().get(..start)
+                != Some(proof.reset.history.annotated_items())
+            || snapshot.history.annotated_items().get(start..end) != Some(proof.gap.as_slice())
+            || exact_gap_hash(snapshot.history.annotated_items().get(start..end)?)?
+                != proof.gap_hash
+            || snapshot.history.pair_safe_prefix_len(end) != end
+            || proof.gap.iter().any(|item| {
+                item.item.turn_id().is_none() || item.item.turn_id() == Some(turn.sub_id.as_str())
+            })
+        {
+            return None;
+        }
+        let home = turn.config.codex_home.clone();
+        let thread = self.thread_id.to_string();
+        let model = model.to_owned();
+        let provider = turn.config.model_provider_id.clone();
+        let anchor = snapshot.history_anchor.clone();
+        let expected = proof.checkpoint.clone();
+        let durable = self.live_thread().is_some();
+        let memory = self.state.lock().await.request_capacity_checkpoint.clone();
+        let persistence = self.track_native_persistence()?;
+        let valid = tokio::task::spawn_blocking(move || -> anyhow::Result<bool> {
+            let _persistence = persistence;
+            let binding =
+                request_capacity::Binding::for_profile(&home, &thread, &model, &provider, &anchor)?;
+            if expected.binding != binding || memory.as_ref() != Some(&expected) {
+                return Ok(false);
+            }
+            if durable {
+                return Ok(request_capacity::load(&home, &binding)?.as_ref() == Some(&expected));
+            }
+            Ok(true)
+        })
+        .await
+        .ok()?
+        .ok()?;
+        if !valid || token.is_cancelled() {
+            return None;
+        }
+        let state = self.state.lock().await;
+        if state.history.history_version() != proof.reset.generation
+            || self.current_window_from_state(&state).0 != proof.reset.history_anchor
+            || state.request_capacity_checkpoint.as_ref() != Some(&proof.checkpoint)
+            || self.services.model_client.auth_owner_generation() != proof.auth_owner_generation
+            || state.history.annotated_items().get(..start)
+                != Some(proof.reset.history.annotated_items())
+            || state.history.annotated_items().get(start..end) != Some(proof.gap.as_slice())
+            || !matches!(
+                proof
+                    .checkpoint
+                    .matches_prefix(state.history.annotated_items()),
+                Ok(true)
+            )
+        {
+            return None;
+        }
+        let mut target = snapshot.history.clone();
+        target.replace_annotated(snapshot.history.annotated_items()[..end].to_vec());
+        Some(CapacityPrefix {
+            history: proof.reset.history,
+            prefix: CompactionPrefix {
+                generation: proof.reset.generation,
+                len: start,
+                auth_owner_generation: proof.auth_owner_generation,
+            },
+            checkpoint: proof.checkpoint,
+            home: proof.home,
+            fresh_summary_history: Some(target),
+            pre_compact_hook_ran: false,
+            prepared_reset: None,
+            reset_completion: None,
+        })
+    }
+}
