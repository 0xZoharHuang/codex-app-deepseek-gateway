+        "wrong child caller"
+    );
+    ensure_access(&sid)?;
+    let name = current_window_station_name()?;
+    let lock = lock_station(session, &name, &caller)?;
+    println!("OWN_STATION_CHILD_ACTUAL_GRANT {}", lock._leaf);
+    Ok(())
+}
