+pub(crate) enum CapacityResetOutcome {
+    Reset(Option<crate::session::CapacityResetContinuation>),
+    FreshSummary(CapacityPrefix),
+}
+
+/// Same native reset lifecycle, with a one-turn proof for a preserved old gap.
+pub(crate) async fn run_inline_capacity_reset_with_old_gap(
+    sess: Arc<Session>,
+    step_context: Arc<StepContext>,
+    world_state: Arc<WorldState>,
+    mut prefix: CapacityPrefix,
+    rejection: UnexpectedResponseError,
+    cancellation_token: CancellationToken,
+) -> CodexResult<CapacityResetOutcome> {
+    if cancellation_token.is_cancelled() {
+        return Err(CodexErr::TurnAborted);
+    }
+    match run_pre_compact_hooks(&sess, &step_context.turn, CompactionTrigger::Auto)
+        .or_cancel(&cancellation_token)
+        .await
+        .unwrap_or(PreCompactHookOutcome::Stopped)
+    {
+        PreCompactHookOutcome::Continue => prefix.mark_pre_compact_hook_ran(),
+        PreCompactHookOutcome::Stopped => return Err(CodexErr::TurnAborted),
+    }
+    match sess
+        .prepare_capacity_reset_for_recovery(
+            &step_context,
+            Arc::clone(&world_state),
+            prefix,
+            &cancellation_token,
+        )
+        .await
+    {
+        crate::session::CapacityResetPreparation::Ready { prefix, completion } => {
+            run_inline_capacity_reset_task(
+                sess,
+                step_context,
+                world_state,
+                prefix,
+                rejection,
+                cancellation_token.clone(),
+            )
+            .await?;
+            if cancellation_token.is_cancelled() {
+                return Err(CodexErr::TurnAborted);
+            }
+            let continuation = match completion {
+                Some(receiver) => receiver.await.ok(),
+                None => None,
+            };
+            Ok(CapacityResetOutcome::Reset(continuation))
+        }
+        crate::session::CapacityResetPreparation::NoProgress(prefix) => {
+            if prefix.needs_fresh_summary() {
+                Ok(CapacityResetOutcome::FreshSummary(prefix))
+            } else {
+                Err(CodexErr::UnexpectedStatus(rejection))
+            }
+        }
+        crate::session::CapacityResetPreparation::Invalid => {
+            if cancellation_token.is_cancelled() {
+                Err(CodexErr::TurnAborted)
+            } else {
+                Err(CodexErr::UnexpectedStatus(rejection))
+            }
+        }
+    }
+}
