+#[test]
+fn historical_projection_rejects_extra_suffix_or_changed_native_instruction() -> anyhow::Result<()>
+{
+    let original = target(exact_pair()?);
+    let mut work = CapacitySummaryWork::new(original);
+    assert!(work.reduce(false, "current-turn")?);
+    let input = native_input();
+    assert!(matches!(
+        &input,
+        ResponseItem::Message {
+            internal_chat_message_metadata_passthrough: None,
+            ..
+        }
+    ));
+    let mut prompt = recorded_prompt(work.selected_history()?, &input, &[InputModality::Image]);
+    assert!(
+        matches!(prompt.last(), Some(ResponseItem::Message {
+        internal_chat_message_metadata_passthrough: Some(metadata), ..
+    }) if metadata.content_item_kinds.as_ref().is_some_and(|kinds|
+        kinds.len() == 1 && kinds[0].0 == "unknown")),
+        "the known native instruction must actually gain positional metadata"
+    );
+    let original_instruction = prompt.last().unwrap().clone();
+    let mut extra = prompt.clone();
+    extra.push(user_message("CURRENT-SUFFIX-MUST-NOT-ENTER"));
+    assert!(
+        work.prepare_prompt(&mut extra, &input, &[InputModality::Image])
+            .is_err()
+    );
+    let mut extra_image = prompt.clone();
+    extra_image.insert(extra_image.len() - 1, typed_source("message")?.remove(0));
+    assert!(
+        work.prepare_prompt(&mut extra_image, &input, &[InputModality::Image])
+            .is_err()
+    );
+    let mut missing = prompt.clone();
+    missing.pop();
+    assert!(
+        work.prepare_prompt(&mut missing, &input, &[InputModality::Image])
+            .is_err()
+    );
+    let mut changed = prompt.clone();
+    *changed.last_mut().unwrap() = user_message("different arbitrary user tail");
+    assert!(
+        work.prepare_prompt(&mut changed, &input, &[InputModality::Image])
+            .is_err()
+    );
+    let mut duplicate = prompt.clone();
+    duplicate.push(input.clone());
+    assert!(
+        work.prepare_prompt(&mut duplicate, &input, &[InputModality::Image])
+            .is_err()
+    );
+    work.prepare_prompt(&mut prompt, &input, &[InputModality::Image])?;
+    let mut framed = prompt.last().unwrap().clone();
+    let parts = codex_context_fragments::to_annotated_content(&mut framed).unwrap();
+    assert_eq!(parts.len(), 2);
+    let (_, kind, provenance) = parts[1].clone().into_parts();
+    assert_eq!(kind.0, "unknown");
+    assert_eq!(provenance, ContentItemMetadata::harness());
+    codex_context_fragments::set_annotated_content(&mut framed, parts[..1].to_vec()).unwrap();
+    assert_eq!(
+        framed, original_instruction,
+        "appending framing must preserve the original instruction and all positional metadata"
+    );
+    Ok(())
+}
