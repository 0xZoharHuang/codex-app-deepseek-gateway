diff --git a/codex-rs/core/src/compact_capacity_projection.rs b/codex-rs/core/src/compact_capacity_projection.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/core/src/compact_capacity_projection.rs
@@ -0,0 +1,632 @@
+//! Prompt-only views of a completed historical typed item.
+//! Original envelopes remain the transaction target. A view is never installed.
+use super::CodexErr;
+use super::CodexResult;
+use super::ResponseItem;
+use super::ResponseItemEnvelope;
+use crate::context_manager::ContextManager;
+use codex_context_fragments::set_annotated_content;
+use codex_context_fragments::to_annotated_content;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use serde::Serialize;
+use sha2::Digest;
+use sha2::Sha256;
+
+/// Byte offsets always refer to one unchanged original text part.
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct ProjectionTextRange {
+    start: usize,
+    end: usize,
+    len: usize,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct ProjectionReceipt {
+    pub(super) source_start: usize,
+    pub(super) source_end: usize,
+    atom_index: usize,
+    atom_count: usize,
+    part_item: usize,
+    call_item: Option<usize>,
+    whole: bool,
+    pub(super) part_start: usize,
+    pub(super) part_end: usize,
+    pub(super) part_count: usize,
+    text_range: Option<ProjectionTextRange>,
+    source_turn: String,
+    source_hash: [u8; 32],
+    projection_hash: [u8; 32],
+}
+
+#[derive(Clone)]
+struct ProjectionAtom {
+    item: usize,
+    call: Option<usize>,
+    parts: usize,
+    whole: bool,
+}
+
+#[derive(Clone)]
+pub(super) struct CapacityProjection {
+    pub(super) source_start: usize,
+    pub(super) source_end: usize,
+    atoms: Vec<ProjectionAtom>,
+    atom_index: usize,
+    pub(super) part_start: usize,
+    pub(super) part_end: usize,
+    text_range: Option<ProjectionTextRange>,
+    source_turn: String,
+}
+
+fn invalid(message: &str) -> CodexErr {
+    CodexErr::InvalidRequest(message.to_owned())
+}
+
+fn fingerprint<T: Serialize + ?Sized>(value: &T) -> CodexResult<[u8; 32]> {
+    let bytes = serde_json::to_vec(value)
+        .map_err(|_| invalid("Cannot fingerprint historical compaction projection"))?;
+    Ok(Sha256::digest(bytes).into())
+}
+
+fn without_execution_metadata(mut item: ResponseItem) -> ResponseItem {
+    // This metadata is attached by the native call inventory after normalization.
+    // It is not original content and must not turn replay context into new progress.
+    item.clear_executed_tool_calls();
+    item
+}
+
+impl CapacityProjection {
+    #[cfg(test)]
+    pub(super) fn new(
+        target: &ContextManager,
+        source_start: usize,
+        source_end: usize,
+        current_turn: &str,
+    ) -> Option<Self> {
+        Self::new_with_confirmed_prefix(target, source_start, source_end, current_turn, 0)
+    }
+
+    pub(super) fn new_with_confirmed_prefix(
+        target: &ContextManager,
+        source_start: usize,
+        source_end: usize,
+        current_turn: &str,
+        confirmed_len: usize,
+    ) -> Option<Self> {
+        let mut projection = Self::source(target, source_start, source_end)?;
+        // The exception is only the captured, hash-verified ordinary-consumed
+        // prefix. Fresh-summary extension must never grant current-input authority.
+        if current_turn.is_empty()
+            || (projection.source_turn == current_turn && source_end > confirmed_len)
+        {
+            return None;
+        }
+        // A multi-atom block becomes one complete pair/message per request.
+        // For one atom the full body just failed: reduce parts, then UTF-8 text.
+        if projection.atoms.len() == 1 && !projection.shrink(target) {
+            return None;
+        }
+        Some(projection)
+    }
+
+    fn source(target: &ContextManager, source_start: usize, source_end: usize) -> Option<Self> {
+        if source_end <= source_start
+            || target.pair_safe_prefix_len(source_start) != source_start
+            || target.pair_safe_prefix_len(source_end) != source_end
+        {
+            return None;
+        }
+        let source = target.annotated_items().get(source_start..source_end)?;
+        let turn = source.first()?.item.turn_id()?.to_owned();
+        if turn.is_empty()
+            || source
+                .iter()
+                .any(|item| item.item.turn_id() != Some(turn.as_str()))
+        {
+            return None;
+        }
+        let mut atoms = Vec::new();
+        let mut used_calls = std::collections::HashSet::new();
+        for (index, envelope) in source.iter().enumerate() {
+            let call = match &envelope.item {
+                ResponseItem::Message {
+                    encrypted_content: None,
+                    content,
+                    status,
+                    ..
+                } if status.as_deref().is_none_or(|status| status == "completed") => {
+                    atoms.push(ProjectionAtom {
+                        item: index,
+                        call: None,
+                        parts: content.len().max(1),
+                        whole: content.is_empty(),
+                    });
+                    continue;
+                }
+                ResponseItem::CustomToolCall {
+                    encrypted_content: None,
+                    status,
+                    ..
+                }
+                | ResponseItem::FunctionCall {
+                    encrypted_content: None,
+                    encrypted_function_args: None,
+                    status,
+                    ..
+                } if status.as_deref().is_none_or(|status| status == "completed") => continue,
+                ResponseItem::CustomToolCallOutput { call_id, .. } => {
+                    let matches = source.iter().enumerate().filter(|(_, item)| matches!(
+                        &item.item, ResponseItem::CustomToolCall { call_id: id, .. } if id == call_id
+                    )).map(|(index, _)| index).collect::<Vec<_>>();
+                    if matches.len() != 1 {
+                        return None;
+                    }
+                    matches[0]
+                }
+                ResponseItem::FunctionCallOutput {
+                    call_id: Some(call_id),
+                    ..
+                } => {
+                    let matches = source.iter().enumerate().filter(|(_, item)| matches!(
+                        &item.item, ResponseItem::FunctionCall { call_id: id, .. } if id == call_id
+                    )).map(|(index, _)| index).collect::<Vec<_>>();
+                    if matches.len() != 1 {
+                        return None;
+                    }
+                    matches[0]
+                }
+                _ => return None,
+            };
+            if call >= index || !used_calls.insert(call) {
+                return None;
+            }
+            let output = match &envelope.item {
+                ResponseItem::FunctionCallOutput { output, .. }
+                | ResponseItem::CustomToolCallOutput { output, .. } => output,
+                _ => return None,
+            };
+            let (parts, whole) = match output.content_items() {
+                Some(parts) => {
+                    if parts.iter().any(|part| {
+                        matches!(part, FunctionCallOutputContentItem::EncryptedContent { .. })
+                    }) {
+                        return None;
+                    }
+                    (parts.len().max(1), parts.is_empty())
+                }
+                // Keep the native string envelope; byte views only edit its clone.
+                None => (1, true),
+            };
+            atoms.push(ProjectionAtom {
+                item: index,
+                call: Some(call),
+                parts,
+                whole,
+            });
+        }
+        let call_count = source
+            .iter()
+            .filter(|item| {
+                matches!(
+                    item.item,
+                    ResponseItem::CustomToolCall { .. } | ResponseItem::FunctionCall { .. }
+                )
+            })
+            .count();
+        if used_calls.len() != call_count {
+            return None;
+        }
+        let part_end = atoms.first()?.parts;
+        Some(Self {
+            source_start,
+            source_end,
+            atoms,
+            atom_index: 0,
+            part_start: 0,
+            part_end,
+            text_range: None,
+            source_turn: turn,
+        })
+    }
+
+    pub(super) fn envelope_len(&self) -> usize {
+        if self.atoms[self.atom_index].call.is_some() {
+            2
+        } else {
+            1
+        }
+    }
+
+    fn text<'a>(&self, target: &'a ContextManager) -> Option<&'a str> {
+        if self.part_end != self.part_start + 1 {
+            return None;
+        }
+        let atom = self.atoms.get(self.atom_index)?;
+        let item = &target
+            .annotated_items()
+            .get(self.source_start + atom.item)?
+            .item;
+        match item {
+            ResponseItem::Message { content, .. } => match content.get(self.part_start)? {
+                ContentItem::InputText { text } => Some(text),
+                // Sampled output offsets/logprobs are opaque; do not fabricate
+                // attribution for a substring of that native payload.
+                _ => None,
+            },
+            ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } => match &output.body {
+                FunctionCallOutputBody::Text(text) if self.part_start == 0 => Some(text),
+                FunctionCallOutputBody::ContentItems(parts) => match parts.get(self.part_start)? {
+                    FunctionCallOutputContentItem::InputText { text } => Some(text),
+                    _ => None,
+                },
+                _ => None,
+            },
+            _ => None,
+        }
+    }
+
+    pub(super) fn items(&self, target: &ContextManager) -> CodexResult<Vec<ResponseItemEnvelope>> {
+        let atom = self
+            .atoms
+            .get(self.atom_index)
+            .ok_or_else(|| invalid("Historical compaction atom disappeared"))?;
+        if self.part_start >= self.part_end || self.part_end > atom.parts {
+            return Err(invalid("Invalid historical compaction part range"));
+        }
+        let text_slice = if let Some(range) = &self.text_range {
+            let text = self
+                .text(target)
+                .ok_or_else(|| invalid("Historical text part changed type"))?;
+            if range.len != text.len() || range.start >= range.end {
+                return Err(invalid("Historical text byte coverage changed"));
+            }
+            Some(
+                text.get(range.start..range.end)
+                    .ok_or_else(|| invalid("Historical text range is not UTF-8 aligned"))?
+                    .to_owned(),
+            )
+        } else {
+            None
+        };
+        let source = target
+            .annotated_items()
+            .get(self.source_start..self.source_end)
+            .ok_or_else(|| invalid("Historical compaction source disappeared"))?;
+        let mut items = Vec::with_capacity(self.envelope_len());
+        if let Some(call) = atom.call {
+            items.push(source[call].clone());
+        }
+        items.push(source[atom.item].clone());
+        if atom.whole {
+            if self.part_start != 0 || self.part_end != 1 {
+                return Err(invalid(
+                    "Whole historical payload cannot change part boundaries",
+                ));
+            }
+            if text_slice.is_none() {
+                return Ok(items);
+            }
+        }
+        let item = &mut items
+            .last_mut()
+            .ok_or_else(|| invalid("Historical compaction part source disappeared"))?
+            .item;
+        match item {
+            ResponseItem::Message { .. } => {
+                let parts = to_annotated_content(item)
+                    .ok_or_else(|| invalid("Historical message lost typed content"))?;
+                let mut selected = parts
+                    .get(self.part_start..self.part_end)
+                    .ok_or_else(|| invalid("Historical message part range changed"))?
+                    .to_vec();
+                if let Some(text_slice) = &text_slice {
+                    let Some(ContentItem::InputText { text }) =
+                        selected.first_mut().map(|part| part.content_mut())
+                    else {
+                        return Err(invalid("Historical message text view changed type"));
+                    };
+                    *text = text_slice.clone();
+                }
+                set_annotated_content(item, selected)
+                    .ok_or_else(|| invalid("Historical message lost annotations"))?;
+            }
+            ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } => {
+                // Slice only a clone. Keep the native body variant, success,
+                // media/detail, metadata and original call/output identity.
+                match &mut output.body {
+                    FunctionCallOutputBody::ContentItems(parts) => {
+                        let mut selected = parts
+                            .get(self.part_start..self.part_end)
+                            .ok_or_else(|| invalid("Historical output part range changed"))?
+                            .to_vec();
+                        if let Some(text_slice) = &text_slice {
+                            let Some(FunctionCallOutputContentItem::InputText { text }) =
+                                selected.first_mut()
+                            else {
+                                return Err(invalid("Historical output text view changed type"));
+                            };
+                            *text = text_slice.clone();
+                        }
+                        *parts = selected;
+                    }
+                    FunctionCallOutputBody::Text(text) => {
+                        if self.part_start != 0 || self.part_end != 1 {
+                            return Err(invalid("Plain historical output changed part boundaries"));
+                        }
+                        if let Some(text_slice) = &text_slice {
+                            *text = text_slice.clone();
+                        }
+                    }
+                }
+            }
+            _ => return Err(invalid("Historical compaction source is not typed content")),
+        }
+        Ok(items)
+    }
+
+    pub(super) fn receipt(&self, target: &ContextManager) -> CodexResult<ProjectionReceipt> {
+        let atom = &self.atoms[self.atom_index];
+        let items = self.items(target)?;
+        let prompt_items = items
+            .into_iter()
+            .map(|item| without_execution_metadata(item.item))
+            .collect::<Vec<_>>();
+        Ok(ProjectionReceipt {
+            source_start: self.source_start,
+            source_end: self.source_end,
+            atom_index: self.atom_index,
+            atom_count: self.atoms.len(),
+            part_item: atom.item,
+            call_item: atom.call,
+            whole: atom.whole,
+            part_start: self.part_start,
+            part_end: self.part_end,
+            part_count: atom.parts,
+            text_range: self.text_range.clone(),
+            source_turn: self.source_turn.clone(),
+            // Native envelopes intentionally do not implement Serialize.
+            // Hash item + harness provenance, and the internal success bit that
+            // the wire payload serializer deliberately omits.
+            source_hash: fingerprint(
+                &target.annotated_items()[self.source_start..self.source_end]
+                    .iter()
+                    .map(|envelope| {
+                        let success = match &envelope.item {
+                            ResponseItem::FunctionCallOutput { output, .. }
+                            | ResponseItem::CustomToolCallOutput { output, .. } => output.success,
+                            _ => None,
+                        };
+                        (&envelope.item, &envelope.metadata, success)
+                    })
+                    .collect::<Vec<_>>(),
+            )?,
+            projection_hash: fingerprint(&prompt_items)?,
+        })
+    }
+
+    pub(super) fn verify_prompt(
+        &self,
+        target: &ContextManager,
+        input: &[ResponseItem],
+        carry_len: usize,
+        compact_input: &ResponseItem,
+    ) -> CodexResult<ProjectionReceipt> {
+        let expected = self
+            .items(target)?
+            .into_iter()
+            .map(|item| without_execution_metadata(item.item))
+            .collect::<Vec<_>>();
+        if input.len() != carry_len + expected.len() + 1
+            || input.last().cloned().map(without_execution_metadata)
+                != Some(without_execution_metadata(compact_input.clone()))
+        {
+            return Err(invalid(
+                "Historical projection has extra input or changed compaction instructions",
+            ));
+        }
+        let actual = input
+            .get(carry_len..carry_len + expected.len())
+            .ok_or_else(|| invalid("Historical projection was removed from the normalized prompt"))?
+            .iter()
+            .cloned()
+            .map(without_execution_metadata)
+            .collect::<Vec<_>>();
+        if actual != expected {
+            return Err(invalid(
+                "Normalized compaction prompt changed original typed parts",
+            ));
+        }
+        // Native pairing uses call_id. Each request has one copy of the selected
+        // completed pair; the other original pairs remain unread, never executed.
+        if let Some(call) = expected.first().filter(|_| expected.len() == 2) {
+            let (calls, outputs) = match call {
+                ResponseItem::CustomToolCall { call_id, .. } => (
+                    input.iter().filter(|item| matches!(item, ResponseItem::CustomToolCall { call_id: id, .. } if id == call_id)).count(),
+                    input.iter().filter(|item| matches!(item, ResponseItem::CustomToolCallOutput { call_id: id, .. } if id == call_id)).count(),
+                ),
+                ResponseItem::FunctionCall { call_id, .. } => (
+                    input.iter().filter(|item| matches!(item, ResponseItem::FunctionCall { call_id: id, .. } if id == call_id)).count(),
+                    input.iter().filter(|item| matches!(item, ResponseItem::FunctionCallOutput { call_id: Some(id), .. } if id == call_id)).count(),
+                ),
+                _ => return Err(invalid("Historical projection lost its original call")),
+            };
+            if calls != 1 || outputs != 1 {
+                return Err(invalid("Historical projection repeated a call/output pair"));
+            }
+        }
+        self.receipt(target)
+    }
+
+    pub(super) fn instruction(&self) -> String {
+        let atom = &self.atoms[self.atom_index];
+        let mut instruction = format!(
+            "Compaction-only partial historical content: original block {}..{}, source content envelope {}, source call envelope {:?}, ordered content unit {} of {}, whole original payload {}, content parts {}..{} of {}. These source positions describe the original history order. This is a view of an already completed historical item, not a new tool invocation or a complete block/output. Other original units and parts still exist and will be read separately. Preserve these parts and the exact previous fresh summary in the next summary; do not execute or repeat historical calls.",
+            self.source_start,
+            self.source_end,
+            self.source_start + atom.item,
+            atom.call.map(|call| self.source_start + call),
+            self.atom_index,
+            self.atoms.len(),
+            atom.whole && self.text_range.is_none(),
+            self.part_start,
+            self.part_end,
+            atom.parts,
+        );
+        if let Some(range) = &self.text_range {
+            instruction.push_str(&format!(
+                " The selected text part contains only UTF-8 bytes {}..{} of its original {} bytes; all other original bytes remain unread until separately summarized.",
+                range.start, range.end, range.len,
+            ));
+        }
+        instruction
+    }
+
+    pub(super) fn shrink(&mut self, target: &ContextManager) -> bool {
+        let count = self.part_end - self.part_start;
+        if count > 1 {
+            self.part_end = self.part_start + count / 2;
+            self.text_range = None;
+            return true;
+        }
+        let Some(text) = self.text(target) else {
+            return false;
+        };
+        let range = self.text_range.clone().unwrap_or(ProjectionTextRange {
+            start: 0,
+            end: text.len(),
+            len: text.len(),
+        });
+        let Some(selected) = text.get(range.start..range.end) else {
+            return false;
+        };
+        // Empty text still belongs to a complete original part. A single scalar
+        // is irreducible and returns the original capacity error unchanged.
+        let Some(first) = selected.chars().next() else {
+            return false;
+        };
+        let mut end = text.floor_char_boundary(range.start + selected.len() / 2);
+        if end == range.start {
+            end += first.len_utf8();
+        }
+        if end >= range.end {
+            return false;
+        }
+        self.text_range = Some(ProjectionTextRange { end, ..range });
+        true
+    }
+
+    pub(super) fn advance_parts(&mut self) -> bool {
+        if let Some(range) = &mut self.text_range {
+            if range.end < range.len {
+                range.start = range.end;
+                range.end = range.len;
+                return true;
+            }
+        }
+        self.text_range = None;
+        if self.part_end < self.atoms[self.atom_index].parts {
+            self.part_start = self.part_end;
+            self.part_end = self.atoms[self.atom_index].parts;
+            return true;
+        }
+        if self.atom_index + 1 == self.atoms.len() {
+            return false;
+        }
+        self.atom_index += 1;
+        self.part_start = 0;
+        self.part_end = self.atoms[self.atom_index].parts;
+        true
+    }
+}
+
+impl ProjectionReceipt {
+    pub(super) fn starts_source(&self) -> bool {
+        self.atom_index == 0
+            && self.part_start == 0
+            && self
+                .text_range
+                .as_ref()
+                .is_none_or(|range| range.start == 0)
+    }
+
+    pub(super) fn completes_source(&self) -> bool {
+        self.atom_index + 1 == self.atom_count
+            && self.part_end == self.part_count
+            && self
+                .text_range
+                .as_ref()
+                .is_none_or(|range| range.end == range.len)
+    }
+
+    pub(super) fn matches_target(&self, target: &ContextManager) -> bool {
+        let Some(mut source) =
+            CapacityProjection::source(target, self.source_start, self.source_end)
+        else {
+            return false;
+        };
+        let Some(atom) = source.atoms.get(self.atom_index) else {
+            return false;
+        };
+        if atom.item != self.part_item
+            || atom.call != self.call_item
+            || atom.parts != self.part_count
+            || atom.whole != self.whole
+            || source.atoms.len() != self.atom_count
+            || source.source_turn != self.source_turn
+        {
+            return false;
+        }
+        source.atom_index = self.atom_index;
+        source.part_start = self.part_start;
+        source.part_end = self.part_end;
+        source.text_range = self.text_range.clone();
+        source.receipt(target).is_ok_and(|receipt| receipt == *self)
+    }
+
+    pub(super) fn continues(&self, previous: &Self) -> bool {
+        self.source_start == previous.source_start
+            && self.source_end == previous.source_end
+            && self.atom_count == previous.atom_count
+            && self.source_turn == previous.source_turn
+            && self.source_hash == previous.source_hash
+            && if self.atom_index == previous.atom_index {
+                self.part_item == previous.part_item
+                    && self.call_item == previous.call_item
+                    && self.whole == previous.whole
+                    && self.part_count == previous.part_count
+                    && if let Some(range) = previous
+                        .text_range
+                        .as_ref()
+                        .filter(|range| range.end < range.len)
+                    {
+                        self.part_start == previous.part_start
+                            && self.part_end == previous.part_end
+                            && self.text_range.as_ref().is_some_and(|next| {
+                                next.start == range.end && next.len == range.len
+                            })
+                    } else {
+                        self.part_start == previous.part_end
+                            && self
+                                .text_range
+                                .as_ref()
+                                .is_none_or(|range| range.start == 0)
+                    }
+            } else {
+                previous.part_end == previous.part_count
+                    && previous
+                        .text_range
+                        .as_ref()
+                        .is_none_or(|range| range.end == range.len)
+                    && self.atom_index == previous.atom_index + 1
+                    && self.part_start == 0
+                    && self
+                        .text_range
+                        .as_ref()
+                        .is_none_or(|range| range.start == 0)
+            }
+    }
+}
