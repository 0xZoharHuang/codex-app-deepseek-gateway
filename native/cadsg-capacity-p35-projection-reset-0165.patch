+fn historical_projection_refuses_unattributed_current_or_incomplete_items(
+    kind: &str,
+) -> anyhow::Result<()> {
+    let mut items = typed_source("message")?;
+    let current = if kind == "current" {
+        OLD_TURN
+    } else {
+        "current-turn"
+    };
+    match kind {
+        "unknown" => {
+            let ResponseItem::Message {
+                internal_chat_message_metadata_passthrough,
+                ..
+            } = &mut items[0]
+            else {
+                unreachable!()
+            };
+            internal_chat_message_metadata_passthrough
+                .as_mut()
+                .unwrap()
+                .turn_id = None;
+        }
+        "in_progress" | "incomplete" => {
+            let ResponseItem::Message { status, .. } = &mut items[0] else {
+                unreachable!()
+            };
+            *status = Some(kind.to_owned());
+        }
+        "missing_output" => items = vec![exact_pair()?.remove(0)],
+        "encrypted" => {
+            let ResponseItem::Message {
+                encrypted_content, ..
+            } = &mut items[0]
+            else {
+                unreachable!()
+            };
+            *encrypted_content = Some("opaque-cannot-project".to_owned());
+        }
+        _ => {}
+    }
+    let source = target(items);
+    assert!(CapacityProjection::new(&source, 0, source.annotated_items().len(), current).is_none());
+    Ok(())
+}
