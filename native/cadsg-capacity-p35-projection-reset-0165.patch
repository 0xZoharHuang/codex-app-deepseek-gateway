+        call["arguments"] = json!({"code":code}).to_string().into();
+        call.as_object_mut().unwrap().remove("input");
+        call["id"] = json!("fc_original-historical-function");
+        let mut output = serde_json::to_value(&pair[1])?;
+        output["type"] = json!("function_call_output");
+        output["id"] = json!("fco_original-historical-function");
+        return Ok(vec![
+            serde_json::from_value(call)?,
+            serde_json::from_value(output)?,
+        ]);
+    }
+    if scenario == "parallel" {
+        let ResponseItem::CustomToolCallOutput { output, .. } = &pair[1] else {
+            unreachable!()
+        };
+        let parts = output.content_items().unwrap();
+        let mut calls = Vec::new();
+        let mut outputs = Vec::new();
+        // Include an empty completed output and success=false. It must be read
+        // as a whole original unit rather than disappearing from block coverage.
+        for (id, selected) in [
+            ("parallel-A", parts[..4].to_vec()),
+            ("parallel-B", parts[4..].to_vec()),
+            ("parallel-empty", Vec::new()),
+        ] {
+            let mut call = pair[0].clone();
+            let ResponseItem::CustomToolCall {
+                call_id,
+                id: item_id,
+                ..
+            } = &mut call
+            else {
+                unreachable!()
+            };
+            *call_id = id.to_owned();
+            *item_id = Some(ResponseItemId::with_suffix("ctc", id));
+            calls.push(call);
+            let mut result = pair[1].clone();
+            let ResponseItem::CustomToolCallOutput {
+                call_id,
+                id: item_id,
+                output,
+                ..
+            } = &mut result
+            else {
+                unreachable!()
+            };
+            *call_id = id.to_owned();
+            *item_id = Some(ResponseItemId::with_suffix("ctco", id));
+            output.body = FunctionCallOutputBody::ContentItems(selected);
+            output.success = Some(false);
+            outputs.push(result);
+        }
+        calls.extend(outputs);
+        return Ok(calls);
+    }
+    if scenario == "message" {
+        let value: serde_json::Value = serde_json::from_str(ORIGINAL_PAIR)?;
+        let mut item: ResponseItem = serde_json::from_value(json!({
+            "type":"message", "id":"msg_original-seven-part-message", "role":"user",
+            "status":"completed", "content":value[1]["output"],
+            "internal_chat_message_metadata_passthrough":{
+                "turn_id":OLD_TURN,
+                "content_item_kinds":(0..8).map(|index| format!("source-part-{index}")).collect::<Vec<_>>(),
+                "content_item_metadata":(0..8).map(|index| if index % 2 == 0 {
+                    ContentItemMetadata::user()
+                } else { ContentItemMetadata::tool(None) }).collect::<Vec<_>>()
+            }
+        }))?;
+        item.set_turn_id_if_missing(OLD_TURN);
+        return Ok(vec![item]);
+    }
+    Ok(pair)
+}
+
+fn target(items: Vec<ResponseItem>) -> ContextManager {
+    let mut target = ContextManager::new();
+    target.replace_annotated(items.into_iter().map(ResponseItemEnvelope::new).collect());
+    target
+}
+
+fn native_input() -> ResponseItem {
+    user_message("Summarize the original historical content.")
+}
+
+fn recorded_prompt(
+    mut history: ContextManager,
+    input: &ResponseItem,
+    modalities: &[InputModality],
+) -> Vec<ResponseItem> {
+    // Match the real pipeline: the instruction is recorded before for_prompt,
+    // so native normalization processes its content and positional metadata.
+    history.record_items(&[input.clone()], TruncationPolicy::Tokens(10_000));
+    history.for_prompt(modalities)
+}
+
+fn prepare(
+    work: &mut CapacitySummaryWork,
+    input: &ResponseItem,
+) -> anyhow::Result<Vec<ResponseItem>> {
+    let mut prompt = recorded_prompt(work.selected_history()?, input, &[InputModality::Image]);
+    work.prepare_prompt(&mut prompt, input, &[InputModality::Image])?;
+    Ok(prompt)
+}
