+impl codex_hooks::HookMcpExecutor for HookCounts {
+    fn execute(
+        &self,
+        call: codex_hooks::HookMcpCall,
+    ) -> futures::future::BoxFuture<'_, anyhow::Result<codex_hooks::HookMcpOutput>> {
+        Box::pin(async move {
+            let stop = if call.tool == "pre" {
+                self.pre.fetch_add(1, Ordering::SeqCst);
+                self.stop.load(Ordering::SeqCst)
+            } else {
+                assert_eq!(call.tool, "post");
+                self.post.fetch_add(1, Ordering::SeqCst);
+                false
+            };
+            Ok(codex_hooks::HookMcpOutput {
+                text: json!({"continue":!stop,"stopReason":"owned reset hook fixture"}).to_string(),
+                source_tool_namespace: Some("owned_reset_fixture".into()),
+            })
+        })
+    }
