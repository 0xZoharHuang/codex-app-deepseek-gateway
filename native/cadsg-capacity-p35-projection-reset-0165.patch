+fn historical_projection_message_keeps_positional_metadata_and_media() -> anyhow::Result<()> {
+    let source = target(typed_source("message")?);
+    let projection = CapacityProjection::new(&source, 0, 1, "current-turn").unwrap();
+    let original = source.annotated_items().to_vec();
+    let selected = projection.items(&source)?;
+    let mut full = source.annotated_items()[0].item.clone();
