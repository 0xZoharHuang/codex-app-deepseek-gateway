+//! One-turn continuation of an admitted native capacity reset.
+//! It never grants a new epoch, current-input authority, or a second reset.
+use super::*;
+use sha2::Digest;
+
+pub(crate) enum CapacityResetPreparation {
+    Ready {
+        prefix: CapacityPrefix,
+        completion: Option<tokio::sync::oneshot::Receiver<CapacityResetContinuation>>,
+    },
+    NoProgress(CapacityPrefix),
+    Invalid,
+}
+
+pub(super) struct PreparedCapacityReset {
+    pub(super) items: Vec<ResponseItemEnvelope>,
+    pub(super) baseline: WorldStateSnapshot,
+}
+
+pub(super) struct CapacityResetCompletion {
+    gap: Arc<Vec<ResponseItemEnvelope>>,
+    gap_hash: [u8; 32],
+    staged: std::sync::Mutex<Option<CapacitySendSnapshot>>,
+    sender: std::sync::Mutex<Option<tokio::sync::oneshot::Sender<CapacityResetContinuation>>>,
+}
+
+/// In-memory only, owned by the existing run_turn invocation and consumed once.
+pub(crate) struct CapacityResetContinuation {
+    original: request_capacity::Checkpoint,
+    checkpoint: request_capacity::Checkpoint,
+    home: PathBuf,
+    reset: CapacitySendSnapshot,
+    auth_owner_generation: Option<u64>,
+    gap: Arc<Vec<ResponseItemEnvelope>>,
+    gap_hash: [u8; 32],
+}
+
+fn exact_gap_hash(items: &[ResponseItemEnvelope]) -> Option<[u8; 32]> {
+    // Include every native item, all harness provenance, and the internal output
+    // success bit that its wire serializer deliberately excludes.
+    let values = items
+        .iter()
+        .map(|envelope| {
+            let success = match &envelope.item {
+                ResponseItem::FunctionCallOutput { output, .. }
+                | ResponseItem::CustomToolCallOutput { output, .. } => output.success,
+                _ => None,
+            };
+            (&envelope.item, &envelope.metadata, success)
+        })
+        .collect::<Vec<_>>();
+    let bytes = serde_json::to_vec(&values).ok()?;
+    Some(sha2::Sha256::digest(bytes).into())
+}
