+#[derive(Default)]
+struct WireState {
+    ordinary: usize,
+    summaries: usize,
+    accepted_images: Vec<String>,
+    last_summary: Option<String>,
+}
+fn image_urls(value: &Value, result: &mut Vec<String>) {
+    match value {
+        Value::Object(map) => {
+            if map.get("type").and_then(Value::as_str) == Some("input_image") {
+                result.push(
+                    map.get("image_url")
+                        .and_then(Value::as_str)
+                        .unwrap()
+                        .to_owned(),
+                );
+            }
+            for value in map.values() {
+                image_urls(value, result);
+            }
+        }
+        Value::Array(values) => {
+            for value in values {
+                image_urls(value, result);
+            }
+        }
+        _ => {}
+    }
+}
+fn is_compact(body: &Value) -> bool {
+    body["input"].as_array().unwrap().iter().any(|item| {
+        item["content"].as_array().is_some_and(|parts| {
+            parts.iter().any(|part| {
+                part["text"].as_str().is_some_and(|text| {
+                    text == crate::compact::SUMMARIZATION_PROMPT
+                        || text.starts_with("Compaction-only partial historical content:")
+                })
+            })
+        })
+    })
+}
+fn release(barrier: &(std::sync::Mutex<bool>, std::sync::Condvar)) {
+    *barrier.0.lock().unwrap() = true;
+    barrier.1.notify_all();
+}
+async fn request_or_end(
+    notify: &tokio::sync::Notify,
+    events: &async_channel::Receiver<codex_protocol::protocol::Event>,
+) -> anyhow::Result<()> {
+    loop {
+        tokio::select! {
+            biased;
+            _=notify.notified()=>return Ok(()),
+            event=events.recv()=>{
+                let event=event?;
+                if matches!(event.msg,EventMsg::TurnComplete(_)|EventMsg::TurnAborted(_)){
+                    anyhow::bail!("native turn ended before expected real ordinary request: {:?}",event.msg);
+                }
+            }
+        }
+    }
+}
