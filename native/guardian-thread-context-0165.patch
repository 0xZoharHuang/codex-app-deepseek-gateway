+#[tokio::test]
+async fn guardian_host_thread_context_rejects_wrong_id_scope_manager_and_inherited_capability() {
+    let first_home = tempdir().expect("first home");
+    let second_home = tempdir().expect("second home");
+    let first_config = guardian_context_test_config(first_home.path()).await;
+    let second_config = guardian_context_test_config(second_home.path()).await;
+    let first_manager = guardian_context_test_manager(&first_config, empty_extension_registry());
+    let second_manager = guardian_context_test_manager(&second_config, empty_extension_registry());
+    let same_id = ThreadId::new();
+    let first = first_manager
+        .start_thread(StartThreadOptions {
+            reserved_thread_id: Some(same_id),
+            environments: Some(Vec::new()),
+            ..StartThreadOptions::new(first_config)
+        })
+        .await
+        .expect("first real runtime");
+    let first_context = first
+        .thread
+        .thread_extension_data()
+        .get::<crate::GuardianThreadContext>()
+        .expect("first host context");
+    let forged_scope = codex_extension_api::ExtensionData::new(same_id.to_string());
+    assert!(
+        first_context
+            .resolve(same_id, &forged_scope, &first_manager)
+            .await
+            .is_none()
+    );
+    assert!(
+        first_context
+            .resolve(
+                ThreadId::new(),
+                first.thread.thread_extension_data(),
+                &first_manager
+            )
+            .await
+            .is_none()
+    );
+    let mut inherited = ExtensionDataInit::new();
+    inherited.insert(crate::GuardianThreadContext::new(&first.thread));
+    let second = second_manager
+        .start_thread(StartThreadOptions {
+            reserved_thread_id: Some(same_id),
+            environments: Some(Vec::new()),
+            session_source: Some(SessionSource::Internal(
+                InternalSessionSource::MemoryConsolidation,
+            )),
+            thread_extension_init: inherited,
+            ..StartThreadOptions::new(second_config)
+        })
+        .await
+        .expect("same ID in an independent native manager");
+    assert!(
+        first_context
+            .resolve(
+                same_id,
+                first.thread.thread_extension_data(),
+                &second_manager
+            )
+            .await
+            .is_none()
+    );
+    assert!(
+        first_context
+            .resolve(
+                same_id,
+                second.thread.thread_extension_data(),
+                &first_manager
+            )
+            .await
+            .is_none()
+    );
+    let second_context = second
+        .thread
+        .thread_extension_data()
+        .get::<crate::GuardianThreadContext>()
+        .expect("fresh host replaced inherited context");
+    assert!(Arc::ptr_eq(
+        &second_context
+            .resolve(
+                same_id,
+                second.thread.thread_extension_data(),
+                &second_manager
+            )
+            .await
+            .expect("second native scope"),
+        &second.thread
+    ));
+    assert!(matches!(
+        second_manager.get_thread(same_id).await,
+        Err(error) if matches!(error.details(), codex_protocol::error::CodexErrorDetails::ThreadNotFound(id) if *id == same_id)
+    ));
+    first
+        .thread
+        .shutdown_and_wait()
+        .await
+        .expect("shutdown first");
+    second
+        .thread
+        .shutdown_and_wait()
+        .await
+        .expect("shutdown second");
+    first_manager.remove_thread(&same_id).await;
+    second_manager.remove_thread(&same_id).await;
+}
