+#[tokio::test]
+async fn guardian_host_thread_context_rejects_removed_closed_and_dropped_runtimes() {
+    let temp = tempdir().expect("test root");
+    let config = guardian_context_test_config(temp.path()).await;
+    let manager = guardian_context_test_manager(&config, empty_extension_registry());
+    let mut retained = Vec::new();
+    for remove_before_shutdown in [true, false] {
+        let new = manager
+            .start_thread(StartThreadOptions {
+                environments: Some(Vec::new()),
+                session_source: Some(SessionSource::Internal(
+                    InternalSessionSource::MemoryConsolidation,
+                )),
+                ..StartThreadOptions::new(config.clone())
+            })
+            .await
+            .expect("real internal runtime");
+        let context = new
+            .thread
+            .thread_extension_data()
+            .get::<crate::GuardianThreadContext>()
+            .expect("host weak context");
+        let weak = Arc::downgrade(&new.thread);
+        if remove_before_shutdown {
+            let removed = manager
+                .remove_thread(&new.thread_id)
+                .await
+                .expect("owner removal");
+            assert!(new.thread.is_running());
+            assert!(
+                context
+                    .resolve(new.thread_id, new.thread.thread_extension_data(), &manager)
+                    .await
+                    .is_none()
+            );
+            drop(removed);
+        }
+        new.thread
+            .shutdown_and_wait()
+            .await
+            .expect("native shutdown");
+        assert!(
+            context
+                .resolve(new.thread_id, new.thread.thread_extension_data(), &manager)
+                .await
+                .is_none()
+        );
+        if !remove_before_shutdown {
+            assert!(manager.owns_thread_runtime(&new.thread).await);
+            manager.remove_thread(&new.thread_id).await;
+        }
+        let fake_scope = codex_extension_api::ExtensionData::new(new.thread_id.to_string());
+        retained.push((context, weak, new.thread_id, fake_scope));
+        drop(new);
+    }
+    tokio::task::yield_now().await;
+    for (context, weak, id, fake_scope) in retained {
+        assert!(
+            weak.upgrade().is_none(),
+            "attachment must not retain a runtime"
+        );
+        assert!(context.resolve(id, &fake_scope, &manager).await.is_none());
+    }
+}
