+#[tokio::test]
+async fn guardian_host_thread_context_resolves_actual_main_and_internal_tool_callbacks() {
+    let temp = tempdir().expect("test root");
+    let config = guardian_context_test_config(temp.path()).await;
+    let probe = Arc::new(GuardianThreadContextProbe::default());
+    let mut registry = codex_extension_api::ExtensionRegistryBuilder::new();
+    registry.tool_lifecycle_contributor(probe.clone());
+    let manager = guardian_context_test_manager(&config, Arc::new(registry.build()));
+    *probe.manager.lock().expect("manager") = Arc::downgrade(&manager);
+    let mut started = Vec::new();
+
+    for source in [
+        SessionSource::Exec,
+        SessionSource::Internal(InternalSessionSource::MemoryConsolidation),
+    ] {
+        let internal = source.is_internal();
+        let new = manager
+            .start_thread(StartThreadOptions {
+                environments: Some(Vec::new()),
+                session_source: Some(source),
+                ..StartThreadOptions::new(config.clone())
+            })
+            .await
+            .expect("real native runtime");
+        if internal {
+            assert!(matches!(
+                manager.get_thread(new.thread_id).await,
+                Err(error) if matches!(error.details(), codex_protocol::error::CodexErrorDetails::ThreadNotFound(id) if *id == new.thread_id)
+            ));
+        } else {
+            assert!(Arc::ptr_eq(
+                &manager
+                    .get_thread(new.thread_id)
+                    .await
+                    .expect("public main lookup"),
+                &new.thread
+            ));
+        }
+        probe
+            .expected
+            .lock()
+            .expect("expected")
+            .insert(new.thread_id, Arc::downgrade(&new.thread));
+
+        new.thread
+            .session
+            .inject_no_new_turn(
+                vec![ResponseItem::Message {
+                    status: None,
+                    encrypted_content: None,
+                    id: None,
+                    role: "user".to_owned(),
+                    content: vec![ContentItem::InputText {
+                        text: format!("native trusted history {}", new.thread_id),
+                    }],
+                    phase: None,
+                    internal_chat_message_metadata_passthrough: None,
+                }],
+                None,
+            )
+            .await;
+        let turn = new.thread.session.new_default_turn().await;
+        for source in [
+            crate::tools::context::ToolCallSource::Direct,
+            crate::tools::context::ToolCallSource::CodeMode {
+                cell_id: "guardian-scope-probe".to_owned(),
+                runtime_tool_call_id: "nested-probe".to_owned(),
+            },
+        ] {
+            let invocation = crate::tools::context::ToolInvocation {
+                session: Arc::clone(&new.thread.session),
+                turn: Arc::clone(&turn),
+                step_context: StepContext::for_test(Arc::clone(&turn)),
+                cancellation_token: tokio_util::sync::CancellationToken::new(),
+                tracker: Arc::new(tokio::sync::Mutex::new(
+                    crate::turn_diff_tracker::TurnDiffTracker::new(),
+                )),
+                call_id: "guardian-context-probe".to_owned(),
+                tool_name: codex_tools::ToolName::plain("exec_command"),
+                source,
+                payload: codex_tools::ToolPayload::Function {
+                    arguments: "{}".to_owned(),
+                },
+                environments: Default::default(),
+            };
+            crate::tools::lifecycle::notify_tool_start(&invocation, None).await;
+        }
+        started.push(new);
+    }
+    assert_eq!(probe.observed.lock().expect("observed").len(), 4);
+    for new in started {
+        new.thread
+            .shutdown_and_wait()
+            .await
+            .expect("native shutdown");
+        manager.remove_thread(&new.thread_id).await;
