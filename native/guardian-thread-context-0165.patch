+// Genuine host callbacks must keep the thread scope that Guardian resolves.
+#[derive(Default)]
+struct GuardianThreadContextProbe {
+    manager: std::sync::Mutex<std::sync::Weak<ThreadManager>>,
+    expected: std::sync::Mutex<HashMap<ThreadId, std::sync::Weak<CodexThread>>>,
+    observed: std::sync::Mutex<Vec<ThreadId>>,
+}
+
+impl codex_extension_api::ToolLifecycleContributor for GuardianThreadContextProbe {
+    fn on_tool_start<'a>(
+        &'a self,
+        input: codex_extension_api::ToolStartInput<'a>,
+    ) -> codex_extension_api::ToolLifecycleFuture<'a> {
+        Box::pin(async move {
+            let id = ThreadId::from_string(input.thread_store.level_id()).expect("native scope ID");
+            let manager = self
+                .manager
+                .lock()
+                .expect("manager")
+                .upgrade()
+                .expect("live manager");
+            let expected = self.expected.lock().expect("expected")[&id]
+                .upgrade()
+                .expect("expected runtime");
+            let context = input
+                .thread_store
+                .get::<crate::GuardianThreadContext>()
+                .expect("host context installed before callbacks");
+            let resolved = context
+                .resolve(id, input.thread_store, &manager)
+                .await
+                .expect("actual native callback scope");
+            assert!(Arc::ptr_eq(&resolved, &expected));
+            assert!(Arc::ptr_eq(
+                &resolved.config().await,
+                &expected.config().await
+            ));
+            let history = resolved.conversation_history_snapshot().await;
+            assert_eq!(
+                history.items().collect::<Vec<_>>(),
+                input.conversation_history.items().collect::<Vec<_>>()
+            );
+            assert_eq!(
+                history.user_message_revision(),
+                input.conversation_history.user_message_revision()
+            );
+            assert_eq!(history.items().count(), 1);
+            self.observed.lock().expect("observed").push(id);
+        })
+    }
+}
