+
+/// Host-installed access to the exact live thread observed by a tool callback.
+///
+/// The weak reference does not retain the runtime. Construction is restricted to
+/// core, and resolution also checks the original attachment scope and current
+/// manager membership; a copied or inherited attachment cannot authorize a
+/// different thread or manager. Public internal-thread lookup stays unchanged.
+pub struct GuardianThreadContext {
+    thread: Weak<CodexThread>,
+}
+
+impl GuardianThreadContext {
+    pub(crate) fn new(thread: &Arc<CodexThread>) -> Self {
+        Self {
+            thread: Arc::downgrade(thread),
+        }
+    }
+
+    pub async fn resolve(
+        &self,
+        expected_thread_id: ThreadId,
+        scope: &codex_extension_api::ExtensionData,
+        manager: &crate::ThreadManager,
+    ) -> Option<Arc<CodexThread>> {
+        let thread = self.thread.upgrade()?;
+        if thread.session.thread_id() != expected_thread_id
+            || scope.level_id() != expected_thread_id.to_string()
+            || !std::ptr::eq(scope, thread.thread_extension_data())
+            || !manager.owns_thread_runtime(&thread).await
+            || !thread.is_running()
+        {
+            return None;
+        }
+        Some(thread)
+    }
 }
 
