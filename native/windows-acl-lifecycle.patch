@@ -0,0 +1,242 @@
+//! Raw security descriptors from an already pinned file handle.
+//! GetSecurityInfo(SE_FILE_OBJECT) can reconstruct legacy inheritance flags
+//! while reading. Never feed that reconstructed ACL back into an exact writer.
+use std::ffi::c_void;
+use windows_sys::Win32::Foundation::{
+    ERROR_INSUFFICIENT_BUFFER, ERROR_INVALID_DATA, ERROR_INVALID_PARAMETER,
+    ERROR_NOT_ENOUGH_MEMORY, ERROR_RETRY, HANDLE, LocalFree,
+};
+use windows_sys::Win32::Security::{
+    ACL, DACL_SECURITY_INFORMATION, GROUP_SECURITY_INFORMATION, GetKernelObjectSecurity,
+    GetSecurityDescriptorDacl, GetSecurityDescriptorGroup, GetSecurityDescriptorLength,
+    GetSecurityDescriptorOwner, IsValidSecurityDescriptor, OWNER_SECURITY_INFORMATION,
+};
+use windows_sys::Win32::System::Memory::{LPTR, LocalAlloc};
+
+const MAX_DESCRIPTOR: u32 = 1_048_576;
+
+// Check bounded self-relative offsets before Win32 component validators.
+// No ACL/ACE normalization or repair is done.
+fn relative_layout_valid(bytes: &[u8]) -> bool {
+    if bytes.len() < 20 || bytes[0] != 1 || u16::from_le_bytes([bytes[2], bytes[3]]) & 0x8000 == 0 {
+        return false;
+    }
+    for (field, sid) in [(4, true), (8, true), (12, false), (16, false)] {
+        let offset = u32::from_le_bytes(bytes[field..field + 4].try_into().unwrap()) as usize;
+        if offset == 0 {
+            continue;
+        }
+        if offset < 20
+            || offset % 4 != 0
+            || offset.checked_add(8).is_none_or(|end| end > bytes.len())
+        {
+            return false;
+        }
+        let length = if sid {
+            if bytes[offset] != 1 || bytes[offset + 1] > 15 {
+                return false;
+            }
+            8 + usize::from(bytes[offset + 1]) * 4
+        } else {
+            usize::from(u16::from_le_bytes([bytes[offset + 2], bytes[offset + 3]]))
+        };
+        if length < 8
+            || offset
+                .checked_add(length)
+                .is_none_or(|end| end > bytes.len())
+        {
+            return false;
+        }
+    }
+    true
+}
+
+/// Keep the existing LocalFree ownership contract at native file ACL callers.
+///
+/// # Safety
+/// The handle must remain pinned with READ_CONTROL; output pointers must be valid.
+/// Component pointers borrow the fixed LocalAlloc descriptor, which the caller
+/// must eventually LocalFree once.
+pub(crate) unsafe fn get_raw_file_security(
+    handle: HANDLE,
+    object_type: i32,
+    information: u32,
+    owner: *mut *mut c_void,
+    group: *mut *mut c_void,
+    dacl: *mut *mut ACL,
+    sacl: *mut *mut ACL,
+    descriptor: *mut *mut c_void,
+) -> u32 {
+    if !owner.is_null() {
+        *owner = std::ptr::null_mut();
+    }
+    if !group.is_null() {
+        *group = std::ptr::null_mut();
+    }
+    if !dacl.is_null() {
+        *dacl = std::ptr::null_mut();
+    }
+    if !sacl.is_null() {
+        *sacl = std::ptr::null_mut();
+    }
+    if !descriptor.is_null() {
+        *descriptor = std::ptr::null_mut();
+    }
+    let allowed =
+        OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION;
+    if object_type != 1
+        || descriptor.is_null()
+        || information == 0
+        || information & !allowed != 0
+        || !sacl.is_null()
+        || (!owner.is_null() && information & OWNER_SECURITY_INFORMATION == 0)
+        || (!group.is_null() && information & GROUP_SECURITY_INFORMATION == 0)
+        || (!dacl.is_null() && information & DACL_SECURITY_INFORMATION == 0)
+    {
+        return ERROR_INVALID_PARAMETER;
+    }
+    let mut needed = 0;
+    let sized = GetKernelObjectSecurity(handle, information, std::ptr::null_mut(), 0, &mut needed);
+    if sized != 0 {
+        return ERROR_INVALID_DATA;
+    }
+    let error = std::io::Error::last_os_error()
+        .raw_os_error()
+        .unwrap_or(ERROR_INVALID_DATA as i32) as u32;
+    if error != ERROR_INSUFFICIENT_BUFFER {
+        return error;
+    }
+    for _ in 0..3 {
+        if !(20..=MAX_DESCRIPTOR).contains(&needed) {
+            return ERROR_INVALID_DATA;
+        }
+        let capacity = needed;
+        let memory = LocalAlloc(LPTR, capacity as usize).cast::<c_void>();
+        if memory.is_null() {
+            return ERROR_NOT_ENOUGH_MEMORY;
+        }
+        let ok = GetKernelObjectSecurity(handle, information, memory, capacity, &mut needed);
+        if ok == 0 {
+            let error = std::io::Error::last_os_error()
+                .raw_os_error()
+                .unwrap_or(ERROR_INVALID_DATA as i32) as u32;
+            LocalFree(memory);
+            if error == ERROR_INSUFFICIENT_BUFFER && needed > capacity {
+                continue;
+            }
+            return error;
+        }
+        let bytes = std::slice::from_raw_parts(memory.cast::<u8>(), capacity as usize);
+        if needed > capacity
+            || needed < 20
+            || !relative_layout_valid(&bytes[..needed as usize])
+            || IsValidSecurityDescriptor(memory) == 0
+            || GetSecurityDescriptorLength(memory) > needed
+        {
+            LocalFree(memory);
+            return ERROR_INVALID_DATA;
+        }
+        let (mut actual_owner, mut actual_group, mut actual_dacl) = (
+            std::ptr::null_mut(),
+            std::ptr::null_mut(),
+            std::ptr::null_mut(),
+        );
+        let (mut present, mut defaulted) = (0, 0);
+        let valid = (owner.is_null()
+            || GetSecurityDescriptorOwner(memory, &mut actual_owner, &mut defaulted) != 0)
+            && (group.is_null()
+                || GetSecurityDescriptorGroup(memory, &mut actual_group, &mut defaulted) != 0)
+            && (dacl.is_null()
+                || GetSecurityDescriptorDacl(
+                    memory,
+                    &mut present,
+                    &mut actual_dacl,
+                    &mut defaulted,
+                ) != 0);
+        if !valid {
+            let error = std::io::Error::last_os_error()
+                .raw_os_error()
+                .unwrap_or(ERROR_INVALID_DATA as i32) as u32;
+            LocalFree(memory);
+            return error;
+        }
+        if !owner.is_null() {
+            *owner = actual_owner;
+        }
+        if !group.is_null() {
+            *group = actual_group;
+        }
+        if !dacl.is_null() {
+            *dacl = actual_dacl;
+        }
+        *descriptor = memory;
+        return 0;
+    }
+    ERROR_RETRY
+}
