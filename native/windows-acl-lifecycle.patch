+    #[test]
+    fn waiter_replans_after_locked_writer_protects_target() -> Result<()> {
+        use std::sync::mpsc;
+        use std::time::Duration;
+        use windows_sys::Win32::Security::{SE_DACL_PROTECTED, SetSecurityDescriptorControl};
+        let root = tempfile::tempdir()?;
+        let path = root.path().join("target");
+        std::fs::create_dir(&path)?;
+        let directory = PinnedDirectory::open(&path)?;
+        let scope = directory.lock_acl(crate::acl_lock::deadline())?;
+        let (ready_tx, ready_rx) = mpsc::channel();
+        let (done_tx, done_rx) = mpsc::channel();
+        let target = path.clone();
+        let worker = std::thread::spawn(move || {
+            let target = PinnedDirectory::open(&target).unwrap();
+            ready_tx.send(()).unwrap();
+            let result = target.lock_acl(crate::acl_lock::deadline()).map(|_| ());
+            done_tx.send(result).unwrap();
+        });
+        ready_rx.recv_timeout(Duration::from_secs(2))?;
+        assert!(done_rx.recv_timeout(Duration::from_millis(100)).is_err());
+        let dacl = Dacl::read(&directory)?;
+        let entries = dacl.entries()?;
+        assert_ne!(
+            unsafe {
+                SetSecurityDescriptorControl(dacl.descriptor, SE_DACL_PROTECTED, SE_DACL_PROTECTED)
+            },
+            0
+        );
+        dacl.write(&directory, &entries)?;
+        drop(scope);
+        done_rx.recv_timeout(Duration::from_secs(2))??;
+        worker.join().unwrap();
+        Ok(())
+    }
