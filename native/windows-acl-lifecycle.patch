+fn managed_read_state_dacl_snapshot(path: &Path) -> Result<(u16, Vec<Vec<u8>>)> {
+    use windows_sys::Win32::Security::{ACE_HEADER, GetAce, GetSecurityDescriptorControl};
+    unsafe {
+        let (acl, descriptor) = crate::acl::fetch_dacl_handle(path)?;
+        let mut control = 0;
+        let mut revision = 0;
+        assert_ne!(
+            GetSecurityDescriptorControl(descriptor, &mut control, &mut revision),
+            0
+        );
+        let mut result = Vec::new();
+        if !acl.is_null() {
+            for index in 0..(*acl).AceCount as u32 {
+                let mut ace = std::ptr::null_mut();
+                assert_ne!(GetAce(acl, index, &mut ace), 0);
+                result.push(
+                    std::slice::from_raw_parts(
+                        ace.cast::<u8>(),
+                        (*ace.cast::<ACE_HEADER>()).AceSize as usize,
+                    )
+                    .to_vec(),
+                );
+            }
+        }
+        win::LocalFree(descriptor as _);
+        Ok((control & 0x1500, result))
+    }
+}
