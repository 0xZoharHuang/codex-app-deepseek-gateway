+    fn parent_inheritance_after_child_snapshot_survives_metadata_commit() -> Result<()> {
+        use std::sync::mpsc;
+        use std::time::Duration;
+        use windows_sys::Win32::Security::{GetSecurityDescriptorControl, SE_DACL_AUTO_INHERITED};
+        let root = tempfile::tempdir()?;
+        let parent = root.path().join("parent");
+        let child = parent.join("child");
+        std::fs::create_dir_all(&child)?;
+        let baseline_sid = sid(1100);
+        assert!(unsafe {
+            crate::acl::ensure_allow_mask_aces_with_inheritance(
+                &parent,
+                &[baseline_sid.as_ptr() as *mut c_void],
+                fs::FILE_GENERIC_READ | fs::FILE_GENERIC_EXECUTE,
+                3,
+            )
+        }?);
+        let child = PinnedDirectory::open(&child)?;
+        let child_scope = child.lock_acl(crate::acl_lock::deadline())?;
+        let stale = Dacl::read(&child)?;
+        let mut stale_entries = stale.entries()?;
+        let (mut control, mut revision) = (0, 0);
+        assert_ne!(
+            unsafe { GetSecurityDescriptorControl(stale.descriptor, &mut control, &mut revision) },
+            0
+        );
+        assert_ne!(
+            control & SE_DACL_AUTO_INHERITED,
+            0,
+            "fixture must exercise actual automatic inheritance"
+        );
+        let metadata_sid = sid(1101);
+        let metadata = metadata_ace(&metadata_sid)?;
+        let index = stale_entries
+            .iter()
+            .position(|ace| ace[1] & INHERITED_ACE as u8 != 0)
+            .unwrap_or(stale_entries.len());
+        stale_entries.insert(index, metadata.clone());
+        let inherited_sid = sid(1102);
+        let parent_sid = inherited_sid.clone();
+        let (done_tx, done_rx) = mpsc::channel();
+        let writer = std::thread::spawn(move || {
+            let result = unsafe {
+                crate::acl::ensure_allow_mask_aces_with_inheritance(
+                    &parent,
+                    &[parent_sid.as_ptr() as *mut c_void],
+                    fs::FILE_GENERIC_READ | fs::FILE_GENERIC_EXECUTE,
+                    3,
+                )
+            };
+            done_tx.send(result).unwrap();
+        });
+        // The parent must wait while the child owns its snapshot and commit.
+        assert!(done_rx.recv_timeout(Duration::from_millis(40)).is_err());
+        stale.write(&child, &stale_entries)?;
+        drop(child_scope);
+        assert!(done_rx.recv_timeout(Duration::from_secs(2))??);
+        writer.join().unwrap();
+        let after = Dacl::read(&child)?.entries()?;
+        assert!(exact_index(&after, &metadata)?.is_some());
+        assert!(
+            after.iter().any(|ace| ace[0] == 0
+                && ace[1] & INHERITED_ACE as u8 != 0
+                && entry_sid(ace).is_ok_and(|v| v == inherited_sid)),
+            "new inherited ACE was lost by the child metadata commit"
+        );
+        Ok(())
+    }
