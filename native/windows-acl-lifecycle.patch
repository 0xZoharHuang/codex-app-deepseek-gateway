+        crate::acl_lock::acquire(handle.as_raw_handle() as _, crate::acl_lock::deadline())?;
+    let mut descriptor: *mut c_void = std::ptr::null_mut();
+    let mut acl: *mut ACL = std::ptr::null_mut();
+    let status = get_raw_file_security(
+        handle.as_raw_handle() as _,
+        1,
+        DACL_SECURITY_INFORMATION,
+        std::ptr::null_mut(),
+        std::ptr::null_mut(),
+        &mut acl,
+        std::ptr::null_mut(),
+        &mut descriptor,
+    );
+    let result = (|| -> Result<bool> {
+        acl_api_result(path, "read managed deny ACL", status)?;
+        if acl.is_null() {
+            return Ok(false);
+        }
+        let indices = managed_deny_read_ace_indices(acl, psid)?;
+        if indices.is_empty() {
+            return Ok(false);
+        }
+        if let Some(error) = write_error {
+            return Err(error).context("open managed deny ACL for update");
+        }
+        let size = (*acl).AclSize as usize;
+        let mut copy = vec![0_u32; size.div_ceil(std::mem::size_of::<u32>())];
+        let changed = copy.as_mut_ptr().cast::<ACL>();
+        std::ptr::copy_nonoverlapping(acl.cast::<u8>(), changed.cast::<u8>(), size);
+        for index in indices.into_iter().rev() {
+            if windows_sys::Win32::Security::DeleteAce(changed, index) == 0 {
+                return Err(std::io::Error::last_os_error())
+                    .context("remove managed deny-read ACE");
+            }
+        }
+        // Pin the same object for read/write; retain native inheritance propagation.
+        acl_api_result(
+            path,
+            "write managed deny ACL",
+            SetSecurityInfo(
+                handle.as_raw_handle() as _,
+                1,
+                DACL_SECURITY_INFORMATION,
+                std::ptr::null_mut(),
+                std::ptr::null_mut(),
+                changed,
+                std::ptr::null_mut(),
+            ),
+        )?;
+        Ok(true)
+    })();
+    if !descriptor.is_null() {
+        LocalFree(descriptor as HLOCAL);
+    }
+    result
+}
