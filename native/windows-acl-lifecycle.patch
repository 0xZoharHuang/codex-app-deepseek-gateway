+    // Use the pinned write-capable handle to install a null DACL for this fixture.
+    unsafe {
+        super::set_directory_dacl_without_propagation(
+            std::os::windows::io::AsRawHandle::as_raw_handle(&_restore.handle) as _,
+            _restore.descriptor,
+            std::ptr::null_mut(),
+        )
+        .unwrap();
+        assert!(
+            !ensure_allow_mask_aces_with_inheritance(
+                root.path(),
+                &[target.as_ptr()],
+                FILE_READ_ATTRIBUTES,
+                0
+            )
+            .unwrap()
+        );
+        let (dacl, descriptor) = fetch_dacl_handle(root.path()).unwrap();
+        assert!(dacl.is_null());
+        LocalFree(descriptor as HLOCAL);
+    }
+}
