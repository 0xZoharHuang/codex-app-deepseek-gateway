+// Every cooperating file DACL writer takes the same inheritance domain.
+// Foreign-owned targets join too; the OS still enforces the existing WRITE_DAC.
+fn lock_acl_update(target: &std::fs::File) -> Result<Option<(crate::acl_lock::AclScope, Vec<u8>)>> {
+    let guard = crate::acl_lock::acquire(target.as_raw_handle() as _, crate::acl_lock::deadline())?;
+    let (mut owner, mut descriptor) = (std::ptr::null_mut(), std::ptr::null_mut());
+    let status = unsafe {
+        GetSecurityInfo(
+            target.as_raw_handle() as _,
+            1,
+            OWNER_SECURITY_INFORMATION,
+            &mut owner,
+            std::ptr::null_mut(),
+            std::ptr::null_mut(),
+            std::ptr::null_mut(),
+            &mut descriptor,
+        )
+    };
+    let result = (|| {
+        ensure!(
+            status == ERROR_SUCCESS && !owner.is_null(),
+            "inspect locked ACL owner: {status}"
+        );
+        Ok(unsafe {
+            std::slice::from_raw_parts(
+                owner.cast::<u8>(),
+                windows_sys::Win32::Security::GetLengthSid(owner) as usize,
+            )
+        }
+        .to_vec())
+    })();
+    if !descriptor.is_null() {
+        unsafe {
+            LocalFree(descriptor as HLOCAL);
+        }
+    }
+    Ok(Some((guard, result?)))
+}
