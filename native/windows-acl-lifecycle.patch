+// Preserve a separate non-inheriting metadata ACE through the native allow setter.
+// The requested permission already contains FILE_READ_ATTRIBUTES; the retained
+// ACE is redundant for access but necessary for exact ownership-based revocation.
+unsafe fn preserve_standalone_metadata_entries(
+    previous: *mut ACL,
+    updated: *mut ACL,
+    requested: &[EXPLICIT_ACCESS_W],
+) -> Result<Option<Vec<u32>>> {
+    use windows_sys::Win32::Security::AddAce;
+    use windows_sys::Win32::Storage::FileSystem::FILE_READ_ATTRIBUTES;
+    if previous.is_null() || updated.is_null() {
+        return Ok(None);
+    }
+    ensure!(
+        IsValidAcl(previous) != 0 && IsValidAcl(updated) != 0,
+        "invalid metadata preservation ACL"
+    );
+    let mut additional = Vec::new();
+    for index in 0..(*previous).AceCount as u32 {
+        let mut raw = std::ptr::null_mut();
+        ensure!(
+            GetAce(previous, index, &mut raw) != 0,
+            "read original metadata ACE"
+        );
+        let header = &*raw.cast::<ACE_HEADER>();
+        if header.AceType != ACCESS_ALLOWED_ACE_TYPE
+            || header.AceFlags != 0
+            || (header.AceSize as usize) < size_of::<ACCESS_ALLOWED_ACE>()
+        {
+            continue;
+        }
+        let ace = &*raw.cast::<ACCESS_ALLOWED_ACE>();
+        if ace.Mask != FILE_READ_ATTRIBUTES
+            || !requested.iter().any(|request| {
+                request.grfAccessPermissions & FILE_READ_ATTRIBUTES != 0
+                    && request.grfInheritance & u32::from(INHERIT_ONLY_ACE) == 0
+                    && EqualSid(
+                        (&raw const ace.SidStart) as *mut c_void,
+                        request.Trustee.ptstrName.cast(),
+                    ) != 0
+            })
+        {
+            continue;
+        }
+        let bytes = std::slice::from_raw_parts(raw.cast::<u8>(), header.AceSize as usize);
+        let mut exists = false;
+        for i in 0..(*updated).AceCount as u32 {
+            let mut current = std::ptr::null_mut();
+            ensure!(
+                GetAce(updated, i, &mut current) != 0,
+                "read updated metadata ACE"
+            );
+            let size = (*current.cast::<ACE_HEADER>()).AceSize as usize;
+            if size == bytes.len()
+                && std::slice::from_raw_parts(current.cast::<u8>(), size) == bytes
+            {
+                exists = true;
+                break;
+            }
+        }
+        if !exists {
+            additional.push(bytes.to_vec());
+        }
+    }
+    if additional.is_empty() {
+        return Ok(None);
+    }
+    let old_size = (*updated).AclSize as usize;
+    let size = old_size + additional.iter().map(Vec::len).sum::<usize>();
+    ensure!(
+        size <= u16::MAX as usize,
+        "metadata-preserving ACL is too large"
+    );
+    let mut storage = vec![0u32; size.div_ceil(size_of::<u32>())];
+    let acl = storage.as_mut_ptr().cast::<ACL>();
+    std::ptr::copy_nonoverlapping(updated.cast::<u8>(), acl.cast::<u8>(), old_size);
+    (*acl).AclSize = size as u16;
+    let mut insertion = (*acl).AceCount as u32;
+    for index in 0..(*acl).AceCount as u32 {
+        let mut raw = std::ptr::null_mut();
+        ensure!(
+            GetAce(acl, index, &mut raw) != 0,
+            "find metadata ACE insertion"
+        );
+        if (*raw.cast::<ACE_HEADER>()).AceFlags & INHERITED_ACE != 0 {
+            insertion = index;
+            break;
+        }
+    }
+    for bytes in additional {
+        ensure!(
+            AddAce(
+                acl,
+                (*acl).AclRevision as u32,
+                insertion,
+                bytes.as_ptr().cast(),
+                bytes.len() as u32
+            ) != 0,
+            "preserve standalone metadata ACE"
+        );
+        insertion += 1;
+    }
+    Ok(Some(storage))
+}
