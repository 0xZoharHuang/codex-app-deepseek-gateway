+/// Reuse the same owner-private, non-reparse lock for another native ACL ledger.
+pub(crate) fn lock_private_state_transaction(
+    directory: &Path,
+    state_name: &str,
+    lock_name: &str,
+) -> Result<StateTransaction> {
+    ensure!(
+        Path::new(state_name)
+            .file_name()
+            .is_some_and(|name| name == state_name)
+            && Path::new(lock_name)
+                .file_name()
+                .is_some_and(|name| name == lock_name),
+        "ACL ledger names must be plain leaf names"
+    );
+    use crate::no_reparse_dir::{DirectoryOpenDisposition, open_directory_no_reparse};
+    let physical_parent =
+        dunce::canonicalize(directory).context("resolve physical deny-read state directory")?;
+    let parent = open_directory_no_reparse(
+        &physical_parent,
+        winfs::FILE_TRAVERSE | winfs::FILE_READ_ATTRIBUTES,
+        winfs::FILE_SHARE_READ | winfs::FILE_SHARE_WRITE,
+        DirectoryOpenDisposition::OpenExisting,
+    )?;
+    let policy = crate::private_acl_lock::PrivatePolicy::current()?;
+    let file = policy.open_file(
+        parent.as_raw_handle() as _,
+        lock_name,
+        winfs::FILE_GENERIC_READ | winfs::FILE_GENERIC_WRITE,
+        winfs::FILE_SHARE_READ | winfs::FILE_SHARE_WRITE,
+        3,
+    )?;
+    let deadline = Instant::now() + Duration::from_secs(2);
+    loop {
+        match file.try_lock() {
+            Ok(()) => break,
+            Err(std::fs::TryLockError::WouldBlock) if Instant::now() < deadline => {
+                std::thread::sleep(Duration::from_millis(10))
+            }
+            Err(std::fs::TryLockError::WouldBlock) => {
+                anyhow::bail!("timed out waiting for deny-read state transaction")
+            }
+            Err(std::fs::TryLockError::Error(error)) => {
+                return Err(error).context("lock deny-read state transaction");
+            }
+        }
+    }
+    // Revalidate the same leaf after waiting; this also rejects new hard links.
+    validate_state_file(&file)?;
+    Ok(StateTransaction {
+        _file: file,
+        _parent: parent,
+        state_path: physical_parent.join(state_name),
+    })
 }
 
