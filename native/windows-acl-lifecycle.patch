+    fn create_explicit_inheritable_fixture_kind(
+        path: &Path,
+        owner: &str,
+        directory: bool,
+    ) -> Result<()> {
+        use std::os::windows::ffi::OsStrExt;
+        use windows_sys::Win32::Security::{
+            InitializeSecurityDescriptor, SECURITY_ATTRIBUTES, SECURITY_DESCRIPTOR,
+            SetSecurityDescriptorDacl,
+        };
+        let mut owner_entry = fixture_owner_ace(owner)?;
+        owner_entry[1] = 3;
+        let mut system_entry = fixture_owner_ace("S-1-5-18")?;
+        system_entry[1] = 3;
+        let bytes = size_of::<ACL>() + owner_entry.len() + system_entry.len();
+        let mut buffer = vec![0_u32; bytes.div_ceil(size_of::<u32>())];
+        let acl = buffer.as_mut_ptr().cast::<ACL>();
+        ensure!(
+            unsafe { InitializeAcl(acl, bytes as u32, 2) } != 0,
+            "initialize exact fixture ACL"
+        );
+        for entry in [&owner_entry, &system_entry] {
+            ensure!(
+                unsafe { AddAce(acl, 2, u32::MAX, entry.as_ptr().cast(), entry.len() as u32) } != 0,
+                "append exact fixture ACE"
+            );
+        }
+        let mut descriptor: SECURITY_DESCRIPTOR = unsafe { std::mem::zeroed() };
+        let pointer = (&raw mut descriptor).cast::<c_void>();
+        ensure!(
+            unsafe { InitializeSecurityDescriptor(pointer, 1) } != 0,
+            "initialize exact fixture descriptor"
+        );
+        ensure!(
+            unsafe { SetSecurityDescriptorDacl(pointer, 1, acl, 0) } != 0,
+            "set exact fixture DACL"
+        );
+        let attributes = SECURITY_ATTRIBUTES {
+            nLength: size_of::<SECURITY_ATTRIBUTES>() as u32,
+            lpSecurityDescriptor: pointer,
+            bInheritHandle: 0,
+        };
+        let name = path
+            .as_os_str()
+            .encode_wide()
+            .chain(Some(0))
+            .collect::<Vec<_>>();
+        if directory {
+            ensure!(
+                unsafe { fs::CreateDirectoryW(name.as_ptr(), &attributes) } != 0,
+                "create exact ACL fixture: {}",
+                std::io::Error::last_os_error()
+            );
+        } else {
+            let handle = unsafe {
+                fs::CreateFileW(
+                    name.as_ptr(),
+                    0x8000_0000 | 0x4000_0000,
+                    fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE,
+                    &attributes,
+                    fs::CREATE_NEW,
+                    fs::FILE_ATTRIBUTE_NORMAL,
+                    std::ptr::null_mut(),
+                )
+            };
+            ensure!(
+                handle != windows_sys::Win32::Foundation::INVALID_HANDLE_VALUE,
+                "create exact file ACL fixture: {}",
+                std::io::Error::last_os_error()
+            );
+            unsafe {
+                windows_sys::Win32::Foundation::CloseHandle(handle);
+            }
+        }
+        Ok(())
+    }
