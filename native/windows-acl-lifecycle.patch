+// Match the pinned-handle DACL write used by file_write: preserve protection
+// and automatic-inheritance control without asking SetSecurityInfo to walk
+// children. Only the supplied directory handle is changed.
+pub(crate) unsafe fn set_directory_dacl_without_propagation(
+    handle: HANDLE,
+    original_descriptor: *mut c_void,
+    dacl: *mut ACL,
+) -> Result<()> {
+    use windows_sys::Win32::Foundation::RtlNtStatusToDosError;
+    use windows_sys::Win32::Security::{
+        GetSecurityDescriptorControl, InitializeSecurityDescriptor,
+        PROTECTED_DACL_SECURITY_INFORMATION, SE_DACL_AUTO_INHERIT_REQ, SE_DACL_AUTO_INHERITED,
+        SE_DACL_DEFAULTED, SE_DACL_PROTECTED, SECURITY_DESCRIPTOR, SetSecurityDescriptorControl,
+        SetSecurityDescriptorDacl,
+    };
+    #[link(name = "ntdll")]
+    unsafe extern "system" {
+        fn NtSetSecurityObject(handle: HANDLE, information: u32, descriptor: *const c_void) -> i32;
+    }
+    let mut control = 0;
+    let mut revision = 0;
+    if GetSecurityDescriptorControl(original_descriptor, &mut control, &mut revision) == 0 {
+        return Err(std::io::Error::last_os_error()).context("read root-only DACL control");
+    }
+    let mut descriptor: SECURITY_DESCRIPTOR = std::mem::zeroed();
+    let descriptor_ptr = (&mut descriptor as *mut SECURITY_DESCRIPTOR).cast::<c_void>();
+    if InitializeSecurityDescriptor(descriptor_ptr, 1) == 0
+        || SetSecurityDescriptorDacl(
+            descriptor_ptr,
+            1,
+            dacl,
+            i32::from(control & SE_DACL_DEFAULTED != 0),
+        ) == 0
+    {
+        return Err(std::io::Error::last_os_error()).context("prepare root-only DACL");
+    }
+    let flags = SE_DACL_PROTECTED | SE_DACL_AUTO_INHERITED | SE_DACL_AUTO_INHERIT_REQ;
+    let mut desired = control & flags;
+    if control & SE_DACL_AUTO_INHERITED != 0 {
+        desired |= SE_DACL_AUTO_INHERIT_REQ;
+    }
+    if SetSecurityDescriptorControl(descriptor_ptr, flags, desired) == 0 {
+        return Err(std::io::Error::last_os_error()).context("preserve root-only DACL control");
+    }
+    let protection = if control & SE_DACL_PROTECTED != 0 {
+        PROTECTED_DACL_SECURITY_INFORMATION
+    } else {
+        0
+    };
+    let status = NtSetSecurityObject(
+        handle,
+        DACL_SECURITY_INFORMATION | protection,
+        descriptor_ptr,
+    );
+    if status < 0 {
+        return Err(std::io::Error::from_raw_os_error(
+            RtlNtStatusToDosError(status) as i32,
+        ))
+        .context("set root-only DACL without descendant propagation");
+    }
+    Ok(())
 }
 
