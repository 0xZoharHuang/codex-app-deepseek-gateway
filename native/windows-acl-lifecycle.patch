+struct PinnedDirectory {
+    path: PathBuf,
+    handle: OwnedHandle,
+    identity: DirectoryId,
+}
+
+impl PinnedDirectory {
+    fn open(path: &Path) -> Result<Self> {
+        // FILE_TRAVERSE participates in sharing checks; no SHARE_DELETE pins the name.
+        let handle = open_directory_no_reparse(
+            path,
+            fs::READ_CONTROL | fs::FILE_READ_ATTRIBUTES | fs::FILE_TRAVERSE,
+            fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE,
+            DirectoryOpenDisposition::OpenExisting,
+        )?;
+        let identity = directory_id(handle.as_raw_handle() as _)?;
+        Ok(Self {
+            path: path.to_owned(),
+            handle,
+            identity,
+        })
+    }
+
+    fn lock_acl(&self, deadline: Option<std::time::Instant>) -> Result<crate::acl_lock::AclScope> {
+        crate::acl_lock::acquire(self.handle.as_raw_handle() as _, deadline)
+    }
+
+    fn write_handle(&self) -> Result<OwnedHandle> {
+        let handle = open_directory_no_reparse(
+            &self.path,
+            fs::READ_CONTROL | fs::WRITE_DAC | fs::FILE_READ_ATTRIBUTES,
+            fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE,
+            DirectoryOpenDisposition::OpenExisting,
+        )?;
+        ensure!(
+            directory_id(handle.as_raw_handle() as _)? == self.identity,
+            "metadata target changed before its ACL update"
+        );
+        Ok(handle)
+    }
+}
+
+fn directory_id(handle: HANDLE) -> Result<DirectoryId> {
+    let mut info = fs::FILE_ID_INFO::default();
+    ensure!(
+        unsafe {
+            fs::GetFileInformationByHandleEx(
+                handle,
+                fs::FileIdInfo,
+                (&mut info as *mut fs::FILE_ID_INFO).cast(),
+                size_of::<fs::FILE_ID_INFO>() as u32,
+            )
+        } != 0,
+        "read metadata directory identity: {}",
+        std::io::Error::last_os_error()
+    );
+    ensure!(
+        info.FileId.Identifier != [0; 16],
+        "metadata directory has no stable identity"
+    );
+    Ok(DirectoryId {
+        volume: info.VolumeSerialNumber,
+        file_id: info.FileId.Identifier,
+    })
+}
+
+fn pin_ancestors(namespace: &SandboxNamespace) -> Result<Vec<PinnedDirectory>> {
+    let mut paths = namespace.home.ancestors().collect::<Vec<_>>();
+    paths.reverse();
+    let pinned = paths
+        .into_iter()
+        .map(PinnedDirectory::open)
+        .collect::<Result<Vec<_>>>()?;
+    let home = pinned.last().context("metadata home is missing")?;
+    let actual = crate::namespace_key::NamespaceKey::for_directory(
+        &namespace.home.to_string_lossy().to_lowercase(),
+        &namespace.owner_sid,
+        home.identity.volume,
+        home.identity.file_id,
+    );
+    ensure!(
+        actual.id() == namespace.key.id(),
+        "metadata home identity changed"
+    );
+    namespace.validate_existing_state()?;
+    Ok(pinned)
+}
+
+// Only below-home parents of this request's already-authorized physical roots
+// enter the grant set. Journal-only paths are validated/revoked, never regranted.
+fn private_descendant(namespace: &SandboxNamespace, path: &Path) -> bool {
+    let key = crate::deny_read_acl::lexical_path_key(dunce::simplified(path));
+    let home = crate::deny_read_acl::lexical_path_key(dunce::simplified(&namespace.home));
+    key.starts_with(&(home + "/"))
+}
+
+fn pin_requested_parents(
+    namespace: &SandboxNamespace,
+    roots: &[PathBuf],
+) -> Result<Vec<PinnedDirectory>> {
+    use std::os::windows::fs::MetadataExt;
+    let mut pinned = pin_ancestors(namespace)?;
+    let own_home = pinned
+        .iter()
+        .find(|p| p.path == namespace.home)
+        .context("metadata home pin is missing")?
+        .identity
+        .clone();
+    let home_depth = dunce::simplified(&namespace.home).components().count();
+    for root in roots {
+        crate::no_reparse_dir::validate_local_directory_path(root)?;
+        if !private_descendant(namespace, root) {
+            continue;
+        }
+        let metadata = match std::fs::symlink_metadata(root) {
+            Ok(metadata) => metadata,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => continue,
+            Err(error) => return Err(error).context("inspect authorized metadata root"),
+        };
+        ensure!(
+            metadata.is_file() || metadata.is_dir(),
+            "authorized metadata root is not a regular file or directory"
+        );
+        ensure!(
+            metadata.file_attributes() & fs::FILE_ATTRIBUTE_REPARSE_POINT == 0,
+            "authorized metadata root is a reparse point"
+        );
+        // Case-folded text is only a candidate filter: Windows directories can
+        // be case-sensitive and Home/HOME can belong to different namespaces.
+        let boundary = root
+            .ancestors()
+            .find(|p| dunce::simplified(p).components().count() == home_depth)
+            .context("authorized root has no physical home boundary")?;
+        let requested_home = PinnedDirectory::open(boundary)?;
+        ensure!(
+            requested_home.identity == own_home,
+            "authorized root belongs to a different physical CODEX_HOME"
+        );
+        for parent in root.ancestors().skip(1) {
+            if !private_descendant(namespace, parent) {
+                break;
+            }
+            // NtCreateFile OBJ_DONT_REPARSE rejects every redirected component;
+            // FILE_TRAVERSE + no SHARE_DELETE pin the actual directory object.
+            // Distinct case-sensitive names can resolve to distinct objects.
+            let directory = PinnedDirectory::open(parent)?;
+            if !pinned
+                .iter()
+                .any(|item| item.identity == directory.identity)
+            {
+                pinned.push(directory);
+            }
+        }
+    }
+    pinned.sort_by_key(|item| item.path.components().count());
+    Ok(pinned)
+}
+
+fn handle_path(handle: HANDLE, volume_guid: bool) -> Result<PathBuf> {
+    use std::os::windows::ffi::OsStringExt;
+    let mut name = vec![0_u16; 32_768];
+    let count = unsafe {
+        fs::GetFinalPathNameByHandleW(
+            handle,
+            name.as_mut_ptr(),
+            name.len() as u32,
+            if volume_guid { 1 } else { 0 },
+        )
+    };
+    ensure!(
+        count > 0 && (count as usize) < name.len(),
+        "resolve metadata object path: {}",
+        std::io::Error::last_os_error()
+    );
+    name.truncate(count as usize);
+    Ok(PathBuf::from(std::ffi::OsString::from_wide(&name)))
+}
+
+fn filesystem_name(handle: HANDLE) -> Result<String> {
+    let mut name = [0_u16; 32];
+    let mut label = [0_u16; 260];
+    let (mut serial, mut maximum, mut flags) = (0_u32, 0_u32, 0_u32);
+    let ok = unsafe {
+        fs::GetVolumeInformationByHandleW(
+            handle,
+            label.as_mut_ptr(),
+            label.len() as u32,
+            &mut serial,
+            &mut maximum,
+            &mut flags,
+            name.as_mut_ptr(),
+            name.len() as u32,
+        )
+    };
+    ensure!(
+        ok != 0,
+        "read metadata volume type: {}",
+        std::io::Error::last_os_error()
+    );
+    let end = name
+        .iter()
+        .position(|v| *v == 0)
+        .context("unterminated filesystem name")?;
+    Ok(String::from_utf16(&name[..end])?)
+}
+
+fn open_recorded_id(
+    home: &PinnedDirectory,
+    identity: &DirectoryId,
+) -> Result<std::result::Result<OwnedHandle, std::io::Error>> {
+    use std::os::windows::io::FromRawHandle;
+    ensure!(
+        identity.volume == home.identity.volume,
+        "metadata identity belongs to another volume"
+    );
+    let mut descriptor = fs::FILE_ID_DESCRIPTOR {
+        dwSize: size_of::<fs::FILE_ID_DESCRIPTOR>() as u32,
+        Type: fs::ExtendedFileIdType,
+        Anonymous: fs::FILE_ID_DESCRIPTOR_0 {
+            ExtendedFileId: fs::FILE_ID_128 {
+                Identifier: identity.file_id,
+            },
+        },
+    };
+    let open = |descriptor: &fs::FILE_ID_DESCRIPTOR| {
+        let handle = unsafe {
+            fs::OpenFileById(
+                home.handle.as_raw_handle() as _,
+                descriptor,
+                fs::READ_CONTROL | fs::FILE_READ_ATTRIBUTES | fs::FILE_TRAVERSE,
+                fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE,
+                std::ptr::null(),
+                fs::FILE_FLAG_BACKUP_SEMANTICS | fs::FILE_FLAG_OPEN_REPARSE_POINT,
+            )
+        };
+        if handle == windows_sys::Win32::Foundation::INVALID_HANDLE_VALUE {
+            Err(std::io::Error::last_os_error())
+        } else {
+            Ok(unsafe { OwnedHandle::from_raw_handle(handle) })
+        }
+    };
+    let first = open(&descriptor);
+    if let Err(error) = &first
+        && matches!(error.raw_os_error(), Some(87 | 50))
+        && identity.file_id[8..] == [0; 8]
+        && filesystem_name(home.handle.as_raw_handle() as _)?.eq_ignore_ascii_case("NTFS")
+    {
+        // Microsoft documents NTFS references as a zero-extended 64-bit ID.
+        // This compatibility path is explicit and every successful open is
+        // subsequently compared against the original complete 128-bit identity.
+        descriptor.Type = fs::FileIdType;
+        descriptor.Anonymous = fs::FILE_ID_DESCRIPTOR_0 {
+            FileId: i64::from_le_bytes(identity.file_id[..8].try_into().unwrap()),
+        };
+        return Ok(open(&descriptor));
+    }
+    Ok(first)
+}
+
+#[derive(Debug)]
+struct NtfsRecordMetadata {
+    ordinal: u64,
+    sequence: u16,
+}
+
+fn same_ntfs_generation(reference: u64, record: &NtfsRecordMetadata) -> bool {
+    record.ordinal == reference & ((1_u64 << 48) - 1)
+        && u64::from(record.sequence) == reference >> 48
+}
+
+fn query_ntfs_record(
+    volume: HANDLE,
+    ordinal: u64,
+    record_bytes: usize,
+) -> Result<NtfsRecordMetadata> {
+    ensure!(
+        ordinal < (1_u64 << 48),
+        "NTFS record ordinal exceeds its documented field"
+    );
+    ensure!(
+        (512..=65_536).contains(&record_bytes),
+        "unsupported bounded NTFS record size"
+    );
+    let mut output = vec![0_u8; 16 + record_bytes - 1];
+    let mut count = 0_u32;
+    let ok = unsafe {
+        windows_sys::Win32::System::IO::DeviceIoControl(
+            volume,
+            0x0009_0068,
+            (&raw const ordinal).cast(),
+            size_of_val(&ordinal) as u32,
+            output.as_mut_ptr().cast(),
+            output.len() as u32,
+            &mut count,
+            std::ptr::null_mut(),
+        )
+    };
+    ensure!(
+        ok != 0,
+        "query one NTFS metadata record: {}",
+        std::io::Error::last_os_error()
+    );
+    parse_ntfs_record_metadata(&output, count as usize, record_bytes, ordinal)
+}
+
+fn parse_ntfs_record_metadata(
+    output: &[u8],
+    count: usize,
+    record_bytes: usize,
+    ordinal: u64,
+) -> Result<NtfsRecordMetadata> {
+    ensure!(
+        ordinal < (1_u64 << 48) && (512..=65_536).contains(&record_bytes),
+        "invalid bounded NTFS metadata request"
+    );
+    ensure!(
+        count <= output.len() && count >= 12,
+        "truncated NTFS record response"
+    );
+    let returned = u64::from_le_bytes(output[..8].try_into().unwrap());
+    let length = u32::from_le_bytes(output[8..12].try_into().unwrap()) as usize;
+    ensure!(
+        length >= 24 && length <= record_bytes && count >= 12 + length,
+        "invalid NTFS metadata header length"
+    );
+    // Only the fixed, documented NTFS3.0/3.1 metadata header is inspected:
+    // signature, SequenceNumber and IN_USE. Attributes/file content are neither
+    // interpreted nor logged. The output FileReferenceNumber can be ordinal-only.
+    ensure!(
+        &output[12..16] == b"FILE",
+        "unrecognized NTFS record signature"
+    );
+    let sequence = u16::from_le_bytes(output[28..30].try_into().unwrap());
+    let flags = u16::from_le_bytes(output[34..36].try_into().unwrap());
+    ensure!(
+        sequence != 0 && flags & 1 != 0,
+        "NTFS result is not an in-use metadata generation"
+    );
+    ensure!(
+        returned >> 48 == 0 || returned >> 48 == u64::from(sequence),
+        "unknown NTFS output-reference encoding"
+    );
+    let returned_ordinal = returned & ((1_u64 << 48) - 1);
+    ensure!(
+        returned_ordinal <= ordinal,
+        "NTFS metadata query returned a higher ordinal"
+    );
+    Ok(NtfsRecordMetadata {
+        ordinal: returned_ordinal,
+        sequence,
+    })
+}
+
+fn parse_ntfs_volume_metadata(data: &[u8], count: usize, expected_volume: u64) -> Result<usize> {
+    ensure!(
+        count <= data.len() && count >= 104,
+        "truncated NTFS version metadata"
+    );
+    ensure!(
+        u64::from_le_bytes(data[..8].try_into().unwrap()) == expected_volume,
+        "read-only NTFS volume differs from pinned namespace volume"
+    );
+    let extended = u32::from_le_bytes(data[96..100].try_into().unwrap());
+    let major = u16::from_le_bytes(data[100..102].try_into().unwrap());
+    let minor = u16::from_le_bytes(data[102..104].try_into().unwrap());
+    ensure!(
+        extended >= 8 && major == 3 && minor <= 1,
+        "unsupported NTFS metadata header version"
+    );
+    let record_bytes = u32::from_le_bytes(data[48..52].try_into().unwrap()) as usize;
+    ensure!(
+        (512..=65_536).contains(&record_bytes),
+        "unsupported NTFS record size"
+    );
+    ensure!(
+        extended as usize <= count - 96,
+        "NTFS extended metadata exceeds returned bytes"
+    );
+    Ok(record_bytes)
+}
+
+fn ntfs_generation_deleted(home: &PinnedDirectory, identity: &DirectoryId) -> Result<bool> {
+    use std::os::windows::ffi::OsStrExt;
+    use std::os::windows::io::FromRawHandle;
+    ensure!(
+        identity.volume == home.identity.volume && identity.file_id[8..] == [0; 8],
+        "deleted-object proof requires the same volume and a zero-extended NTFS reference"
+    );
+    ensure!(
+        filesystem_name(home.handle.as_raw_handle() as _)?.eq_ignore_ascii_case("NTFS"),
+        "deleted-object proof is only defined for NTFS"
+    );
+    let live_control = open_recorded_id(home, &home.identity)?
+        .context("NTFS live control identity cannot be opened")?;
+    ensure!(
+        directory_id(live_control.as_raw_handle() as _)? == home.identity,
+        "NTFS live control returned a different full identity"
+    );
+    let physical = handle_path(home.handle.as_raw_handle() as _, true)?;
+    let text = physical.to_string_lossy();
+    ensure!(
+        text.starts_with(r"\\?\Volume{"),
+        "metadata volume has no pinned GUID path"
+    );
+    let end = text
+        .find('}')
+        .context("metadata volume GUID is malformed")?
+        + 1;
+    ensure!(
+        text.as_bytes().get(end) == Some(&b'\\'),
+        "metadata GUID boundary is invalid"
+    );
+    let volume_name: Vec<u16> = std::ffi::OsStr::new(&text[..end])
+        .encode_wide()
+        .chain(Some(0))
+        .collect();
+    // Cold native uninstall may require its existing elevated context for this
+    // read-only volume open. Normal per-request grants never call this proof.
+    let raw = unsafe {
+        fs::CreateFileW(
+            volume_name.as_ptr(),
+            0x8000_0000,
+            fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE | fs::FILE_SHARE_DELETE,
+            std::ptr::null(),
+            fs::OPEN_EXISTING,
+            0,
+            std::ptr::null_mut(),
+        )
+    };
+    ensure!(
+        raw != windows_sys::Win32::Foundation::INVALID_HANDLE_VALUE,
+        "open read-only metadata volume: {}",
+        std::io::Error::last_os_error()
+    );
+    let volume = unsafe { OwnedHandle::from_raw_handle(raw) };
+    ensure!(
+        filesystem_name(volume.as_raw_handle() as _)?.eq_ignore_ascii_case("NTFS"),
+        "metadata volume type changed"
+    );
+    let mut data = [0_u8; 128];
+    let mut count = 0_u32;
+    let ok = unsafe {
+        windows_sys::Win32::System::IO::DeviceIoControl(
+            volume.as_raw_handle() as _,
+            0x0009_0064,
+            std::ptr::null(),
+            0,
+            data.as_mut_ptr().cast(),
+            data.len() as u32,
+            &mut count,
+            std::ptr::null_mut(),
+        )
+    };
+    ensure!(
+        ok != 0 && count >= 104,
+        "read NTFS volume metadata: {}",
+        std::io::Error::last_os_error()
+    );
+    let record_bytes = parse_ntfs_volume_metadata(&data, count as usize, identity.volume)?;
+    ensure!(
+        home.identity.file_id[8..] == [0; 8],
+        "NTFS live control ID is not zero extended"
+    );
+    let control = u64::from_le_bytes(home.identity.file_id[..8].try_into().unwrap());
+    let expected = u64::from_le_bytes(identity.file_id[..8].try_into().unwrap());
+    let mask = (1_u64 << 48) - 1;
+    let control_matches = |value: &NtfsRecordMetadata| same_ntfs_generation(control, value);
+    ensure!(
+        control_matches(&query_ntfs_record(
+            volume.as_raw_handle() as _,
+            control & mask,
+            record_bytes
+        )?),
+        "live namespace NTFS control generation differs"
+    );
+    let actual = query_ntfs_record(volume.as_raw_handle() as _, expected & mask, record_bytes)?;
+    ensure!(
+        control_matches(&query_ntfs_record(
+            volume.as_raw_handle() as _,
+            control & mask,
+            record_bytes
+        )?),
+        "live namespace NTFS control changed after object query"
+    );
+    ensure!(
+        directory_id(live_control.as_raw_handle() as _)? == home.identity,
+        "NTFS live control identity changed after metadata queries"
+    );
+    // Official FSCTL returns the first in-use ordinal <= requested. A lower
+    // ordinal proves this slot is unused; another sequence proves generation
+    // replacement. An alive matching generation remains unknown, never retired.
+    Ok(!same_ntfs_generation(expected, &actual))
+}
+
+fn resolve_recorded_directory(
+    namespace: &SandboxNamespace,
+    grant: &Grant,
+) -> Result<Option<PinnedDirectory>> {
+    if let Ok(directory) = PinnedDirectory::open(&grant.path)
+        && directory.identity == grant.identity
+    {
+        return Ok(Some(directory));
+    }
+    ensure!(
+        private_descendant(namespace, &grant.path),
+        "recorded ancestor identity changed"
+    );
+    let home = PinnedDirectory::open(&namespace.home)?;
+    let opened = open_recorded_id(&home, &grant.identity)?;
+    let handle = match opened {
+        Ok(handle) => handle,
+        Err(error) if matches!(error.raw_os_error(), Some(2 | 3)) => return Ok(None),
+        Err(error) if error.raw_os_error() == Some(87) => {
+            if ntfs_generation_deleted(&home, &grant.identity)? {
+                return Ok(None);
+            }
+            return Err(error)
+                .context("historical metadata generation is live but cannot be opened");
+        }
+        Err(error) => {
+            return Err(error)
+                .context("historical metadata identity unresolved; ownership retained");
+        }
+    };
+    ensure!(
+        directory_id(handle.as_raw_handle() as _)? == grant.identity,
+        "reopened metadata object identity differs"
+    );
+    let mut tag: fs::FILE_ATTRIBUTE_TAG_INFO = unsafe { std::mem::zeroed() };
+    ensure!(
+        unsafe {
+            fs::GetFileInformationByHandleEx(
+                handle.as_raw_handle() as _,
+                fs::FileAttributeTagInfo,
+                (&raw mut tag).cast(),
+                size_of_val(&tag) as u32,
+            )
+        } != 0,
+        "inspect reopened metadata directory: {}",
+        std::io::Error::last_os_error()
+    );
+    ensure!(
+        tag.FileAttributes & fs::FILE_ATTRIBUTE_DIRECTORY != 0
+            && tag.FileAttributes & fs::FILE_ATTRIBUTE_REPARSE_POINT == 0,
+        "recorded metadata object is not a physical directory"
+    );
+    let path = handle_path(handle.as_raw_handle() as _, false)?;
+    Ok(Some(PinnedDirectory {
+        path,
+        handle,
+        identity: grant.identity.clone(),
+    }))
+}
+
+struct Dacl {
+    descriptor: *mut c_void,
+    owner: *mut c_void,
+    acl: *mut ACL,
+}
+
+impl Drop for Dacl {
+    fn drop(&mut self) {
+        if !self.descriptor.is_null() {
+            unsafe {
+                LocalFree(self.descriptor);
+            }
+        }
+    }
+}
+
+impl Dacl {
+    fn read(directory: &PinnedDirectory) -> Result<Self> {
+        let mut value = Self {
+            descriptor: std::ptr::null_mut(),
+            owner: std::ptr::null_mut(),
+            acl: std::ptr::null_mut(),
+        };
+        let code = unsafe {
+            get_raw_file_security(
+                directory.handle.as_raw_handle() as _,
+                SE_FILE_OBJECT,
+                DACL_SECURITY_INFORMATION | OWNER_SECURITY_INFORMATION,
+                &mut value.owner,
+                std::ptr::null_mut(),
+                &mut value.acl,
+                std::ptr::null_mut(),
+                &mut value.descriptor,
+            )
+        };
+        ensure!(code == 0, "read ancestor DACL: {code}");
+        ensure!(
+            value.acl.is_null() || unsafe { IsValidAcl(value.acl) } != 0,
+            "invalid ancestor DACL"
+        );
+        Ok(value)
+    }
+
+    fn require_owner(&self, expected: &str) -> Result<()> {
+        let expected = crate::token::LocalSid::from_string(expected)?;
+        ensure!(
+            !self.owner.is_null() && unsafe { EqualSid(self.owner, expected.as_ptr()) } != 0,
+            "refusing to modify another owner's ancestor metadata"
+        );
+        Ok(())
+    }
+
+    fn entries(&self) -> Result<Vec<Vec<u8>>> {
+        let mut entries = Vec::new();
+        if self.acl.is_null() {
+            return Ok(entries);
+        }
+        for index in 0..unsafe { (*self.acl).AceCount } as u32 {
+            let mut raw = std::ptr::null_mut();
+            ensure!(
+                unsafe { GetAce(self.acl, index, &mut raw) } != 0,
+                "read metadata ACE"
+            );
+            let header = unsafe { &*raw.cast::<ACE_HEADER>() };
+            ensure!(
+                header.AceSize as usize >= size_of::<ACE_HEADER>(),
+                "invalid metadata ACE size"
+            );
+            entries.push(
+                unsafe { std::slice::from_raw_parts(raw.cast::<u8>(), header.AceSize as usize) }
+                    .to_vec(),
+            );
+        }
+        Ok(entries)
+    }
+
+    fn write(&self, directory: &PinnedDirectory, entries: &[Vec<u8>]) -> Result<()> {
+        ensure!(!self.acl.is_null(), "a null DACL already permits metadata");
+        let size = size_of::<ACL>() + entries.iter().map(Vec::len).sum::<usize>();
+        ensure!(size <= u16::MAX as usize, "ancestor DACL is too large");
+        let mut storage = vec![0u32; size.div_ceil(size_of::<u32>())];
+        let acl = storage.as_mut_ptr().cast::<ACL>();
+        let revision = unsafe { (*self.acl).AclRevision } as u32;
+        ensure!(
+            unsafe { InitializeAcl(acl, size as u32, revision) } != 0,
+            "initialize metadata DACL"
+        );
+        for ace in entries {
+            ensure!(
+                unsafe {
+                    AddAce(
+                        acl,
+                        revision,
+                        u32::MAX,
+                        ace.as_ptr().cast(),
+                        ace.len() as u32,
+                    )
+                } != 0,
+                "copy metadata DACL entry"
+            );
+        }
+        let handle = directory.write_handle()?;
+        unsafe {
+            crate::acl::set_directory_dacl_without_propagation(
+                handle.as_raw_handle() as _,
+                self.descriptor,
+                acl,
+            )
+        }
+    }
+}
+
+fn metadata_mask(mask: u32) -> bool {
+    mask & (fs::FILE_READ_ATTRIBUTES | 0x8000_0000 | 0x2000_0000 | 0x1000_0000) != 0
+}
+
+fn entry_sid(ace: &[u8]) -> Result<&[u8]> {
+    ensure!(ace.len() >= 16, "truncated metadata trustee");
+    let sid = &ace[8..];
+    ensure!(
+        unsafe { IsValidSid(sid.as_ptr() as *mut c_void) } != 0,
+        "invalid metadata trustee"
+    );
+    let len = unsafe { GetLengthSid(sid.as_ptr() as *mut c_void) } as usize;
+    ensure!(len <= sid.len(), "metadata trustee exceeds ACE");
+    Ok(&sid[..len])
+}
+
+fn already_readable(dacl: &Dacl, entries: &[Vec<u8>], principals: &[Vec<u8>]) -> Result<bool> {
+    if dacl.acl.is_null() {
+        return Ok(true);
+    }
+    let mut allowed = false;
+    for ace in entries {
+        if ace[1] & INHERIT_ONLY_ACE as u8 != 0 || ace.len() < 8 {
+            continue;
+        }
+        let mask = u32::from_le_bytes(ace[4..8].try_into().unwrap());
+        if !metadata_mask(mask) {
+            continue;
+        }
+        match ace[0] {
+            0 | 1 => {
+                let trustee = entry_sid(ace)?;
+                if principals.iter().any(|sid| trustee == sid) {
+                    ensure!(
+                        ace[0] != 1,
+                        "explicit ancestor metadata denial must not be weakened"
+                    );
+                    allowed = true;
+                }
+            }
+            // Conditional/object denials need a full token evaluation; do not override them.
+            6 | 10 | 12 => bail!("conditional ancestor metadata denial cannot be replaced"),
+            _ => {}
+        }
+    }
+    Ok(allowed)
+}
+
+fn metadata_ace(sid: &[u8]) -> Result<Vec<u8>> {
+    ensure!(
+        sid.len() >= 8 && unsafe { IsValidSid(sid.as_ptr() as *mut c_void) } != 0,
+        "invalid metadata SID"
+    );
+    ensure!(
+        unsafe { GetLengthSid(sid.as_ptr() as *mut c_void) } as usize == sid.len(),
+        "invalid metadata SID size"
+    );
+    let size = 8 + sid.len();
+    let mut ace = vec![0, 0]; // ACCESS_ALLOWED_ACE, no inheritance flags.
+    ace.extend_from_slice(&(size as u16).to_le_bytes());
+    ace.extend_from_slice(&fs::FILE_READ_ATTRIBUTES.to_le_bytes());
+    ace.extend_from_slice(sid);
+    Ok(ace)
+}
+
+fn exact_index(entries: &[Vec<u8>], owned: &[u8]) -> Result<Option<usize>> {
+    let exact = entries
+        .iter()
+        .enumerate()
+        .filter(|(_, ace)| ace.as_slice() == owned)
+        .map(|(i, _)| i)
+        .collect::<Vec<_>>();
+    ensure!(exact.len() <= 1, "duplicate owned ancestor metadata ACE");
+    Ok(exact.first().copied())
+}
+
+fn owned_index(entries: &[Vec<u8>], owned: &[u8], sid: &[u8]) -> Result<Option<usize>> {
+    if let Some(index) = exact_index(entries, owned)? {
+        return Ok(Some(index));
+    }
+    for ace in entries {
+        if ace[0] == 0
+            && ace.len() >= 16
+            && entry_sid(ace)? == sid
+            && metadata_mask(u32::from_le_bytes(ace[4..8].try_into().unwrap()))
+        {
+            bail!("owned metadata ACE was changed; preserve the ledger and unrelated permissions");
+        }
+    }
+    Ok(None)
+}
+
+fn load(path: &Path) -> Result<Option<Ledger>> {
+    let mut file = match OpenOptions::new()
+        .read(true)
+        .share_mode(fs::FILE_SHARE_READ | fs::FILE_SHARE_DELETE)
+        .custom_flags(fs::FILE_FLAG_OPEN_REPARSE_POINT)
+        .open(path)
+    {
+        Ok(file) => file,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error).context("open ancestor metadata ledger"),
+    };
+    validate_state_file(&file)?;
+    let mut bytes = Vec::new();
+    file.read_to_end(&mut bytes)?;
+    Ok(Some(serde_json::from_slice(&bytes).context(
+        "invalid ancestor metadata ledger; preserve it for recovery",
+    )?))
+}
+
+fn save(path: &Path, ledger: &Ledger) -> Result<()> {
+    let file = OpenOptions::new()
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .share_mode(fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE)
+        .custom_flags(fs::FILE_FLAG_OPEN_REPARSE_POINT)
+        .open(path)?;
+    validate_state_file(&file)?;
+    crate::file_write::write_file_atomically_preserving_dacl(
+        path,
+        &serde_json::to_vec_pretty(ledger)?,
+        file,
+    )?;
+    // A successful atomic rename alone does not flush the ownership record.
+    // Persist it before any ACL mutation, including each successful revocation.
+    let committed = OpenOptions::new()
+        .write(true)
+        .share_mode(fs::FILE_SHARE_READ)
+        .custom_flags(fs::FILE_FLAG_OPEN_REPARSE_POINT)
+        .open(path)?;
+    validate_state_file(&committed)?;
+    committed
+        .sync_all()
+        .context("flush ancestor metadata ownership before ACL mutation")
+}
+
+fn validate(
+    ledger: &Ledger,
+    namespace: &SandboxNamespace,
+    pinned: &[PinnedDirectory],
+) -> Result<Vec<u8>> {
+    ensure!(
+        ledger.schema == 1
+            && ledger.namespace == namespace.key.id()
+            && ledger.owner_sid == namespace.owner_sid,
+        "ancestor metadata ledger owner mismatch"
+    );
+    let sid = crate::token::LocalSid::from_string(&ledger.group_sid)?;
+    let bytes = unsafe {
+        std::slice::from_raw_parts(
+            sid.as_ptr().cast::<u8>(),
+            GetLengthSid(sid.as_ptr()) as usize,
+        )
+    }
+    .to_vec();
+    let expected = metadata_ace(&bytes)?;
+    let mut used = std::collections::HashSet::new();
+    let current_home = PinnedDirectory::open(&namespace.home)?;
+    for grant in &ledger.grants {
+        crate::no_reparse_dir::validate_local_directory_path(&grant.path)?;
+        let target = pinned
+            .iter()
+            .find(|directory| directory.path == grant.path && directory.identity == grant.identity);
+        if private_descendant(namespace, &grant.path) {
+            // Old targets may have been deleted or renamed. Protected journal
+            // structure/namespace/ACE remains validated without re-opening or
+            // regranting an unrelated historical object during a new request.
+            ensure!(
+                grant.identity.volume == current_home.identity.volume
+                    && grant.identity.file_id != [0; 16],
+                "private metadata journal has a foreign volume or invalid identity"
+            );
+            if let Some(directory) = target {
+                Dacl::read(directory)?.require_owner(&namespace.owner_sid)?;
+            }
+        } else {
+            let target = target.context("ledger target is not a current CODEX_HOME ancestor")?;
+            ensure!(
+                target.path != namespace.home && target.path.parent().is_some(),
+                "ledger may not target home itself or a volume root"
+            );
+        }
+        ensure!(
+            grant.ace == expected
+                && used.insert((
+                    grant.path.clone(),
+                    grant.identity.volume,
+                    grant.identity.file_id
+                )),
+            "ancestor metadata identity/ACE mismatch"
+        );
+    }
+    Ok(bytes)
+}
+
+fn transaction(namespace: &SandboxNamespace) -> Result<crate::deny_read_state::StateTransaction> {
+    lock_private_state_transaction(
+        &crate::setup::sandbox_secrets_dir(&namespace.home),
+        STATE,
+        LOCK,
+    )
+}
+fn grant_ledger(
+    namespace: &SandboxNamespace,
+    pinned: &[PinnedDirectory],
+    path: &Path,
+    group: &str,
+) -> Result<Ledger> {
+    let mut ledger = load(path)?.unwrap_or_else(|| Ledger {
+        schema: 1,
+        namespace: namespace.key.id(),
+        owner_sid: namespace.owner_sid.clone(),
+        group_sid: group.to_owned(),
+        grants: Vec::new(),
+    });
+    validate(&ledger, namespace, pinned)?;
+    ensure!(
+        !ledger.grants.iter().any(|g| g.revoking),
+        "ancestor metadata revocation is incomplete; finish native uninstall before setup"
+    );
+    if ledger.group_sid != group {
+        ensure!(
+            ledger.grants.is_empty(),
+            "ancestor metadata group SID changed with pending grants"
+        );
+        ledger.group_sid = group.to_owned();
+        save(path, &ledger)?;
+    }
+    Ok(ledger)
+}
+/// Grant only missing metadata, with scope -> owner journal -> home transaction.
+/// No owner/home journal is held while waiting for an inheritance domain.
+pub(crate) fn grant(namespace: &SandboxNamespace, group_sid: &[u8]) -> Result<()> {
+    grant_for_roots(namespace, group_sid, &[])
+}
+
+pub(crate) fn grant_for_roots(
+    namespace: &SandboxNamespace,
+    group_sid: &[u8],
+    roots: &[PathBuf],
+) -> Result<()> {
+    let pinned = pin_requested_parents(namespace, roots)?;
+    grant_pinned(namespace, group_sid, &pinned)
+}
+
+fn grant_pinned(
+    namespace: &SandboxNamespace,
+    group_sid: &[u8],
+    pinned: &[PinnedDirectory],
+) -> Result<()> {
+    let group = crate::winutil::string_from_sid_bytes(group_sid).map_err(anyhow::Error::msg)?;
+    let planned = {
+        let _journal = crate::setup_mutex::acquire_metadata_acl_lock(&namespace.owner_sid, 5_000)?;
+        let tx = transaction(namespace)?;
+        grant_ledger(namespace, pinned, &tx.state_path, &group)?
+    };
+    let ace = metadata_ace(group_sid)?;
+    let principals = vec![
+        group_sid.to_vec(),
+        crate::resolve_sid("Users")?,
+        crate::resolve_sid("Authenticated Users")?,
+        crate::resolve_sid("Everyone")?,
+    ];
+    let deadline = crate::acl_lock::deadline();
+    for directory in pinned
+        .iter()
+        .filter(|p| p.path != namespace.home && p.path.parent().is_some())
+    {
+        let dacl = Dacl::read(directory)?;
+        let entries = dacl.entries()?;
+        let previously_owned = planned
+            .grants
+            .iter()
+            .any(|g| g.path == directory.path && g.identity == directory.identity);
+        if !previously_owned && already_readable(&dacl, &entries, &principals)? {
+            continue;
+        }
+        // These three guards are scoped to this target. Never wait for the next
+        // domain with an owner-wide or home-local journal held.
+        let _scope = directory.lock_acl(deadline)?;
+        let _journal = crate::setup_mutex::acquire_metadata_acl_lock(&namespace.owner_sid, 5_000)?;
+        let tx = transaction(namespace)?;
+        let mut ledger = grant_ledger(namespace, pinned, &tx.state_path, &group)?;
+        let dacl = Dacl::read(directory)?;
+        let mut entries = dacl.entries()?;
+        if let Some(owned) = ledger
+            .grants
+            .iter()
+            .find(|g| g.path == directory.path && g.identity == directory.identity)
+        {
+            owned_index(&entries, &owned.ace, group_sid)?;
+        }
+        if already_readable(&dacl, &entries, &principals)? {
+            continue;
+        }
+        dacl.require_owner(&namespace.owner_sid)?;
+        if !ledger
+            .grants
+            .iter()
+            .any(|g| g.path == directory.path && g.identity == directory.identity)
+        {
+            ledger.grants.push(Grant {
+                path: directory.path.clone(),
+                identity: directory.identity.clone(),
+                ace: ace.clone(),
+                revoking: false,
+            });
+            save(&tx.state_path, &ledger)?;
+        }
+        let index = entries
+            .iter()
+            .position(|entry| entry[1] & INHERITED_ACE as u8 != 0)
+            .unwrap_or(entries.len());
+        entries.insert(index, ace.clone());
+        dacl.write(directory, &entries)?;
+        ensure!(
+            owned_index(&Dacl::read(directory)?.entries()?, &ace, group_sid)?.is_some(),
+            "metadata ACE did not persist"
+        );
+    }
+    Ok(())
+}
+/// Remove only journaled exact bytes on the same pinned objects. Replanning never
+/// carries a stale last-index across an unlocked transaction.
+pub(crate) fn revoke(namespace: &SandboxNamespace) -> Result<()> {
+    let path = crate::setup::sandbox_secrets_dir(&namespace.home).join(STATE);
+    if !path.try_exists()? {
+        return Ok(());
+    }
+    let pinned = pin_ancestors(namespace)?;
+    let deadline = crate::acl_lock::deadline();
+    loop {
+        let planned = {
+            let _journal =
+                crate::setup_mutex::acquire_metadata_acl_lock(&namespace.owner_sid, 5_000)?;
+            let tx = transaction(namespace)?;
+            let Some(ledger) = load(&tx.state_path)? else {
+                return Ok(());
+            };
+            validate(&ledger, namespace, &pinned)?;
+            let Some(grant) = ledger.grants.last() else {
+                return Ok(());
+            };
+            grant.clone()
+        };
+        let Some(directory) = resolve_recorded_directory(namespace, &planned)? else {
+            // This branch is reached only by an identity lookup's documented
+            // absence or the bounded same-volume NTFS generation proof.
+            let _journal =
+                crate::setup_mutex::acquire_metadata_acl_lock(&namespace.owner_sid, 5_000)?;
+            let tx = transaction(namespace)?;
+            let Some(mut ledger) = load(&tx.state_path)? else {
+                return Ok(());
+            };
+            let sid = validate(&ledger, namespace, &pinned)?;
+            if ledger.grants.last() != Some(&planned) {
+                ensure!(
+                    deadline.is_none_or(|end| std::time::Instant::now() < end),
+                    "deleted metadata ownership changed while locking"
+                );
+                continue;
+            }
+            if crate::namespace::local_group_exists(&namespace.key.group())? {
+                ensure!(
+                    crate::resolve_sid(&namespace.key.group())? == sid,
+                    "metadata group identity changed while retiring deleted generation"
+                );
+            }
+            ledger.grants.pop();
+            save(&tx.state_path, &ledger)?;
+            continue;
+        };
+        let _scope = directory.lock_acl(deadline)?;
+        let _journal = crate::setup_mutex::acquire_metadata_acl_lock(&namespace.owner_sid, 5_000)?;
+        let tx = transaction(namespace)?;
+        let Some(mut ledger) = load(&tx.state_path)? else {
+            return Ok(());
+        };
+        let sid = validate(&ledger, namespace, &pinned)?;
+        if ledger.grants.last() != Some(&planned) {
+            ensure!(
+                deadline.is_none_or(|end| std::time::Instant::now() < end),
+                "metadata revocation changed while locking"
+            );
+            continue;
+        }
+        if crate::namespace::local_group_exists(&namespace.key.group())? {
+            ensure!(
+                crate::resolve_sid(&namespace.key.group())? == sid,
+                "metadata group identity changed"
+            );
+        }
+        let dacl = Dacl::read(&directory)?;
+        if private_descendant(namespace, &planned.path) {
+            dacl.require_owner(&namespace.owner_sid)?;
+        }
+        let mut entries = dacl.entries()?;
+        let index = if planned.revoking {
+            exact_index(&entries, &planned.ace)?
+        } else {
+            let index = owned_index(&entries, &planned.ace, &sid)?;
+            if index.is_some() {
+                dacl.require_owner(&namespace.owner_sid)?;
+                ledger.grants.last_mut().unwrap().revoking = true;
+                save(&tx.state_path, &ledger)?;
+            }
+            index
+        };
+        if let Some(index) = index {
+            dacl.require_owner(&namespace.owner_sid)?;
+            entries.remove(index);
+            dacl.write(&directory, &entries)?;
+            ensure!(
+                exact_index(&Dacl::read(&directory)?.entries()?, &planned.ace)?.is_none(),
+                "owned ancestor metadata ACE remains after revocation"
+            );
+        }
+        ledger.grants.pop();
+        save(&tx.state_path, &ledger)?;
+    }
+}
