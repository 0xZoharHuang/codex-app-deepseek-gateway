+/// private DACL and pinned physical parent keep a different path from becoming
+/// a second lock for this same ledger. Dropping the handles releases the lock.
+pub(crate) struct StateTransaction {
+    _file: File,
+    _parent: std::os::windows::io::OwnedHandle,
+    pub(crate) state_path: PathBuf,
+}
