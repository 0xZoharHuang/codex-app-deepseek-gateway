+fn managed_read_state_transactions_serialize_two_writers_without_losing_ownership() -> Result<()> {
+    use std::sync::mpsc;
+    let temp = TempDir::new()?;
+    fs::create_dir(sandbox_dir(temp.path()))?;
+    let first = temp.path().join("first");
+    let second = temp.path().join("second");
+    fs::create_dir(&first)?;
+    fs::create_dir(&second)?;
+    let alias_parent = TempDir::new()?;
+    let alias = alias_parent.path().join("home-alias");
+    assert!(
+        Command::new("cmd.exe")
+            .args(["/c", "mklink", "/J"])
+            .arg(&alias)
+            .arg(temp.path())
+            .output()?
+            .status
+            .success()
+    );
+    let home = temp.path().to_owned();
+    let (entered_tx, entered_rx) = mpsc::channel();
+    let (release_tx, release_rx) = mpsc::channel();
+    let (second_tx, second_rx) = mpsc::channel();
+    let (blocked_tx, blocked_rx) = mpsc::channel();
+    std::thread::scope(|scope| -> Result<()> {
+        let home = &home;
+        let first = &first;
+        let writer_one = scope.spawn(move || -> Result<()> {
+            let sid_text = "S-1-5-21-10-20-30-424243";
+            let sid = LocalSid::from_string(sid_text)?;
+            unsafe {
+                sync_persistent_deny_read_acls_with(
+                    &home,
+                    sid_text,
+                    std::slice::from_ref(first),
+                    sid.as_ptr(),
+                    |planned, principal| {
+                        entered_tx.send(()).unwrap();
+                        release_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+                        apply_planned_deny_read_acls(planned, principal)
+                    },
+                )
+            }?;
+            Ok(())
+        });
+        entered_rx.recv_timeout(Duration::from_secs(5))?;
+        let writer_two = scope.spawn(|| -> Result<()> {
+            let observed_lock = OpenOptions::new()
+                .read(true)
+                .write(true)
+                .open(sandbox_dir(&alias).join("deny_read_acl_state.lock"))?;
+            assert!(
+                matches!(
+                    observed_lock.try_lock(),
+                    Err(std::fs::TryLockError::WouldBlock)
+                ),
+                "second writer must actually observe the first writer's OS lock"
+            );
+            blocked_tx.send(())?;
+            drop(observed_lock);
+            let sid_text = "S-1-5-21-10-20-30-424244";
+            let sid = LocalSid::from_string(sid_text)?;
+            unsafe {
+                sync_persistent_deny_read_acls(
+                    &alias,
+                    sid_text,
+                    std::slice::from_ref(&second),
+                    sid.as_ptr(),
+                )
+            }?;
+            second_tx.send(()).unwrap();
+            Ok(())
+        });
+        blocked_rx.recv_timeout(Duration::from_secs(5))?;
+        assert!(
+            matches!(
+                second_rx.recv_timeout(Duration::from_millis(100)),
+                Err(mpsc::RecvTimeoutError::Timeout)
+            ),
+            "second writer must not bypass the first transaction through an alias"
+        );
+        release_tx.send(())?;
+        writer_one.join().expect("first writer")?;
+        writer_two.join().expect("second writer")?;
+        Ok(())
+    })?;
+    let state = load_state(&sandbox_dir(&home).join(DENY_READ_ACL_STATE_FILE))?;
+    assert_eq!(state.principals.len(), 2);
+    assert_eq!(state.principals["S-1-5-21-10-20-30-424243"], vec![first]);
+    assert_eq!(state.principals["S-1-5-21-10-20-30-424244"], vec![second]);
+    Ok(())
+}
