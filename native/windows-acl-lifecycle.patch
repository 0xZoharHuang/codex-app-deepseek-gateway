+//! Owner-private, zero-byte coordination files. They carry no persistent state.
+//! Keeping each live RW handle non-delete-shared prevents cleanup split locks.
+use crate::no_reparse_dir::{
+    DirectoryOpenDisposition, open_directory_no_reparse, open_no_reparse_with_security,
+};
+use anyhow::{Context, Result, ensure};
+use std::ffi::c_void;
+use std::fs::File;
+use std::os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle};
+use std::path::Path;
+use windows_sys::Win32::Foundation::{HANDLE, LocalFree};
+use windows_sys::Win32::Security::Authorization::{
+    ConvertStringSecurityDescriptorToSecurityDescriptorW, GetSecurityInfo,
+};
+use windows_sys::Win32::Security::{
+    ACCESS_ALLOWED_ACE, ACE_HEADER, ACL, DACL_SECURITY_INFORMATION, EqualSid, GetAce,
+    GetSecurityDescriptorControl, GetSecurityDescriptorDacl, OWNER_SECURITY_INFORMATION,
+    SE_DACL_PROTECTED, TOKEN_QUERY,
+};
+use windows_sys::Win32::Storage::FileSystem as fs;
+use windows_sys::Win32::System::Threading::{GetCurrentProcess, OpenProcessToken};
+
+struct Descriptor(*mut c_void);
+impl Drop for Descriptor {
+    fn drop(&mut self) {
+        if !self.0.is_null() {
+            unsafe {
+                LocalFree(self.0);
+            }
+        }
+    }
+}
+pub(crate) struct PrivatePolicy {
+    descriptor: Descriptor,
+    user: Vec<u8>,
+}
+impl PrivatePolicy {
+    pub(crate) fn current() -> Result<Self> {
+        let mut token = std::ptr::null_mut();
+        ensure!(
+            unsafe { OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &mut token) } != 0,
+            "open private lock owner token: {}",
+            std::io::Error::last_os_error()
+        );
+        let token = unsafe { OwnedHandle::from_raw_handle(token) };
+        let user = unsafe { crate::token::get_user_sid_bytes(token.as_raw_handle() as _) }?;
+        let user_text = crate::winutil::string_from_sid_bytes(&user).map_err(anyhow::Error::msg)?;
+        let text = crate::winutil::to_wide(format!(
+            "O:{user_text}D:P(A;;FA;;;{user_text})(A;;FA;;;SY)(A;;FA;;;BA)"
+        ));
+        let mut descriptor = Descriptor(std::ptr::null_mut());
+        ensure!(
+            unsafe {
+                ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                    text.as_ptr(),
+                    1,
+                    &mut descriptor.0,
+                    std::ptr::null_mut(),
+                )
+            } != 0,
+            "create private lock security: {}",
+            std::io::Error::last_os_error()
+        );
+        Ok(Self { descriptor, user })
+    }
+    pub(crate) fn validate(&self, handle: HANDLE) -> Result<()> {
+        let mut actual = Descriptor(std::ptr::null_mut());
+        let (mut owner, mut acl) = (std::ptr::null_mut(), std::ptr::null_mut());
+        let status = unsafe {
+            GetSecurityInfo(
+                handle,
+                1,
+                OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION,
+                &mut owner,
+                std::ptr::null_mut(),
+                &mut acl,
+                std::ptr::null_mut(),
+                &mut actual.0,
+            )
+        };
+        ensure!(status == 0, "inspect private lock security: {status}");
+        let (mut control, mut revision) = (0, 0);
+        ensure!(
+            unsafe { GetSecurityDescriptorControl(actual.0, &mut control, &mut revision) } != 0,
+            "inspect private lock flags"
+        );
+        ensure!(
+            control & SE_DACL_PROTECTED != 0
+                && !owner.is_null()
+                && unsafe { EqualSid(owner, self.user.as_ptr() as _) } != 0,
+            "lock object is not private to its owner"
+        );
+        let (mut expected, mut present, mut defaulted) = (std::ptr::null_mut(), 0, 0);
+        ensure!(
+            unsafe {
+                GetSecurityDescriptorDacl(
+                    self.descriptor.0,
+                    &mut present,
+                    &mut expected,
+                    &mut defaulted,
+                )
+            } != 0
+                && present != 0
+                && !acl.is_null()
+                && !expected.is_null(),
+            "invalid private lock DACL"
+        );
+        ensure!(
+            unsafe { entries(acl)? == entries(expected)? },
+            "private lock DACL differs from owner-private policy"
+        );
+        Ok(())
+    }
+    pub(crate) fn open_file(
+        &self,
+        parent: HANDLE,
+        name: &str,
+        access: u32,
+        share: u32,
+        disposition: u32,
+    ) -> Result<File> {
+        ensure!(
+            Path::new(name).file_name().is_some_and(|leaf| leaf == name) && !name.contains(':'),
+            "private lock name must be a plain leaf"
+        );
+        let mut wide = crate::winutil::to_wide(name);
+        let handle = open_no_reparse_with_security(
+            parent,
+            &mut wide,
+            access,
+            share,
+            disposition,
+            0x40 | 0x20,
+            self.descriptor.0,
+        )?;
+        let file = File::from(handle);
+        crate::deny_read_state::validate_state_file(&file)?;
+        self.validate(file.as_raw_handle() as _)?;
+        Ok(file)
+    }
+    fn open_directory(&self, parent: HANDLE, name: &str) -> Result<OwnedHandle> {
+        let mut wide = crate::winutil::to_wide(name);
+        let handle = open_no_reparse_with_security(
+            parent,
+            &mut wide,
+            fs::FILE_GENERIC_READ | fs::FILE_GENERIC_WRITE | fs::FILE_GENERIC_EXECUTE,
+            fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE,
+            3,
+            1 | 0x20,
+            self.descriptor.0,
+        )?;
+        self.validate(handle.as_raw_handle() as _)?;
+        Ok(handle)
+    }
+}
+unsafe fn entries(acl: *mut ACL) -> Result<Vec<Vec<u8>>> {
+    let mut result = Vec::new();
+    for index in 0..unsafe { (*acl).AceCount } as u32 {
+        let mut entry = std::ptr::null_mut();
+        ensure!(
+            unsafe { GetAce(acl, index, &mut entry) } != 0,
+            "read private lock ACE"
+        );
+        let header = unsafe { &*entry.cast::<ACE_HEADER>() };
+        ensure!(
+            header.AceType == 0
+                && header.AceFlags == 0
+                && header.AceSize as usize >= size_of::<ACCESS_ALLOWED_ACE>(),
+            "non-private lock ACE"
+        );
+        let ace = unsafe { &*entry.cast::<ACCESS_ALLOWED_ACE>() };
+        ensure!(
+            ace.Mask == fs::FILE_ALL_ACCESS,
+            "unexpected private lock access"
+        );
+        result.push(
+            unsafe { std::slice::from_raw_parts(entry.cast::<u8>(), header.AceSize as usize) }
+                .to_vec(),
+        );
+    }
+    Ok(result)
+}
+pub(crate) struct PrivateLockDirectory {
+    policy: PrivatePolicy,
+    directory: OwnedHandle,
+    _parent: OwnedHandle,
+}
+impl PrivateLockDirectory {
+    pub(crate) fn open() -> Result<Self> {
+        // dirs-next on Windows calls SHGetKnownFolderPath(FOLDERID_LocalAppData).
+        // No environment override, per-install location, or shared CDS/App state.
+        let parent = dirs_next::data_local_dir()
+            .context("Windows LocalAppData known folder is unavailable")?;
+        Self::at(&parent, "CodexDeepSeekNativeAcl")
+    }
+    fn at(parent: &Path, name: &str) -> Result<Self> {
+        let parent = dunce::canonicalize(parent)?;
+        let parent = open_directory_no_reparse(
+            &parent,
+            fs::FILE_TRAVERSE | fs::FILE_READ_ATTRIBUTES,
+            fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE,
+            DirectoryOpenDisposition::OpenExisting,
+        )?;
+        let policy = PrivatePolicy::current()?;
+        let directory = policy.open_directory(parent.as_raw_handle() as _, name)?;
+        Ok(Self {
+            policy,
+            directory,
+            _parent: parent,
+        })
+    }
+    pub(crate) fn open_leaf(&self, name: &str) -> Result<File> {
+        let file = self.policy.open_file(
+            self.directory.as_raw_handle() as _,
+            name,
+            fs::FILE_GENERIC_READ | fs::FILE_GENERIC_WRITE,
+            fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE,
+            3,
+        )?;
+        ensure!(
+            file.metadata()?.len() == 0,
+            "ACL coordination file must be empty"
+        );
+        Ok(file)
+    }
+    /// Only an unused leaf can be opened with DELETE access and no sharing.
+    /// Delete by that same validated handle; never unlink/reopen an active name.
+    pub(crate) fn try_cleanup(&self, name: &str) -> Result<bool> {
+        let file = match self.policy.open_file(
+            self.directory.as_raw_handle() as _,
+            name,
+            fs::DELETE | fs::FILE_GENERIC_READ | fs::FILE_GENERIC_WRITE,
+            0,
+            1,
+        ) {
+            Ok(file) => file,
+            Err(error)
+                if error
+                    .chain()
+                    .filter_map(|e| e.downcast_ref::<std::io::Error>())
+                    .any(|e| matches!(e.raw_os_error(), Some(2 | 3 | 5 | 32 | 303))) =>
+            {
+                return Ok(false);
+            }
+            Err(error) => return Err(error),
+        };
+        ensure!(
+            file.metadata()?.len() == 0,
+            "refusing to delete nonempty ACL coordination file"
+        );
+        let disposition = fs::FILE_DISPOSITION_INFO { DeleteFile: true };
+        ensure!(
+            unsafe {
+                fs::SetFileInformationByHandle(
+                    file.as_raw_handle() as _,
+                    fs::FileDispositionInfo,
+                    (&disposition as *const fs::FILE_DISPOSITION_INFO).cast(),
+                    size_of::<fs::FILE_DISPOSITION_INFO>() as u32,
+                )
+            } != 0,
+            "delete unused ACL lock: {}",
+            std::io::Error::last_os_error()
+        );
+        Ok(true)
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn live_and_waiting_handles_block_cleanup_and_reuse_same_file() -> Result<()> {
+        let temp = tempfile::tempdir()?;
+        let dir = PrivateLockDirectory::at(temp.path(), "private")?;
+        let name = "unit.lock";
+        let held = dir.open_leaf(name)?;
+        held.try_lock()?;
+        let waiting = dir.open_leaf(name)?;
+        assert!(matches!(
+            waiting.try_lock(),
+            Err(std::fs::TryLockError::WouldBlock)
+        ));
+        assert!(!dir.try_cleanup(name)?);
+        drop(held);
+        assert!(!dir.try_cleanup(name)?);
+        waiting.try_lock()?;
+        drop(waiting);
+        assert!(dir.try_cleanup(name)?);
+        assert!(!dir.try_cleanup(name)?);
+        let next = dir.open_leaf(name)?;
+        next.try_lock()?;
+        drop(next);
+        assert!(dir.try_cleanup(name)?);
+        Ok(())
+    }
+    #[test]
+    fn rejects_nonempty_and_hardlinked_files_without_repair() -> Result<()> {
+        use std::io::Write;
+        let temp = tempfile::tempdir()?;
+        let dir = PrivateLockDirectory::at(temp.path(), "private")?;
+        let mut file = dir.open_leaf("nonempty.lock")?;
+        file.write_all(b"not a lock")?;
+        drop(file);
+        assert!(dir.open_leaf("nonempty.lock").is_err());
+        assert!(dir.try_cleanup("nonempty.lock").is_err());
+        assert!(temp.path().join("private/nonempty.lock").exists());
+        let file = dir.open_leaf("linked.lock")?;
+        drop(file);
+        std::fs::hard_link(
+            temp.path().join("private/linked.lock"),
+            temp.path().join("private/other.lock"),
+        )?;
+        assert!(dir.open_leaf("linked.lock").is_err());
+        assert!(dir.try_cleanup("linked.lock").is_err());
+        Ok(())
+    }
+}
