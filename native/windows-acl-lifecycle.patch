+        } else {
+            "(A;;0x80;;;S-1-5-21-10-20-30-4248)"
+        };
+        let sddl = format!("D:P(D;;WD;;;OW)(D;;WD;;;WD)(A;;FR;;;WD){target}");
+        let mut next = std::ptr::null_mut();
